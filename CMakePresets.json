{
  "version": 3,
  "configurePresets": [
    {
      "name": "fm1",
      "displayName": "JieLi pi32v2 (FM-1)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/fm1",
      "toolchainFile": "${sourceDir}/cmake/pi32v2.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "FMZX_LCD_RGB565": "OFF", "FMZX_PRODUCT": "FM-1_948" }
    },
    {
      "name": "fm1-preview",
      "displayName": "JieLi pi32v2 (FM-1), RGB565 by default: the fm1-emu preview",
      "inherits": "fm1",
      "binaryDir": "${sourceDir}/build/fm1-preview",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "FMZX_LCD_RGB565": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "fm1", "configurePreset": "fm1" },
    { "name": "fm1-preview", "configurePreset": "fm1-preview" }
  ]
}
