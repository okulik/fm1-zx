# ---------------------------------------------------------------------------------------------
# The plan (plan.json, written by fmzx-pack personal --plan)


@dataclass
class Score:
    key: str
    shadow: bool
    seconds: float
    status: str


@dataclass
class Game:
    id: str
    name: str
    file: str
    how: str
    packed: int | None
    reason: str | None
    music: str
    scores: list[Score]

    @property
    def left_out(self) -> bool:
        return self.packed is None

    @property
    def can_arrange(self) -> bool:
        return bool(self.scores) and not self.left_out

    def plays(self) -> str:
        """What plays for a game with nothing to arrange."""
        return "nothing to arrange: FM from code" if self.music.startswith("music learned") else "beeper"


@dataclass
class Plan:
    room: int
    used: int
    games: list[Game]

    def game(self, gid: str) -> Game | None:
        return next((g for g in self.games if g.id == gid), None)

    def packed(self) -> list[Game]:
        """The packed games in name order (the picker's: A to Z, case not counting)."""
        return sorted((g for g in self.games if not g.left_out), key=lambda g: (g.name.casefold(), g.id))

    def overhead(self) -> int:
        """The pack's bytes beyond its games' (header, directory, shared tables)."""
        return max(0, self.used - sum(g.packed or 0 for g in self.games))


def parse_plan(doc: dict) -> Plan:
    games = []
    for r in doc.get("games", []):
        scores = [Score(str(s["key"]), bool(s.get("shadow", False)), float(s.get("seconds", 0.0)), str(s.get("status", "")))
                  for s in (r.get("scores") or [])]
        packed = r.get("packed")
        games.append(Game(str(r["id"]), str(r.get("name", r["id"])), str(r.get("file", "")), str(r.get("how", "")),
                          None if packed is None else int(packed), r.get("reason"), str(r.get("music", "")), scores))
    return Plan(int(doc.get("room", 0)), int(doc.get("used", 0)), games)


def load_plan(path: Path) -> Plan | None:
    try:
        return parse_plan(json.loads(path.read_text()))
    except (OSError, ValueError, KeyError, TypeError):
        return None


# ---------------------------------------------------------------------------------------------
# Choices, takes and candidates (W/all/arrange/, tools/arrange-music's layout)


def read_toml(path: Path) -> dict:
    try:
        with path.open("rb") as f:
            return tomllib.load(f)
    except (OSError, tomllib.TOMLDecodeError):
        return {}


def parse_choice(v) -> int | str | None:
    if isinstance(v, bool):
        return None
    if isinstance(v, int):
        return v if v >= 0 else None
    if isinstance(v, str):
        if v.isdigit():
            return int(v)
        if re.fullmatch(r"(chip|ay)-[1-9][0-9]*", v):
            return v
    return None


def read_choices(all_dir: Path) -> dict[str, int | str]:
    out = {}
    for k, v in read_toml(all_dir / "arrange" / "choices.toml").get("choices", {}).items():
        c = parse_choice(v)
        if c is not None:
            out[str(k)] = c
    return out


def choice_label(c: int | str | None) -> str:
    if c in (None, 0):
        return "original"
    return f"take-{c}" if isinstance(c, int) else str(c)


def numbered(d: Path, prefix: str) -> list[tuple[int, Path]]:
    out = []
    for p in d.glob(prefix + "*"):
        n = p.name[len(prefix):]
        if n.isdigit() and (p / "arranged.toml").is_file():
            out.append((int(n), p))
    return sorted(out)


def metrics_line(m: dict) -> str:
    f = lambda k: float(m.get(k, 0) or 0)  # noqa: E731
    return (f"key {m.get('key') or '?'}; consonance bass {f('bass_consonance'):.2f} pad {f('pad_consonance'):.2f}; "
            f"notes/s lead {m.get('lead_nps', 0)} bass {m.get('bass_nps', 0)} pad {m.get('pad_nps', 0)} "
            f"drums {m.get('drums_nps', 0)}")


@dataclass
class Candidate:
    label: str
    take: str  # the preview's take: "beeper", "fm" (the whole game), "0", "<n>", "chip-<n>", "c64-<n>", "ay-<n>", "zx128-<n>"
    choice: int | str | None  # the value for pick --set; None: not a choice
    info: str
    file: Path | None = None  # tools/arrange-music's render, played without music-preview
    source: Path | None = None  # a preview older than this is made again
    direct: bool = False  # always the file (the C64's or the Spectrum 128's own sound)


WHOLE_GAME = "game"  # the preview key of a game without scores


def score_candidates(all_dir: Path, gid: str, sc: Score | None) -> list[Candidate]:
    if sc is None:
        return [Candidate("beeper", "beeper", None, "the game's own sound"),
                Candidate("FM (from code/memory)", "fm", None, "what FM: engines plays")]
    d = all_dir / "arrange" / gid / sc.key
    out = [Candidate("beeper", "beeper", None, "the game's own sound, to compare", source=d / "score.toml"),
           Candidate("FM (from code/memory)", "0", 0,
                     "take 0: the live version (the routine)" if sc.shadow else "take 0: the original",
                     d / "original.wav", d / "score.toml")]
    for n, p in numbered(d, "take-"):
        doc = read_toml(p / "arranged.toml")
        gen = str(doc.get("generator", "")).split(" ")[0]
        out.append(Candidate(f"AI take-{n}" + (f" ({gen})" if gen else ""), str(n), n,
                             metrics_line(doc.get("metrics", {})), p / "fm1.wav", p / "arranged.toml"))
    for n, p in numbered(d, "chip-"):
        doc = read_toml(p / "arranged.toml")
        mm = float(doc.get("metrics", {}).get("melody_match", 0.0) or 0.0)
        out.append(Candidate(f"SID chip-{n}", f"chip-{n}", f"chip-{n}",
                             f"melody match {mm:.2f}; {doc.get('source', '?')}", p / "fm1.wav", p / "arranged.toml"))
        if (p / "chip.wav").is_file():
            out.append(Candidate(f"C64 original (chip-{n})", f"c64-{n}", None, "the C64's own sound (sidplayfp)",
                                 p / "chip.wav", direct=True))
    for n, p in numbered(d, "ay-"):
        doc = read_toml(p / "arranged.toml")
        mm = float(doc.get("metrics", {}).get("melody_match", 0.0) or 0.0)
        out.append(Candidate(f"AY ay-{n}", f"ay-{n}", f"ay-{n}",
                             f"melody match {mm:.2f}; {doc.get('source', '?')}", p / "fm1.wav", p / "arranged.toml"))
        if (p / "ay.wav").is_file():
            out.append(Candidate(f"Spectrum 128 original (ay-{n})", f"zx128-{n}", None, "the Spectrum 128's own sound (ffmpeg)",
                                 p / "ay.wav", direct=True))
    return out


def preview_path(w: Path, gid: str, key: str, take: str) -> Path:
    return w / "previews" / f"{gid}__{key}__{take}.wav"


def preview_argv(tool: str, all_dir: Path, gid: str, key: str, take: str, out: Path) -> list[str]:
    a = [tool, str(all_dir), "--game", gid]
    if key != WHOLE_GAME:
        a += ["--score", key]
    if take == "beeper":
        a += ["--beeper"]
    elif take != "fm":
        a += ["--take", take]
    return a + ["-o", str(out)]


def play_route(w: Path, gid: str, key: str, c: Candidate, preview_ok: bool) -> tuple[str, Path | None, str]:
    """How a candidate plays: ("file", path, note), ("render", preview path, note) or
    ("none", None, why)."""
    if c.direct:
        return ("file", c.file, c.file.name) if c.file and c.file.is_file() else ("none", None, f"no {c.file.name if c.file else 'file'}")
    if preview_ok:
        out = preview_path(w, gid, key, c.take)
        try:
            fresh = out.is_file() and (c.source is None or not c.source.exists()
                                       or out.stat().st_mtime >= c.source.stat().st_mtime)
        except OSError:
            fresh = False
        return ("file", out, "music-preview") if fresh else ("render", out, "music-preview")
    if c.file and c.file.is_file():
        note = f"{c.file.name} (General MIDI render)" if c.file.name == "original.wav" else c.file.name
        return "file", c.file, note
    if c.file is None:
        return "none", None, "nothing to play: music-preview is not built"
    return "none", None, f"nothing to play: no {c.file.name} (music-preview is not built; FluidSynth renders)"


# ---------------------------------------------------------------------------------------------
# The studio's state (W/studio.toml)


def load_methods(w: Path) -> dict[str, set[str]]:
    doc = read_toml(w / "studio.toml")
    out = {}
    for gid, ms in doc.get("methods", {}).items():
        if isinstance(ms, list):
            out[str(gid)] = {m for m in ms if m in METHODS}
    return out


def save_methods(w: Path, methods: dict[str, set[str]]) -> None:
    lines = ["# tools/pack-studio: the music methods marked per game (FM is always there)", "[methods]"]
    for gid in sorted(methods):
        ms = [m for m in METHODS if m in methods[gid]]
        if ms:
            lines.append(f"{json.dumps(gid)} = [{', '.join(json.dumps(m) for m in ms)}]")
    w.mkdir(parents=True, exist_ok=True)
    tmp = w / "studio.toml.tmp"
    tmp.write_text("\n".join(lines) + "\n")
    tmp.replace(w / "studio.toml")


# ---------------------------------------------------------------------------------------------
# The split and the pack folders


def split_packs(games: list[tuple[str, int]], room: int, overhead: int = 0, margin: float = MARGIN) -> list[list[str]]:
    """Games (id, packed bytes) in order into packs: each filled while its total stays within
    room minus the margin minus the overhead. A game bigger than that gets a pack of its own."""
    limit = room * (1 - margin) - overhead
    packs: list[list[str]] = []
    cur: list[str] = []
    total = 0
    for gid, size in games:
        if cur and total + size > limit:
            packs.append(cur)
            cur, total = [], 0
        cur.append(gid)
        total += size
    if cur:
        packs.append(cur)
    return packs


GAME_RE = re.compile(r"^[ \t]*\[\[[ \t]*game[ \t]*\]\][ \t]*(#.*)?\r?\n?$")
COMMENTED_GAME_RE = re.compile(r"^[ \t]*#[ \t#]*\[\[[ \t]*game[ \t]*\]\]")


def _comment(line: str) -> bool:
    return line.lstrip().startswith("#")


def split_games_file(text: str) -> tuple[str, list[tuple[str, str]]]:
    """A personal games file as (its header comment, [(id, entry text)]): each entry from its
    [[game]] line to its last line (its [game.*] tables and the comment lines right after them
    included; blank lines, a commented-out game or a "# missing:" line below it are not)."""
    lines = text.splitlines(keepends=True)
    starts = [i for i, ln in enumerate(lines) if GAME_RE.match(ln)]
    header = []
    for ln in lines[:starts[0] if starts else len(lines)]:
        if not ln.strip() or not _comment(ln):
            break
        header.append(ln)
    entries = []
    for k, s in enumerate(starts):
        chunk = lines[s:starts[k + 1] if k + 1 < len(starts) else len(lines)]
        last = max(i for i, ln in enumerate(chunk) if i == 0 or (ln.strip() and not _comment(ln)))
        end = last + 1
        while end < len(chunk) and chunk[end].strip() and _comment(chunk[end]) \
                and not COMMENTED_GAME_RE.match(chunk[end]) and not chunk[end].lstrip().startswith("# missing:"):
            end += 1
        body = "".join(chunk[:end])
        if not body.endswith("\n"):
            body += "\n"
        try:
            doc = tomllib.loads(body)
            gid = str(doc["game"][0]["id"])
        except (tomllib.TOMLDecodeError, KeyError, IndexError, TypeError) as e:
            raise ValueError(f"the games file's entry at line {s + 1} does not read: {e}") from None
        entries.append((gid, body))
    return "".join(header), entries


def absolute_file(entry: str, base: Path) -> str:
    """The entry with a relative `file` made absolute from base (the games file's folder)."""
    f = tomllib.loads(entry)["game"][0].get("file")
    if not isinstance(f, str) or Path(f).is_absolute():
        return entry
    lines = entry.splitlines(keepends=True)
    for i, ln in enumerate(lines[1:], 1):
        if ln.lstrip().startswith("["):
            break
        if re.match(r"^[ \t]*file[ \t]*=", ln):
            lines[i] = f"file = {json.dumps(str((base / f).resolve()))}\n"
            break
    return "".join(lines)


def subset_games_file(text: str, ids: list[str], base: Path, note: str) -> str:
    header, entries = split_games_file(text)
    by = dict(entries)
    missing = [g for g in ids if g not in by]
    if missing:
        raise ValueError(f"no entry for {', '.join(missing)} in the games file")
    out = header + "".join(f"# {ln}\n" for ln in note.splitlines()) + "\n"
    return out + "\n".join(absolute_file(by[g], base) for g in ids)


def is_studio_pack(d: Path) -> bool:
    return (d / MARKER).is_file()


def write_pack_folder(w: Path, n: int, ids: list[str], text: str) -> Path:
    """W/pack-<n>/: the marker, the games file and the two links into W/all."""
    d = w / f"pack-{n}"
    if d.exists() and any(d.iterdir()) and not is_studio_pack(d):
        raise ValueError(f"{d} is not the studio's (no {MARKER}): move it away")
    d.mkdir(parents=True, exist_ok=True)
    (d / MARKER).write_text(json.dumps({"games": ids}) + "\n")
    (d / "personal-games.toml").write_text(text)
    for name in ("sound-cache", "arrange"):
        (w / "all" / name).mkdir(parents=True, exist_ok=True)
        link = d / name
        target = Path("..") / "all" / name
        if link.is_symlink():
            if Path(os.readlink(link)) == target:
                continue
            link.unlink()
        elif link.is_dir():
            shutil.rmtree(link)
        elif link.exists():
            link.unlink()
        link.symlink_to(target, target_is_directory=True)
    return d


def pack_folders(w: Path) -> list[tuple[int, Path]]:
    out = []
    for d in w.glob("pack-*"):
        n = d.name[5:]
        if n.isdigit() and d.is_dir():
            out.append((int(n), d))
    return sorted(out)


def remove_stale_packs(w: Path, count: int) -> list[Path]:
    """Removes W/pack-<m> for m > count that the studio made; returns them."""
    gone = []
    for n, d in pack_folders(w):
        if n > count and is_studio_pack(d):
            shutil.rmtree(d)  # the links inside are removed, not followed
            gone.append(d)
    return gone


def pack_summary(w: Path, plan: Plan | None) -> list[str]:
    """The packs on disk the studio made: each pack's games and its fmzx.fwsc."""
    out = []
    for n, d in pack_folders(w):
        if not is_studio_pack(d):
            continue
        try:
            ids = json.loads((d / MARKER).read_text()).get("games", [])
        except (OSError, ValueError):
            ids = []
        games = [plan.game(g) if plan else None for g in ids]
        names = [g.name if g else gid for g, gid in zip(games, ids)]
        size = sum((g.packed or 0) for g in games if g) if plan else None
        fw = d / "fmzx.fwsc"
        where = str(fw) if fw.is_file() else f"{fw} (not built)"
        out.append(f"pack {n}: {len(ids)} game{'s' if len(ids) != 1 else ''}" + (f", {kb(size)}" if size else "") + f": {where}")
        out.append(f"  {', '.join(names) or '-'}")
    return out


# ---------------------------------------------------------------------------------------------
# The SID collection


def member_ok(name: str) -> bool:
    """An archive member's path that stays inside the folder it is unpacked into."""
    if not name or "\0" in name or "\\" in name or name.startswith("/") or re.match(r"^[A-Za-z]:", name):
        return False
    return ".." not in PurePosixPath(name).parts


@dataclass
class Member:
    name: str
    kind: str  # "file", "dir", "link" (a symbolic or hard link) or "other" (a device, a fifo)
    size: int


def archive_tool() -> tuple[str, str] | None:
    """("bsdtar", path) for bsdtar (libarchive; macOS's tar), else ("7z", path) for 7-Zip; None
    when neither is installed."""
    tar = shutil.which("bsdtar")
    if not tar and shutil.which("tar"):
        with contextlib.suppress(OSError, subprocess.SubprocessError):
            if "bsdtar" in subprocess.run(["tar", "--version"], capture_output=True, text=True, timeout=10).stdout:
                tar = shutil.which("tar")
    if tar:
        return "bsdtar", tar
    for exe in ("7zz", "7z", "7za"):
        if shutil.which(exe):
            return "7z", shutil.which(exe)
    return None


NO_ARCHIVE_TOOL = "unpacking a .7z needs bsdtar (libarchive) or 7-Zip (7zz, 7z or 7za): install one and try again"
BSDTAR_LINE = re.compile(r"^(?P<mode>\S{10})\s+\d+\s+\S+\s+\S+\s+(?P<size>\d+)\s")


def parse_bsdtar_listing(names: str, verbose: str) -> list[Member]:
    """bsdtar's member list: names from tar -tf (one a line, exactly), kind and size from the
    same lines of tar -tvf (the mode's first letter: - a file, d a folder, l, h a link, others a
    device or a fifo; a hard link also says "link to"). A listing that does not read is an
    error."""
    ns = names.splitlines()
    vs = verbose.splitlines()
    if len(ns) != len(vs):
        raise ValueError(f"the listings do not agree ({len(ns)} names, {len(vs)} verbose lines)")
    out = []
    for n, v in zip(ns, vs):
        m = BSDTAR_LINE.match(v)
        if not m:
            raise ValueError(f"a listing line does not read: {v!r}")
        c = m["mode"][0]
        kind = ("link" if c in "lh" or " link to " in v else "file") if c in "-lh" else "dir" if c == "d" else "other"
        out.append(Member(n, kind, int(m["size"])))
    return out


def parse_7z_listing(text: str) -> list[Member]:
    """7-Zip's member list (7z l -slt): the blocks after the "----------" line, one a member,
    "Path = ", "Size = ", "Folder = +" for a folder, "Attributes = " (its Unix mode, when there,
    gives the kind as for bsdtar) and "Symbolic Link = " or "Hard Link = " for a link."""
    lines = text.splitlines()
    try:
        lines = lines[lines.index("----------") + 1:]
    except ValueError:
        raise ValueError("no member list in 7-Zip's listing") from None
    blocks, cur = [], {}
    for ln in lines + [""]:
        if not ln.strip():
            if cur:
                blocks.append(cur)
            cur = {}
            continue
        k, sep, v = ln.partition(" = ")
        if not sep:
            k, v = ln.rstrip(" ="), ""
        cur[k.strip()] = v
    out = []
    for blk in blocks:
        if "Path" not in blk:
            raise ValueError(f"a member without a path in 7-Zip's listing: {blk}")
        mode = next((t for t in blk.get("Attributes", "").split() if len(t) == 10 and t[0] in "-dlbcps"), "")
        if blk.get("Symbolic Link") or blk.get("Hard Link") or mode[:1] == "l":
            kind = "link"
        elif mode[:1] in ("b", "c", "p", "s"):
            kind = "other"
        elif blk.get("Folder") == "+" or mode[:1] == "d" or "D" in blk.get("Attributes", "").split(" ")[0]:
            kind = "dir"
        else:
            kind = "file"
        size = blk.get("Size", "").strip()
        out.append(Member(blk["Path"], kind, int(size) if size.isdigit() else 0))
    return out


def check_members(name: str, members: list[Member], max_bytes: int) -> None:
    """Refuses the whole archive when a member's path would land outside its folder, a member is
    a link or a device, or it unpacks to more than max_bytes."""
    for m in members:
        if not member_ok(m.name):
            raise ValueError(f"refused {name}: the member {m.name!r} would land outside its folder")
        if m.kind == "link":
            raise ValueError(f"refused {name}: the member {m.name!r} is a link")
        if m.kind == "other":
            raise ValueError(f"refused {name}: the member {m.name!r} is a device")
    total = sum(m.size for m in members)
    if total > max_bytes:
        raise ValueError(f"refused {name}: it unpacks to {total} bytes")


def list_members(archive: Path, tool: tuple[str, str]) -> list[Member]:
    def run(argv: list[str]) -> str:
        r = subprocess.run(argv, stdin=subprocess.DEVNULL, capture_output=True, text=True, errors="replace")
        if r.returncode != 0:
            raise ValueError(f"{Path(argv[0]).name} could not list {archive.name}: {(r.stderr or r.stdout).strip()[-300:]}")
        return r.stdout
    kind, exe = tool
    if kind == "bsdtar":
        return parse_bsdtar_listing(run([exe, "-t", "-f", str(archive)]), run([exe, "-t", "-v", "-f", str(archive)]))
    return parse_7z_listing(run([exe, "l", "-slt", str(archive)]))


def safe_extract_7z(archive: Path, dest: Path, max_bytes: int = UNPACK_MAX) -> str:
    """Unpacks an untrusted .7z into dest (replacing it), through a temporary folder beside it,
    with bsdtar or else 7-Zip: their member list first (check_members refuses the whole
    archive), then the unpacking; then removes any link and checks every path stays inside.
    Nothing in it is run. Returns the tool's name."""
    tool = archive_tool()
    if tool is None:
        raise ValueError(NO_ARCHIVE_TOOL)
    check_members(archive.name, list_members(archive, tool), max_bytes)
    tmp = dest.parent / f".{dest.name}.tmp"
    shutil.rmtree(tmp, ignore_errors=True)
    tmp.mkdir(parents=True)
    try:
        kind, exe = tool
        argv = [exe, "-x", "-f", str(archive), "-C", str(tmp)] if kind == "bsdtar" else [exe, "x", "-y", "-bd", f"-o{tmp}", str(archive)]
        r = subprocess.run(argv, stdin=subprocess.DEVNULL, capture_output=True, text=True, errors="replace")
        if r.returncode != 0:
            raise ValueError(f"{Path(exe).name} could not unpack {archive.name}: {(r.stderr or r.stdout).strip()[-300:]}")
        root = tmp.resolve()
        for p in sorted(tmp.rglob("*"), reverse=True):
            if p.is_symlink():
                p.unlink()
            elif not p.resolve().is_relative_to(root):
                raise ValueError(f"refused {archive.name}: {p} is outside its folder")
        shutil.rmtree(dest, ignore_errors=True)
        tmp.replace(dest)
        return Path(exe).name
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def find_collection(d: Path) -> Path | None:
    """The folder holding DOCUMENTS/STIL.txt: d or up to three folders below it, the shallowest
    (hidden folders skipped)."""
    if not d.is_dir():
        return None
    for depth in range(4):
        found = [p for p in sorted(d.glob("/".join(["*"] * depth + ["DOCUMENTS", "STIL.txt"])))
                 if not any(part.startswith(".") for part in p.relative_to(d).parts)]
        if found:
            return found[0].parent.parent
    return None


def downloaded_collection(root: Path) -> Path | None:
    """The newest collection under build/hvsc/<version>/."""
    if not root.is_dir():
        return None
    versions = sorted((p for p in root.iterdir() if p.is_dir() and p.name.isdigit()), key=lambda p: -int(p.name))
    for v in versions:
        c = find_collection(v)
        if c:
            return c
    return None


def url_ok(url: str) -> bool:
    u = urllib.parse.urlparse(url)
    return u.scheme == "https" or (u.scheme == "http" and u.hostname in ("127.0.0.1", "localhost"))


def fetch_hvsc(root: Path, progress: Callable[[str], None], log: Callable[[str], None], api: str | None = None) -> Path:
    """Downloads and unpacks the collection into root/<version>/; returns the collection folder."""
    api = api or os.environ.get("FMZX_HVSC_API") or HVSC_API
    if archive_tool() is None:
        raise ValueError(NO_ARCHIVE_TOOL)
    if not url_ok(api):
        raise ValueError(f"not an https address: {api}")
    headers = {"User-Agent": "pack-studio"}
    with urllib.request.urlopen(urllib.request.Request(api, headers=headers), timeout=30) as r:
        info = json.loads(r.read(1 << 20))
    version = int(info["version"])
    url = str(info["complete"]["url"])
    if not url_ok(url):
        raise ValueError(f"not an https address: {url}")
    dest = root / str(version)
    have = find_collection(dest)
    if have:
        return have
    root.mkdir(parents=True, exist_ok=True)
    archive = root / f"HVSC_{version}.7z"
    if not archive.is_file():
        part = root / f"HVSC_{version}.7z.part"
        log(f"downloading {url}")
        with urllib.request.urlopen(urllib.request.Request(url, headers=headers), timeout=60) as r, part.open("wb") as f:
            total = int(r.headers.get("Content-Length") or 0)
            got = 0
            last = 0.0
            while True:
                b = r.read(1 << 20)
                if not b:
                    break
                f.write(b)
                got += len(b)
                if time.monotonic() - last > 0.3:
                    last = time.monotonic()
                    progress(f"downloading the SID collection (HVSC {version}): {got / 1e6:.1f}"
                             + (f" of {total / 1e6:.1f} MB" if total else " MB"))
        if total and got != total:
            raise ValueError(f"the download stopped at {got} of {total} bytes")
        part.replace(archive)
        log(f"downloaded {archive} ({got} bytes)")
    progress(f"unpacking the SID collection (HVSC {version})")
    log(f"unpacked with {safe_extract_7z(archive, dest)}")
    archive.unlink()
    c = find_collection(dest)
    if c is None:
        raise ValueError(f"no DOCUMENTS/STIL.txt in {dest}")
    log(f"the SID collection: {c}")
    return c


# ---------------------------------------------------------------------------------------------
# The AY collection (chris-y/AY on GitHub: Spectrum AY music, music/ay/games/ and music/ay/misc/)


def find_ay_collection(d: Path) -> Path | None:
    """The .ay collection in d: d/music/ay (a downloaded or cloned collection), else d itself
    when it holds .ay files (in it or in folders below)."""
    if not d.is_dir():
        return None
    if (d / "music" / "ay").is_dir():
        return d / "music" / "ay"
    return d if next(d.rglob("*.ay"), None) else None


def downloaded_ay(root: Path) -> Path | None:
    """The newest collection under build/ay/<commit>/."""
    if not root.is_dir():
        return None
    for v in sorted((p for p in root.iterdir() if p.is_dir() and re.fullmatch(r"[0-9a-f]{12}", p.name)),
                    key=lambda p: -p.stat().st_mtime):
        if (v / "music" / "ay").is_dir():
            return v / "music" / "ay"
    return None


def safe_extract_ay(archive: Path, dest: Path, max_bytes: int = UNPACK_MAX) -> int:
    """Unpacks the music/ay folder of an untrusted .tar.gz of the collection (<top>/music/ay/...)
    into dest/music/ay (replacing dest), through a temporary folder beside it, reading the
    archive as a stream: a member whose path is absolute or holds "..", or one under music/ay
    that is a link or a device, refuses the whole archive, as does more than max_bytes; other
    members (screenshots, the rest of the repository) are skipped. Nothing in it is run. Returns
    the files unpacked."""
    import tarfile

    tmp = dest.parent / f".{dest.name}.tmp"
    shutil.rmtree(tmp, ignore_errors=True)
    tmp.mkdir(parents=True)
    try:
        total = files = 0
        with tarfile.open(archive, "r|gz") as tf:
            for m in tf:
                if not member_ok(m.name):
                    raise ValueError(f"refused {archive.name}: the member {m.name!r} would land outside its folder")
                parts = PurePosixPath(m.name).parts
                if len(parts) < 3 or parts[1:3] != ("music", "ay"):
                    continue
                if not (m.isfile() or m.isdir()):
                    raise ValueError(f"refused {archive.name}: the member {m.name!r} is a link or a device")
                out = tmp.joinpath(*parts[1:])
                if m.isdir():
                    out.mkdir(parents=True, exist_ok=True)
                    continue
                total += m.size
                if total > max_bytes:
                    raise ValueError(f"refused {archive.name}: it unpacks to more than {max_bytes} bytes")
                out.parent.mkdir(parents=True, exist_ok=True)
                src = tf.extractfile(m)
                with out.open("wb") as f:
                    shutil.copyfileobj(src, f)
                files += 1
        root = tmp.resolve()
        for p in tmp.rglob("*"):
            if p.is_symlink() or not p.resolve().is_relative_to(root):
                raise ValueError(f"refused {archive.name}: {p} is outside its folder")
        if not (tmp / "music" / "ay").is_dir():
            raise ValueError(f"no music/ay folder in {archive.name}")
        shutil.rmtree(dest, ignore_errors=True)
        tmp.replace(dest)
        return files
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def fetch_ay(root: Path, progress: Callable[[str], None], log: Callable[[str], None], api: str | None = None,
             tarball: str | None = None) -> Path:
    """Downloads the collection's newest commit and unpacks its music/ay into root/<commit, 12
    digits>/; returns the collection folder (music/ay)."""
    api = api or os.environ.get("FMZX_AY_API") or AY_API
    tarball = tarball or os.environ.get("FMZX_AY_TARBALL") or AY_TARBALL
    if not url_ok(api):
        raise ValueError(f"not an https address: {api}")
    headers = {"User-Agent": "pack-studio", "Accept": "application/vnd.github+json"}
    with urllib.request.urlopen(urllib.request.Request(api, headers=headers), timeout=30) as r:
        sha = str(json.loads(r.read(4 << 20)).get("sha", ""))
    if not re.fullmatch(r"[0-9a-f]{40}", sha):
        raise ValueError(f"{api}: no commit in the answer")
    dest = root / sha[:12]
    if (dest / "music" / "ay").is_dir():
        return dest / "music" / "ay"
    url = tarball.format(sha=sha)
    if not url_ok(url):
        raise ValueError(f"not an https address: {url}")
    root.mkdir(parents=True, exist_ok=True)
    archive = root / f"AY-{sha[:12]}.tar.gz"
    part = root / f"AY-{sha[:12]}.tar.gz.part"
    log(f"downloading {url}")
    with urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "pack-studio"}), timeout=60) as r, \
            part.open("wb") as f:
        total = int(r.headers.get("Content-Length") or 0)
        got = 0
        last = 0.0
        while True:
            b = r.read(1 << 20)
            if not b:
                break
            f.write(b)
            got += len(b)
            if time.monotonic() - last > 0.3:
                last = time.monotonic()
                progress(f"downloading the AY collection ({sha[:12]}): {got / 1e6:.1f}"
                         + (f" of {total / 1e6:.1f} MB" if total else " MB"))
    if total and got != total:
        part.unlink(missing_ok=True)
        raise ValueError(f"the download stopped at {got} of {total} bytes")
    part.replace(archive)
    log(f"downloaded {archive} ({got} bytes)")
    progress(f"unpacking the AY collection ({sha[:12]})")
    try:
        n = safe_extract_ay(archive, dest)
    finally:
        archive.unlink(missing_ok=True)
    c = dest / "music" / "ay"
    log(f"the AY collection: {c} ({n} files)")
    return c


# ---------------------------------------------------------------------------------------------
# Jobs: one at a time, in a thread (the screen) or in turn (--status, --build)


@dataclass
class Job:
    title: str
    argv: list[str] | None = None
    fn: Callable[[Job], int] | None = None
    cwd: Path | None = None
    env: dict[str, str] | None = None
    chain: str | None = None  # when it fails, the waiting jobs of its chain are dropped
    on_done: Callable[[Job], None] | None = None
    rc: int | None = None
    progress: str = ""
    tail: deque = field(default_factory=lambda: deque(maxlen=400))
    runner: Runner | None = None

    def out(self, line: str) -> None:
        self.runner._line(self, line)

    def text(self) -> str:
        return "".join(self.tail)


class Runner:
    def __init__(self, log_path: Path, threaded: bool, echo: bool = False):
        self.log_path = log_path
        self.threaded = threaded
        self.echo = echo
        self.pending: deque[Job] = deque()
        self.done: deque[Job] = deque()
        self.current: Job | None = None
        self.last_line = ""
        self.lock = threading.Lock()
        self.cond = threading.Condition(self.lock)
        self.proc: subprocess.Popen | None = None
        self.stopping = False
        self.failed: list[Job] = []  # the jobs that failed, in turn
        log_path.parent.mkdir(parents=True, exist_ok=True)
        self.log = log_path.open("a", encoding="utf-8", errors="replace")
        if threaded:
            threading.Thread(target=self._worker, daemon=True).start()

    def submit(self, job: Job) -> Job:
        job.runner = self
        with self.cond:
            self.pending.append(job)
            self.cond.notify()
        return job

    def busy(self) -> bool:
        return self.current is not None or bool(self.pending)

    def waiting(self) -> int:
        return len(self.pending)

    def _line(self, job: Job, line: str) -> None:
        if not line.endswith("\n"):
            line += "\n"
        job.tail.append(line)
        with self.lock:
            self.log.write(line)
            self.log.flush()
        if line.strip() and not line.startswith("== "):
            self.last_line = line.strip()
        if self.echo:
            sys.stdout.write(line)
            sys.stdout.flush()

    def _run(self, job: Job) -> None:
        self.current = job
        stamp = time.strftime("%H:%M:%S")
        self._line(job, f"== {stamp} {job.title}" + (f": {shlex.join(job.argv)}" if job.argv else ""))
        try:
            if job.argv:
                env = dict(os.environ, **(job.env or {}))
                self.proc = subprocess.Popen(job.argv, cwd=job.cwd, env=env, stdin=subprocess.DEVNULL,
                                             stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
                                             errors="replace", bufsize=1, start_new_session=True)
                for line in self.proc.stdout:
                    self._line(job, line)
                job.rc = self.proc.wait()
            else:
                job.rc = job.fn(job)
        except Exception as e:  # noqa: BLE001 - a job's failure is reported, the studio goes on
            for ln in traceback.format_exception_only(e):
                self._line(job, ln)
            job.rc = 1
        finally:
            self.proc = None
        self._line(job, f"== {job.title}: " + ("done" if job.rc == 0 else f"failed (exit {job.rc})"))
        self.current = None

    def _worker(self) -> None:
        while True:
            with self.cond:
                while not self.pending:
                    self.cond.wait()
                job = self.pending.popleft()
            self._run(job)
            with self.lock:
                self.done.append(job)

    def _finish(self, job: Job) -> None:
        if job.rc != 0:
            self.failed.append(job)
        if job.rc != 0 and job.chain:
            with self.lock:
                dropped = [j for j in self.pending if j.chain == job.chain]
                for j in dropped:
                    self.pending.remove(j)
            for j in dropped:
                self._line(j, f"== skipped: {j.title} ({job.title} failed)")
        if job.on_done:
            job.on_done(job)

    def pump(self) -> bool:
        """Runs the finished jobs' on_done in this (the screen's) thread; True when any finished."""
        any_ = False
        while True:
            with self.lock:
                if not self.done:
                    return any_
                job = self.done.popleft()
            any_ = True
            self._finish(job)

    def drain(self) -> None:
        """Without a thread: runs every job, the ones their on_done adds included."""
        while self.pending:
            job = self.pending.popleft()
            self._run(job)
            self._finish(job)

    def stop(self) -> None:
        with self.lock:
            self.pending.clear()
        p = self.proc
        if p and p.poll() is None:
            with contextlib.suppress(OSError):
                os.killpg(p.pid, signal.SIGTERM)


