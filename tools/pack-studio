def player_argv(path: Path) -> list[str] | None:
    given = os.environ.get("FMZX_PLAYER")
    if given:
        return shlex.split(given) + [str(path)]
    if sys.platform == "darwin" and shutil.which("afplay"):
        return ["afplay", str(path)]
    if shutil.which("ffplay"):
        return ["ffplay", "-nodisp", "-autoexit", "-loglevel", "quiet", str(path)]
    for p in ("paplay", "aplay"):
        if shutil.which(p):
            return [p, str(path)]
    return None


class Player:
    def __init__(self):
        self.proc: subprocess.Popen | None = None
        self.what: str | None = None  # the playing candidate's id

    def play(self, path: Path, what: str) -> str | None:
        self.stop()
        argv = player_argv(path)
        if argv is None:
            return "no player: install ffplay (ffmpeg), paplay or aplay, or set FMZX_PLAYER"
        self.proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                     stderr=subprocess.DEVNULL, start_new_session=True)
        self.what = what
        return None

    def poll(self) -> None:
        if self.proc and self.proc.poll() is not None:
            self.proc, self.what = None, None

    def stop(self) -> None:
        if self.proc and self.proc.poll() is None:
            with contextlib.suppress(OSError):
                os.killpg(self.proc.pid, signal.SIGTERM)
            with contextlib.suppress(subprocess.TimeoutExpired):
                self.proc.wait(timeout=2)
        self.proc, self.what = None, None


