def color_wanted(env: dict, has_colors: bool) -> bool:
    """Colours unless the terminal has none or NO_COLOR is set (and not empty; no-color.org)."""
    return has_colors and not env.get("NO_COLOR")


# The start screen: a game's loading screen, drawn as ZX pixels (two to a character cell, in
# half blocks) in the Spectrum's eight colours: 0 black, 1 blue, 2 red, 3 magenta, 4 green,
# 5 cyan, 6 yellow, 7 white.
SPLASH_FONT = {
    "F": ("#####", "#    ", "#### ", "#    ", "#    "),
    "M": ("#   #", "## ##", "# # #", "#   #", "#   #"),
    "-": ("   ", "   ", "###", "   ", "   "),
    "1": (" # ", "## ", " # ", " # ", "###"),
    "Z": ("#####", "   # ", "  #  ", " #   ", "#####"),
    "X": ("#   #", " # # ", "  #  ", " # # ", "#   #"),
}
SPLASH_NOTE = ("..##.", "..#.#", "..#..", "..#..", "###..", "###..")
SPLASH_W, SPLASH_ROWS = 68, 18  # the paper in cells: 17 rows of picture (68 x 34 pixels), a line of text
SPLASH_BORDER = (13, 4, 5)  # the border in cells: each side, above, below (cut to the terminal)
SPLASH_MIN = (SPLASH_W + 4, SPLASH_ROWS + 2)  # columns, rows: a smaller terminal gets no start screen
SPLASH_PILOT, SPLASH_DATA, SPLASH_FLASH = 5, 18, 5  # ticks: the pilot stripes, the picture loading, a flash's half
SPLASH_SUBTITLE = "P A C K   S T U D I O"
SPLASH_KEY = " PRESS ANY KEY "


def splash_picture() -> list[list[int]]:
    """The picture's pixels (rows of colours): the name in tall letters over a night sky, a
    striped sun between mountains, notes in the air, a piano keyboard along the bottom with
    the four-colour flash at its end."""
    W, H = SPLASH_W, (SPLASH_ROWS - 1) * 2
    px = [[0] * W for _ in range(H)]

    def dot(x: int, y: int, c: int) -> None:
        if 0 <= x < W and 0 <= y < H:
            px[y][x] = c
    rnd = random.Random(48)
    for _ in range(46):  # the stars
        dot(rnd.randrange(W), rnd.randrange(20), rnd.choice((7, 7, 5, 6, 1)))
    for y in range(17, 26):  # the sun: yellow, red, magenta, with gaps towards the horizon
        if y in (22, 24):
            continue
        for x in range(W):
            if (x - 34) ** 2 + (y - 26) ** 2 <= 81:
                dot(x, y, 6 if y < 20 else 2 if y < 23 else 3)
    for cx, top in ((9, 18), (21, 21), (48, 22), (59, 19)):  # the mountains, lit from the left
        for y in range(top, 26):
            half = (y - top) * 3 // 2
            for x in range(cx - half, cx + half + 1):
                dot(x, y, 5 if x <= cx - half + 1 else 1)
    for x in range(W):  # the ground
        dot(x, 26, 3)
        dot(x, 27, 1 if x % 4 < 2 else 0)
    for y in range(28, H):  # the keyboard, and the case's end
        for x in range(54):
            k, at = divmod(x + 2, 4)
            black = y < 31 and x >= 2 and at < 3 and k % 7 in (1, 2, 4, 5, 6)
            dot(x, y, 0 if black or x % 4 == 3 else 7)
        for i, c in enumerate((2, 6, 4, 5)):  # the flash
            for d in (0, 1):
                dot(54 + i * 2 + d + (H - 1 - y), y, c)
    for x0, y0, c in ((4, 13, 4), (60, 12, 5), (47, 13, 6)):  # the notes
        for j, row in enumerate(SPLASH_NOTE):
            for i, ch in enumerate(row):
                if ch == "#":
                    dot(x0 + i, y0 + j, c)
    # the name: letters twice the font's size, a blue shadow, bands of colour down them
    x, spots = 2, []
    for ch, gap in zip("FM-1ZX", (1, 1, 1, 2, 1, 0)):
        g = SPLASH_FONT[ch]
        for j, row in enumerate(g):
            for i, bit in enumerate(row):
                if bit == "#":
                    spots += [(x + (i * 2) + dx, 2 + j * 2 + dy) for dx in (0, 1) for dy in (0, 1)]
        x += (len(g[0]) + gap) * 2
    for sx, sy in spots:
        dot(sx + 1, sy + 1, 1)
    bands = (7, 6, 6, 6, 2, 2, 3, 3, 5, 5)
    for sx, sy in spots:
        dot(sx, sy, bands[sy - 2])
    return px


def splash_cells(w: int, h: int, tick: int, utf8: bool, color: bool = True) -> list[tuple[int, int, str, tuple[int, int]]]:
    """The start screen at a tick, as (row, column, text, (ink, paper)) runs drawn in order.
    The border: wide red and cyan stripes (the pilot tone), then thin blue and yellow ones
    while the picture loads a row at a time, then black; it is SPLASH_BORDER wide where the
    terminal has the room, and what is outside it is black. Each cell holds two pixels, one over
    the other: a half block in the upper one's colour on the lower one's, or (without colour)
    the block that shows which are lit. Under the picture, "PRESS ANY KEY" flashes once it has
    loaded. Empty when the terminal is smaller than SPLASH_MIN."""
    if w < SPLASH_MIN[0] or h < SPLASH_MIN[1]:
        return []
    cells: list[tuple[int, int, str, tuple[int, int]]] = []
    loaded = tick >= SPLASH_PILOT + SPLASH_DATA
    if tick < SPLASH_PILOT:
        border = [2 if ((y + tick) // 2) % 2 else 5 for y in range(h)]
    elif not loaded:
        rnd = random.Random(tick)
        border = []
        while len(border) < h:
            border += [1 if rnd.random() < 0.5 else 6] * rnd.choice((1, 1, 1, 2))
    else:
        border = [0] * h
    # the border as wide as a Spectrum's beside its picture (48 pixels a side by 256, 48 above and
    # 56 below by 192), or what the terminal has room for; the rest of the terminal black
    left, top, bottom = SPLASH_BORDER
    px0 = (w - SPLASH_W) // 2
    py0 = top + (h - top - SPLASH_ROWS - bottom) // 2 if h >= top + SPLASH_ROWS + bottom else (h - SPLASH_ROWS) // 2
    x0, x1 = max(0, px0 - left), min(w, px0 + SPLASH_W + left)
    y0, y1 = max(0, py0 - top), min(h, py0 + SPLASH_ROWS + bottom)
    for y in range(h):
        cells.append((y, x0, " " * (x1 - x0), (0, border[y])) if y0 <= y < y1 else (y, 0, " " * w, (0, 0)))
    for y in range(SPLASH_ROWS):
        cells.append((py0 + y, px0, " " * SPLASH_W, (7, 0)))
    pic = splash_picture()
    shown = max(0, min(SPLASH_ROWS - 1, (tick - SPLASH_PILOT + 1) * (SPLASH_ROWS - 1) // SPLASH_DATA)) if tick >= SPLASH_PILOT else 0
    up, down, full = ("▀", "▄", "█") if utf8 else ('"', "_", "#")
    for cy in range(shown):
        top, bot = pic[cy * 2], pic[cy * 2 + 1]
        x = 0
        while x < SPLASH_W:
            t, b = top[x], bot[x]
            n = 1
            while x + n < SPLASH_W and (top[x + n], bot[x + n]) == (t, b):
                n += 1
            if color and (utf8 or t == b):
                text, ink = (" ", (7, t)) if t == b else (up, (t, b))
            elif color:  # no half block to draw: the lit pixel's colour
                text, ink = (full if t and b else up if t else down), (t or b, 0)
            else:
                text, ink = (full if t and b else up if t else down if b else " "), (7, 0)
            if (t, b) != (0, 0):
                cells.append((py0 + cy, px0 + x, text * n, ink))
            x += n
    if shown > 7:
        cells.append((py0 + 7, px0 + (SPLASH_W - len(SPLASH_SUBTITLE)) // 2, SPLASH_SUBTITLE, (7, 0)))
    if loaded:
        lit = ((tick - SPLASH_PILOT - SPLASH_DATA) // SPLASH_FLASH) % 2 == 0
        cells.append((py0 + SPLASH_ROWS - 1, px0 + (SPLASH_W - len(SPLASH_KEY)) // 2, SPLASH_KEY, (0, 7) if lit else (7, 0)))
    for y in range(y0, y1):
        if x0 > 0:
            cells.append((y, 0, " " * x0, (0, 0)))
        if x1 < w:
            cells.append((y, x1, " " * (w - x1), (0, 0)))
    return cells


def run_splash(scr, curses, utf8: bool, colors: bool, seconds: float = 3.0) -> None:
    """Shows the start screen for a moment (FMZX_SPLASH=0: not at all); a key ends it and
    still does what it does on the games screen."""
    if os.environ.get("FMZX_SPLASH", "1") == "0":
        return
    zx = (curses.COLOR_BLACK, curses.COLOR_BLUE, curses.COLOR_RED, curses.COLOR_MAGENTA, curses.COLOR_GREEN,
          curses.COLOR_CYAN, curses.COLOR_YELLOW, curses.COLOR_WHITE)
    bright = 8 if colors and getattr(curses, "COLORS", 8) >= 16 else 0  # the Spectrum's BRIGHT colours
    pairs: dict[tuple[int, int], int] = {}

    def attr(ink: int, paper: int) -> int:
        if not colors:
            return curses.A_REVERSE if paper in (1, 2, 7) else curses.A_BOLD if ink == 7 and paper == 0 else 0
        if (ink, paper) not in pairs:
            n = 20 + len(pairs)
            try:
                curses.init_pair(n, zx[ink] + (bright if ink else 0), zx[paper] + (bright if paper else 0))
            except (curses.error, ValueError):
                return 0
            pairs[(ink, paper)] = n
        return curses.color_pair(pairs[(ink, paper)]) | (0 if bright else curses.A_BOLD)
    end = time.monotonic() + seconds
    tick = 0
    scr.timeout(70)
    try:
        while time.monotonic() < end:
            h, w = scr.getmaxyx()
            cells = splash_cells(w, h, tick, utf8, colors)
            if not cells:
                return
            scr.erase()
            for y, x, text, (ink, paper) in cells:
                with contextlib.suppress(curses.error):
                    scr.addstr(y, x, text[:w - x - (1 if y == h - 1 else 0)], attr(ink, paper))
            scr.refresh()
            tick += 1
            try:
                ch = scr.getch()
            except KeyboardInterrupt:
                return
            if ch != -1 and ch != curses.KEY_RESIZE:
                with contextlib.suppress(curses.error):
                    curses.ungetch(ch)
                return
    finally:
        scr.timeout(200)
        scr.erase()


def run_ui(st: Studio) -> None:
    import curses
    import locale

    locale.setlocale(locale.LC_ALL, "")
    os.environ.setdefault("ESCDELAY", "25")  # a lone Esc (stop, back) without a second's wait
    # curses.wrapper's own, but colours started only when wanted (NO_COLOR: not even the default pair)
    scr = curses.initscr()
    try:
        curses.noecho()
        curses.cbreak()
        scr.keypad(True)
        if color_wanted(os.environ, curses.has_colors()):
            with contextlib.suppress(curses.error):
                curses.start_color()
        ui = UI(scr, st, curses)
        run_splash(scr, curses, ui.utf8, color_wanted(os.environ, curses.has_colors()))
        ui.loop()
    finally:
        scr.keypad(False)
        curses.echo()
        curses.nocbreak()
        curses.endwin()


class UI:
    def __init__(self, scr, st: Studio, curses):
        import locale

        self.c = curses
        self.scr = scr
        self.st = st
        self.screen = "games"
        self.gi = 0  # games screen cursor
        self.gtop = 0
        self.game: Game | None = None
        self.ci = 0  # game screen cursor (index into its candidate rows)
        self.ctop = 0
        self.pi = 0  # pack view cursor (index into its game rows)
        self.ptop = 0
        self.text_lines: list[str] = []
        self.text_from = "games"
        self.text_off = 0  # lines up from the end (log) or down from the top (others)
        self.text_kind = ""
        self.confirm_quit = False
        self.confirm_stop: Job | None = None  # the running job x asks to stop
        self.ji = 0  # jobs view cursor (index into its jobs)
        self.jsel: Job | None = None  # the job under it: the cursor follows it as the jobs move
        self.jtop = 0
        self.jobs_from = "games"
        self.text_job: Job | None = None  # the job whose output the text screen shows
        self.game_from = "games"
        self.quit = False
        self.utf8 = "UTF-8" in locale.getpreferredencoding(False).upper().replace("UTF8", "UTF-8")
        with contextlib.suppress(curses.error):
            curses.curs_set(0)
        scr.timeout(200)
        scr.keypad(True)
        self.attr = self.attrs(curses, color_wanted(os.environ, curses.has_colors()))

    @staticmethod
    def attrs(curses, colors: bool) -> dict[str, int]:
        B, D, R = curses.A_BOLD, curses.A_DIM, curses.A_REVERSE
        a = {"dim": D, "bold": B, "rev": R, "sel": R | B, "title": B, "name": B, "head": B, "key": B,
             "chosen": B, "judge": B, "ai": B, "sid": B, "ay": B, "err": B, "run": B, "ok": 0, "cached": D, "warn": B,
             "bar": R, "bar_run": R | B, "bar_ok": R, "bar_err": R | B, "keycap": R | B,
             "prog_run": B, "prog_ok": B, "prog_err": R | B, "prog_off": D, "track": D}
        a.update({f"p{n}": B for n in range(1, PACKS_MAX + 1)})
        if not colors:
            return a
        try:
            try:
                curses.use_default_colors()
                bg = -1
            except curses.error:
                bg = curses.COLOR_BLACK
            names = ("GREEN", "YELLOW", "RED", "MAGENTA", "CYAN", "BLUE")
            for i, n in enumerate(names, 1):
                curses.init_pair(i, getattr(curses, f"COLOR_{n}"), bg)
            g, y, r, m, c, b = (curses.color_pair(i) for i in range(1, len(names) + 1))
            curses.init_pair(len(names) + 1, curses.COLOR_BLACK, curses.COLOR_CYAN)
            a["keycap"] = curses.color_pair(len(names) + 1) | B
        except curses.error:
            return a
        a.update({"chosen": g | B, "judge": b | B, "ai": m | B, "sid": c | B, "ay": y | B, "err": r | B, "run": y, "ok": g,
                  "cached": g | D, "warn": y | B, "bar_run": y | R, "bar_ok": g | R, "bar_err": r | R,
                  "prog_run": y | B, "prog_ok": g | B, "prog_err": r | B})
        cycle = (c, m, y, g, b)
        a.update({f"p{n}": cycle[(n - 1) % len(cycle)] | B for n in range(1, PACKS_MAX + 1)})
        return a

    # -- drawing

    def put(self, y: int, x: int, s: str, attr: int = 0) -> int:
        """Writes s at (y, x), cut at the edge; returns the column after it."""
        h, w = self.scr.getmaxyx()
        if y < 0 or y >= h or x >= w or x < 0:
            return x + len(s)
        room = w - x - (1 if y == h - 1 else 0)
        if room <= 0:
            return x + len(s)
        with contextlib.suppress(self.c.error):
            self.scr.addstr(y, x, s.replace("\t", " ")[:room], attr)
        return x + len(s)

    def put_key(self, y: int, x: int, key: str, what: str = "") -> int:
        """A key as a cap (" g ", reversed, coloured), then what it does; returns the next column."""
        x = self.put(y, x, f" {key} ", self.attr["keycap"])
        return self.put(y, x, f" {what}  " if what else "  ")

    def put_help(self, y: int, text: str) -> None:
        """A key line: each key a cap, what it does after it; cut at the edge, so the keys used
        most come first."""
        x = 0
        for seg in text.split("  "):
            key, _, what = seg.partition(" ")
            x = self.put_key(y, x, key, what)

    def draw(self) -> None:
        self.scr.erase()
        h, w = self.scr.getmaxyx()
        if h < 4 or w < 16:
            self.put(0, 0, "too small")
            self.scr.refresh()
            return
        getattr(self, f"draw_{self.screen}")(h, w)
        self.draw_message(h, w)
        self.draw_status(h, w)
        self.scr.refresh()

    def draw_message(self, h: int, w: int) -> None:
        """A question (y/n), else a message of the last 3 s, on the key line (above the bar), in
        place of the keys."""
        st = self.st
        if self.confirm_stop is not None:
            msg, a = f"stop {self.confirm_stop.title}? It is running (y/n)", self.attr["bar_err"]
        elif self.confirm_quit:
            msg, a = "jobs are running: quit and stop them? (y/n)", self.attr["bar_err"]
        elif st.flash_msg and time.monotonic() - st.flash_at < FLASH_SECS:
            msg, a = st.flash_msg, self.attr[{"ok": "bar_ok", "err": "bar_err"}.get(st.flash_kind, "bar")]
        else:
            return
        self.put(h - 2, 0, f" {msg}".ljust(w), a)

    def status_runs(self, w: int, now: float) -> tuple[list[tuple[str, str]], str]:
        """The bottom line's runs (progress_line's) and its colour (run, ok, err, off; idle): the
        activity's bar (activity_progress); for 3 s after it ends, full and green when done, red
        where it stopped when a step failed; else "idle" and the last message."""
        st = self.st
        a = st.activity(now)
        if a.state != "idle":
            p = activity_progress(a, now)
            kind = {"run": "run", "done": "ok", "failed": "err"}.get(a.state, "off")
            return progress_line(p, w, self.utf8, now), kind
        msg = st.flash_msg if st.flash_msg and now - st.flash_at >= FLASH_SECS else ""
        return [("idle", "label")] + ([("  " + msg, "queue")] if msg else []), "idle"

    def draw_status(self, h: int, w: int) -> None:
        """The bottom line: the progress bar (status_runs)."""
        runs, kind = self.status_runs(w - 1, time.monotonic())
        bright = self.attr.get(f"prog_{kind}", self.attr["dim"])
        attr = {"label": bright, "fill": bright, "track": self.attr["track"], "figures": 0, "queue": self.attr["dim"], "gap": 0}
        if kind == "idle":
            attr["label"] = self.attr["dim"]
        x = 0
        for text, part in runs:
            x = self.put(h - 1, x, text, attr[part])

    def pack_tag(self, gid: str | None) -> tuple[str, int]:
        n = self.st.packs.get(gid) if gid else None
        return (f"P{n}", self.attr[f"p{n}"]) if n else ("-" if not self.utf8 else "—", self.attr["dim"])

    def columns(self, w: int) -> tuple[int, int]:
        """The name's and how's widths on the games list (how goes on a narrow screen)."""
        how = 12 if w >= 72 else 0
        return min(28, max(8, w - 40 - how)), how

    def draw_panel(self, y: int, h: int, w: int) -> int:
        """The packs panel from line y (at most a third of the screen); returns the next line."""
        st, p = self.st, self.st.plan
        lines = pack_lines(p, st.packs, width=max(4, min(20, w - 50)), utf8=self.utf8)
        cap = max(1, (h - 6) // 3)
        if len(lines) > cap:
            more = len(lines) - cap
            lines = lines[:cap - 1] + [(0, f"+{more} more (p: the packs)", False)]
        note = st.sizes_note()
        for n, ln, over in lines:
            if over:
                self.put(y, 0, ln, self.attr["err"])
            elif n:
                x = self.put(y, 0, f"P{n}", self.attr[f"p{n}"])
                self.put(y, x, ln[len(f"P{n}"):])
            else:
                x = self.put(y, 0, ln, self.attr["dim"])
                if note:
                    self.put(y, x + 2, note, self.attr["warn"])
                    note = ""
            y += 1
        return y

    def draw_games(self, h: int, w: int) -> None:
        st, p = self.st, self.st.plan
        x = self.put(0, 0, "pack-studio", self.attr["title"])
        head = f"  {st.folder.name}"
        if p:
            fill = st.assigned()
            n = len(fill) if fill else len(split_packs([(g.id, g.packed) for g in p.packed()], p.room, p.overhead()))
            head += f"  {len(p.games)} games, {kb(p.used)}, room {kb(p.room)}: {n} pack{'s' if n != 1 else ''}"
        elif st.live:
            head += "  learning" + ("…" if self.utf8 else "...")
        x = self.put(0, x, head, self.attr["bold"])
        hear = sum(1 for g in p.games if st.tune_counts(g)["hear"]) if p else 0
        if hear:
            x = self.put(0, x, f"  {plural(hear, 'game')} to hear (n: the next)", self.attr["warn"])
        self.put(0, x, f"  ->  {st.w}", self.attr["bold"])
        live = st.live
        if live and live.phase == "failed":
            self.put(1, 0, "the learning failed (l: the log)", self.attr["err"])
        elif not p:
            x = 0
            for kind, what in LIVE_LEGEND:
                x = self.put(1, x, LIVE_GLYPHS[kind][0 if self.utf8 else 1], self.live_attr(kind))
                x = self.put(1, x, f" {what}   ", self.attr["dim"])
        else:
            x = self.put(1, 0, "music to try (FM from the code is always there): ", self.attr["dim"])
            for key, label, k, what in METHOD_KEYS:
                x = self.put_key(1, x, key)
                x = self.put(1, x - 1, label, self.attr[k])
                x = self.put(1, x, f" {what}   ", self.attr["dim"])
            self.put(1, x, "(capital: every game; g makes the takes)", self.attr["dim"])
        if not p:
            self.put_help(h - 2, HELP_LIVE)
            return self.draw_live(h, w)
        self.put_help(h - 2, HELP_GAMES)
        top = self.draw_panel(2, h, w) + 1 if h >= 12 else 3
        rows = h - 2 - top
        if rows <= 0:
            return
        self.gi = max(0, min(self.gi, len(p.games) - 1))
        self.gtop = min(max(self.gtop, self.gi - rows + 1), self.gi)
        self.gtop = max(0, self.gtop)
        nw, hw = self.columns(w)
        over_packs = {n for n, _ in packs_over(p, st.packs)}
        bars = st.activity().games
        for k, g in enumerate(p.games[self.gtop:self.gtop + rows]):
            i = self.gtop + k
            y = top + k
            sel = i == self.gi
            rv = self.attr["sel"] if sel else 0
            base = (self.attr["dim"] if g.left_out else 0) | rv
            self.put(y, 0, " " * w, rv)
            x = self.put(y, 0, "> " if sel else "  ", base)
            x = self.put(y, x, f"{g.name[:nw]:<{nw}}", (self.attr["dim"] if g.left_out else self.attr["name"]) | rv)
            gb = bars.get(g.id)
            if gb is not None and gb.state == "run":
                self.put_row_bar(y, x + 1, gb, w, rv)
                continue
            queued = gb is not None and gb.state == "queued"
            if hw:
                x = self.put(y, x, f" {g.how[:hw]:<{hw}}", base)
            x = self.put(y, x, f" {kb(g.packed):>9} ", base)
            tag, ta = self.pack_tag(None if g.left_out else g.id)
            over = not g.left_out and st.packs.get(g.id) in over_packs
            x = self.put(y, x, f"{tag:<2}", (self.attr["err"] if over else ta) | rv)
            x += 1
            ms = st.marked(g.id)
            x = self.put(y, x + 1, "FM", (self.attr["dim"] if g.left_out else 0) | rv)
            for _, label, m, _ in METHOD_KEYS:
                on = m in ms and g.can_arrange
                dot = "\u00b7" if self.utf8 else "."
                text = label if on else dot * len(label)
                x = self.put(y, x + 1, text, (self.attr[m] if on else self.attr["dim"]) | rv)
            if queued:
                self.put(y, x + 2, "queued", self.attr["dim"] | rv)
                continue
            why = st.game_failed.get(g.id)
            if why:
                x = self.put(y, x + 2, f"{'✗' if self.utf8 else 'x'} {why} (l: the log)", self.attr["err"] | rv)
                continue
            mark, ma = self.tune_mark(g)
            x = self.put(y, x + 2, f"{mark:<3}", ma | rv)
            summary = st.choice_summary(g)
            x = self.put(y, x + 1, summary, (self.attr["dim"] | rv) if g.no_music else base)
            if not g.left_out and g.scores:
                self.put(y, x + 3, g.music, self.attr["dim"] | rv)

    def put_row_bar(self, y: int, x: int, gb: GameBar, w: int, rv: int) -> int:
        """A game's bar on its row in place of its columns while it has work in hand: squares as
        wide as the row leaves (4 to 20), then what is in hand ("learning", "SID takes"), dim. A
        game queued (not begun, or between its steps) shows no bar: its columns, "queued" dim in
        place of its tunes."""
        bw = max(4, min(ROW_BAR, w - x - 12))
        for t, on in render_bar(gb.frac, bw, self.utf8):
            x = self.put(y, x, t, (self.attr["prog_run"] if on else self.attr["track"]) | rv)
        return self.put(y, x + 1, gb.word, self.attr["dim"] | rv)

    def tune_mark(self, g: Game) -> tuple[str, int]:
        """A game's tunes at a glance: "?2" (yellow) two to hear (the judge is not sure, nothing
        chosen); "m" (dim) takes the judge has not chosen from yet (m judges); "✓" (green) every
        score with takes chosen, by the owner or the judge; nothing without takes."""
        n = self.st.tune_counts(g)
        if n["hear"]:
            return f"?{n['hear']}", self.attr["warn"]
        if n["sure"] or n["unjudged"]:
            return "m", self.attr["dim"]
        if n["owner"] or n["judge"]:
            return ("\u2713" if self.utf8 else "+"), self.attr["ok"]
        return "", 0

    def next_to_hear(self) -> None:
        """n: the cursor to the next game with a score to hear (round to the top)."""
        st, p = self.st, self.st.plan
        n = len(p.games)
        for k in range(1, n + 1):
            i = (self.gi + k) % n
            if st.tune_counts(p.games[i])["hear"]:
                self.gi = i
                c = st.tune_counts(p.games[i])
                st.flash(f"{p.games[i].name}: {plural(c['hear'], 'score')} to hear (Enter: its takes)")
                return
        st.flash("no game to hear: the judge is sure of every score it weighed, or you chose")

    def live_attr(self, kind: str) -> int:
        return {"run": self.attr["run"], "ok": self.attr["ok"], "cached": self.attr["cached"], "out": self.attr["dim"],
                "waiting": self.attr["dim"]}[kind]

    def draw_live(self, h: int, w: int) -> None:
        """The list before the plan is there (the first learning): each game's state as a glyph,
        its bar while it has work in hand."""
        rows = self.st.refresh_live()
        bars = self.st.activity().games
        if not rows:
            self.put(3, 2, "the list appears when the games file is written (l: the log)", self.attr["dim"])
            return
        avail = h - 5
        if avail <= 0:
            return
        self.gi = max(0, min(self.gi, len(rows) - 1))
        self.gtop = max(0, min(max(self.gtop, self.gi - avail + 1), self.gi))
        nw, hw = self.columns(w)
        for k, r in enumerate(rows[self.gtop:self.gtop + avail]):
            y = 3 + k
            sel = self.gtop + k == self.gi
            rv = self.attr["sel"] if sel else 0
            glyph, kind = live_glyph(r, self.utf8)
            out = kind == "out"
            self.put(y, 0, " " * w, rv)
            x = self.put(y, 0, "> " if sel else "  ", rv)
            x = self.put(y, x, f"{glyph} ", self.live_attr(kind) | rv)
            x = self.put(y, x, f"{r.name[:nw]:<{nw}}", (self.attr["dim"] if out else self.attr["name"]) | rv)
            gb = bars.get(r.gid or r.name)
            if gb is not None and gb.state == "run":
                self.put_row_bar(y, x + 1, gb, w, rv)
                continue
            if hw:
                x = self.put(y, x, f" {('' if out else r.how)[:hw]:<{hw}}", (self.attr["dim"] if out else 0) | rv)
            x = self.put(y, x, f" {('~' + kb(r.size)) if r.size else '':>10} ", self.attr["dim"] | rv)
            tag, ta = self.pack_tag(r.gid) if self.st.packs.get(r.gid or "") else ("", 0)
            x = self.put(y, x, f"{tag:<2} ", ta | rv)
            if out and r.how:
                self.put(y, x + 1, r.how, self.attr["dim"] | rv)
            elif self.st.game_failed.get(r.gid or r.name):
                self.put(y, x + 1, f"{'✗' if self.utf8 else 'x'} {self.st.game_failed[r.gid or r.name]} (l: the log)",
                         self.attr["err"] | rv)

    def game_rows(self) -> list[tuple[str, Score | None, str, Candidate | None]]:
        """("head", score, key, None), ("judge", score, key, None) (its state and the judge's
        verdict, for a score with takes) and ("cand", score, key, candidate) rows."""
        g = self.game
        rows = []
        for s in g.scores or [None]:
            key = s.key if s else WHOLE_GAME
            rows.append(("head", s, key, None))
            if s is not None and any(self.st.tune_state(g, s)):
                rows.append(("judge", s, key, None))
            rows += [("cand", s, key, c) for c in self.st.candidates(g, s)]
        return rows

    def draw_game(self, h: int, w: int) -> None:
        st = self.st
        if st.plan and st.plan.game(self.game.id):
            self.game = st.plan.game(self.game.id)  # the plan read again
        g = self.game
        x = self.put(0, 0, g.name, self.attr["title"])
        x = self.put(0, x, f"  ({g.id})  {g.how}  {kb(g.packed)}  ")
        tag, ta = self.pack_tag(g.id)
        self.put(0, x, f"pack {tag}" if st.packs.get(g.id) else "in no pack", ta)
        self.put(1, 0, g.music, self.attr["dim"])
        ms = st.marked(g.id)
        if g.can_arrange:
            x = self.put(2, 0, "music to try: ", self.attr["dim"])
            for key, label, k, what in METHOD_KEYS:
                on = k in ms
                x = self.put_key(2, x, key)
                x = self.put(2, x - 1, "[x] " if on else "[ ] ", self.attr[k] if on else self.attr["dim"])
                x = self.put(2, x, f"{label} {what}   ", self.attr[k] if on else self.attr["dim"])
        elif g.no_music:
            heard = st.whole_game_sound(g)
            text = ("No music found in this game: it plays sound effects from its own code." if heard == "effects"
                    else f"No music found in this game: it makes no sound in its first {heard.split()[1]} s." if heard
                    else "No music found in this game: Enter renders its own sound, to hear any sound effects.")
            self.put(2, 0, text, self.attr["dim"])
        else:
            self.put(2, 0, f"{g.plays()}: no score, so no AI, SID or AY; listen to the whole game below", self.attr["dim"])
        self.put_help(h - 2, HELP_GAME)
        rows = self.game_rows()
        cands = [i for i, r in enumerate(rows) if r[0] == "cand"]
        if not cands:
            return
        self.ci = max(0, min(self.ci, len(cands) - 1))
        sel_row = cands[self.ci]
        avail = h - 6
        if avail <= 0:
            return
        if sel_row - 1 < self.ctop:
            self.ctop = max(0, sel_row - 1)
        if sel_row >= self.ctop + avail:
            self.ctop = sel_row - avail + 1
        ch = st.choices()
        for k, (kind, s, key, c) in enumerate(rows[self.ctop:self.ctop + avail]):
            y = 4 + k
            if kind == "head":
                if s is None:
                    self.put(y, 0, "the whole game (nothing to choose; to listen)" if not g.no_music
                             else "the whole game (no music to choose)", self.attr["head"])
                else:
                    x = self.put(y, 0, f"score {s.key}  {s.seconds:.1f} s{'  shadow: replaces the live version when chosen' if s.shadow else ''}",
                                 self.attr["head"])
                    status = s.status or "-"
                    x = self.put(y, x, "   plan: ", self.attr["dim"])
                    self.put(y, x, status, self.attr["err"] if status.startswith("refused") else 0)
                continue
            if kind == "judge":
                tstate, words = st.tune_state(g, s)
                label, la = TUNE_STATES[tstate]
                x = self.put(y, 2, label, self.attr[la]) + 2 if label else 2
                if words:
                    self.put(y, x, words, self.attr["warn"] if tstate == "hear" else self.attr["dim"])
                continue
            sel = self.ctop + k == sel_row
            sid = f"{g.id}/{s.key}" if s is not None else ""
            chosen = s is not None and c.choice is not None and ch.get(sid, 0) == c.choice
            by_judge = chosen and st.judged().get(sid) == c.choice
            state = st.state_of(g, key, c)
            rv = self.attr["sel"] if sel else 0
            unavailable = state.startswith(("nothing to play", "no ", "silent"))
            self.put(y, 0, " " * w, rv)
            x = self.put(y, 0, "> " if sel else "  ", rv)
            ca = self.attr["judge" if by_judge else "chosen"]
            x = self.put(y, x, ("j " if by_judge else "* ") if chosen else "  ", (ca if chosen else 0) | rv)
            la = ca if chosen else self.attr["dim"] if unavailable else 0
            self.put(y, x, f"{c.label[:26]:<26} ", la | rv)
            x = 32
            if state:
                sa = (self.attr["warn"] if state in ("playing", "rendering...")
                      else self.attr["err"] if state.startswith("render failed") else self.attr["dim"])
                self.put(y, x, f"[{state}] ", sa | rv)
                x += len(state) + 3
            if c.judge is not None:
                x = self.put_judge(y, x, c, w, rv)
            self.put(y, x, c.info, (self.attr["dim"] if not sel else 0) | rv)

    def put_judge(self, y: int, x: int, c: Candidate, w: int, rv: int) -> int:
        """A take's judge figures on its row: its place in the judge's order (#1, the judge's
        pick, in the judge's colour), closeness (coloured: the same tune, part of it, another),
        quality (and its three parts on a wide screen), its faults in red; the next column."""
        j = c.judge
        rank = j.get("rank", 0)
        x = self.put(y, x, f"#{rank:<2}", (self.attr["judge"] if rank == 1 else self.attr["dim"]) | rv) + 1
        if c.take == "0":
            x = self.put(y, x, " " * 10, rv) + 1
        else:
            cl = float(j.get("closeness", 0) or 0)
            x = self.put(y, x, f"close {pct(cl):>4}", self.attr[close_band(cl)] | rv) + 1
        x = self.put(y, x, f"qual {pct(j.get('quality')):>4}", rv) + 1
        if w >= 140:
            x = self.put(y, x, f"(poly {pct(j.get('polyphony')):>4} harm {pct(j.get('harmony')):>4} rhy {pct(j.get('rhythm')):>4})",
                         self.attr["dim"] | rv) + 1
        faults = j.get("faults") or []
        if faults:
            x = self.put(y, x + 1, "; ".join(faults), self.attr["err"] | rv) + 1
        return x + 1

    def pack_rows(self) -> list[tuple[str, int, Game | None]]:
        """The pack view's rows: ("head", pack, None) and ("game", pack, game); pack 0: in none."""
        p, st = self.st.plan, self.st
        rows = []
        for n, gs in pack_fill(p, st.packs).items():
            rows.append(("head", n, None))
            rows += [("game", n, g) for g in gs]
        rows.append(("head", 0, None))
        rows += [("game", 0, g) for g in unassigned(p, st.packs)]
        return rows

    def draw_packs(self, h: int, w: int) -> None:
        st, p = self.st, self.st.plan
        self.put(0, 0, "the packs", self.attr["title"])
        self.put(0, 11, f"  room {kb(p.room)}, a pack holds {kb(fill_limit(p))} of games  {st.sizes_note()}", self.attr["dim"])
        self.put_help(h - 2, HELP_PACKS)
        rows = self.pack_rows()
        games = [i for i, r in enumerate(rows) if r[0] == "game"]
        avail = h - 4
        if avail <= 0:
            return
        if not games:
            self.put(2, 2, "no packed game", self.attr["dim"])
            return
        self.pi = max(0, min(self.pi, len(games) - 1))
        sel_row = games[self.pi]
        if sel_row - 1 < self.ptop:
            self.ptop = max(0, sel_row - 1)
        if sel_row >= self.ptop + avail:
            self.ptop = sel_row - avail + 1
        lines = {n: (ln, over) for n, ln, over in pack_lines(p, st.packs, width=max(4, min(20, w - 50)), utf8=self.utf8)}
        nw = min(28, max(8, w - 20))
        for k, (kind, n, g) in enumerate(rows[self.ptop:self.ptop + avail]):
            y = 2 + k
            if kind == "head":
                ln, over = lines.get(n, (f"P{n}", False))
                if over:
                    self.put(y, 0, ln, self.attr["err"])
                elif n:
                    x = self.put(y, 0, f"P{n}", self.attr[f"p{n}"])
                    self.put(y, x, ln[len(f"P{n}"):], self.attr["head"])
                else:
                    self.put(y, 0, ln if ln.startswith("in no pack") else "in no pack", self.attr["head"])
                continue
            sel = self.ptop + k == sel_row
            rv = self.attr["sel"] if sel else 0
            self.put(y, 0, " " * w, rv)
            x = self.put(y, 0, "  > " if sel else "    ", rv)
            x = self.put(y, x, f"{g.name[:nw]:<{nw}}", self.attr["name"] | rv)
            self.put(y, x, f" {kb(g.packed):>9}", rv)

    def job_list(self) -> list[tuple[str, list[Job]]]:
        """The jobs view's groups: running; waiting, in the order they run (the held ones, which
        wait for a download, last); finished, newest first."""
        r = self.st.runner
        with r.lock:
            jobs, queue = list(r.jobs), list(r.pending)
        held = [j for j in jobs if j.state == "waiting" and j not in queue]
        done = sorted((j for j in jobs if j.state in FINISHED), key=lambda j: j.ended or 0, reverse=True)
        return [("running", [j for j in jobs if j.state == "running"]),
                ("waiting", [j for j in queue if j.state == "waiting"] + held), ("finished", done)]

    def jobs_flat(self) -> list[Job]:
        return [j for _, js in self.job_list() for j in js]

    def follow(self, flat: list[Job]) -> Job | None:
        """The job under the cursor, the cursor moved to where it is now in the list."""
        if self.jsel is not None and self.jsel in flat:
            self.ji = flat.index(self.jsel)
        self.ji = max(0, min(self.ji, len(flat) - 1))
        self.jsel = flat[self.ji] if flat else None
        return self.jsel

    def put_what(self, y: int, x: int, what: str, width: int, attr: int = 0) -> int:
        """A job's kind, its method word (AI, SID, AY) in the method's colour."""
        text = f"{what[:width]:<{width}}"
        m = re.search(r"\b(AI|SID|AY)\b", text)
        if not m:
            return self.put(y, x, text, attr)
        x0 = self.put(y, x, text[:m.start()], attr)
        x0 = self.put(y, x0, m[1], self.attr[m[1].lower()] | attr)
        return self.put(y, x0, text[m.end():], attr)

    def draw_jobs(self, h: int, w: int) -> None:
        now = time.monotonic()
        groups = self.job_list()
        n = {k: len(js) for k, js in groups}
        x = self.put(0, 0, "jobs", self.attr["title"])
        self.put(0, x, f"  {n['running']} running, {n['waiting']} waiting, {n['finished']} finished; one at a time, in this order",
                 self.attr["dim"])
        self.put_help(h - 2, HELP_JOBS)
        flat = [j for _, js in groups for j in js]
        if not flat:
            self.put(2, 2, "no jobs yet: g makes the takes of the methods marked (a, s, y)", self.attr["dim"])
            return
        sel_job = self.follow(flat)
        ww = min(24, max(len(j.what or j.title) for j in flat))
        gw = min(22, max((len(j.game) for j in flat), default=0))
        x_detail = 2 + 14 + 1 + ww + 2 + (gw + 2 if gw else 0)
        indent = 17 if w >= 60 else 4
        # ("head", text, None), ("job", job, its detail when it fits beside it), ("more", job, a line of its
        # detail below it, wrapped, at most 3)
        rows: list[tuple[str, object, str]] = []
        for key, js in groups:
            if not js:
                continue
            rows.append(("head", f"{key} ({len(js)})" if key != "running" else key, ""))
            for j in js:
                d = job_detail(j, now)
                if len(d) <= w - x_detail - 1 - (JOB_BAR + 1 if j.state == "running" else 0):
                    rows.append(("job", j, d))
                    continue
                rows.append(("job", j, ""))
                lines = textwrap.wrap(d, max(8, w - indent - 1))
                if len(lines) > 3:
                    lines = lines[:2] + [textwrap.shorten(" ".join(lines[2:]), max(8, w - indent - 1), placeholder=" ...")]
                rows += [("more", j, ln) for ln in lines]
        sel_row = next(i for i, r in enumerate(rows) if r[0] == "job" and r[1] is sel_job)
        avail = h - 4
        if avail <= 0:
            return
        last = sel_row
        while last + 1 < len(rows) and rows[last + 1][0] == "more":
            last += 1
        if sel_row - 1 < self.jtop:
            self.jtop = max(0, sel_row - 1)
        if last >= self.jtop + avail:
            self.jtop = max(0, min(sel_row, last - avail + 1))
        for k, (kind, item, d) in enumerate(rows[self.jtop:self.jtop + avail]):
            y = 2 + k
            if kind == "head":
                self.put(y, 0, item, self.attr["head"])
                continue
            j = item
            state, sk = job_state(j, now)
            sa = {"run": self.attr["run"], "ok": self.attr["ok"], "err": self.attr["err"], "wait": self.attr["dim"],
                  "off": self.attr["dim"]}[sk]
            da = self.attr["err"] if sk == "err" else self.attr["dim"] if sk in ("wait", "off") else 0
            sel = j is sel_job
            rv = self.attr["sel"] if sel else 0
            if kind == "more":
                if sel:
                    self.put(y, 0, " " * w, rv)
                self.put(y, indent, d, (da if not sel else 0) | rv)
                continue
            self.put(y, 0, " " * w, rv)
            x = self.put(y, 0, "> " if sel else "  ", rv)
            x = self.put(y, x, f"{state:<14} ", sa | rv)
            x = self.put_what(y, x, j.what or j.title, ww, rv)
            x = self.put(y, x + 2, f"{j.game[:gw]:<{gw}}", self.attr["name"] | rv) if gw else x
            xd = x_detail
            if j.state == "running" and xd + JOB_BAR < w:
                try:
                    frac = job_progress(j, now).frac
                except Exception:  # noqa: BLE001
                    frac = None
                for t, on in render_bar(frac, JOB_BAR, self.utf8, now):
                    xd = self.put(y, xd, t, (self.attr["prog_run"] if on else self.attr["track"]) | rv)
                xd += 1
            if d:
                self.put(y, xd, d, (da if not sel else 0) | rv)

    def open_jobs(self) -> None:
        if self.screen == "text":
            if self.text_from != "jobs":
                self.jobs_from = self.text_from
        elif self.screen != "jobs":
            self.jobs_from = self.screen
        self.screen, self.ji, self.jsel, self.jtop = "jobs", 0, None, 0

    def open_game_of(self, j: Job) -> None:
        """o: the job's game (to listen to its takes)."""
        st = self.st
        g = st.plan.game(j.gid) if st.plan and j.gid else None
        if g is None:
            st.flash(f"{j.title}: no game to open", "err")
        elif g.left_out:
            st.flash(f"{g.name}: left out ({g.reason or g.how})")
        else:
            self.game, self.ci, self.ctop, self.screen, self.game_from = g, 0, 0, "game", "jobs"

    def cancel_job(self, j: Job) -> None:
        """x: a waiting job off the queue at once; the running one after a y."""
        if j.state == "running":
            self.confirm_stop = j
        else:
            self.st.cancel_job(j)

    def open_text(self, kind: str) -> None:
        self.text_from = self.screen if self.screen != "text" else self.text_from
        self.screen = "text"
        self.text_kind = kind
        self.text_off = 0

    def text_content(self) -> list[str]:
        if self.text_kind == "log":
            try:
                with self.st.runner.log_path.open("rb") as f:
                    f.seek(0, 2)
                    size = f.tell()
                    f.seek(max(0, size - (256 << 10)))
                    return f.read().decode("utf-8", "replace").splitlines()
            except OSError:
                return ["(no log yet)"]
        if self.text_kind == "summary":
            return self.st.summary or ["(no build yet)"]
        if self.text_kind == "job":
            j = self.text_job
            lines = [ln.rstrip("\n") for ln in j.tail]
            if len(j.tail) == j.tail.maxlen:
                lines.insert(0, "(its earlier lines: l, the whole log)")
            return lines or ["(no output in the log yet)"]
        return (__doc__ or "").splitlines()

    def line_attr(self, ln: str) -> int:
        if self.text_kind == "help":
            return 0
        low = ln.lower()
        if "failed" in low or "error" in low or "refused" in low:
            return self.attr["err"]
        if ln.startswith("== "):
            return self.attr["ok"] if ln.endswith(": done") else self.attr["bold"]
        if ln.startswith(("built ", "reused ")):
            return self.attr["ok"]
        if ln.startswith(("not built", "in no pack", "left out")):
            return self.attr["warn"]
        return 0

    def draw_text(self, h: int, w: int) -> None:
        lines = self.text_content()
        if self.text_kind == "job":
            j = self.text_job
            state, sk = job_state(j, time.monotonic())
            x = self.put(0, 0, j.title, self.attr["title"])
            x = self.put(0, x + 2, state, {"run": self.attr["run"], "ok": self.attr["ok"], "err": self.attr["err"]}.get(sk, self.attr["dim"]))
            self.put(0, x + 2, f"its lines in {self.st.runner.log_path}", self.attr["dim"])
        else:
            title = {"log": f"log: {self.st.runner.log_path}", "summary": "the build", "help": "help"}[self.text_kind]
            self.put(0, 0, title, self.attr["title"])
        self.put_help(h - 2, HELP_JOB_TEXT if self.text_kind == "job" else HELP_TEXT)
        rows = h - 3
        if rows <= 0:
            return
        span = max(0, len(lines) - rows)
        self.text_off = max(0, min(self.text_off, span))
        top = span - self.text_off if self.text_kind in ("log", "job") else self.text_off
        for k, ln in enumerate(lines[top:top + rows]):
            self.put(1 + k, 0, ln, self.line_attr(ln))

    # -- keys

    def key(self, ch: int) -> None:
        c = self.c
        if ch == c.KEY_RESIZE:
            with contextlib.suppress(Exception):
                c.update_lines_cols()
            return
        if self.confirm_stop is not None:
            if ch in (ord("y"), ord("Y")):
                self.st.cancel_job(self.confirm_stop)
            self.confirm_stop = None
            return
        if self.confirm_quit:
            if ch in (ord("y"), ord("Y")):
                self.quit = True
            self.confirm_quit = False
            return
        if ch == ord("J") and self.screen != "jobs":
            self.open_jobs()
            return
        word = KEY_WORDS.get(chr(ch)) if 0 < ch < 128 and self.screen in ("games", "game", "packs", "jobs") else None
        if word and (chr(ch) != "x" or self.screen == "jobs") and (chr(ch) != "c" or self.screen == "game"):
            on = (self.game.name if self.screen == "game" and self.game else
                  self.jsel.title if self.screen == "jobs" and self.jsel else "")
            if not on and self.screen == "games" and self.st.plan and self.gi < len(self.st.plan.games) and chr(ch) in "mr":
                on = self.st.plan.games[self.gi].name if chr(ch) == "m" else ""
            self.st.event(f"key {chr(ch)} ({self.screen} screen): {word}" + (f", {on}" if on else ""))
        getattr(self, f"key_{self.screen}")(ch)

    def ask_quit(self) -> None:
        if self.st.runner.busy():
            self.confirm_quit = True
        else:
            self.quit = True

    def move(self, ch: int, i: int, n: int, page: int) -> int:
        c = self.c
        if ch in (c.KEY_DOWN, ord("j")):
            i += 1
        elif ch in (c.KEY_UP, ord("k")):
            i -= 1
        elif ch == c.KEY_NPAGE:
            i += page
        elif ch == c.KEY_PPAGE:
            i -= page
        elif ch == c.KEY_HOME:
            i = 0
        elif ch == c.KEY_END:
            i = n - 1
        return max(0, min(i, n - 1))

    def moves(self, ch: int) -> bool:
        c = self.c
        return ch in (c.KEY_DOWN, c.KEY_UP, c.KEY_NPAGE, c.KEY_PPAGE, c.KEY_HOME, c.KEY_END, ord("j"), ord("k"))

    @staticmethod
    def pack_key(ch: int) -> int | None:
        """1-9: that pack; 0 or x: none."""
        if ord("1") <= ch <= ord("9"):
            return ch - ord("0")
        return 0 if ch in (ord("0"), ord("x")) else None

    def key_games(self, ch: int) -> None:
        st, p, c = self.st, self.st.plan, self.c
        h, _ = self.scr.getmaxyx()
        g = p.games[self.gi] if p and p.games and self.gi < len(p.games) else None
        if ch in (ord("q"), ord("Q")):
            self.ask_quit()
        elif ch == ord("l"):
            self.open_text("log")
        elif ch == ord("?"):
            self.open_text("help")
        elif not p:
            rows = st.refresh_live()
            if self.moves(ch) and rows:
                self.gi = self.move(ch, self.gi, len(rows), max(1, h - 6))
            elif self.pack_key(ch) is not None and rows and self.gi < len(rows):
                r = rows[self.gi]
                if r.gid:
                    st.assign(r.gid, self.pack_key(ch))
                else:
                    st.flash(f"{r.name}: not in the games file yet", "err")
            elif ch in (10, 13, c.KEY_ENTER, c.KEY_RIGHT):
                st.flash("still learning: the games open when the plan is ready")
            elif ch in (ord("r"), ord("b"), ord("g"), ord("f"), ord("p"), ord("A"), ord("S"), ord("Y"), ord("a"), ord("s"), ord("y"),
                        ord("m"), ord("M"), ord("n")):
                st.flash("still learning: wait for the plan", "err")
        elif ch == ord("r"):
            st.relearn()
        elif ch == ord("b"):
            st.build()
        elif ch == ord("A"):
            st.toggle_all("ai")
        elif ch == ord("S"):
            st.toggle_all("sid")
        elif ch == ord("Y"):
            st.toggle_all("ay")
        elif ch == ord("g"):
            st.generate()
        elif ch == ord("M"):
            st.auto()
        elif ch == ord("f"):
            st.fill()
        elif ch == ord("p"):
            self.screen, self.pi, self.ptop = "packs", 0, 0
        elif not g:
            return
        elif self.moves(ch):
            self.gi = self.move(ch, self.gi, len(p.games), max(1, h - 6))
        elif self.pack_key(ch) is not None:
            st.assign(g.id, self.pack_key(ch))
        elif ch == ord("m"):
            st.auto([g.id])
        elif ch == ord("n"):
            self.next_to_hear()
        elif ch == ord("a"):
            st.toggle(g.id, "ai")
        elif ch == ord("s"):
            st.toggle(g.id, "sid")
        elif ch == ord("y"):
            st.toggle(g.id, "ay")
        elif ch in (10, 13, c.KEY_ENTER, c.KEY_RIGHT):
            if g.left_out:
                st.flash(f"{g.name}: left out ({g.reason or g.how})")
            else:
                self.game, self.ci, self.ctop, self.screen, self.game_from = g, 0, 0, "game", "games"

    def key_packs(self, ch: int) -> None:
        st, c = self.st, self.c
        if not st.plan:
            self.screen = "games"
            return
        h, _ = self.scr.getmaxyx()
        rows = self.pack_rows()
        games = [r[2] for r in rows if r[0] == "game"]
        g = games[self.pi] if games and self.pi < len(games) else None
        if ch in (c.KEY_LEFT, ord("h"), ord("p"), 27, c.KEY_BACKSPACE, 127, 8):
            self.screen = "games"
        elif ch in (ord("q"), ord("Q")):
            self.ask_quit()
        elif ch == ord("l"):
            self.open_text("log")
        elif ch == ord("?"):
            self.open_text("help")
        elif ch == ord("b"):
            st.build()
        elif ch == ord("f"):
            st.fill()
        elif self.moves(ch) and games:
            self.pi = self.move(ch, self.pi, len(games), max(1, h - 6))
        elif g and self.pack_key(ch) is not None:
            if st.assign(g.id, self.pack_key(ch)):  # the cursor follows the game
                moved = [r[2] for r in self.pack_rows() if r[0] == "game"]
                self.pi = next((i for i, x in enumerate(moved) if x.id == g.id), self.pi)
        elif g and ch in (10, 13, c.KEY_ENTER, c.KEY_RIGHT):
            self.game, self.ci, self.ctop, self.screen, self.game_from = g, 0, 0, "game", "games"

    def key_game(self, ch: int) -> None:
        st, c, g = self.st, self.c, self.game
        rows = self.game_rows()
        cands = [r for r in rows if r[0] == "cand"]
        h, _ = self.scr.getmaxyx()
        cur = cands[self.ci] if cands and self.ci < len(cands) else None
        if ch in (c.KEY_LEFT, ord("h"), c.KEY_BACKSPACE, 127, 8) or (ch == 27 and st.player.what is None and not st.want_play):
            self.screen = self.game_from if self.game_from != "packs" or st.plan else "games"
        elif ch == 27:
            st.stop()
        elif cur and ch == ord(" "):
            st.toggle_play(g, cur[2], cur[3])
        elif ch in (ord("q"), ord("Q")):
            self.ask_quit()
        elif ch == ord("l"):
            self.open_text("log")
        elif ch == ord("?"):
            self.open_text("help")
        elif ch == ord("a"):
            st.toggle(g.id, "ai")
        elif ch == ord("s"):
            st.toggle(g.id, "sid")
        elif ch == ord("y"):
            st.toggle(g.id, "ay")
        elif ch == ord("Y"):
            st.toggle_all("ay")
        elif ch == ord("g"):
            st.generate([g.id])
        elif ch == ord("m"):
            st.auto([g.id])
        elif ch == ord("b"):
            st.build()
        elif self.moves(ch):
            self.ci = self.move(ch, self.ci, len(cands), max(1, h - 8))
        elif cur and ch in (10, 13, c.KEY_ENTER):
            st.toggle_play(g, cur[2], cur[3])
        elif cur and ch == ord("c"):
            if cur[1] is None:
                st.flash("the whole game: nothing to choose")
            else:
                st.choose(g, cur[1], cur[3])

    def key_jobs(self, ch: int) -> None:
        c = self.c
        h, _ = self.scr.getmaxyx()
        flat = self.jobs_flat()
        j = self.follow(flat)
        if ch in (c.KEY_LEFT, ord("h"), ord("J"), 27, c.KEY_BACKSPACE, 127, 8):
            self.screen = self.jobs_from if self.jobs_from != "packs" or self.st.plan else "games"
        elif ch in (ord("q"), ord("Q")):
            self.ask_quit()
        elif ch == ord("l"):
            self.open_text("log")
        elif ch == ord("?"):
            self.open_text("help")
        elif self.moves(ch) and flat:
            self.ji = self.move(ch, self.ji, len(flat), max(1, (h - 4) // 2))
            self.jsel = flat[self.ji]
        elif j and ch in (10, 13, c.KEY_ENTER, c.KEY_RIGHT):
            self.text_job = j
            self.open_text("job")
        elif j and ch == ord("o"):
            self.open_game_of(j)
        elif j and ch == ord("x"):
            self.cancel_job(j)

    def key_text(self, ch: int) -> None:
        c = self.c
        h, _ = self.scr.getmaxyx()
        page = max(1, h - 4)
        sign = 1 if self.text_kind in ("log", "job") else -1  # the log and a job's output count from their end
        if self.text_kind == "job" and ch == ord("o"):
            self.open_game_of(self.text_job)
        elif self.text_kind == "job" and ch == ord("x"):
            self.cancel_job(self.text_job)
        elif ch in (ord("q"), ord("Q"), 27, ord("l"), ord("?"), c.KEY_LEFT, ord("h")):
            self.screen = self.text_from
        elif ch in (c.KEY_UP, ord("k")):
            self.text_off += sign
        elif ch in (c.KEY_DOWN, ord("j")):
            self.text_off -= sign
        elif ch == c.KEY_PPAGE:
            self.text_off += sign * page
        elif ch in (c.KEY_NPAGE, ord(" ")):
            self.text_off -= sign * page
        elif ch == c.KEY_HOME:
            self.text_off = 1 << 30 if sign > 0 else 0
        elif ch == c.KEY_END:
            self.text_off = 0 if sign > 0 else 1 << 30
        self.text_off = max(0, self.text_off)

    def loop(self) -> None:
        st = self.st
        shown = None
        while not self.quit:
            if st.runner.pump() and st.summary is not None and st.summary is not shown:
                shown = st.summary
                self.open_text("summary")
            if self.screen == "packs" and not st.plan:
                self.screen = "games"
            if self.confirm_stop is not None and self.confirm_stop.state != "running":
                self.confirm_stop = None
            st.player.poll()
            self.draw()
            try:
                ch = self.scr.getch()
            except KeyboardInterrupt:
                self.ask_quit()
                continue
            if ch != -1:
                self.key(ch)
        st.player.stop()
        st.runner.stop()


