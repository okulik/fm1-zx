# ---------------------------------------------------------------------------------------------
# The plan (plan.json, written by fmzx-pack personal --plan)


@dataclass
class Score:
    key: str
    shadow: bool
    seconds: float
    status: str


@dataclass
class Game:
    id: str
    name: str
    file: str
    how: str
    packed: int | None
    reason: str | None
    music: str
    scores: list[Score]

    @property
    def left_out(self) -> bool:
        return self.packed is None

    @property
    def can_arrange(self) -> bool:
        return bool(self.scores) and not self.left_out

    def plays(self) -> str:
        """What plays for a game with nothing to arrange."""
        return "nothing to arrange: FM from code" if self.music.startswith("music learned") else "beeper"


@dataclass
class Plan:
    room: int
    used: int
    games: list[Game]

    def game(self, gid: str) -> Game | None:
        return next((g for g in self.games if g.id == gid), None)

    def packed(self) -> list[Game]:
        """The packed games in name order (the picker's: A to Z, case not counting)."""
        return sorted((g for g in self.games if not g.left_out), key=lambda g: (g.name.casefold(), g.id))

    def overhead(self) -> int:
        """The pack's bytes beyond its games' (header, directory, shared tables)."""
        return max(0, self.used - sum(g.packed or 0 for g in self.games))


def parse_plan(doc: dict) -> Plan:
    games = []
    for r in doc.get("games", []):
        scores = [Score(str(s["key"]), bool(s.get("shadow", False)), float(s.get("seconds", 0.0)), str(s.get("status", "")))
                  for s in (r.get("scores") or [])]
        packed = r.get("packed")
        games.append(Game(str(r["id"]), str(r.get("name", r["id"])), str(r.get("file", "")), str(r.get("how", "")),
                          None if packed is None else int(packed), r.get("reason"), str(r.get("music", "")), scores))
    return Plan(int(doc.get("room", 0)), int(doc.get("used", 0)), games)


def load_plan(path: Path) -> Plan | None:
    try:
        return parse_plan(json.loads(path.read_text()))
    except (OSError, ValueError, KeyError, TypeError):
        return None


# ---------------------------------------------------------------------------------------------
# Choices, takes and candidates (W/all/arrange/, tools/arrange-music's layout)


def read_toml(path: Path) -> dict:
    try:
        with path.open("rb") as f:
            return tomllib.load(f)
    except (OSError, tomllib.TOMLDecodeError):
        return {}


def parse_choice(v) -> int | str | None:
    if isinstance(v, bool):
        return None
    if isinstance(v, int):
        return v if v >= 0 else None
    if isinstance(v, str):
        if v.isdigit():
            return int(v)
        if re.fullmatch(r"(chip|ay)-[1-9][0-9]*", v):
            return v
    return None


def read_choices(all_dir: Path) -> dict[str, int | str]:
    out = {}
    for k, v in read_toml(all_dir / "arrange" / "choices.toml").get("choices", {}).items():
        c = parse_choice(v)
        if c is not None:
            out[str(k)] = c
    return out


def choice_label(c: int | str | None) -> str:
    if c in (None, 0):
        return "original"
    return f"take-{c}" if isinstance(c, int) else str(c)


def numbered(d: Path, prefix: str) -> list[tuple[int, Path]]:
    out = []
    for p in d.glob(prefix + "*"):
        n = p.name[len(prefix):]
        if n.isdigit() and (p / "arranged.toml").is_file():
            out.append((int(n), p))
    return sorted(out)


def metrics_line(m: dict) -> str:
    f = lambda k: float(m.get(k, 0) or 0)  # noqa: E731
    return (f"key {m.get('key') or '?'}; consonance bass {f('bass_consonance'):.2f} pad {f('pad_consonance'):.2f}; "
            f"notes/s lead {m.get('lead_nps', 0)} bass {m.get('bass_nps', 0)} pad {m.get('pad_nps', 0)} "
            f"drums {m.get('drums_nps', 0)}")


@dataclass
class Candidate:
    label: str
    take: str  # the preview's take: "beeper", "fm" (the whole game), "0", "<n>", "chip-<n>", "c64-<n>", "ay-<n>", "zx128-<n>"
    choice: int | str | None  # the value for pick --set; None: not a choice
    info: str
    file: Path | None = None  # tools/arrange-music's render, played without music-preview
    source: Path | None = None  # a preview older than this is made again
    direct: bool = False  # always the file (the C64's or the Spectrum 128's own sound)


WHOLE_GAME = "game"  # the preview key of a game without scores


def score_candidates(all_dir: Path, gid: str, sc: Score | None) -> list[Candidate]:
    if sc is None:
        return [Candidate("beeper", "beeper", None, "the game's own sound"),
                Candidate("FM (from code/memory)", "fm", None, "what FM: engines plays")]
    d = all_dir / "arrange" / gid / sc.key
    out = [Candidate("beeper", "beeper", None, "the game's own sound, to compare", source=d / "score.toml"),
           Candidate("FM (from code/memory)", "0", 0,
                     "take 0: the live version (the routine)" if sc.shadow else "take 0: the original",
                     d / "original.wav", d / "score.toml")]
    for n, p in numbered(d, "take-"):
        doc = read_toml(p / "arranged.toml")
        gen = str(doc.get("generator", "")).split(" ")[0]
        out.append(Candidate(f"AI take-{n}" + (f" ({gen})" if gen else ""), str(n), n,
                             metrics_line(doc.get("metrics", {})), p / "fm1.wav", p / "arranged.toml"))
    for n, p in numbered(d, "chip-"):
        doc = read_toml(p / "arranged.toml")
        mm = float(doc.get("metrics", {}).get("melody_match", 0.0) or 0.0)
        out.append(Candidate(f"SID chip-{n}", f"chip-{n}", f"chip-{n}",
                             f"melody match {mm:.2f}; {doc.get('source', '?')}", p / "fm1.wav", p / "arranged.toml"))
        if (p / "chip.wav").is_file():
            out.append(Candidate(f"C64 original (chip-{n})", f"c64-{n}", None, "the C64's own sound (sidplayfp)",
                                 p / "chip.wav", direct=True))
    for n, p in numbered(d, "ay-"):
        doc = read_toml(p / "arranged.toml")
        mm = float(doc.get("metrics", {}).get("melody_match", 0.0) or 0.0)
        out.append(Candidate(f"AY ay-{n}", f"ay-{n}", f"ay-{n}",
                             f"melody match {mm:.2f}; {doc.get('source', '?')}", p / "fm1.wav", p / "arranged.toml"))
        if (p / "ay.wav").is_file():
            out.append(Candidate(f"Spectrum 128 original (ay-{n})", f"zx128-{n}", None, "the Spectrum 128's own sound (ffmpeg)",
                                 p / "ay.wav", direct=True))
    return out


def preview_path(w: Path, gid: str, key: str, take: str) -> Path:
    return w / "previews" / f"{gid}__{key}__{take}.wav"


def preview_argv(tool: str, all_dir: Path, gid: str, key: str, take: str, out: Path) -> list[str]:
    a = [tool, str(all_dir), "--game", gid]
    if key != WHOLE_GAME:
        a += ["--score", key]
    if take == "beeper":
        a += ["--beeper"]
    elif take != "fm":
        a += ["--take", take]
    return a + ["-o", str(out)]


def play_route(w: Path, gid: str, key: str, c: Candidate, preview_ok: bool) -> tuple[str, Path | None, str]:
    """How a candidate plays: ("file", path, note), ("render", preview path, note) or
    ("none", None, why)."""
    if c.direct:
        return ("file", c.file, c.file.name) if c.file and c.file.is_file() else ("none", None, f"no {c.file.name if c.file else 'file'}")
    if preview_ok:
        out = preview_path(w, gid, key, c.take)
        try:
            fresh = out.is_file() and (c.source is None or not c.source.exists()
                                       or out.stat().st_mtime >= c.source.stat().st_mtime)
        except OSError:
            fresh = False
        return ("file", out, "music-preview") if fresh else ("render", out, "music-preview")
    if c.file and c.file.is_file():
        note = f"{c.file.name} (General MIDI render)" if c.file.name == "original.wav" else c.file.name
        return "file", c.file, note
    if c.file is None:
        return "none", None, "nothing to play: music-preview is not built"
    return "none", None, f"nothing to play: no {c.file.name} (music-preview is not built; FluidSynth renders)"


# ---------------------------------------------------------------------------------------------
# The studio's state (W/studio.toml)


def load_methods(w: Path) -> dict[str, set[str]]:
    doc = read_toml(w / "studio.toml")
    out = {}
    for gid, ms in doc.get("methods", {}).items():
        if isinstance(ms, list):
            out[str(gid)] = {m for m in ms if m in METHODS}
    return out


def save_methods(w: Path, methods: dict[str, set[str]]) -> None:
    lines = ["# tools/pack-studio: the music methods marked per game (FM is always there)", "[methods]"]
    for gid in sorted(methods):
        ms = [m for m in METHODS if m in methods[gid]]
        if ms:
            lines.append(f"{json.dumps(gid)} = [{', '.join(json.dumps(m) for m in ms)}]")
    w.mkdir(parents=True, exist_ok=True)
    tmp = w / "studio.toml.tmp"
    tmp.write_text("\n".join(lines) + "\n")
    tmp.replace(w / "studio.toml")


# ---------------------------------------------------------------------------------------------
# The split and the pack folders


def split_packs(games: list[tuple[str, int]], room: int, overhead: int = 0, margin: float = MARGIN) -> list[list[str]]:
    """Games (id, packed bytes) in order into packs: each filled while its total stays within
    room minus the margin minus the overhead. A game bigger than that gets a pack of its own."""
    limit = room * (1 - margin) - overhead
    packs: list[list[str]] = []
    cur: list[str] = []
    total = 0
    for gid, size in games:
        if cur and total + size > limit:
            packs.append(cur)
            cur, total = [], 0
        cur.append(gid)
        total += size
    if cur:
        packs.append(cur)
    return packs


GAME_RE = re.compile(r"^[ \t]*\[\[[ \t]*game[ \t]*\]\][ \t]*(#.*)?\r?\n?$")
COMMENTED_GAME_RE = re.compile(r"^[ \t]*#[ \t#]*\[\[[ \t]*game[ \t]*\]\]")


def _comment(line: str) -> bool:
    return line.lstrip().startswith("#")


def split_games_file(text: str) -> tuple[str, list[tuple[str, str]]]:
    """A personal games file as (its header comment, [(id, entry text)]): each entry from its
    [[game]] line to its last line (its [game.*] tables and the comment lines right after them
    included; blank lines, a commented-out game or a "# missing:" line below it are not)."""
    lines = text.splitlines(keepends=True)
    starts = [i for i, ln in enumerate(lines) if GAME_RE.match(ln)]
    header = []
    for ln in lines[:starts[0] if starts else len(lines)]:
        if not ln.strip() or not _comment(ln):
            break
        header.append(ln)
    entries = []
    for k, s in enumerate(starts):
        chunk = lines[s:starts[k + 1] if k + 1 < len(starts) else len(lines)]
        last = max(i for i, ln in enumerate(chunk) if i == 0 or (ln.strip() and not _comment(ln)))
        end = last + 1
        while end < len(chunk) and chunk[end].strip() and _comment(chunk[end]) \
                and not COMMENTED_GAME_RE.match(chunk[end]) and not chunk[end].lstrip().startswith("# missing:"):
            end += 1
        body = "".join(chunk[:end])
        if not body.endswith("\n"):
            body += "\n"
        try:
            doc = tomllib.loads(body)
            gid = str(doc["game"][0]["id"])
        except (tomllib.TOMLDecodeError, KeyError, IndexError, TypeError) as e:
            raise ValueError(f"the games file's entry at line {s + 1} does not read: {e}") from None
        entries.append((gid, body))
    return "".join(header), entries


def absolute_file(entry: str, base: Path) -> str:
    """The entry with a relative `file` made absolute from base (the games file's folder)."""
    f = tomllib.loads(entry)["game"][0].get("file")
    if not isinstance(f, str) or Path(f).is_absolute():
        return entry
    lines = entry.splitlines(keepends=True)
    for i, ln in enumerate(lines[1:], 1):
        if ln.lstrip().startswith("["):
            break
        if re.match(r"^[ \t]*file[ \t]*=", ln):
            lines[i] = f"file = {json.dumps(str((base / f).resolve()))}\n"
            break
    return "".join(lines)


def subset_games_file(text: str, ids: list[str], base: Path, note: str) -> str:
    header, entries = split_games_file(text)
    by = dict(entries)
    missing = [g for g in ids if g not in by]
    if missing:
        raise ValueError(f"no entry for {', '.join(missing)} in the games file")
    out = header + "".join(f"# {ln}\n" for ln in note.splitlines()) + "\n"
    return out + "\n".join(absolute_file(by[g], base) for g in ids)


def is_studio_pack(d: Path) -> bool:
    return (d / MARKER).is_file()


def write_pack_folder(w: Path, n: int, ids: list[str], text: str) -> Path:
    """W/pack-<n>/: the marker, the games file and the two links into W/all."""
    d = w / f"pack-{n}"
    if d.exists() and any(d.iterdir()) and not is_studio_pack(d):
        raise ValueError(f"{d} is not the studio's (no {MARKER}): move it away")
    d.mkdir(parents=True, exist_ok=True)
    (d / MARKER).write_text(json.dumps({"games": ids}) + "\n")
    (d / "personal-games.toml").write_text(text)
    for name in ("sound-cache", "arrange"):
        (w / "all" / name).mkdir(parents=True, exist_ok=True)
        link = d / name
        target = Path("..") / "all" / name
        if link.is_symlink():
            if Path(os.readlink(link)) == target:
                continue
            link.unlink()
        elif link.is_dir():
            shutil.rmtree(link)
        elif link.exists():
            link.unlink()
        link.symlink_to(target, target_is_directory=True)
    return d


def pack_folders(w: Path) -> list[tuple[int, Path]]:
    out = []
    for d in w.glob("pack-*"):
        n = d.name[5:]
        if n.isdigit() and d.is_dir():
            out.append((int(n), d))
    return sorted(out)


def remove_stale_packs(w: Path, count: int) -> list[Path]:
    """Removes W/pack-<m> for m > count that the studio made; returns them."""
    gone = []
    for n, d in pack_folders(w):
        if n > count and is_studio_pack(d):
            shutil.rmtree(d)  # the links inside are removed, not followed
            gone.append(d)
    return gone


def pack_summary(w: Path, plan: Plan | None) -> list[str]:
    """The packs on disk the studio made: each pack's games and its fmzx.fwsc."""
    out = []
    for n, d in pack_folders(w):
        if not is_studio_pack(d):
            continue
        try:
            ids = json.loads((d / MARKER).read_text()).get("games", [])
        except (OSError, ValueError):
            ids = []
        games = [plan.game(g) if plan else None for g in ids]
        names = [g.name if g else gid for g, gid in zip(games, ids)]
        size = sum((g.packed or 0) for g in games if g) if plan else None
        fw = d / "fmzx.fwsc"
        where = str(fw) if fw.is_file() else f"{fw} (not built)"
        out.append(f"pack {n}: {len(ids)} game{'s' if len(ids) != 1 else ''}" + (f", {kb(size)}" if size else "") + f": {where}")
        out.append(f"  {', '.join(names) or '-'}")
    return out


