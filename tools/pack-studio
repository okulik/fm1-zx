@dataclass
class BuildRun:
    packs: list[list[str]] = field(default_factory=list)
    text: str = ""
    built: int = 0
    too_big: list[str] = field(default_factory=list)
    error: str | None = None


class Studio:
    def __init__(self, folder: Path, w: Path, args: argparse.Namespace, runner: Runner, tools: Tools | None = None):
        self.folder = folder  # the games folder, or a games file used as written
        self.w = w
        self.all = w / "all"
        self.args = args
        self.runner = runner
        self.tools = tools or Tools.from_env()
        self.plan = load_plan(self.all / "plan.json")
        self.methods = load_methods(w)
        self.player = Player()
        self.flash_msg = ""
        self.flash_at = 0.0
        self.version = 0  # counts finished jobs: the screen's caches follow it
        self.rendering: set[str] = set()
        self.failed: dict[str, str] = {}  # preview name -> why its render failed
        self.want_play: str | None = None
        self.choosing: set[str] = set()
        self.waiters: dict[str, list[Callable[[Path], None]]] = {}  # per collection being downloaded
        self.build_run: BuildRun | None = None
        self.summary: list[str] | None = None
        self.build_ok: bool | None = None
        self.errors: list[str] = []  # what stopped a step before it ran (the headless commands report them)
        self._cands: dict[tuple, list[Candidate]] = {}
        self._choices: tuple[int, dict] | None = None

    # -- messages and data

    def flash(self, msg: str) -> None:
        self.flash_msg, self.flash_at = msg, time.monotonic()
        if not self.runner.threaded:
            print(f"{PROG}: {msg}", file=sys.stderr, flush=True)

    def fail(self, msg: str) -> None:
        self.errors.append(msg)
        self.flash(msg)

    def games_file(self) -> Path:
        """The games file the packs take their entries from: the one given, else the folder's."""
        return self.folder if self.folder.is_file() else self.all / "personal-games.toml"

    def changed(self, _job: Job | None = None) -> None:
        self.version += 1
        self._cands.clear()
        self._choices = None

    def reload_plan(self) -> None:
        self.plan = load_plan(self.all / "plan.json")
        self.changed()

    def choices(self) -> dict[str, int | str]:
        if self._choices is None or self._choices[0] != self.version:
            self._choices = (self.version, read_choices(self.all))
        return self._choices[1]

    def candidates(self, g: Game, sc: Score | None) -> list[Candidate]:
        k = (g.id, sc.key if sc else WHOLE_GAME)
        if k not in self._cands:
            self._cands[k] = score_candidates(self.all, g.id, sc)
        return self._cands[k]

    def choice_summary(self, g: Game) -> str:
        if g.left_out:
            return f"left out: {g.reason or g.how}"
        if not g.scores:
            return g.plays()
        ch = self.choices()
        return " / ".join(choice_label(ch.get(f"{g.id}/{s.key}", 0)) for s in g.scores)

    def marked(self, gid: str) -> set[str]:
        return self.methods.get(gid, set())

    def sid_dir(self) -> Path | None:
        if self.args.sid_dir:
            p = Path(self.args.sid_dir).expanduser()
            return (find_collection(p) or p) if p.is_dir() else None
        return downloaded_collection(hvsc_root())

    def ay_dir(self) -> Path | None:
        if self.args.ay_dir:
            p = Path(self.args.ay_dir).expanduser()
            return (find_ay_collection(p) or p) if p.is_dir() else None
        return downloaded_ay(ay_root())

    def uv_env(self) -> dict[str, str]:
        return {"UV_OFFLINE": "1"} if self.args.offline else {}

    # -- start and learning

    def startup(self, learn: bool = True, preview: bool = True) -> None:
        if os.environ.get("FMZX_SKIP_DEVICE_BUILD", "0") != "1":
            for preset in ("fm1", "fm1-preview"):
                self.runner.submit(Job(f"device build {preset} (configure)",
                                       [str(ROOT / "tools/fm1-docker"), "cmake", "--preset", preset], chain="start"))
                self.runner.submit(Job(f"device build {preset}",
                                       [str(ROOT / "tools/fm1-docker"), "cmake", "--build", "--preset", preset],
                                       chain="start"))
        if not self.tools.fmzx_pack_given:
            self.runner.submit(Job("build fmzx-pack", ["cargo", "build", "--release", "-p", "fmzx-pack"],
                                   cwd=ROOT / "host", chain="start"))
        if preview and not self.tools.preview_given:
            def preview_built(j: Job) -> None:
                self.changed()
                if j.rc != 0:
                    self.flash("music-preview did not build: playing the renders tools/arrange-music wrote")
            self.runner.submit(Job("build music-preview", ["cargo", "build", "--release", "-p", "music", "--bin",
                                                           "music-preview"], cwd=ROOT / "host", on_done=preview_built))
        if learn:
            self.runner.submit(self.plan_job("start"))

    def plan_job(self, chain: str, then: Callable[[Job], None] | None = None) -> Job:
        argv = [self.tools.fmzx_pack, "personal", str(self.folder), "-o", str(self.all)]
        for a in apps():
            argv += ["--app", str(a)]
        argv.append("--plan")

        def done(j: Job) -> None:
            self.reload_plan()
            if j.rc != 0:
                self.flash("learning failed (l: the log)")
            elif self.plan is None:
                j.rc = 1
                self.flash(f"no plan in {self.all / 'plan.json'} (l: the log)")
            elif then is None:
                n = len(self.plan.packed())
                self.flash(f"learned: {len(self.plan.games)} games, {n} packed, {kb(self.plan.used)} "
                           f"for a room of {kb(self.plan.room)}")
            if then:
                then(j)
        self.all.mkdir(parents=True, exist_ok=True)
        return Job("learn the games (plan)", argv, chain=chain, on_done=done)

    def relearn(self) -> None:
        self.runner.submit(self.plan_job("plan"))
        self.flash("learning again")

    # -- methods

    def toggle(self, gid: str, method: str) -> None:
        g = self.plan.game(gid) if self.plan else None
        if g is None:
            return
        if not g.can_arrange:
            self.flash(f"{g.name}: " + (f"left out ({g.reason})" if g.left_out else
                                        f"{g.plays()}: no score for AI, SID or AY"))
            return
        ms = self.methods.setdefault(gid, set())
        ms.symmetric_difference_update({method})
        save_methods(self.w, self.methods)

    def toggle_all(self, method: str) -> None:
        if not self.plan:
            return
        gs = [g for g in self.plan.games if g.can_arrange]
        if not gs:
            self.flash("no game has a score: nothing to arrange")
            return
        on = not all(method in self.marked(g.id) for g in gs)
        for g in gs:
            ms = self.methods.setdefault(g.id, set())
            (ms.add if on else ms.discard)(method)
        save_methods(self.w, self.methods)
        self.flash(f"{method.upper()} {'marked' if on else 'unmarked'} for {len(gs)} games")

    # -- generating

    def generate(self, ids: list[str] | None = None, methods: tuple[str, ...] = METHODS) -> None:
        """Queues the jobs for the marked methods among methods, for the games with scores (those
        of ids when given)."""
        if not self.plan:
            self.fail("no plan yet: wait for the learning")
            return
        gs = [g for g in self.plan.games if g.can_arrange and (ids is None or g.id in ids)]
        ai, sid, ay = ([g for g in gs if m in methods and m in self.marked(g.id)] for m in METHODS)
        if not ai and not sid and not ay:
            self.fail("nothing marked: a marks AI, s marks SID, y marks AY (FM needs nothing)")
            return
        if not self.tools.arrange_given() and not shutil.which("uv"):
            self.fail("AI, SID and AY takes need uv (https://docs.astral.sh/uv/): tools/arrange-music runs through it")
            return
        for g in ai:
            argv = [self.tools.arrange, "generate", str(self.all), "--game", g.id]
            if self.args.model:
                argv += ["--model", self.args.model]
            if self.args.offline:
                argv += ["--offline"]
            self.runner.submit(Job(f"AI takes for {g.name}", argv, env=self.uv_env(), on_done=self.changed))
        for gs_, kind, cmd, opt in ((sid, "SID", "chip", "--sid-dir"), (ay, "AY", "ay", "--ay-dir")):
            if gs_:
                def queue(d: Path, gs_=gs_, kind=kind, cmd=cmd, opt=opt) -> None:
                    for g in gs_:
                        self.runner.submit(Job(f"{kind} takes for {g.name}",
                                               [self.tools.arrange, cmd, str(self.all), "--game", g.id, opt, str(d)],
                                               env=self.uv_env(), on_done=self.changed))
                self.with_collection(kind, queue)
        self.flash(f"queued: {len(ai)} AI, {len(sid)} SID, {len(ay)} AY")

    def generate_headless(self, methods: list[str], ids: list[str]) -> None:
        """--generate: marks methods for the games given (every game with scores when none) and
        queues their jobs."""
        if not self.plan:
            return self.fail("no plan: the learning failed (see the log)")
        unknown = [g for g in ids if self.plan.game(g) is None]
        if unknown:
            return self.fail(f"--game {', '.join(unknown)}: no such game (--status lists the ids)")
        gs = [self.plan.game(g) for g in ids] if ids else [g for g in self.plan.games if g.can_arrange]
        for g in gs:
            if not g.can_arrange:
                return self.fail(f"--game {g.id}: " + (f"left out ({g.reason})" if g.left_out else
                                                        f"{g.plays()}: no score for AI, SID or AY"))
        if not gs:
            return self.fail("no game has a score: nothing to arrange")
        for g in gs:
            self.methods.setdefault(g.id, set()).update(methods)
        save_methods(self.w, self.methods)
        self.generate([g.id for g in gs], tuple(methods))

    def with_collection(self, kind: str, then: Callable[[Path], None]) -> None:
        """Runs then(the collection's folder) for "SID" or "AY": the one given (--sid-dir,
        --ay-dir) or downloaded, else after a download job (none with --offline)."""
        given, opt, find, root = ((self.args.sid_dir, "--sid-dir", self.sid_dir, hvsc_root()) if kind == "SID"
                                  else (self.args.ay_dir, "--ay-dir", self.ay_dir, ay_root()))
        d = find()
        if given:
            if d is None:
                self.fail(f"{opt} {given}: no such folder")
            else:
                then(d)
            return
        if d:
            then(d)
            return
        if self.args.offline:
            self.fail(f"{kind}: --offline downloads nothing: give {opt} PATH, or put the collection in {root}")
            return
        if kind in self.waiters:
            self.waiters[kind].append(then)
            return
        self.waiters[kind] = [then]

        def fetch(j: Job) -> int:
            def progress(s: str) -> None:
                j.progress = s
            (fetch_hvsc if kind == "SID" else fetch_ay)(root, progress, j.out)
            return 0

        def fetched(j: Job) -> None:
            waiters = self.waiters.pop(kind, [])
            d = find()
            if j.rc != 0 or d is None:
                self.flash(f"the {kind} collection did not download (l: the log)")
                return
            for t in waiters:
                t(d)
        self.runner.submit(Job(f"download the {kind} collection ({'HVSC' if kind == 'SID' else 'chris-y/AY'})", fn=fetch,
                               on_done=fetched))

    # -- listening and choosing

    def route(self, g: Game, key: str, c: Candidate) -> tuple[str, Path | None, str]:
        return play_route(self.w, g.id, key, c, self.tools.preview_ok())

    @staticmethod
    def cand_id(g: Game, key: str, c: Candidate) -> str:
        return f"{g.id}__{key}__{c.take}"

    def play(self, g: Game, key: str, c: Candidate) -> None:
        cid = self.cand_id(g, key, c)
        self.player.stop()
        self.want_play = None
        how, path, note = self.route(g, key, c)
        if how == "file":
            err = self.player.play(path, cid)
            self.flash(err or f"playing {c.label} ({note})")
        elif how == "none":
            self.flash(f"{c.label}: {note}")
        else:
            self.want_play = cid
            if cid in self.rendering:
                return
            self.rendering.add(cid)
            self.failed.pop(cid, None)
            path.parent.mkdir(parents=True, exist_ok=True)
            tmp = path.with_name(path.stem + ".tmp.wav")
            argv = preview_argv(self.tools.music_preview, self.all, g.id, key, c.take, tmp)

            def rendered(j: Job) -> None:
                self.rendering.discard(cid)
                ok = j.rc == 0 and tmp.is_file()
                if ok:
                    tmp.replace(path)
                else:
                    tmp.unlink(missing_ok=True)
                    lines = [ln.strip() for ln in j.tail if ln.strip() and not ln.startswith("==")]
                    self.failed[cid] = lines[-1] if lines else f"exit {j.rc}"
                if self.want_play != cid:
                    return
                self.want_play = None
                if ok:
                    err = self.player.play(path, cid)
                    self.flash(err or f"playing {c.label} (music-preview)")
                elif c.file and c.file.is_file():
                    err = self.player.play(c.file, cid)
                    self.flash(err or f"render failed ({self.failed[cid]}): playing {c.file.name}")
                else:
                    self.flash(f"{c.label}: render failed: {self.failed[cid]}")
            self.runner.submit(Job(f"render {g.name} {key} {c.take}", argv, on_done=rendered))
            self.flash(f"rendering {c.label}...")

    def stop(self) -> None:
        self.want_play = None
        self.player.stop()

    def state_of(self, g: Game, key: str, c: Candidate) -> str:
        cid = self.cand_id(g, key, c)
        if self.player.what == cid:
            return "playing"
        if cid in self.rendering:
            return "rendering..."
        if f"{g.id}/{key}" in self.choosing and c.choice is not None:
            return ""
        if cid in self.failed:
            return f"render failed: {self.failed[cid]}"
        how, _, note = self.route(g, key, c)
        return note if how == "none" else ""

    def choose(self, g: Game, sc: Score, c: Candidate) -> None:
        if c.choice is None:
            self.flash(f"{c.label} is there to compare: not a choice")
            return
        sid = f"{g.id}/{sc.key}"
        self.choosing.add(sid)

        def chosen(j: Job) -> None:
            self.choosing.discard(sid)
            self.changed()
            self.flash(f"{g.name}: {sc.key} plays {choice_label(c.choice)} (b builds with it)" if j.rc == 0
                       else "choosing failed (l: the log)")
        self.runner.submit(Job(f"choose {choice_label(c.choice)} for {sid}",
                               [self.tools.arrange, "pick", str(self.all), "--set", f"{sid}={c.choice}"],
                               env=self.uv_env(), on_done=chosen))

    # -- building

    def build(self) -> None:
        if self.build_run:
            self.flash("a build is running")
            return
        self.build_run = BuildRun()
        self.summary = None
        self.build_ok = None
        missing = [f for f in device_files() if not f.is_file()]
        if missing:
            return self._finish(f"no {missing[0]}: the device builds make it (FMZX_SKIP_DEVICE_BUILD=1 skipped them)"
                                if os.environ.get("FMZX_SKIP_DEVICE_BUILD", "0") == "1"
                                else f"no {missing[0]}: the device builds did not make it (see the log)")
        self.runner.submit(self.plan_job("build", then=self._split))
        self.flash("building: the plan, then the packs")

    def _split(self, j: Job) -> None:
        br = self.build_run
        if j.rc != 0 or not self.plan:
            return self._finish("the learning failed (see the log)")
        packed = self.plan.packed()
        if not packed:
            return self._finish("no game to pack")
        try:
            br.text = self.games_file().read_text()
            split_games_file(br.text)
        except (OSError, ValueError) as e:
            return self._finish(str(e))
        br.packs = split_packs([(g.id, g.packed) for g in packed], self.plan.room, self.plan.overhead())
        self._pack(0)

    def _pack(self, i: int) -> None:
        br = self.build_run
        n = i + 1
        try:
            src = "../all/personal-games.toml" if not self.folder.is_file() else str(self.folder)
            note = f"Pack {n} of the games in {src}, made by tools/pack-studio on every build:\nedit that file instead."
            text = subset_games_file(br.text, br.packs[i], self.games_file().parent, note)
            d = write_pack_folder(self.w, n, br.packs[i], text)
        except (OSError, ValueError) as e:
            return self._finish(str(e))
        argv = [self.tools.fmzx_pack, "personal", str(d / "personal-games.toml"), "-o", str(d)]
        for a in apps():
            argv += ["--app", str(a)]
        self.runner.submit(Job(f"pack {n} ({len(br.packs[i])} games)", argv, chain="build",
                               on_done=lambda j: self._packed(i, j)))

    def _packages(self, i: int) -> None:
        d = self.w / f"pack-{i + 1}"
        argv = [self.tools.make_packages]
        if self.args.offline:
            argv.append("--offline")
        if self.args.cache:
            argv += ["--cache", str(Path(self.args.cache).expanduser().resolve())]
        env = {"FMZX_SKIP_DEVICE_BUILD": "1", "FMZX_PACKAGES_PACK": str(d / "games.bin"), "FMZX_PACKAGES_OUT": str(d)}

        def done(j: Job) -> None:
            if j.rc != 0:
                return self._finish(f"pack {i + 1}'s packages failed (see the log)")
            self.build_run.built = i + 1
            return self._pack(i + 1) if i + 1 < len(self.build_run.packs) else self._finish(None)
        self.runner.submit(Job(f"pack {i + 1}: the packages and their verify", argv, env=env, chain="build", on_done=done))

    def _packed(self, i: int, j: Job) -> None:
        br = self.build_run
        if j.rc == 0:
            return self._packages(i)
        if NOT_FIT not in j.text():
            return self._finish(f"pack {i + 1} failed (see the log)")
        if len(br.packs[i]) == 1:
            br.too_big.append(br.packs.pop(i)[0])
            return self._pack(i) if i < len(br.packs) else self._finish(None)
        last = br.packs[i].pop()
        if i + 1 == len(br.packs):
            br.packs.append([])
        br.packs[i + 1].insert(0, last)
        self.runner._line(j, f"== pack {i + 1} does not fit: {last} goes to pack {i + 2}")
        self._pack(i)

    def _finish(self, error: str | None) -> None:
        br = self.build_run
        br.error = error
        lines = []
        if error is None:
            for d in remove_stale_packs(self.w, len(br.packs)):
                lines.append(f"removed {d} (beyond the {len(br.packs)} packs)")
        lines += pack_summary(self.w, self.plan)
        names = lambda ids: ", ".join((self.plan.game(g).name if self.plan and self.plan.game(g) else g) for g in ids)  # noqa: E731
        if br.too_big:
            lines.append(f"in no pack (too big for a pack of its own): {names(br.too_big)}")
        if self.plan:
            out = [g for g in self.plan.games if g.left_out]
            if out:
                lines.append("left out: " + "; ".join(f"{g.name} ({g.reason or g.how})" for g in out))
        if error:
            lines.append(f"build failed: {error}")
        else:
            lines.append(f"built {len(br.packs)} pack{'s' if len(br.packs) != 1 else ''}: install a pack's fmzx.fwsc "
                         "as docs/install.md describes")
        self.summary = lines
        self.build_ok = error is None and not br.too_big
        self.build_run = None
        self.changed()
        self.flash("build done" if error is None else f"build failed: {error}")

    # -- text for --status

    def status_lines(self) -> list[str]:
        p = self.plan
        out = [f"workspace {self.w}"]
        if p is None:
            return out + ["no plan yet"]
        packed = p.packed()
        est = split_packs([(g.id, g.packed) for g in packed], p.room, p.overhead())
        out.append(f"room {kb(p.room)}; all games {kb(p.used)}; a build makes {len(est)} pack{'s' if len(est) != 1 else ''}")
        sd = self.sid_dir()
        out.append("SID collection: " + (str(sd) if sd else "none: given with --sid-dir" if self.args.sid_dir
                                         else "none (--offline)" if self.args.offline
                                         else f"downloaded to {hvsc_root()} on the first SID job"))
        ad = self.ay_dir()
        out.append("AY collection: " + (str(ad) if ad else "none: given with --ay-dir" if self.args.ay_dir
                                        else "none (--offline)" if self.args.offline
                                        else f"downloaded to {ay_root()} on the first AY job"))
        out.append("listening: " + ("music-preview" if self.tools.preview_ok()
                                    else "tools/arrange-music's renders (music-preview is not built)"))
        ch = self.choices()
        for g in p.games:
            out.append("")
            if g.left_out:
                out.append(f"{g.name} ({g.id})  left out: {g.reason or g.how}")
                continue
            ms = ["FM"] + [m.upper() for m in METHODS if m in self.marked(g.id)]
            out.append(f"{g.name} ({g.id})  {g.how}  {kb(g.packed)}  methods: {' '.join(ms)}")
            out.append(f"  {g.music}")
            groups = [(s, s.key) for s in g.scores] or [(None, WHOLE_GAME)]
            if not g.scores:
                out.append(f"  {g.plays()}")
            for s, key in groups:
                if s:
                    chosen = ch.get(f"{g.id}/{s.key}", 0)
                    out.append(f"  score {s.key}  {s.seconds:.1f} s{'  shadow' if s.shadow else ''}  "
                               f"plan: {s.status or '-'}  choice: {choice_label(chosen)}")
                else:
                    chosen = None
                for c in self.candidates(g, s):
                    how, path, note = self.route(g, key, c)
                    if how == "file":
                        play = f"plays {path.name if note != 'music-preview' else 'its preview'}"
                    else:
                        play = "plays a music-preview render" if how == "render" else note
                    mark = "*" if s and c.choice is not None and c.choice == chosen else " "
                    out.append(f"   {mark} {c.label:<26} {c.info}  [{play}]")
        out.append("")
        out.append("a build makes:")
        names = {g.id: g.name for g in packed}
        sizes = {g.id: g.packed for g in packed}
        for n, ids in enumerate(est, 1):
            out.append(f"  pack {n}: {', '.join(names[g] for g in ids)} ({kb(sum(sizes[g] for g in ids) + p.overhead())})")
        built = pack_summary(self.w, p)
        if built:
            out.append("built:")
            out += [f"  {ln}" for ln in built]
        return out


