def build_root() -> Path:
    return Path(os.environ.get("FMZX_BUILD") or ROOT / "build")


def apps() -> list[Path]:
    """The app images the packs go with: the release build's and the preview build's."""
    b = build_root()
    return [b / "fm1/platform/fm1/fmzx_app.bin", b / "fm1-preview/platform/fm1/fmzx_app.bin"]


def device_files() -> list[Path]:
    """What a build needs from the device builds: both app images and the boot loader."""
    return apps() + [build_root() / "fm1/third_party/felucca-loader/loader.bin"]


def die(msg: str) -> None:
    print(f"{PROG}: {msg}", file=sys.stderr)
    sys.exit(1)


def kb(n: int | float | None) -> str:
    return "-" if n is None else f"{n / 1024:.1f} KB"


