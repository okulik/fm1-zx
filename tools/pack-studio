def load_methods(w: Path) -> dict[str, set[str]]:
    doc = read_toml(w / "studio.toml")
    out = {}
    for gid, ms in doc.get("methods", {}).items():
        if isinstance(ms, list):
            out[str(gid)] = {m for m in ms if m in METHODS}
    return out


def load_packs(w: Path) -> dict[str, int]:
    """The pack each game is put in (1 to 9; a game not listed is in none)."""
    out = {}
    for gid, n in read_toml(w / "studio.toml").get("packs", {}).items():
        if isinstance(n, int) and not isinstance(n, bool) and 1 <= n <= PACKS_MAX:
            out[str(gid)] = n
    return out


def save_studio(w: Path, methods: dict[str, set[str]], packs: dict[str, int]) -> None:
    lines = ["# tools/pack-studio: the music methods marked per game (FM is always there)", "[methods]"]
    for gid in sorted(methods):
        ms = [m for m in METHODS if m in methods[gid]]
        if ms:
            lines.append(f"{json.dumps(gid)} = [{', '.join(json.dumps(m) for m in ms)}]")
    lines += ["", "# the pack each game goes in (1 to 9); a game not listed goes in none", "[packs]"]
    lines += [f"{json.dumps(gid)} = {packs[gid]}" for gid in sorted(packs) if 1 <= packs[gid] <= PACKS_MAX]
    w.mkdir(parents=True, exist_ok=True)
    tmp = w / "studio.toml.tmp"
    tmp.write_text("\n".join(lines) + "\n")
    tmp.replace(w / "studio.toml")


def save_methods(w: Path, methods: dict[str, set[str]]) -> None:
    save_studio(w, methods, load_packs(w))


def save_packs(w: Path, packs: dict[str, int]) -> None:
    save_studio(w, load_methods(w), packs)


# ---------------------------------------------------------------------------------------------
# The packs the owner fills: each game in pack 1 to 9 or in none (W/studio.toml [packs])


def fill_limit(plan: Plan) -> float:
    """The bytes of games a pack holds: the room minus the margin minus the pack's overhead (the
    split's limit)."""
    return plan.room * (1 - MARGIN) - plan.overhead()


def pack_fill(plan: Plan, packs: dict[str, int]) -> dict[int, list[Game]]:
    """The packed games in each pack that has any, in name order."""
    out: dict[int, list[Game]] = {}
    for g in plan.packed():
        n = packs.get(g.id)
        if n:
            out.setdefault(n, []).append(g)
    return dict(sorted(out.items()))


def unassigned(plan: Plan, packs: dict[str, int]) -> list[Game]:
    return [g for g in plan.packed() if not packs.get(g.id)]


def pack_total(games: list[Game]) -> int:
    return sum(g.packed or 0 for g in games)


def over_by(plan: Plan, packs: dict[str, int], gid: str, n: int) -> float:
    """How many bytes pack n would be over its limit with the game put in it (0: it fits)."""
    g = plan.game(gid)
    if g is None or g.left_out or n < 1:
        return 0
    total = sum(x.packed or 0 for x in plan.packed() if packs.get(x.id) == n and x.id != gid) + (g.packed or 0)
    return max(0.0, total - fill_limit(plan))


def auto_fill(plan: Plan, packs: dict[str, int]) -> tuple[dict[str, int], list[str]]:
    """Every packed game in no pack put in the first pack with room for it, in name order;
    returns the packs and the games that fit in none of the nine."""
    out = dict(packs)
    limit = fill_limit(plan)
    totals = {n: pack_total(gs) for n, gs in pack_fill(plan, out).items()}
    left = []
    for g in unassigned(plan, out):
        n = next((n for n in range(1, PACKS_MAX + 1) if totals.get(n, 0) + (g.packed or 0) <= limit), None)
        if n is None:
            left.append(g.id)
            continue
        out[g.id] = n
        totals[n] = totals.get(n, 0) + (g.packed or 0)
    return out, left


def packs_over(plan: Plan, packs: dict[str, int]) -> list[tuple[int, float]]:
    limit = fill_limit(plan)
    return [(n, pack_total(gs) - limit) for n, gs in pack_fill(plan, packs).items() if pack_total(gs) > limit]


def bar(frac: float, width: int, utf8: bool) -> str:
    full = max(0, min(width, round(frac * width)))
    return ("█" * full + "░" * (width - full)) if utf8 else ("#" * full + "." * (width - full))


def pack_lines(plan: Plan, packs: dict[str, int], width: int = 12, utf8: bool = False) -> list[tuple[int, str, bool]]:
    """The packs panel: (pack number, line, over) per pack with games, then (0, the games in no
    pack, False)."""
    limit = fill_limit(plan)
    out = []
    for n, gs in pack_fill(plan, packs).items():
        t = pack_total(gs)
        over = t > limit
        out.append((n, f"P{n} {t / 1024:6.1f}/{limit / 1024:.1f} KB {bar(t / limit if limit > 0 else 1, width, utf8)} "
                       f"{len(gs)} game{'s' if len(gs) != 1 else ''}" + (f"  {kb(t - limit)} over" if over else ""), over))
    un = unassigned(plan, packs)
    if not out:
        n = len(split_packs([(g.id, g.packed) for g in plan.packed()], plan.room, plan.overhead()))
        out.append((0, f"no game put in a pack: b builds the automatic split ({n} pack{'s' if n != 1 else ''}); "
                       "1-9 puts a game in a pack, f fills them", False))
    else:
        out.append((0, f"in no pack: {len(un)} game{'s' if len(un) != 1 else ''}, {kb(pack_total(un))}", False))
    return out


# ---------------------------------------------------------------------------------------------
# The learning's progress (fmzx-pack personal's lines on stderr) and the games list while it runs


PROGRESS_PLAN_RE = re.compile(r"^learning (\d+) games: (\d+) from the cache, (\d+) to learn, (\d+) at a time$")
PROGRESS_DONE_RE = re.compile(r"^(loaded|converted|learned) (\d+)/(\d+): (.+)$")
PROGRESS_START_RE = re.compile(r"^(loading|converting|learning): (.+)$")
GAME_EXTS = (".sna", ".z80", ".tap", ".tzx")


def parse_progress(line: str) -> tuple | None:
    """A progress line as ("plan", games, from cache, to learn, at a time), ("done", verb, k, n,
    rest) or ("start", verb, name); None for any other line."""
    s = line.strip()
    if m := PROGRESS_PLAN_RE.match(s):
        return ("plan",) + tuple(int(x) for x in m.groups())
    if m := PROGRESS_DONE_RE.match(s):
        return ("done", m[1], int(m[2]), int(m[3]), m[4])
    if m := PROGRESS_START_RE.match(s):
        return ("start", m[1], m[2])
    return None


@dataclass
class LiveRow:
    name: str
    base: str  # the game file's name
    gid: str | None = None  # from the games file
    state: str = "waiting"  # waiting, converting, converted, learning, learned, cached, left out
    how: str = ""  # how it went in, or why it was left out
    seconds: float | None = None
    since: float = 0.0  # when its learning started
    size: int | None = None  # its converted file's bytes (approximate: before packing)


def rows_from_folder(folder: Path) -> list[LiveRow]:
    try:
        files = [p for p in folder.iterdir() if p.suffix.lower() in GAME_EXTS and not p.name.startswith(".") and p.is_file()]
    except OSError:
        files = []
    return sorted((LiveRow(p.stem, p.name) for p in files), key=lambda r: (r.name.casefold(), r.base))


def rows_from_games_file(text: str) -> list[LiveRow]:
    try:
        games = tomllib.loads(text).get("game", [])
    except tomllib.TOMLDecodeError:
        return []
    rows = [LiveRow(str(g.get("name", g.get("id", "?"))), PurePosixPath(str(g.get("file", ""))).name, str(g.get("id", "")))
            for g in games if isinstance(g, dict)]
    return sorted(rows, key=lambda r: (r.name.casefold(), r.gid or ""))


def fmt_left(seconds: float) -> str:
    if seconds < 60:
        return "under a minute"
    if seconds < 90 * 60:
        return f"about {round(seconds / 60)} min"
    return f"about {seconds / 3600:.1f} h"


class Live:
    """The games list while fmzx-pack personal runs: a row per game, its state from the progress
    lines (apply), the header (header). Fed from the job's thread, read by the screen's."""

    def __init__(self, rows: list[LiveRow]):
        self.lock = threading.Lock()
        self.rows = rows
        self.phase = "start"  # start, loading, converting, learning, done, failed
        self.k = 0
        self.n = 0
        self.to_learn: int | None = None
        self.threads = 1

    def set_rows(self, rows: list[LiveRow]) -> None:
        """New rows (the games file written), each keeping the state of the row of its file (or
        of its name, a row a progress line made); an old row with no new one stays when left out."""
        with self.lock:
            old = list(self.rows)
            for r in rows:
                o = next((o for o in old if o.base == r.base), None) or next((o for o in old if o.name == r.name), None)
                if o:
                    old.remove(o)
                    r.state, r.how, r.seconds, r.since, r.size = o.state, o.how, o.seconds, o.since, r.size or o.size
            self.rows = rows + [o for o in old if o.state == "left out"]

    def _find(self, rest: str, done: bool) -> tuple[LiveRow, str]:
        best, state, best_len = None, "", -1
        for r in self.rows:
            for key in (r.name, r.base):
                if not key:
                    continue
                hit = rest.startswith(key + " (") and rest.endswith(")") if done else rest == key
                if hit and (len(key) > best_len or (len(key) == best_len and best.state in ("learned", "cached", "left out"))):
                    best, best_len = r, len(key)
                    state = rest[len(key) + 2:-1] if done else ""
        if best is None:
            if done and " (" in rest and rest.endswith(")"):
                name, state = rest[:-1].rsplit(" (", 1)
            else:
                name = rest
            best = LiveRow(name, name)
            self.rows.append(best)
        return best, state

    def apply(self, line: str, now: float | None = None) -> bool:
        """Takes a line of the job's output; True when it was a progress line."""
        p = parse_progress(line)
        if p is None:
            return False
        now = time.monotonic() if now is None else now
        with self.lock:
            if p[0] == "plan":
                self.phase, self.n, self.k, self.to_learn, self.threads = "learning", p[1], 0, p[3], max(1, p[4])
            elif p[0] == "start":
                r, _ = self._find(p[2], False)
                if p[1] == "learning":
                    r.state, r.since = "learning", now
                else:
                    r.state = "converting"
                    self.phase = "loading" if p[1] == "loading" else "converting"
            else:
                _, verb, k, n, rest = p
                r, state = self._find(rest, True)
                self.k, self.n = k, n
                if verb == "learned":
                    self.phase = "learning"
                    if state == "cached":
                        r.state = "cached"
                    else:
                        r.state = "learned"
                        with contextlib.suppress(ValueError):
                            r.seconds = float(state.split()[0])
                else:
                    self.phase = "loading" if verb == "loaded" else "converting"
                    if state.startswith("left out: "):
                        r.state, r.how = "left out", state[len("left out: "):]
                    else:
                        r.state, r.how = "converted", state
        return True

    def estimate(self, now: float) -> float | None:
        """Seconds the learning has left: the games still to learn, at the average time of the
        ones learned (not from the cache), so many at a time; None before one is learned."""
        secs = [r.seconds for r in self.rows if r.state == "learned" and r.seconds is not None]
        if self.to_learn is None or not secs:
            return None
        avg = sum(secs) / len(secs)
        left = self.to_learn - len(secs)
        if left <= 0:
            return 0.0
        busy = [r for r in self.rows if r.state == "learning"]
        work = sum(max(avg * 0.1, avg - (now - r.since)) for r in busy) + max(0, left - len(busy)) * avg
        return work / max(1, min(self.threads, left))

    def header(self, now: float | None = None, dash: str = "-") -> str:
        now = time.monotonic() if now is None else now
        with self.lock:
            if self.phase == "loading":
                return "loading the new game files" + (f": {self.k} of {self.n}" if self.n else "")
            if self.phase == "converting":
                return f"converting {self.k} of {self.n} games" if self.n else "converting the games"
            if self.phase == "learning":
                head = f"learning {self.k} of {self.n} games"
                est = self.estimate(now)
                if est is not None:
                    return head + (f" {dash} {fmt_left(est)} left" if est > 0 else f" {dash} finishing")
                if self.to_learn:
                    return head + f" {dash} {self.to_learn} not learned before: timing the first"
                return head
            if self.phase == "failed":
                return "the learning failed (l: the log)"
            return ""

    def snapshot(self) -> list[LiveRow]:
        with self.lock:
            return [LiveRow(**vars(r)) for r in self.rows]


def live_state(r: LiveRow, now: float) -> tuple[str, str]:
    """A live row's state text and its kind (for its colour): waiting, run, ok, cached, out."""
    if r.state == "converting":
        return "converting...", "run"
    if r.state == "learning":
        t = int(now - r.since) if r.since else 0
        return f"learning... {t // 60}:{t % 60:02d}", "run"
    if r.state == "learned":
        return (f"learned ({r.seconds:.1f} s)" if r.seconds is not None else "learned"), "ok"
    if r.state == "cached":
        return "learned (cached)", "cached"
    if r.state == "left out":
        return f"left out: {r.how}", "out"
    return "waiting", "waiting"


# ---------------------------------------------------------------------------------------------
# Earlier learning: the sound caches of other personal packs under build/


CACHE_FILE_RE = re.compile(r"^[0-9a-f]{8}-[A-Za-z0-9._-]+\.bin$")  # fmzx-pack's <crc>-<version>.bin
REUSE_SKIP = {"sound-cache", "arrange", "converted", "previews", "hvsc", "ay", "node_modules", "CMakeFiles"}


def reuse_root() -> Path | None:
    v = os.environ.get("FMZX_REUSE_FROM")
    if v is not None:
        return Path(v) if v else None
    return ROOT / "build"


def earlier_caches(search: Path, exclude: Path, depth: int = 4) -> list[Path]:
    """The sound-cache folders (not links) under search, at most depth folders down, of a personal
    pack's folder (beside a personal-games.toml or a converted/manifest.toml), none inside exclude."""
    out = []
    try:
        ex = exclude.resolve()
    except OSError:
        ex = exclude
    base = len(search.parts)
    for dp, dns, _ in os.walk(search):
        d = Path(dp)
        sc = d / "sound-cache"
        if "sound-cache" in dns and not sc.is_symlink() and sc.is_dir() \
                and ((d / "personal-games.toml").is_file() or (d / "converted" / "manifest.toml").is_file()):
            r = sc.resolve()
            if r != ex and ex not in r.parents:
                out.append(sc)
        dns[:] = sorted(x for x in dns if len(d.parts) - base < depth and not x.startswith(".") and x not in REUSE_SKIP
                        and not (d / x).is_symlink())
    return out


def reuse_caches(search: Path, dest: Path, exclude: Path) -> list[tuple[Path, int]]:
    """Copies the cache files dest lacks from earlier_caches(search, exclude) into dest (never
    one dest has); returns (the folder, files copied) per folder that gave any. A cache file
    names its game by content (fmzx-pack: the converted file's CRC, its key script and overrides,
    and the learner's version), so a copy is the same game's music."""
    dest.mkdir(parents=True, exist_ok=True)
    have = {p.name for p in dest.iterdir()}
    out = []
    for sc in earlier_caches(search, exclude):
        n = 0
        for f in sorted(sc.iterdir()):
            if not CACHE_FILE_RE.match(f.name) or f.name in have or f.is_symlink() or not f.is_file():
                continue
            tmp, target = dest / f".{f.name}.reuse", dest / f.name
            try:
                shutil.copyfile(f, tmp)
                try:
                    os.link(tmp, target)  # fails when it is there: never overwritten
                except FileExistsError:
                    continue
                except OSError:  # no hard links there
                    if target.exists():
                        continue
                    os.replace(tmp, target)
            except OSError:
                continue
            finally:
                tmp.unlink(missing_ok=True)
            have.add(f.name)
            n += 1
        if n:
            out.append((sc.parent, n))
    return out


def shown_path(p: Path) -> str:
    try:
        return str(p.relative_to(ROOT))
    except ValueError:
        return str(p)


# ---------------------------------------------------------------------------------------------
# The split and the pack folders


def split_packs(games: list[tuple[str, int]], room: int, overhead: int = 0, margin: float = MARGIN) -> list[list[str]]:
    """Games (id, packed bytes) in order into packs: each filled while its total stays within
    room minus the margin minus the overhead. A game bigger than that gets a pack of its own."""
    limit = room * (1 - margin) - overhead
    packs: list[list[str]] = []
    cur: list[str] = []
    total = 0
    for gid, size in games:
        if cur and total + size > limit:
            packs.append(cur)
            cur, total = [], 0
        cur.append(gid)
        total += size
    if cur:
        packs.append(cur)
    return packs


GAME_RE = re.compile(r"^[ \t]*\[\[[ \t]*game[ \t]*\]\][ \t]*(#.*)?\r?\n?$")
COMMENTED_GAME_RE = re.compile(r"^[ \t]*#[ \t#]*\[\[[ \t]*game[ \t]*\]\]")


def _comment(line: str) -> bool:
    return line.lstrip().startswith("#")


def split_games_file(text: str) -> tuple[str, list[tuple[str, str]]]:
    """A personal games file as (its header comment, [(id, entry text)]): each entry from its
    [[game]] line to its last line (its [game.*] tables and the comment lines right after them
    included; blank lines, a commented-out game or a "# missing:" line below it are not)."""
    lines = text.splitlines(keepends=True)
    starts = [i for i, ln in enumerate(lines) if GAME_RE.match(ln)]
    header = []
    for ln in lines[:starts[0] if starts else len(lines)]:
        if not ln.strip() or not _comment(ln):
            break
        header.append(ln)
    entries = []
    for k, s in enumerate(starts):
        chunk = lines[s:starts[k + 1] if k + 1 < len(starts) else len(lines)]
        last = max(i for i, ln in enumerate(chunk) if i == 0 or (ln.strip() and not _comment(ln)))
        end = last + 1
        while end < len(chunk) and chunk[end].strip() and _comment(chunk[end]) \
                and not COMMENTED_GAME_RE.match(chunk[end]) and not chunk[end].lstrip().startswith("# missing:"):
            end += 1
        body = "".join(chunk[:end])
        if not body.endswith("\n"):
            body += "\n"
        try:
            doc = tomllib.loads(body)
            gid = str(doc["game"][0]["id"])
        except (tomllib.TOMLDecodeError, KeyError, IndexError, TypeError) as e:
            raise ValueError(f"the games file's entry at line {s + 1} does not read: {e}") from None
        entries.append((gid, body))
    return "".join(header), entries


def absolute_file(entry: str, base: Path) -> str:
    """The entry with a relative `file` made absolute from base (the games file's folder)."""
    f = tomllib.loads(entry)["game"][0].get("file")
    if not isinstance(f, str) or Path(f).is_absolute():
        return entry
    lines = entry.splitlines(keepends=True)
    for i, ln in enumerate(lines[1:], 1):
        if ln.lstrip().startswith("["):
            break
        if re.match(r"^[ \t]*file[ \t]*=", ln):
            lines[i] = f"file = {json.dumps(str((base / f).resolve()))}\n"
            break
    return "".join(lines)


def subset_games_file(text: str, ids: list[str], base: Path, note: str) -> str:
    header, entries = split_games_file(text)
    by = dict(entries)
    missing = [g for g in ids if g not in by]
    if missing:
        raise ValueError(f"no entry for {', '.join(missing)} in the games file")
    out = header + "".join(f"# {ln}\n" for ln in note.splitlines()) + "\n"
    return out + "\n".join(absolute_file(by[g], base) for g in ids)


def is_studio_pack(d: Path) -> bool:
    return (d / MARKER).is_file()


def write_pack_folder(w: Path, n: int, ids: list[str], text: str) -> Path:
    """W/pack-<n>/: the marker, the games file and the two links into W/all."""
    d = w / f"pack-{n}"
    if d.exists() and any(d.iterdir()) and not is_studio_pack(d):
        raise ValueError(f"{d} is not the studio's (no {MARKER}): move it away")
    d.mkdir(parents=True, exist_ok=True)
    (d / MARKER).write_text(json.dumps({"games": ids}) + "\n")
    (d / "personal-games.toml").write_text(text)
    for name in ("sound-cache", "arrange"):
        (w / "all" / name).mkdir(parents=True, exist_ok=True)
        link = d / name
        target = Path("..") / "all" / name
        if link.is_symlink():
            if Path(os.readlink(link)) == target:
                continue
            link.unlink()
        elif link.is_dir():
            shutil.rmtree(link)
        elif link.exists():
            link.unlink()
        link.symlink_to(target, target_is_directory=True)
    return d


def pack_folders(w: Path) -> list[tuple[int, Path]]:
    out = []
    for d in w.glob("pack-*"):
        n = d.name[5:]
        if n.isdigit() and d.is_dir():
            out.append((int(n), d))
    return sorted(out)


def remove_stale_packs(w: Path, keep: set[int]) -> list[Path]:
    """Removes the W/pack-<m> the studio made that are not among keep; returns them."""
    gone = []
    for n, d in pack_folders(w):
        if n not in keep and is_studio_pack(d):
            shutil.rmtree(d)  # the links inside are removed, not followed
            gone.append(d)
    return gone


def pack_summary(w: Path, plan: Plan | None) -> list[str]:
    """The packs on disk the studio made: each pack's games and its fmzx.fwsc."""
    out = []
    for n, d in pack_folders(w):
        if not is_studio_pack(d):
            continue
        try:
            ids = json.loads((d / MARKER).read_text()).get("games", [])
        except (OSError, ValueError):
            ids = []
        games = [plan.game(g) if plan else None for g in ids]
        names = [g.name if g else gid for g, gid in zip(games, ids)]
        size = sum((g.packed or 0) for g in games if g) if plan else None
        fw = d / "fmzx.fwsc"
        where = str(fw) if fw.is_file() else f"{fw} (not built)"
        out.append(f"pack {n}: {len(ids)} game{'s' if len(ids) != 1 else ''}" + (f", {kb(size)}" if size else "") + f": {where}")
        out.append(f"  {', '.join(names) or '-'}")
    return out


# ---------------------------------------------------------------------------------------------
# The SID collection


def member_ok(name: str) -> bool:
    """An archive member's path that stays inside the folder it is unpacked into."""
    if not name or "\0" in name or "\\" in name or name.startswith("/") or re.match(r"^[A-Za-z]:", name):
        return False
    return ".." not in PurePosixPath(name).parts


@dataclass
class Member:
    name: str
    kind: str  # "file", "dir", "link" (a symbolic or hard link) or "other" (a device, a fifo)
    size: int


def archive_tool() -> tuple[str, str] | None:
    """("bsdtar", path) for bsdtar (libarchive; macOS's tar), else ("7z", path) for 7-Zip; None
    when neither is installed."""
    tar = shutil.which("bsdtar")
    if not tar and shutil.which("tar"):
        with contextlib.suppress(OSError, subprocess.SubprocessError):
            if "bsdtar" in subprocess.run(["tar", "--version"], capture_output=True, text=True, timeout=10).stdout:
                tar = shutil.which("tar")
    if tar:
        return "bsdtar", tar
    for exe in ("7zz", "7z", "7za"):
        if shutil.which(exe):
            return "7z", shutil.which(exe)
    return None


NO_ARCHIVE_TOOL = "unpacking a .7z needs bsdtar (libarchive) or 7-Zip (7zz, 7z or 7za): install one and try again"
BSDTAR_LINE = re.compile(r"^(?P<mode>\S{10})\s+\d+\s+\S+\s+\S+\s+(?P<size>\d+)\s")


def parse_bsdtar_listing(names: str, verbose: str) -> list[Member]:
    """bsdtar's member list: names from tar -tf (one a line, exactly), kind and size from the
    same lines of tar -tvf (the mode's first letter: - a file, d a folder, l, h a link, others a
    device or a fifo; a hard link also says "link to"). A listing that does not read is an
    error."""
    ns = names.splitlines()
    vs = verbose.splitlines()
    if len(ns) != len(vs):
        raise ValueError(f"the listings do not agree ({len(ns)} names, {len(vs)} verbose lines)")
    out = []
    for n, v in zip(ns, vs):
        m = BSDTAR_LINE.match(v)
        if not m:
            raise ValueError(f"a listing line does not read: {v!r}")
        c = m["mode"][0]
        kind = ("link" if c in "lh" or " link to " in v else "file") if c in "-lh" else "dir" if c == "d" else "other"
        out.append(Member(n, kind, int(m["size"])))
    return out


def parse_7z_listing(text: str) -> list[Member]:
    """7-Zip's member list (7z l -slt): the blocks after the "----------" line, one a member,
    "Path = ", "Size = ", "Folder = +" for a folder, "Attributes = " (its Unix mode, when there,
    gives the kind as for bsdtar) and "Symbolic Link = " or "Hard Link = " for a link."""
    lines = text.splitlines()
    try:
        lines = lines[lines.index("----------") + 1:]
    except ValueError:
        raise ValueError("no member list in 7-Zip's listing") from None
    blocks, cur = [], {}
    for ln in lines + [""]:
        if not ln.strip():
            if cur:
                blocks.append(cur)
            cur = {}
            continue
        k, sep, v = ln.partition(" = ")
        if not sep:
            k, v = ln.rstrip(" ="), ""
        cur[k.strip()] = v
    out = []
    for blk in blocks:
        if "Path" not in blk:
            raise ValueError(f"a member without a path in 7-Zip's listing: {blk}")
        mode = next((t for t in blk.get("Attributes", "").split() if len(t) == 10 and t[0] in "-dlbcps"), "")
        if blk.get("Symbolic Link") or blk.get("Hard Link") or mode[:1] == "l":
            kind = "link"
        elif mode[:1] in ("b", "c", "p", "s"):
            kind = "other"
        elif blk.get("Folder") == "+" or mode[:1] == "d" or "D" in blk.get("Attributes", "").split(" ")[0]:
            kind = "dir"
        else:
            kind = "file"
        size = blk.get("Size", "").strip()
        out.append(Member(blk["Path"], kind, int(size) if size.isdigit() else 0))
    return out


def check_members(name: str, members: list[Member], max_bytes: int) -> None:
    """Refuses the whole archive when a member's path would land outside its folder, a member is
    a link or a device, or it unpacks to more than max_bytes."""
    for m in members:
        if not member_ok(m.name):
            raise ValueError(f"refused {name}: the member {m.name!r} would land outside its folder")
        if m.kind == "link":
            raise ValueError(f"refused {name}: the member {m.name!r} is a link")
        if m.kind == "other":
            raise ValueError(f"refused {name}: the member {m.name!r} is a device")
    total = sum(m.size for m in members)
    if total > max_bytes:
        raise ValueError(f"refused {name}: it unpacks to {total} bytes")


def list_members(archive: Path, tool: tuple[str, str]) -> list[Member]:
    def run(argv: list[str]) -> str:
        r = subprocess.run(argv, stdin=subprocess.DEVNULL, capture_output=True, text=True, errors="replace")
        if r.returncode != 0:
            raise ValueError(f"{Path(argv[0]).name} could not list {archive.name}: {(r.stderr or r.stdout).strip()[-300:]}")
        return r.stdout
    kind, exe = tool
    if kind == "bsdtar":
        return parse_bsdtar_listing(run([exe, "-t", "-f", str(archive)]), run([exe, "-t", "-v", "-f", str(archive)]))
    return parse_7z_listing(run([exe, "l", "-slt", str(archive)]))


def safe_extract_7z(archive: Path, dest: Path, max_bytes: int = UNPACK_MAX) -> str:
    """Unpacks an untrusted .7z into dest (replacing it), through a temporary folder beside it,
    with bsdtar or else 7-Zip: their member list first (check_members refuses the whole
    archive), then the unpacking; then removes any link and checks every path stays inside.
    Nothing in it is run. Returns the tool's name."""
    tool = archive_tool()
    if tool is None:
        raise ValueError(NO_ARCHIVE_TOOL)
    check_members(archive.name, list_members(archive, tool), max_bytes)
    tmp = dest.parent / f".{dest.name}.tmp"
    shutil.rmtree(tmp, ignore_errors=True)
    tmp.mkdir(parents=True)
    try:
        kind, exe = tool
        argv = [exe, "-x", "-f", str(archive), "-C", str(tmp)] if kind == "bsdtar" else [exe, "x", "-y", "-bd", f"-o{tmp}", str(archive)]
        r = subprocess.run(argv, stdin=subprocess.DEVNULL, capture_output=True, text=True, errors="replace")
        if r.returncode != 0:
            raise ValueError(f"{Path(exe).name} could not unpack {archive.name}: {(r.stderr or r.stdout).strip()[-300:]}")
        root = tmp.resolve()
        for p in sorted(tmp.rglob("*"), reverse=True):
            if p.is_symlink():
                p.unlink()
            elif not p.resolve().is_relative_to(root):
                raise ValueError(f"refused {archive.name}: {p} is outside its folder")
        shutil.rmtree(dest, ignore_errors=True)
        tmp.replace(dest)
        return Path(exe).name
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def find_collection(d: Path) -> Path | None:
    """The folder holding DOCUMENTS/STIL.txt: d or up to three folders below it, the shallowest
    (hidden folders skipped)."""
    if not d.is_dir():
        return None
    for depth in range(4):
        found = [p for p in sorted(d.glob("/".join(["*"] * depth + ["DOCUMENTS", "STIL.txt"])))
                 if not any(part.startswith(".") for part in p.relative_to(d).parts)]
        if found:
            return found[0].parent.parent
    return None


def downloaded_collection(root: Path) -> Path | None:
    """The newest collection under build/hvsc/<version>/."""
    if not root.is_dir():
        return None
    versions = sorted((p for p in root.iterdir() if p.is_dir() and p.name.isdigit()), key=lambda p: -int(p.name))
    for v in versions:
        c = find_collection(v)
        if c:
            return c
    return None


def url_ok(url: str) -> bool:
    u = urllib.parse.urlparse(url)
    return u.scheme == "https" or (u.scheme == "http" and u.hostname in ("127.0.0.1", "localhost"))


def fetch_hvsc(root: Path, progress: Callable[[str], None], log: Callable[[str], None], api: str | None = None) -> Path:
    """Downloads and unpacks the collection into root/<version>/; returns the collection folder."""
    api = api or os.environ.get("FMZX_HVSC_API") or HVSC_API
    if archive_tool() is None:
        raise ValueError(NO_ARCHIVE_TOOL)
    if not url_ok(api):
        raise ValueError(f"not an https address: {api}")
    headers = {"User-Agent": "pack-studio"}
    with urllib.request.urlopen(urllib.request.Request(api, headers=headers), timeout=30) as r:
        info = json.loads(r.read(1 << 20))
    version = int(info["version"])
    url = str(info["complete"]["url"])
    if not url_ok(url):
        raise ValueError(f"not an https address: {url}")
    dest = root / str(version)
    have = find_collection(dest)
    if have:
        return have
    root.mkdir(parents=True, exist_ok=True)
    archive = root / f"HVSC_{version}.7z"
    if not archive.is_file():
        part = root / f"HVSC_{version}.7z.part"
        log(f"downloading {url}")
        with urllib.request.urlopen(urllib.request.Request(url, headers=headers), timeout=60) as r, part.open("wb") as f:
            total = int(r.headers.get("Content-Length") or 0)
            got = 0
            last = 0.0
            while True:
                b = r.read(1 << 20)
                if not b:
                    break
                f.write(b)
                got += len(b)
                if time.monotonic() - last > 0.3:
                    last = time.monotonic()
                    progress(f"downloading the SID collection (HVSC {version}): {got / 1e6:.1f}"
                             + (f" of {total / 1e6:.1f} MB" if total else " MB"))
        if total and got != total:
            raise ValueError(f"the download stopped at {got} of {total} bytes")
        part.replace(archive)
        log(f"downloaded {archive} ({got} bytes)")
    progress(f"unpacking the SID collection (HVSC {version})")
    log(f"unpacked with {safe_extract_7z(archive, dest)}")
    archive.unlink()
    c = find_collection(dest)
    if c is None:
        raise ValueError(f"no DOCUMENTS/STIL.txt in {dest}")
    log(f"the SID collection: {c}")
    return c


# ---------------------------------------------------------------------------------------------
# The AY collection (chris-y/AY on GitHub: Spectrum AY music, music/ay/games/ and music/ay/misc/)


def find_ay_collection(d: Path) -> Path | None:
    """The .ay collection in d: d/music/ay (a downloaded or cloned collection), else d itself
    when it holds .ay files (in it or in folders below)."""
    if not d.is_dir():
        return None
    if (d / "music" / "ay").is_dir():
        return d / "music" / "ay"
    return d if next(d.rglob("*.ay"), None) else None


def downloaded_ay(root: Path) -> Path | None:
    """The newest collection under build/ay/<commit>/."""
    if not root.is_dir():
        return None
    for v in sorted((p for p in root.iterdir() if p.is_dir() and re.fullmatch(r"[0-9a-f]{12}", p.name)),
                    key=lambda p: -p.stat().st_mtime):
        if (v / "music" / "ay").is_dir():
            return v / "music" / "ay"
    return None


def safe_extract_ay(archive: Path, dest: Path, max_bytes: int = UNPACK_MAX) -> int:
    """Unpacks the music/ay folder of an untrusted .tar.gz of the collection (<top>/music/ay/...)
    into dest/music/ay (replacing dest), through a temporary folder beside it, reading the
    archive as a stream: a member whose path is absolute or holds "..", or one under music/ay
    that is a link or a device, refuses the whole archive, as does more than max_bytes; other
    members (screenshots, the rest of the repository) are skipped. Nothing in it is run. Returns
    the files unpacked."""
    import tarfile

    tmp = dest.parent / f".{dest.name}.tmp"
    shutil.rmtree(tmp, ignore_errors=True)
    tmp.mkdir(parents=True)
    try:
        total = files = 0
        with tarfile.open(archive, "r|gz") as tf:
            for m in tf:
                if not member_ok(m.name):
                    raise ValueError(f"refused {archive.name}: the member {m.name!r} would land outside its folder")
                parts = PurePosixPath(m.name).parts
                if len(parts) < 3 or parts[1:3] != ("music", "ay"):
                    continue
                if not (m.isfile() or m.isdir()):
                    raise ValueError(f"refused {archive.name}: the member {m.name!r} is a link or a device")
                out = tmp.joinpath(*parts[1:])
                if m.isdir():
                    out.mkdir(parents=True, exist_ok=True)
                    continue
                total += m.size
                if total > max_bytes:
                    raise ValueError(f"refused {archive.name}: it unpacks to more than {max_bytes} bytes")
                out.parent.mkdir(parents=True, exist_ok=True)
                src = tf.extractfile(m)
                with out.open("wb") as f:
                    shutil.copyfileobj(src, f)
                files += 1
        root = tmp.resolve()
        for p in tmp.rglob("*"):
            if p.is_symlink() or not p.resolve().is_relative_to(root):
                raise ValueError(f"refused {archive.name}: {p} is outside its folder")
        if not (tmp / "music" / "ay").is_dir():
            raise ValueError(f"no music/ay folder in {archive.name}")
        shutil.rmtree(dest, ignore_errors=True)
        tmp.replace(dest)
        return files
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def fetch_ay(root: Path, progress: Callable[[str], None], log: Callable[[str], None], api: str | None = None,
             tarball: str | None = None) -> Path:
    """Downloads the collection's newest commit and unpacks its music/ay into root/<commit, 12
    digits>/; returns the collection folder (music/ay)."""
    api = api or os.environ.get("FMZX_AY_API") or AY_API
    tarball = tarball or os.environ.get("FMZX_AY_TARBALL") or AY_TARBALL
    if not url_ok(api):
        raise ValueError(f"not an https address: {api}")
    headers = {"User-Agent": "pack-studio", "Accept": "application/vnd.github+json"}
    with urllib.request.urlopen(urllib.request.Request(api, headers=headers), timeout=30) as r:
        sha = str(json.loads(r.read(4 << 20)).get("sha", ""))
    if not re.fullmatch(r"[0-9a-f]{40}", sha):
        raise ValueError(f"{api}: no commit in the answer")
    dest = root / sha[:12]
    if (dest / "music" / "ay").is_dir():
        return dest / "music" / "ay"
    url = tarball.format(sha=sha)
    if not url_ok(url):
        raise ValueError(f"not an https address: {url}")
    root.mkdir(parents=True, exist_ok=True)
    archive = root / f"AY-{sha[:12]}.tar.gz"
    part = root / f"AY-{sha[:12]}.tar.gz.part"
    log(f"downloading {url}")
    with urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "pack-studio"}), timeout=60) as r, \
            part.open("wb") as f:
        total = int(r.headers.get("Content-Length") or 0)
        got = 0
        last = 0.0
        while True:
            b = r.read(1 << 20)
            if not b:
                break
            f.write(b)
            got += len(b)
            if time.monotonic() - last > 0.3:
                last = time.monotonic()
                progress(f"downloading the AY collection ({sha[:12]}): {got / 1e6:.1f}"
                         + (f" of {total / 1e6:.1f} MB" if total else " MB"))
    if total and got != total:
        part.unlink(missing_ok=True)
        raise ValueError(f"the download stopped at {got} of {total} bytes")
    part.replace(archive)
    log(f"downloaded {archive} ({got} bytes)")
    progress(f"unpacking the AY collection ({sha[:12]})")
    try:
        n = safe_extract_ay(archive, dest)
    finally:
        archive.unlink(missing_ok=True)
    c = dest / "music" / "ay"
    log(f"the AY collection: {c} ({n} files)")
    return c


