        s = buf.getvalue()
        check(rc == 0 and (w / "all" / "plan.json").is_file(), "--status: learned (plan.json)")
        check("Alpha (alpha)" in s and "score 8951-1a2b3c4d" in s and "FM (from code/memory)" in s
              and "choice: original" in s, "--status: the scored game, its score, FM, its choice")
        check("bravo (bravo)" in s and "nothing to arrange: FM from code" in s, "--status: FM from code without scores")
        check("Charlie (charlie)" in s and "\n  beeper\n" in s, "--status: beeper without a score or a routine")
        check("Delta (delta)  left out: 128K" in s, "--status: the game left out, with why")
        check("a build makes 2 packs" in s and "pack 1: Alpha, bravo" in s and "pack 2: Charlie" in s,
