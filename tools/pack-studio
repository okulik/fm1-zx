# The SID collection


def member_ok(name: str) -> bool:
    """An archive member's path that stays inside the folder it is unpacked into."""
    if not name or "\0" in name or "\\" in name or name.startswith("/") or re.match(r"^[A-Za-z]:", name):
        return False
    return ".." not in PurePosixPath(name).parts


@dataclass
class Member:
    name: str
    kind: str  # "file", "dir", "link" (a symbolic or hard link) or "other" (a device, a fifo)
    size: int


def archive_tool() -> tuple[str, str] | None:
    """("bsdtar", path) for bsdtar (libarchive; macOS's tar), else ("7z", path) for 7-Zip; None
    when neither is installed."""
    tar = shutil.which("bsdtar")
    if not tar and shutil.which("tar"):
        with contextlib.suppress(OSError, subprocess.SubprocessError):
            if "bsdtar" in subprocess.run(["tar", "--version"], capture_output=True, text=True, timeout=10).stdout:
                tar = shutil.which("tar")
    if tar:
        return "bsdtar", tar
    for exe in ("7zz", "7z", "7za"):
        if shutil.which(exe):
            return "7z", shutil.which(exe)
    return None


NO_ARCHIVE_TOOL = "unpacking a .7z needs bsdtar (libarchive) or 7-Zip (7zz, 7z or 7za): install one and try again"
BSDTAR_LINE = re.compile(r"^(?P<mode>\S{10})\s+\d+\s+\S+\s+\S+\s+(?P<size>\d+)\s")


def parse_bsdtar_listing(names: str, verbose: str) -> list[Member]:
    """bsdtar's member list: names from tar -tf (one a line, exactly), kind and size from the
    same lines of tar -tvf (the mode's first letter: - a file, d a folder, l, h a link, others a
    device or a fifo; a hard link also says "link to"). A listing that does not read is an
    error."""
    ns = names.splitlines()
    vs = verbose.splitlines()
    if len(ns) != len(vs):
        raise ValueError(f"the listings do not agree ({len(ns)} names, {len(vs)} verbose lines)")
    out = []
    for n, v in zip(ns, vs):
        m = BSDTAR_LINE.match(v)
        if not m:
            raise ValueError(f"a listing line does not read: {v!r}")
        c = m["mode"][0]
        kind = ("link" if c in "lh" or " link to " in v else "file") if c in "-lh" else "dir" if c == "d" else "other"
        out.append(Member(n, kind, int(m["size"])))
    return out


def parse_7z_listing(text: str) -> list[Member]:
    """7-Zip's member list (7z l -slt): the blocks after the "----------" line, one a member,
    "Path = ", "Size = ", "Folder = +" for a folder, "Attributes = " (its Unix mode, when there,
    gives the kind as for bsdtar) and "Symbolic Link = " or "Hard Link = " for a link."""
    lines = text.splitlines()
    try:
        lines = lines[lines.index("----------") + 1:]
    except ValueError:
        raise ValueError("no member list in 7-Zip's listing") from None
    blocks, cur = [], {}
    for ln in lines + [""]:
        if not ln.strip():
            if cur:
                blocks.append(cur)
            cur = {}
            continue
        k, sep, v = ln.partition(" = ")
        if not sep:
            k, v = ln.rstrip(" ="), ""
        cur[k.strip()] = v
    out = []
    for blk in blocks:
        if "Path" not in blk:
            raise ValueError(f"a member without a path in 7-Zip's listing: {blk}")
        mode = next((t for t in blk.get("Attributes", "").split() if len(t) == 10 and t[0] in "-dlbcps"), "")
        if blk.get("Symbolic Link") or blk.get("Hard Link") or mode[:1] == "l":
            kind = "link"
        elif mode[:1] in ("b", "c", "p", "s"):
            kind = "other"
        elif blk.get("Folder") == "+" or mode[:1] == "d" or "D" in blk.get("Attributes", "").split(" ")[0]:
            kind = "dir"
        else:
            kind = "file"
        size = blk.get("Size", "").strip()
        out.append(Member(blk["Path"], kind, int(size) if size.isdigit() else 0))
    return out


def check_members(name: str, members: list[Member], max_bytes: int) -> None:
    """Refuses the whole archive when a member's path would land outside its folder, a member is
    a link or a device, or it unpacks to more than max_bytes."""
    for m in members:
        if not member_ok(m.name):
            raise ValueError(f"refused {name}: the member {m.name!r} would land outside its folder")
        if m.kind == "link":
            raise ValueError(f"refused {name}: the member {m.name!r} is a link")
        if m.kind == "other":
            raise ValueError(f"refused {name}: the member {m.name!r} is a device")
    total = sum(m.size for m in members)
    if total > max_bytes:
        raise ValueError(f"refused {name}: it unpacks to {total} bytes")


def list_members(archive: Path, tool: tuple[str, str]) -> list[Member]:
    def run(argv: list[str]) -> str:
        r = subprocess.run(argv, stdin=subprocess.DEVNULL, capture_output=True, text=True, errors="replace")
        if r.returncode != 0:
            raise ValueError(f"{Path(argv[0]).name} could not list {archive.name}: {(r.stderr or r.stdout).strip()[-300:]}")
        return r.stdout
    kind, exe = tool
    if kind == "bsdtar":
        return parse_bsdtar_listing(run([exe, "-t", "-f", str(archive)]), run([exe, "-t", "-v", "-f", str(archive)]))
    return parse_7z_listing(run([exe, "l", "-slt", str(archive)]))


def safe_extract_7z(archive: Path, dest: Path, max_bytes: int = UNPACK_MAX) -> str:
    """Unpacks an untrusted .7z into dest (replacing it), through a temporary folder beside it,
    with bsdtar or else 7-Zip: their member list first (check_members refuses the whole
    archive), then the unpacking; then removes any link and checks every path stays inside.
    Nothing in it is run. Returns the tool's name."""
    tool = archive_tool()
    if tool is None:
        raise ValueError(NO_ARCHIVE_TOOL)
    check_members(archive.name, list_members(archive, tool), max_bytes)
    tmp = dest.parent / f".{dest.name}.tmp"
    shutil.rmtree(tmp, ignore_errors=True)
    tmp.mkdir(parents=True)
    try:
        kind, exe = tool
        argv = [exe, "-x", "-f", str(archive), "-C", str(tmp)] if kind == "bsdtar" else [exe, "x", "-y", "-bd", f"-o{tmp}", str(archive)]
        r = subprocess.run(argv, stdin=subprocess.DEVNULL, capture_output=True, text=True, errors="replace")
        if r.returncode != 0:
            raise ValueError(f"{Path(exe).name} could not unpack {archive.name}: {(r.stderr or r.stdout).strip()[-300:]}")
        root = tmp.resolve()
        for p in sorted(tmp.rglob("*"), reverse=True):
            if p.is_symlink():
                p.unlink()
            elif not p.resolve().is_relative_to(root):
                raise ValueError(f"refused {archive.name}: {p} is outside its folder")
        shutil.rmtree(dest, ignore_errors=True)
        tmp.replace(dest)
        return Path(exe).name
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def find_collection(d: Path) -> Path | None:
    """The folder holding DOCUMENTS/STIL.txt: d or up to three folders below it, the shallowest
    (hidden folders skipped)."""
    if not d.is_dir():
        return None
    for depth in range(4):
        found = [p for p in sorted(d.glob("/".join(["*"] * depth + ["DOCUMENTS", "STIL.txt"])))
                 if not any(part.startswith(".") for part in p.relative_to(d).parts)]
        if found:
            return found[0].parent.parent
    return None


def downloaded_collection(root: Path) -> Path | None:
    """The newest collection under build/hvsc/<version>/."""
    if not root.is_dir():
        return None
    versions = sorted((p for p in root.iterdir() if p.is_dir() and p.name.isdigit()), key=lambda p: -int(p.name))
    for v in versions:
        c = find_collection(v)
        if c:
            return c
    return None


def url_ok(url: str) -> bool:
    u = urllib.parse.urlparse(url)
    return u.scheme == "https" or (u.scheme == "http" and u.hostname in ("127.0.0.1", "localhost"))


def fetch_hvsc(root: Path, progress: Callable[[str], None], log: Callable[[str], None], api: str | None = None) -> Path:
    """Downloads and unpacks the collection into root/<version>/; returns the collection folder."""
    api = api or os.environ.get("FMZX_HVSC_API") or HVSC_API
    if archive_tool() is None:
        raise ValueError(NO_ARCHIVE_TOOL)
    if not url_ok(api):
        raise ValueError(f"not an https address: {api}")
    headers = {"User-Agent": "pack-studio"}
    with urllib.request.urlopen(urllib.request.Request(api, headers=headers), timeout=30) as r:
        info = json.loads(r.read(1 << 20))
    version = int(info["version"])
    url = str(info["complete"]["url"])
    if not url_ok(url):
        raise ValueError(f"not an https address: {url}")
    dest = root / str(version)
    have = find_collection(dest)
    if have:
        return have
    root.mkdir(parents=True, exist_ok=True)
    archive = root / f"HVSC_{version}.7z"
    if not archive.is_file():
        part = root / f"HVSC_{version}.7z.part"
        log(f"downloading {url}")
        with urllib.request.urlopen(urllib.request.Request(url, headers=headers), timeout=60) as r, part.open("wb") as f:
            total = int(r.headers.get("Content-Length") or 0)
            got = 0
            last = 0.0
            while True:
                b = r.read(1 << 20)
                if not b:
                    break
                f.write(b)
                got += len(b)
                if time.monotonic() - last > 0.3:
                    last = time.monotonic()
                    progress(f"downloading the SID collection (HVSC {version}): {got / 1e6:.1f}"
                             + (f" of {total / 1e6:.1f} MB" if total else " MB"))
        if total and got != total:
            raise ValueError(f"the download stopped at {got} of {total} bytes")
        part.replace(archive)
        log(f"downloaded {archive} ({got} bytes)")
    progress(f"unpacking the SID collection (HVSC {version})")
    log(f"unpacked with {safe_extract_7z(archive, dest)}")
    archive.unlink()
    c = find_collection(dest)
    if c is None:
        raise ValueError(f"no DOCUMENTS/STIL.txt in {dest}")
    log(f"the SID collection: {c}")
    return c


# ---------------------------------------------------------------------------------------------
# The AY collection (chris-y/AY on GitHub: Spectrum AY music, music/ay/games/ and music/ay/misc/)


def find_ay_collection(d: Path) -> Path | None:
    """The .ay collection in d: d/music/ay (a downloaded or cloned collection), else d itself
    when it holds .ay files (in it or in folders below)."""
    if not d.is_dir():
        return None
    if (d / "music" / "ay").is_dir():
        return d / "music" / "ay"
    return d if next(d.rglob("*.ay"), None) else None


def downloaded_ay(root: Path) -> Path | None:
    """The newest collection under build/ay/<commit>/."""
    if not root.is_dir():
        return None
    for v in sorted((p for p in root.iterdir() if p.is_dir() and re.fullmatch(r"[0-9a-f]{12}", p.name)),
                    key=lambda p: -p.stat().st_mtime):
        if (v / "music" / "ay").is_dir():
            return v / "music" / "ay"
    return None


def safe_extract_ay(archive: Path, dest: Path, max_bytes: int = UNPACK_MAX) -> int:
    """Unpacks the music/ay folder of an untrusted .tar.gz of the collection (<top>/music/ay/...)
    into dest/music/ay (replacing dest), through a temporary folder beside it, reading the
    archive as a stream: a member whose path is absolute or holds "..", or one under music/ay
    that is a link or a device, refuses the whole archive, as does more than max_bytes; other
    members (screenshots, the rest of the repository) are skipped. Nothing in it is run. Returns
    the files unpacked."""
    import tarfile

    tmp = dest.parent / f".{dest.name}.tmp"
    shutil.rmtree(tmp, ignore_errors=True)
    tmp.mkdir(parents=True)
    try:
        total = files = 0
        with tarfile.open(archive, "r|gz") as tf:
            for m in tf:
                if not member_ok(m.name):
                    raise ValueError(f"refused {archive.name}: the member {m.name!r} would land outside its folder")
                parts = PurePosixPath(m.name).parts
                if len(parts) < 3 or parts[1:3] != ("music", "ay"):
                    continue
                if not (m.isfile() or m.isdir()):
                    raise ValueError(f"refused {archive.name}: the member {m.name!r} is a link or a device")
                out = tmp.joinpath(*parts[1:])
                if m.isdir():
                    out.mkdir(parents=True, exist_ok=True)
                    continue
                total += m.size
                if total > max_bytes:
                    raise ValueError(f"refused {archive.name}: it unpacks to more than {max_bytes} bytes")
                out.parent.mkdir(parents=True, exist_ok=True)
                src = tf.extractfile(m)
                with out.open("wb") as f:
                    shutil.copyfileobj(src, f)
                files += 1
        root = tmp.resolve()
        for p in tmp.rglob("*"):
            if p.is_symlink() or not p.resolve().is_relative_to(root):
                raise ValueError(f"refused {archive.name}: {p} is outside its folder")
        if not (tmp / "music" / "ay").is_dir():
            raise ValueError(f"no music/ay folder in {archive.name}")
        shutil.rmtree(dest, ignore_errors=True)
        tmp.replace(dest)
        return files
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def fetch_ay(root: Path, progress: Callable[[str], None], log: Callable[[str], None], api: str | None = None,
             tarball: str | None = None) -> Path:
    """Downloads the collection's newest commit and unpacks its music/ay into root/<commit, 12
    digits>/; returns the collection folder (music/ay)."""
    api = api or os.environ.get("FMZX_AY_API") or AY_API
    tarball = tarball or os.environ.get("FMZX_AY_TARBALL") or AY_TARBALL
    if not url_ok(api):
        raise ValueError(f"not an https address: {api}")
    headers = {"User-Agent": "pack-studio", "Accept": "application/vnd.github+json"}
    with urllib.request.urlopen(urllib.request.Request(api, headers=headers), timeout=30) as r:
        sha = str(json.loads(r.read(4 << 20)).get("sha", ""))
    if not re.fullmatch(r"[0-9a-f]{40}", sha):
        raise ValueError(f"{api}: no commit in the answer")
    dest = root / sha[:12]
    if (dest / "music" / "ay").is_dir():
        return dest / "music" / "ay"
    url = tarball.format(sha=sha)
    if not url_ok(url):
        raise ValueError(f"not an https address: {url}")
    root.mkdir(parents=True, exist_ok=True)
    archive = root / f"AY-{sha[:12]}.tar.gz"
    part = root / f"AY-{sha[:12]}.tar.gz.part"
    log(f"downloading {url}")
    with urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "pack-studio"}), timeout=60) as r, \
            part.open("wb") as f:
        total = int(r.headers.get("Content-Length") or 0)
        got = 0
        last = 0.0
        while True:
            b = r.read(1 << 20)
            if not b:
                break
            f.write(b)
            got += len(b)
            if time.monotonic() - last > 0.3:
                last = time.monotonic()
                progress(f"downloading the AY collection ({sha[:12]}): {got / 1e6:.1f}"
                         + (f" of {total / 1e6:.1f} MB" if total else " MB"))
    if total and got != total:
        part.unlink(missing_ok=True)
        raise ValueError(f"the download stopped at {got} of {total} bytes")
    part.replace(archive)
    log(f"downloaded {archive} ({got} bytes)")
    progress(f"unpacking the AY collection ({sha[:12]})")
    try:
        n = safe_extract_ay(archive, dest)
    finally:
        archive.unlink(missing_ok=True)
    c = dest / "music" / "ay"
    log(f"the AY collection: {c} ({n} files)")
    return c


# ---------------------------------------------------------------------------------------------
# What a takes job is doing, and what it did: tools/arrange-music's progress lines and its summary
# line ("summary: kind=sid game=ID scores=1 pending=1 takes=3 ... best=0.73 seconds=41 source=...")


TAKES_LABEL = {"ai": "AI", "sid": "SID", "ay": "AY"}
AMT_PASSES = ("drums", "bass", "chords")  # tools/arrange-music's amt passes, in order
ORIGIN = {"sid": "C64", "ay": "Spectrum 128"}
RE_AI_HEAD = re.compile(r"(\d+) scores, (\d+) to arrange \((\d+) takes each")
RE_OWN_HEAD = re.compile(r"(\d+) scores, (\d+) to search for")
RE_SCORE = re.compile(r"^\[[^\]]+\] .*: [\d.]+ s of music, \d+ notes; (\d+) takes with \w+(?:, roughly (.+) a take)?$")
RE_PASS_AT = re.compile(r"^\[[^\]]+\] take (\d+) (\w+): ([\d.]+)/([\d.]+) s, \d+ notes, \d+ s so far, about (.+) left in this take")
RE_PASS_DONE = re.compile(r"^\[[^\]]+\] take (\d+) (\w+): \d+ notes in \d+ s")
RE_TAKE_DONE = re.compile(r"^\[[^\]]+\] take (\d+)/(\d+) in ([^:]+):")
RE_CANDS = re.compile(r"^\[[^\]]+\] .*: (\d+) candidates to check$")
RE_CHECKED = re.compile(r"^\[[^\]]+\]   \S.* #\d+: (closeness|not converted|no notes)")
RE_JUDGING = re.compile(r"^tools/arrange-music: judging (\d+) scores")
RE_JUDGED = re.compile(r"^\[([^\]/]+)/[^\]]*\] judged: ")
RE_JPLAN = re.compile(r"^progress: score ([^/\s]+)/\S+ renders=(\d+)$")
RE_JRENDERED = re.compile(r"^progress: rendered ([^/\s]+)/\S+ ")
RE_OWN_TAKE = re.compile(r"^\[[^\]]+\] (chip|ay)-\d+: ")
RE_UV = re.compile(r"^(Downloading|Downloaded|Installed|Prepared|Resolved|Building|Built|Updating|Updated) ")


def parse_summary(line: str) -> dict[str, str] | None:
    """tools/arrange-music's summary line as its fields; None for any other line."""
    s = line.strip()
    if not s.startswith("summary: "):
        return None
    body, _, source = s[len("summary: "):].partition(" source=")
    doc = dict(kv.split("=", 1) for kv in body.split() if "=" in kv)
    if source:
        doc["source"] = source
    return doc


def parse_dur(text: str) -> float | None:
    """tools/arrange-music's durations ("40 s", "12 min", "1.5 h") in seconds; None for "?"."""
    m = re.fullmatch(r"\s*([\d.]+) (s|min|h)\s*", text)
    if not m:
        return None
    return float(m[1]) * {"s": 1, "min": 60, "h": 3600}[m[2]]


def fmt_secs(s: float) -> str:
    """A job's time: "12 s", "3 min 12 s", "1 h 4 min"."""
    s = max(0, int(round(s)))
    if s < 60:
        return f"{s} s"
    if s < 3600:
        return f"{s // 60} min {s % 60} s"
    return f"{s // 3600} h {s % 3600 // 60} min"


def short_source(source: str) -> str:
    """A take's source without its subtune and file: "C64: <title> by <author> (<released>)"."""
    return re.split(r", (?:subtune|song) \d+,", source, maxsplit=1)[0].strip()


def plural(n: int, word: str) -> str:
    return f"{n} {word}{'' if n == 1 else 's'}"


def summary_text(kind: str, s: dict[str, str]) -> str:
    """A finished takes or judge job's result in words, from its summary line."""
    num = lambda k: int(s.get(k, "0") or 0) if str(s.get(k, "0")).isdigit() else 0  # noqa: E731
    if kind == "judge":
        if not num("tunes"):
            return "no takes to judge"
        text = (f"{plural(num('tunes'), 'score')}: {num('picked')} chosen by the judge"
                + (f" ({num('applied')} in this run)" if num("applied") else "") + f", {num('owner')} by you, {num('flagged')} to hear")
        if num("faults"):
            text += f", {plural(num('faults'), 'faulty take')}"
        return text + ("; the renderer check skipped (no music-preview)" if s.get("renderer") == "skipped" else "")
    label = TAKES_LABEL.get(kind, kind.upper())
    if s.get("scores") == "0":
        return "no scores to arrange"
    if s.get("pending") == "0":
        return f"had its {label} takes already: nothing to do"
    takes = num("takes")
    if kind == "ai":
        secs = float(s["seconds"]) if s.get("seconds", "").isdigit() else None
        return f"{plural(takes, 'take')} written" + (f", {fmt_secs(secs)}" if secs is not None else "")
    refused = num("refused")
    skipped = ""
    if refused:
        skipped = (f", {plural(refused, 'song')} skipped (48K beeper or CPC tunes)" if kind == "ay"
                   else f", {plural(refused, 'tune')} skipped (the converter refuses it)" if refused == 1
                   else f", {plural(refused, 'tune')} skipped (the converter refuses them)")
    if takes:
        best = s.get("best", "-")
        weak = ""
        try:
            weak = "; weak: probably another tune, listen" if float(best) < WEAK_CLOSE else ""
        except ValueError:
            pass
        src = short_source(s.get("source", ""))
        return f"{plural(takes, 'take')}, best closeness {pct(best)}" + (f" ({src})" if src else "") + weak + skipped
    if num("candidates") == 0:
        return f"no {ORIGIN.get(kind, kind)} tune found by that name"
    return f"0 takes{skipped}" + ("" if refused >= num("candidates") else f" ({plural(num('candidates'), 'candidate')}, none converted)")


class JudgeWatch:
    """A judge job's progress (tools/arrange-music judge): the scores judged of those to judge,
    each game's steps (its takes rendered and its scores judged, of those its progress lines
    planned), then its summary line's fields."""

    def __init__(self):
        self.kind = "judge"
        self.summary: dict[str, str] | None = None
        self.total = 0
        self.done = 0
        self.games: dict[str, list[int]] = {}  # game id -> [steps done, steps planned]
        self.planned = False  # its progress lines' plan seen (an older tools/arrange-music has none)

    def feed(self, line: str, now: float | None = None) -> None:
        s = line.strip()
        if (sm := parse_summary(s)) is not None:
            self.summary = sm
        elif m := RE_JUDGING.match(s):
            self.total = int(m[1])
        elif m := RE_JPLAN.match(s):
            self.planned = True
            self.games.setdefault(m[1], [0, 0])[1] += int(m[2]) + 1
        elif m := RE_JRENDERED.match(s):
            self.games.setdefault(m[1], [0, 0])[0] += 1
        elif m := RE_JUDGED.match(s):
            self.done += 1
            g = self.games.setdefault(m[1], [0, 0])
            g[0] += 1
            g[1] = max(g[1], g[0])

    def game_frac(self, gid: str) -> float:
        """A game's share of the judging done: its steps done of those planned (0 before its
        plan line, 1 for a game with nothing to judge once the plan is complete)."""
        g = self.games.get(gid)
        if not self.planned:
            return 0.0
        if g is None:
            return 1.0
        return min(1.0, g[0] / g[1]) if g[1] else 0.0

    def running_text(self, now: float | None = None) -> str:
        return f"judging: {self.done} of {self.total} scores" if self.total else "starting"

    def progress(self, label: str, now: float | None = None) -> Progress:
        if not self.total:
            return Progress(label, None, "starting")
        planned = sum(g[1] for g in self.games.values()) if self.planned else 0
        frac = sum(g[0] for g in self.games.values()) / planned if planned else self.done / self.total
        return Progress(label, min(1.0, frac), f"{self.done}/{self.total} scores")


class TakesWatch:
    """A takes job's (tools/arrange-music generate, chip or ay) progress, fed its output lines:
    what it is doing (running_text) and, at its end, its summary line's fields."""

    def __init__(self, kind: str):
        self.kind = kind
        self.summary: dict[str, str] | None = None
        self.phase = ""
        self.takes_each = 0
        self.pending = 0
        self.score_i = 0
        self.todo = 0  # takes to write for the current score
        self.take_est: float | None = None  # seconds a take, as estimated
        self.take_times: list[float] = []
        self.done_in_score = 0
        self.take: int | None = None
        self.pass_ = ""
        self.pct = 0.0
        self.take_left: float | None = None
        self.at = 0.0
        self.cands = 0
        self.checked = 0
        self.written = 0

    def feed(self, line: str, now: float | None = None) -> None:
        s = line.strip()
        now = time.monotonic() if now is None else now
        if (sm := parse_summary(s)) is not None:
            self.summary = sm
        elif "downloading the model" in s:
            self.phase = "downloading the model (about 1.4 GB, once)"
        elif RE_UV.match(s):
            self.phase = "uv: getting tools/arrange-music's packages (once)"
        elif m := RE_AI_HEAD.search(s):
            self.pending, self.takes_each, self.phase = int(m[2]), int(m[3]), ""
        elif m := RE_OWN_HEAD.search(s):
            self.pending, self.phase = int(m[2]), ""
        elif s.startswith("tools/arrange-music: indexing "):
            self.phase = "indexing the collection (once)"
        elif m := RE_SCORE.match(s):
            self.score_i += 1
            self.todo, self.take_est = int(m[1]), parse_dur(m[2] or "")
            self.done_in_score, self.take, self.pass_, self.pct, self.take_left, self.phase = 0, None, "", 0.0, None, ""
        elif m := RE_PASS_AT.match(s):
            self.take, self.pass_ = int(m[1]), m[2]
            si = AMT_PASSES.index(m[2]) if m[2] in AMT_PASSES else 0
            self.pct = (si + float(m[3]) / max(float(m[4]), 1e-6)) / len(AMT_PASSES)
            self.take_left, self.at = parse_dur(m[5]), now
        elif m := RE_PASS_DONE.match(s):
            self.take, self.pass_ = int(m[1]), m[2]
            si = AMT_PASSES.index(m[2]) if m[2] in AMT_PASSES else 0
            self.pct, self.take_left = (si + 1) / len(AMT_PASSES), None
        elif m := RE_TAKE_DONE.match(s):
            self.done_in_score += 1
            self.takes_each = self.takes_each or int(m[2])
            d = parse_dur(m[3])
            if d is not None:
                self.take_times.append(d)
            self.take, self.pass_, self.pct, self.take_left = None, "", 0.0, None
        elif m := RE_CANDS.match(s):
            self.cands += int(m[1])
            self.phase = ""
        elif RE_CHECKED.match(s):
            self.checked += 1
        elif RE_OWN_TAKE.match(s):
            self.written += 1

    def running_text(self, now: float | None = None) -> str:
        now = time.monotonic() if now is None else now
        if self.phase:
            return self.phase
        if self.kind != "ai":
            if not self.cands:
                return "looking for the game's tune by name"
            return f"checking candidates: {self.checked} of {self.cands}" + (f", {plural(self.written, 'take')} written" if self.written else "")
        if not self.score_i:
            return "starting"
        pre = f"score {self.score_i} of {self.pending}, " if self.pending > 1 else ""
        n, take = self.take_of()
        text = f"{pre}take {take} of {n}"
        if self.pass_:
            text += f", pass '{self.pass_}', {self.pct * 100:.0f}%"
        left = self.left(now)
        if left is not None:
            text += f" ({fmt_left(left)} left)"
        return text

    def take_of(self) -> tuple[int, int]:
        """An AI job's takes for the current score, and the one being made."""
        n = self.takes_each or self.todo
        return n, self.take or (n - self.todo + self.done_in_score + 1)

    def left(self, now: float) -> float | None:
        """An AI job's seconds left for the current score: the take being made, then the others
        at the average of those done (else the estimate); None with neither."""
        avg = sum(self.take_times) / len(self.take_times) if self.take_times else self.take_est
        if avg is None:
            return None
        here = max(0.0, self.take_left - (now - self.at)) if self.take_left is not None else avg * (1 - self.pct)
        return here + max(0, self.todo - self.done_in_score - 1) * avg

    def progress(self, label: str, now: float | None = None) -> Progress:
        """The bar: an AI job (take - 1 + the take's share done) / takes, per score of those to
        arrange; a SID or AY job the candidates checked of those found; a phase without figures
        (the model's download, indexing) not known (a spinner)."""
        now = time.monotonic() if now is None else now
        if self.phase:
            return Progress(label, None, self.phase.split(" (")[0])
        if self.kind != "ai":
            if not self.cands:
                return Progress(label, None, "looking for the tune")
            return Progress(label, min(1.0, self.checked / self.cands), f"{self.checked}/{self.cands} candidates")
        if not self.score_i:
            return Progress(label, None, "starting")
        n, take = self.take_of()
        within = min(1.0, (take - 1 + self.pct) / n) if n else 0.0
        frac = (self.score_i - 1 + within) / max(1, self.pending)
        figs = (f"score {self.score_i}/{self.pending} " if self.pending > 1 else "") + f"take {take}/{n}"
        if self.pass_:
            figs += f" {self.pass_} {self.pct * 100:.0f}%"
        left = self.left(now)
        return Progress(label, frac, figs, short_left(left) if left is not None else "")


# ---------------------------------------------------------------------------------------------
# Jobs: one at a time, in a thread (the screen) or in turn (--status, --build); every line they
# and the studio say goes to W/studio.log, none to the screen


LOG_MAX = 4 << 20  # W/studio.log's bytes before it moves to W/studio.log.1 (the one before goes)
TAG_W = 16  # a log line's tag column


class Log:
    """W/studio.log: a line per event and per line of a job's output, each "HH:MM:SS <tag> <text>",
    the tag the job's number, kind and game ("#4 sid alpha") or "studio" (what the owner asked
    for, the studio's messages); a session starts with a dated line. Past max_bytes the file moves
    to studio.log.1 (replacing the one there) and another starts. Written from any thread."""

    def __init__(self, path: Path, max_bytes: int = LOG_MAX):
        self.path = path
        self.max = max_bytes
        self.lock = threading.Lock()
        path.parent.mkdir(parents=True, exist_ok=True)
        try:
            self.size = path.stat().st_size
        except OSError:
            self.size = 0
        if self.size >= self.max:
            self._rotate()
        self.f = path.open("a", encoding="utf-8", errors="replace")

    def _rotate(self) -> None:
        with contextlib.suppress(OSError):
            os.replace(self.path, self.path.with_name(self.path.name + ".1"))
        self.size = 0

    def _put(self, text: str) -> None:
        data = text.encode("utf-8", "replace")
        with self.lock:
            if self.size and self.size + len(data) > self.max:
                with contextlib.suppress(OSError):
                    self.f.close()
                self._rotate()
                self.f = self.path.open("a", encoding="utf-8", errors="replace")
            with contextlib.suppress(OSError, ValueError):
                self.f.write(text)
                self.f.flush()
            self.size += len(data)

    def write(self, tag: str, text: str) -> None:
        stamp = time.strftime("%H:%M:%S")
        lines = text.rstrip("\n").split("\n")
        self._put("".join(f"{stamp} {tag:<{TAG_W}} {ln.rstrip()}\n" for ln in lines))

    def session(self, what: str) -> None:
        self._put(f"-- {time.strftime('%Y-%m-%d %H:%M:%S')} {what}\n")

    def close(self) -> None:
        with self.lock, contextlib.suppress(OSError):
            self.f.close()


CANCELLED_RC = -15  # a cancelled job's exit code (as when stopped with SIGTERM)
FINISHED = ("done", "failed", "cancelled", "skipped")


class Cancelled(Exception):
    """Raised in a function job (a download) when it is cancelled."""


@dataclass(eq=False)
class Job:
    title: str
    argv: list[str] | None = None
    fn: Callable[[Job], int] | None = None
    cwd: Path | None = None
    env: dict[str, str] | None = None
    chain: str | None = None  # when it fails, the waiting jobs of its chain are dropped
    on_done: Callable[[Job], None] | None = None
    on_line: Callable[[str], None] | None = None  # each output line, in the job's thread
    kind: str = ""  # ai, sid, ay (takes), judge, dl-sid, dl-ay, learn, reuse, render, pack, setup
    what: str = ""  # its kind in words, on the jobs view (else the title)
    game: str = ""  # the game it is for (or what it works on), on the jobs view
    gid: str = ""  # the game's id
    gids: list[str] = field(default_factory=list)  # the games it works for, when more than one (a judge of all, a pack)
    detail: Callable[[], str] | None = None  # while it runs, its line on the jobs view
    wait_note: str = ""  # why it waits (a collection's download)
    skip_note: str = ""  # why it was skipped
    rc: int | None = None
    progress: str = ""  # a function job's progress in words (a download's MB)
    tail: deque = field(default_factory=lambda: deque(maxlen=2000))  # its output lines (also in the log)
    runner: Runner | None = None
    state: str = "new"  # waiting, running, then done, failed, cancelled or skipped
    closed: bool = False  # finished and its on_done run
    n: int = 0  # its number in the session
    added: float = 0.0
    started: float | None = None
    ended: float | None = None
    cancelled: bool = False
    watch: TakesWatch | JudgeWatch | None = None
    live: Live | None = None  # the games' steps (a learn job, a pack's fmzx-pack)
    stage: tuple[int, int, int] | None = None  # a build's job: (its pack, of packs, 0 the pack or 1 its packages)
    after: list[Job] = field(default_factory=list)  # the jobs it waits for: it starts once each has finished

    def __post_init__(self):
        if self.kind in TAKES_LABEL:
            self.watch = TakesWatch(self.kind)
        elif self.kind in ("judge", "settle"):
            self.watch = JudgeWatch()

    def ready(self) -> bool:
        """Whether the jobs it waits for have all finished (done, failed, cancelled or skipped)."""
        return all(j.state in FINISHED for j in self.after)

    @property
    def tag(self) -> str:
        """Its tag in the log: "#4 sid alpha"."""
        return f"#{self.n} {self.kind or 'job'}" + (f" {self.gid}" if self.gid else "")

    def game_ids(self) -> list[str]:
        return self.gids or ([self.gid] if self.gid else [])

    def check(self) -> None:
        """A function job calls this (through out and its progress) to stop when cancelled."""
        if self.cancelled:
            raise Cancelled()

    def out(self, line: str) -> None:
        self.check()
        self.runner._line(self, line)

    def text(self) -> str:
        return "".join(self.tail)


RE_ERRORISH = re.compile(r"error|fail|no such|not found|cannot|can't|refus|panick|denied|missing|does not|did not|"
                         r"^no |not an? ", re.I)


def fail_words(j: Job, width: int = 70) -> str:
    """The last line of a job's output that reads as an error (a tool's own message, its
    "tools/<name>: " prefix dropped), cut to width; "" when none does."""
    lines = [ln.strip() for ln in j.tail if ln.strip()]
    msg = next((ln for ln in reversed(lines) if RE_ERRORISH.search(ln)), "")
    msg = re.sub(r"^(tools/[\w-]+|fmzx-pack|music-preview|error(\[\w+\])?)\s*:\s*", "", msg)
    return msg if len(msg) <= width else msg[:width - 3].rstrip() + "..."


def fail_reason(j: Job, width: int = 70) -> str:
    """A failed job's reason in a line: its exit code and fail_words."""
    msg = fail_words(j, width)
    return f"exit {j.rc}" + (f": {msg}" if msg else "")


def job_state(j: Job, now: float) -> tuple[str, str]:
    """A job's state in words and its colour: run, ok, err, wait or off."""
    if j.state == "running":
        e = int(now - (j.started or now))
        return f"running {e // 60}:{e % 60:02}", "run"
    if j.state == "done":
        return f"done in {fmt_secs((j.ended or now) - (j.started or now))}", "ok"
    if j.state == "failed":
        return "failed", "err"
    if j.state in ("cancelled", "skipped"):
        return j.state, "off"
    return "waiting", "wait"


def job_detail(j: Job, now: float) -> str:
    """A job's line beside its state, in words (never its raw output): what it does while it
    runs, what it did when finished, why it failed."""
    if j.state == "waiting":
        return j.wait_note
    if j.state == "skipped":
        return j.skip_note
    if j.state == "cancelled":
        return "stopped while it ran" if j.started else "taken off the queue"
    if j.state == "running":
        if j.watch:
            return j.watch.running_text(now)
        if j.detail:
            with contextlib.suppress(Exception):
                if d := j.detail():
                    return d
        return j.progress
    if j.state == "failed":
        log = j.runner.log.path.name if j.runner else "studio.log"
        return f"{fail_reason(j)} (the rest in {log}: l)"
    if j.watch and j.watch.summary is not None:
        return summary_text(j.kind, j.watch.summary)
    return ""


RE_DL = re.compile(r"^downloading the (\w+) collection .*: ([\d.]+)(?: of ([\d.]+))? MB$")


def job_progress(j: Job, now: float | None = None) -> Progress:
    """The bar for a running job, by its kind: the learning from its games list, a download
    from its bytes, a takes job from its progress lines, a build's pack from the packs done; any
    other (a render, the device builds, the judge's final pass) not known (a spinner)."""
    now = time.monotonic() if now is None else now
    if j.kind == "learn" and j.live is not None:
        return j.live.progress(now)
    if j.kind in TAKES_LABEL and j.watch is not None:
        return j.watch.progress(f"{TAKES_LABEL[j.kind]} takes: {j.game}", now)
    if j.kind == "judge" and j.watch is not None:
        return j.watch.progress(f"judge: {j.game}" if j.game else "judge", now)
    if j.kind.startswith("dl-"):
        what = j.kind[3:].upper()
        if m := RE_DL.match(j.progress):
            got, total = float(m[2]), float(m[3]) if m[3] else 0.0
            return Progress(f"downloading {what} collection", got / total if total else None,
                            f"{got:.0f}/{total:.0f} MB" if total else f"{got:.0f} MB")
        if j.progress.startswith("unpacking"):
            return Progress(f"unpacking {what} collection", None)
        return Progress(f"downloading {what} collection", None)
    if j.kind == "pack" and j.stage:
        k, n, sub = j.stage
        inner = j.live.fraction() if j.live is not None and not sub else 0.0
        return Progress(f"building pack {k} of {n}", (k - 1 + sub * 0.5 + inner * 0.5) / max(1, n), "packages" if sub else "packing")
    if j.kind == "settle":
        return Progress("final judge pass", None)
    if j.kind == "render":
        return Progress("rendering a preview", None)
    if j.kind == "reuse":
        return Progress("reusing earlier learning", None)
    return Progress(j.what or j.title, None)


# ---------------------------------------------------------------------------------------------
# The activity: the jobs since the queue was last empty, as a bar per game and one for it all


GAME_KINDS = ("ai", "sid", "ay", "judge")  # the jobs for one game each: the activity's bar names none of them


@dataclass
class Unit:
    """A job's work for one game: its share done, whether it is finished (its job finished and
    its on_done run, or its row of the learning done), what is in hand ("learning", "SID takes";
    "waiting" when nothing is) and whether it does work worth a line of its own (a game learned,
    loaded or left out, takes made or judged; a game the learning takes from the cache does not)."""
    key: str
    name: str
    frac: float
    fin: bool
    word: str
    work: bool = True


@dataclass
class GameBar:
    """A game's work in the activity: its share done (each of its steps, a job or the learning's
    phases, counted as done, as far as its tool reports, or not), what is in hand ("learning",
    "SID takes") and its figures, and its state: run (work in hand), queued (none in hand: not
    begun, or between its steps), done or failed."""
    key: str  # the game's id (a row's name before the games file gives ids)
    name: str
    frac: float
    word: str
    state: str
    why: str = ""  # failed: what failed
    reason: str = ""  # failed: the failed job's own words (its exit code when it has none)
    figures: str = ""  # the step in hand's figures ("2/4 candidates")
    work: bool = False  # it did (or does) work worth a line of its own
    started: float | None = None
    ended: float | None = None
    jobs: list = field(default_factory=list)  # its jobs, in turn


@dataclass
class Activity:
    """What the bottom line shows: the activity's share done (its games' and its steps without a
    game, a step each), what it is (name, label), its games finished of those in it, the time it
    has run, and its state: run, done, failed, cancelled, or idle (no activity, or one that ended
    more than DONE_SECS ago)."""
    games: dict[str, GameBar]
    frac: float
    label: str
    done_games: int
    n_games: int
    steps: int  # its items: games and steps without a game
    running: Job | None
    known: bool  # the running step reports how far it is
    left: str
    state: str
    started: float | None = None  # its first job's start
    key: int = 0  # its first job's number: another activity, another key
    name: str = ""


def job_units(j: Job, now: float) -> list[Unit]:
    """A job's work per game, a Unit for each game it works for; [] for a job without a game (a
    download, a device or tool build, a render, the judge's final pass)."""
    over = j.state in FINISHED and j.closed
    ok = j.state == "done"
    if j.live is not None and j.kind in ("learn", "pack"):
        out = []
        with j.live.lock:
            rows = [LiveRow(**vars(r)) for r in j.live.rows]
        word = f"pack {j.stage[0]}" if j.kind == "pack" and j.stage else ""
        for r in rows:
            d, k, rfin = r.steps()
            frac = 1.0 if ok or rfin else d / k if k else 0.0
            busy = j.state == "running" and r.word() != "waiting"
            work = r.state in ("learned", "left out") or "load" in r.done
            out.append(Unit(r.gid or r.name, r.name, frac, over or rfin, (word or r.word()) if busy else "waiting", work))
        return out
    ids = j.game_ids()
    if not ids or j.kind not in (*GAME_KINDS, "pack"):
        return []
    word = {"judge": "judging", "pack": f"pack {j.stage[0]}" if j.stage else "pack"}.get(j.kind, f"{TAKES_LABEL.get(j.kind, '')} takes")
    out = []
    for gid in ids:
        if ok:
            frac = 1.0
        elif j.state != "running":
            frac = 0.0
        elif j.kind == "judge" and isinstance(j.watch, JudgeWatch):
            frac = j.watch.game_frac(gid)
        elif j.kind in TAKES_LABEL and j.watch is not None:
            frac = j.watch.progress("", now).frac or 0.0
        else:
            frac = 0.0
        name = j.game if len(ids) == 1 else gid
        out.append(Unit(gid, name, frac, over, word if j.state == "running" else "waiting", j.kind != "pack"))
    return out


def activity_name(jobs: list[Job]) -> str:
    """What the activity does, in a few words, from its jobs' kinds ("" for setup steps alone)."""
    kinds = {j.kind for j in jobs}
    takes = kinds & set(TAKES_LABEL)
    if kinds & {"judge", "settle"}:
        return "finding and judging" if takes else "judging"
    if takes:
        return {frozenset({"ai"}): "making AI takes", frozenset({"sid"}): "finding C64 versions",
                frozenset({"ay"}): "finding 128 versions", frozenset({"sid", "ay"}): "finding C64 and 128 versions"}.get(
            frozenset(takes), "making takes")
    if "pack" in kinds:
        return "building packs"
    if "learn" in kinds:
        return "learning the games"
    return ""


def step_label(j: Job, name: str, now: float) -> str:
    """The bottom line's label while j runs: the activity's name for a game's job (no game named),
    else the step's own label."""
    if j.kind in GAME_KINDS:
        return name or j.what or j.title
    try:
        return job_progress(j, now).label
    except Exception:  # noqa: BLE001 - a step whose progress cannot be worked out keeps its title
        return j.what or j.title


def fmt_clock(seconds: float) -> str:
    """An elapsed time on the bar: "0:07", "12:30", "1:02:03"."""
    s = max(0, int(seconds))
    return f"{s // 3600}:{s % 3600 // 60:02}:{s % 60:02}" if s >= 3600 else f"{s // 60}:{s % 60:02}"


LEFT_AFTER = 3  # games finished, one at a time, before the bottom line estimates the time left


def activity_of(jobs: list[Job], names: dict[str, str], now: float, current: Job | None = None,
                ahead: list[Unit] | None = None) -> Activity:
    """The activity of these jobs (Runner.activity): each game's bar (its steps, each 1 when
    finished, else its share done, averaged) and state, the steps without a game (1 when
    finished, a download its share of the bytes, others 0 until done), the whole: games and those
    steps, each counted once. ahead: steps known but not queued yet (a build's later packs)."""
    per: dict[str, dict] = {}
    loose: list[float] = []

    def entry(u: Unit) -> dict:
        return per.setdefault(u.key, {"name": names.get(u.key, u.name), "units": [], "failed": "", "reason": "", "word": "",
                                      "figures": "", "hand": False, "open": False, "work": False, "started": None,
                                      "ended": None, "jobs": []})
    for u in ahead or []:
        g = entry(u)
        g["units"].append(0.0)
        g["open"] = True
    for j in jobs:
        units = job_units(j, now)
        if not units:
            f = 1.0 if j.state in FINISHED else 0.0
            if j.state == "running" and j.kind.startswith("dl-"):
                with contextlib.suppress(Exception):
                    f = job_progress(j, now).frac or 0.0
            loose.append(f)
            continue
        for u in units:
            g = entry(u)
            g["units"].append(1.0 if u.fin and j.state != "failed" else u.frac)  # a failed step: where it stopped
            g["work"] = g["work"] or u.work
            if j not in g["jobs"]:
                g["jobs"].append(j)
            if j.started is not None and (j.live is None or u.word != "waiting" or u.fin):
                g["started"] = min(g["started"] or j.started, j.started)
            if j.ended is not None:
                g["ended"] = max(g["ended"] or 0.0, j.ended)
            if j.state == "failed" and not (j.live is not None and u.frac >= 1.0):
                g["failed"] = g["failed"] or f"{j.what or j.title} failed"
                g["reason"] = g["reason"] or fail_words(j, 60) or f"exit {j.rc}"
            if not u.fin:
                g["open"] = True
                if u.word != "waiting":
                    g["hand"], g["word"] = True, u.word
                    if j.live is None and len(j.game_ids()) == 1:
                        with contextlib.suppress(Exception):
                            g["figures"] = job_progress(j, now).figures
    games = {}
    for key, g in per.items():
        frac = sum(g["units"]) / len(g["units"])
        state = "run" if g["hand"] else "queued" if g["open"] else "failed" if g["failed"] else "done"
        games[key] = GameBar(key, g["name"], frac, g["word"] if g["hand"] else "", state, g["failed"], g["reason"],
                             g["figures"] if g["hand"] else "", g["work"], g["started"], g["ended"] if state in ("done", "failed") else None,
                             g["jobs"])
    items = [gb.frac if gb.state in ("run", "queued") else 1.0 for gb in games.values()] + loose
    frac = sum(items) / len(items) if items else 0.0
    running = current if current is not None and current in jobs else None
    name = activity_name(jobs)
    label, known, left = "", True, ""
    if running is not None:
        label = step_label(running, name, now)
        if running.kind not in GAME_KINDS:
            try:
                p = job_progress(running, now)
                known, left = p.frac is not None, p.left if running.kind == "learn" else ""
            except Exception:  # noqa: BLE001 - a step whose progress cannot be worked out spins
                known = False
    done_games = sum(1 for gb in games.values() if gb.state in ("done", "failed"))
    one_by_one = not any(j.kind in ("learn", "pack") for j in jobs)
    timed = [gb.ended - gb.started for gb in games.values() if gb.ended is not None and gb.started is not None]
    if not left and one_by_one and len(timed) >= LEFT_AFTER and done_games < len(games):
        hand = [gb for gb in games.values() if gb.state == "run" and gb.started is not None]
        secs = sum(timed) / len(timed) * (len(games) - done_games) - sum(now - gb.started for gb in hand)
        left = short_left(max(0.0, secs))
    started = min((j.started for j in jobs if j.started is not None), default=None)
    if any(j.state not in FINISHED for j in jobs):
        state = "run"
        label = label or name or "waiting"
    elif not jobs:
        state = "idle"
    else:
        ended = max(j.ended or 0 for j in jobs)
        last = max((j for j in jobs if j.started), key=lambda j: j.ended or 0, default=None) or max(jobs, key=lambda j: j.ended or 0)
        state = ("failed" if any(j.state == "failed" for j in jobs) else
                 "cancelled" if last.state == "cancelled" else "done")
        label = step_label(last, name, now) if last.started else name or last.title
        if now - ended >= DONE_SECS:
            state = "idle"
    return Activity(games, frac, label, done_games, len(games), len(items), running, known, left, state, started,
                    jobs[0].n if jobs else 0, name)


def activity_progress(a: Activity, now: float) -> Progress:
    """The bottom line's Progress for the activity: what it is (or the step without a game that
    runs), the bar of the whole, "k of n games", the time it has run, the time left where it can
    be estimated; a running step without a measure adds a spinner and the time it has run (in
    place of the activity's); a lone such step is that alone (no bar)."""
    figs = f"{a.done_games} of {plural(a.n_games, 'game')}" if a.n_games else ""
    j = a.running
    spin = ""
    if j is not None and not a.known and j.started:
        spin = fmt_clock(now - j.started)
    if a.state == "run" and a.steps <= 1 and not a.n_games and spin:
        return Progress(a.label, None, "", spin)
    if a.state in ("done", "failed", "cancelled"):
        word = {"done": "done", "failed": "failed (J: the jobs, l: the log)", "cancelled": "cancelled"}[a.state]
        return Progress(a.label, 1.0 if a.state == "done" else a.frac, word if not figs else f"{figs}  {word}")
    if not spin and a.started is not None:
        figs = "  ".join(x for x in (figs, fmt_clock(now - a.started)) if x)
    return Progress(a.label, a.frac, figs, a.left, spin)


class Runner:
    def __init__(self, log_path: Path, threaded: bool, log_max: int = LOG_MAX):
        self.threaded = threaded
        self.pending: deque[Job] = deque()
        self.done: deque[Job] = deque()
        self.current: Job | None = None
        self.lock = threading.Lock()
        self.cond = threading.Condition(self.lock)
        self.proc: subprocess.Popen | None = None
        self.stopping = False
        self.failed: list[Job] = []  # the jobs that failed, in turn
        self.jobs: list[Job] = []  # every job of the session, in the order submitted
        self.activity: list[Job] = []  # the jobs since the queue was last empty: what the bars show
        self.after: Callable[[Job], None] | None = None  # each finished job, after its on_done
        self.log = Log(log_path, log_max)
        if threaded:
            threading.Thread(target=self._worker, daemon=True).start()

    @property
    def log_path(self) -> Path:
        return self.log.path

    def submit(self, job: Job, hold: bool = False) -> Job:
        """Queues the job; held, it waits (listed) until release. The queue keeps the order the
        jobs were submitted in (a released job takes its place again), and the next job is the
        first whose jobs to wait for (after) have finished. A job submitted when every job of the
        activity is finished (its on_done run) starts another activity."""
        job.runner = self
        job.state, job.added = "waiting", time.monotonic()
        with self.cond:
            if all(j.closed for j in self.activity):
                self.activity = []
            self.activity.append(job)
            self.jobs.append(job)
            job.n = len(self.jobs)
            if not hold:
                self.pending.append(job)
                self.cond.notify()
        self.log.write(job.tag, f"queued: {job.title}" + (" (held: " + (job.wait_note or "until the jobs before it are done") + ")"
                                                          if hold else ""))
        return job

    def release(self, job: Job) -> None:
        """A held job into the queue, in its place by the order submitted."""
        with self.cond:
            if job.state == "waiting" and job not in self.pending:
                at = next((i for i, j in enumerate(self.pending) if j.n > job.n), len(self.pending))
                self.pending.insert(at, job)
                self.cond.notify()

    def skip(self, job: Job, why: str) -> None:
        """A held job dropped (its on_done not run)."""
        with self.cond:
            if job in self.pending:
                self.pending.remove(job)
            job.state, job.skip_note, job.ended, job.closed = "skipped", why, time.monotonic(), True
            self.cond.notify()
        self.log.write(job.tag, f"skipped: {job.title} ({why})")

    def cancel(self, job: Job) -> str:
        """A waiting job off the queue ("cancelled"; its on_done runs, through pump, with
        CANCELLED_RC), or the running one stopped ("stopping": its process group gets SIGTERM,
        SIGKILL 5 s later; a function job stops at its next line); "" for a finished job."""
        with self.cond:
            if job.state == "waiting":
                if job in self.pending:
                    self.pending.remove(job)
                job.cancelled, job.rc, job.state, job.ended = True, CANCELLED_RC, "cancelled", time.monotonic()
                self.done.append(job)
                self.cond.notify()
                what = "cancelled"
            elif job.state == "running" and job is self.current:
                job.cancelled = True
                what = "stopping"
            else:
                return ""
        if what == "cancelled":
            self.log.write(job.tag, f"cancelled: {job.title} (taken off the queue)")
        else:
            self.log.write(job.tag, f"stopping: {job.title}")
            self._kill(self.proc)
        return what

    @staticmethod
    def _kill(p: subprocess.Popen | None) -> None:
        if p is None or p.poll() is not None:
            return
        with contextlib.suppress(OSError):
            os.killpg(p.pid, signal.SIGTERM)

        def later() -> None:
            with contextlib.suppress(subprocess.TimeoutExpired):
                p.wait(5)
                return
            with contextlib.suppress(OSError):
                os.killpg(p.pid, signal.SIGKILL)
        threading.Thread(target=later, daemon=True).start()

    def busy(self) -> bool:
        return self.current is not None or bool(self.pending)

    def waiting(self) -> int:
        return len(self.pending)

    def _line(self, job: Job, line: str) -> None:
        """A line of the job's output: to the log (tagged), its tail, its watcher and on_line."""
        line = line.rstrip("\n") + "\n"
        job.tail.append(line)
        self.log.write(job.tag, "| " + line)
        if job.watch:
            with contextlib.suppress(Exception):
                job.watch.feed(line)
        if job.on_line:
            with contextlib.suppress(Exception):
                job.on_line(line)

    def note(self, job: Job, text: str) -> None:
        """An event of the job's (not its output) to the log."""
        self.log.write(job.tag, text)

    def _next(self) -> Job | None:
        """The first job of the queue whose jobs to wait for have finished (the lock held)."""
        return next((j for j in self.pending if j.ready()), None)

    def _start(self) -> Job:
        """The next job, running from now (the lock held: a cancel sees it waiting or running)."""
        job = self._next()
        self.pending.remove(job)
        self.current = job
        job.state, job.started = "running", time.monotonic()
        return job

    def _run(self, job: Job) -> None:
        cmd = ""
        if job.argv:
            cmd = ": " + " ".join([f"{k}={shlex.quote(v)}" for k, v in (job.env or {}).items()] + [shlex.join(job.argv)])
            if job.cwd:
                cmd += f"  (in {job.cwd})"
        self.log.write(job.tag, f"start: {job.title}{cmd}")
        try:
            if job.argv:
                env = dict(os.environ, **(job.env or {}))
                proc = subprocess.Popen(job.argv, cwd=job.cwd, env=env, stdin=subprocess.DEVNULL,
                                        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
                                        errors="replace", bufsize=1, start_new_session=True)
                with self.lock:
                    self.proc = proc
                if job.cancelled:  # cancelled as it started
                    self._kill(proc)
                for line in proc.stdout:
                    self._line(job, line)
                job.rc = proc.wait()
            else:
                job.rc = job.fn(job)
        except Cancelled:
            job.rc = CANCELLED_RC
        except Exception as e:  # noqa: BLE001 - a job's failure is reported, the studio goes on
            for ln in traceback.format_exception_only(e):
                self._line(job, ln)
            job.rc = 1
        finally:
            with self.lock:
                self.proc = None
        job.ended = time.monotonic()
        state = "done" if job.rc == 0 else "cancelled" if job.cancelled else "failed"
        self.log.write(job.tag, f"end: {state}, exit {job.rc}, {fmt_secs(job.ended - (job.started or job.ended))}"
                       + (f": {fail_words(job, 200)}" if state == "failed" and fail_words(job) else ""))
        job.state = state
        self.current = None

    def _worker(self) -> None:
        while True:
            with self.cond:
                while self._next() is None:
                    self.cond.wait()
                job = self._start()
            self._run(job)
            with self.lock:
                self.done.append(job)

    def _finish(self, job: Job) -> None:
        if job.rc != 0:
            self.failed.append(job)
        if job.rc != 0 and job.chain:
            with self.lock:
                dropped = [j for j in self.pending if j.chain == job.chain]
                for j in dropped:
                    self.pending.remove(j)
            for j in dropped:
                self.skip(j, f"{job.title} " + ("cancelled" if job.cancelled else "failed"))
        try:
            if job.on_done:
                job.on_done(job)
            if self.after:
                self.after(job)
        finally:
            job.closed = True

    def pump(self) -> bool:
        """Runs the finished jobs' on_done in this (the screen's) thread; True when any finished."""
        any_ = False
        while True:
            with self.lock:
                if not self.done:
                    return any_
                job = self.done.popleft()
            any_ = True
            self._finish(job)

    def drain(self) -> None:
        """Without a thread: runs every job, the ones their on_done adds included (a job whose
        jobs to wait for can never finish, held ones nothing releases, is skipped)."""
        while self.pending:
            with self.lock:
                ready = self._next() is not None
                job = self._start() if ready else None
            if job is None:
                for j in list(self.pending):
                    self.skip(j, "the jobs it waits for did not run")
                break
            self._run(job)
            self._finish(job)
        while self.pump():  # the cancelled ones
            pass

    def stop(self) -> None:
        with self.lock:
            self.pending.clear()
        p = self.proc
        if p and p.poll() is None:
            with contextlib.suppress(OSError):
                os.killpg(p.pid, signal.SIGTERM)


