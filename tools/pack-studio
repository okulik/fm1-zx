        packs = {n: json.loads((d / MARKER).read_text())["games"] for n, d in pack_folders(w3) if is_studio_pack(d)}
        g3 = tomllib.loads((w3 / "pack-1" / "personal-games.toml").read_text())
        check(rc == 0 and packs == {1: ["alpha", "bravo"], 2: ["charlie"]} and gfile.read_text() == gtext
              and not (w3 / "all" / "personal-games.toml").exists()
              and ["personal", str(gfile), "-o", str(w3 / "all")] + app_args + ["--plan"]
              in [json.loads(ln) for ln in pack_calls.read_text().splitlines()],
              f"games file: learned from it as written, the packs from its entries ({packs})")
        check(g3["game"][1]["file"] == str(gfile.parent / "bravo.sna") and str(gfile) in (w3 / "pack-1" / "personal-games.toml").read_text(),
              "games file: a relative file from the games file's folder; the pack's note names it")
        check(workspace(w / "all" / "personal-games.toml", None) == w and workspace(gfile, None) == ROOT / "build/studio/my-games"
              and workspace(games, None) == ROOT / "build/studio/My Games",
              "games file: a workspace's all/personal-games.toml works in that workspace")

        # -- --try: the browser test bench on a built pack
        with contextlib.redirect_stdout(io.StringIO()):
            rc = main([str(games), "-o", str(w), "--try"])
            rc2 = main([str(games), "-o", str(w), "--try", "2"])
        with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
            rc5 = main([str(games), "-o", str(w), "--try", "5"])
        dcalls = [json.loads(ln) for ln in demo_calls.read_text().splitlines()]
        check(rc == 0 and rc2 == 0 and rc5 == 1 and dcalls == [["--packages", str(w / "pack-1")], ["--packages", str(w / "pack-2")]],
              f"--try [N]: tools/web-demo --packages W/pack-N; a pack not built fails ({dcalls})")

        # -- the SID collection: the member checks on listings (bsdtar's and 7-Zip's), safe unpacking,
        # and the download from 127.0.0.1
        names = "C64Music/\nC64Music/a b.sid\n../escaped.txt\nC64Music/lnk\nC64Music/dev\n"
        verbose = ("drwxr-xr-x  0 0      0           0 Nov 25 21:33 C64Music/\n"
                   "-rw-r--r--  0 0      0           5 Nov 25 21:33 C64Music/a b.sid\n"
                   "-rw-r--r--  0 0      0           2 Nov 25 21:33 ../escaped.txt\n"
                   "lrwxr-xr-x  0 0      0           0 Nov 25 21:33 C64Music/lnk -> /etc/passwd\n"
                   "crw-r--r--  0 0      0           0 Nov 25 21:33 C64Music/dev\n")
        ms = parse_bsdtar_listing(names, verbose)
        check([(m.name, m.kind, m.size) for m in ms] == [("C64Music/", "dir", 0), ("C64Music/a b.sid", "file", 5),
                                                          ("../escaped.txt", "file", 2), ("C64Music/lnk", "link", 0),
                                                          ("C64Music/dev", "other", 0)], "listing: bsdtar's names, kinds and sizes")
        slt = """7-Zip (z) 24.08 (arm64)

Listing archive: x.7z

--
Path = x.7z
Type = 7z
Physical Size = 300

----------
Path = C64Music
Size = 0
Folder = +
Attributes = D_ drwxr-xr-x

Path = C64Music/a b.sid
Size = 5
Folder = -
Attributes = A_ -rw-r--r--

Path = C64Music/lnk
Size = 11
Folder = -
Attributes = A_ lrwxrwxrwx
Symbolic Link = /etc/passwd

Path = /abs.txt
Size = 3
Folder = -
Attributes = A_ -rw-r--r--

Path = C64Music/pipe
Size = 0
Folder = -
Attributes = A_ prw-r--r--
"""
        ms7 = parse_7z_listing(slt)
        check([(m.name, m.kind, m.size) for m in ms7] == [("C64Music", "dir", 0), ("C64Music/a b.sid", "file", 5),
                                                           ("C64Music/lnk", "link", 11), ("/abs.txt", "file", 3),
                                                           ("C64Music/pipe", "other", 0)], "listing: 7-Zip's names, kinds and sizes")

        def refused(members: list[Member], max_bytes: int = UNPACK_MAX) -> str | None:
            try:
                check_members("x.7z", members, max_bytes)
            except ValueError as e:
                return str(e)
            return None
        check(refused(ms[:2]) is None and refused(ms7[:2]) is None, "listing: a plain archive passes")
        check("outside its folder" in (refused(ms[:3]) or "") and "outside its folder" in (refused(ms7[:2] + ms7[3:4]) or ""),
              "listing: a path escaping its folder (..) or absolute refuses the archive")
        check("is a link" in (refused(ms[:2] + ms[3:4]) or "") and "is a link" in (refused(ms7[:3]) or ""),
              "listing: a link refuses the archive")
        check("is a device" in (refused(ms[:2] + ms[4:]) or "") and "is a device" in (refused(ms7[:2] + ms7[4:]) or ""),
              "listing: a device or a fifo refuses the archive")
        check("unpacks to" in (refused(ms[:2], 4) or ""), "listing: more than the limit refuses the archive")
        try:
            parse_bsdtar_listing("a\nb\n", "-rw-r--r--  0 0      0           5 Nov 25 21:33 a\n")
            check(False, "listing: listings that disagree are an error")
        except ValueError:
            check(True, "listing: listings that disagree are an error")
        check(not member_ok("/abs") and not member_ok("a/../../b") and not member_ok("C:x") and member_ok("C64Music/a b.sid"),
              "unpack: the path checks")
        src = t / "web"
        src.mkdir()
        tool = archive_tool()
        if tool is None or tool[0] != "bsdtar":
            print("skip  a real .7z (written by bsdtar), its unpacking and the download: bsdtar is not installed")
        else:
            tree = t / "tree"
            (tree / "C64Music/DOCUMENTS").mkdir(parents=True)
            (tree / "C64Music/MUSICIANS/S/Someone").mkdir(parents=True)
            (tree / "C64Music/DOCUMENTS/STIL.txt").write_text("STIL\n")
            (tree / "C64Music/MUSICIANS/S/Someone/Alpha.sid").write_bytes(b"PSID")
            (tree / "x.txt").write_bytes(b"x")
            (tree / "lnk").symlink_to("/etc/passwd")

            def seven(out: Path, *members: str, subst: str | None = None) -> None:
                argv = [tool[1], "--format", "7zip", "-c", "-f", str(out)] + (["-P", "-s", subst] if subst else []) + list(members)
                subprocess.run(argv, cwd=tree, check=True, capture_output=True)
            seven(src / "HVSC_85-all-of-them.7z", "C64Music")
            seven(t / "evil.7z", "C64Music/DOCUMENTS", "x.txt", subst=",^x.txt$,../escaped.txt,")
            seven(t / "link.7z", "C64Music/DOCUMENTS", "lnk")
            for bad, why in (("evil.7z", "a member escaping its folder"), ("link.7z", "a link")):
                try:
                    safe_extract_7z(t / bad, t / "evil-out")
                    check(False, f"unpack: {why} refuses the archive (bsdtar's .7z)")
                except ValueError:
                    check(not (t / "escaped.txt").exists() and not (t / "evil-out").exists()
                          and not (t / ".evil-out.tmp").exists(), f"unpack: {why} refuses the archive (bsdtar's .7z)")
            how = safe_extract_7z(src / "HVSC_85-all-of-them.7z", t / "ext" / "85")
            check(find_collection(t / "ext") == t / "ext" / "85" / "C64Music"
                  and (t / "ext/85/C64Music/MUSICIANS/S/Someone/Alpha.sid").read_bytes() == b"PSID",
                  f"unpack with {how}: the collection found")
        import http.server

        class Quiet(http.server.SimpleHTTPRequestHandler):
            def __init__(self, *a, **k):
                super().__init__(*a, directory=str(src), **k)

            def log_message(self, *a):
                pass
        if (src / "HVSC_85-all-of-them.7z").is_file():
            srv = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Quiet)
            threading.Thread(target=srv.serve_forever, daemon=True).start()
            base = f"http://127.0.0.1:{srv.server_address[1]}"
            (src / "api.json").write_text(json.dumps({"version": 85, "complete": {"url": f"{base}/HVSC_85-all-of-them.7z"}}))
            seen = []
            try:
                coll = fetch_hvsc(t / "hvsc", seen.append, lambda s: None, api=f"{base}/api.json")
            finally:
                srv.shutdown()
            check(coll == t / "hvsc" / "85" / "C64Music" and (coll / "MUSICIANS/S/Someone/Alpha.sid").is_file(),
                  "download: unpacked into build/hvsc/<version>/, the collection found")
            check(not list((t / "hvsc").glob("*.7z*")) and any("unpacking" in x for x in seen),
                  "download: the archive removed after unpacking, progress shown")
            check(downloaded_collection(t / "hvsc") == coll and find_collection(t / "hvsc") == coll,
                  "download: found again on the next start")
        check(not url_ok("http://example.org/x.7z") and url_ok("https://example.org/x.7z"), "download: https only (or 127.0.0.1)")

        # -- the AY collection: the download from 127.0.0.1, only music/ay unpacked, a bad archive refused
        import tarfile

        sha = "0123456789abcdef0123456789abcdef01234567"
        top = f"AY-{sha}"

        def tgz(path: Path, members: list[tuple[str, bytes | None, str]]) -> None:
            with tarfile.open(path, "w:gz") as tf:
                for name, data, kind in members:
                    ti = tarfile.TarInfo(name)
                    if kind == "dir":
                        ti.type = tarfile.DIRTYPE
                        tf.addfile(ti)
                    elif kind == "link":
                        ti.type, ti.linkname = tarfile.SYMTYPE, "/etc/passwd"
                        tf.addfile(ti)
                    else:
                        ti.size = len(data)
                        tf.addfile(ti, io.BytesIO(data))

        (src / "tar").mkdir()
        tgz(src / "tar" / sha, [(top, None, "dir"), (f"{top}/README.md", b"readme", "file"),
                                (f"{top}/screenshots/a.png", b"png", "file"), (f"{top}/music/ay/games", None, "dir"),
                                (f"{top}/music/ay/games/Alpha.ay", b"ZXAYEMUL", "file"),
                                (f"{top}/music/ay/misc/Other.ay", b"ZXAYEMUL", "file")])
        (src / "commits.json").write_text(json.dumps({"sha": sha, "commit": {"message": "x"}}))
        tgz(t / "evil-ay.tar.gz", [(f"{top}/music/ay/games/ok.ay", b"ok", "file"), (f"{top}/music/ay/../../../escaped.txt", b"x", "file")])
        tgz(t / "link-ay.tar.gz", [(f"{top}/music/ay/games/ok.ay", b"ok", "file"), (f"{top}/music/ay/games/l.ay", None, "link")])
        for bad, why in (("evil-ay.tar.gz", "a path escaping its folder"), ("link-ay.tar.gz", "a link")):
            try:
                safe_extract_ay(t / bad, t / "ay-out")
                check(False, f"AY unpack: {why} refuses the archive")
            except ValueError:
                check(not (t / "escaped.txt").exists() and not (t / "ay-out").exists() and not (t / ".ay-out.tmp").exists(),
                      f"AY unpack: {why} refuses the archive")
        srv = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Quiet)
        threading.Thread(target=srv.serve_forever, daemon=True).start()
        base = f"http://127.0.0.1:{srv.server_address[1]}"
        seen = []
        try:
            acoll = fetch_ay(t / "ay", seen.append, lambda s: None, api=f"{base}/commits.json", tarball=f"{base}/tar/{{sha}}")
            again = fetch_ay(t / "ay", seen.append, lambda s: None, api=f"{base}/commits.json", tarball=f"{base}/nowhere/{{sha}}")
        finally:
            srv.shutdown()
        dest = t / "ay" / sha[:12]
        check(acoll == dest / "music" / "ay" and (acoll / "games" / "Alpha.ay").read_bytes() == b"ZXAYEMUL"
              and (acoll / "misc" / "Other.ay").is_file(), "AY download: music/ay unpacked into build/ay/<commit>/")
        check(not (dest / "screenshots").exists() and not (dest / "README.md").exists() and not list((t / "ay").glob("*.tar.gz*"))
              and any("unpacking" in x for x in seen), "AY download: the rest of the repository skipped, the archive removed, progress shown")
        check(again == acoll and downloaded_ay(t / "ay") == acoll and find_ay_collection(dest) == acoll,
              "AY download: the commit there already is not downloaded again; found on the next start")

        # -- --status on the workspace the steps above left
        buf = io.StringIO()
        with contextlib.redirect_stdout(buf):
            main([str(games), "-o", str(w), "--status"])
        s = buf.getvalue()
        check("methods: FM AI SID AY" in s and "* SID chip-1" in s and "  AY ay-1  " in s and "choice: chip-1" in s and "built:" in s
              and "pack 2: 1 game," in s and f"AY collection: {t / 'ay' / sha[:12] / 'music' / 'ay'}" in s
              and "not available" not in s, "--status: methods (AY among them), the chosen candidate, the built packs, the AY collection")
        print("\n".join("      " + ln for ln in s.splitlines()[:14]))

        # -- the screen, in a pseudo-terminal: keys, a resize down to 3x10, quit
        import fcntl
        import pty
        import struct
        import termios

        def size(fd: int, rows: int, cols: int) -> None:
            fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", rows, cols, 0, 0))

        pid, fd = pty.fork()
        if pid == 0:
            os.environ["TERM"] = "xterm-256color"
            try:
                os.execv(sys.executable, [sys.executable, str(Path(__file__).resolve()), str(games), "-o", str(w)])
            finally:
                os._exit(127)
        size(fd, 24, 100)
        os.kill(pid, signal.SIGWINCH)
        out, status = _wait_pty(fd, pid, 2.0)
        keys = [b"j", b"k", b"y", b"y", b"\r", b"j", b"j", b"j", b"\r", b" ", b"c", b"y", b"y", b"l", b"k", b"q", b"h", b"?", b"q"]
        for k in keys:
            os.write(fd, k)
            o, status = _wait_pty(fd, pid, 0.15)
            out += o
        for rows, cols in ((10, 30), (3, 10), (1, 1), (30, 120)):
            size(fd, rows, cols)
            os.kill(pid, signal.SIGWINCH)
            o, status = _wait_pty(fd, pid, 0.4)
            out += o
        os.write(fd, b"\x1b[B\x1b[B\r")
        out += _wait_pty(fd, pid, 0.5)[0]
        os.write(fd, b"h")
        os.write(fd, b"q")
        o, status = _wait_pty(fd, pid, 1.0)
        out += o
        if status is None:
            os.write(fd, b"y")
            o, status = _wait_pty(fd, pid, 5.0)
            out += o
        if status is None:
            os.kill(pid, signal.SIGKILL)
            os.waitpid(pid, 0)
        os.close(fd)
        text_out = out.decode("utf-8", "replace")
        check(status is not None and os.WIFEXITED(status) and os.WEXITSTATUS(status) == 0 and "Traceback" not in text_out,
              "screen: keys, resizes down to 1x1, quit; exit 0" + ("" if status is not None else " (it hung)")
              + ("" if "Traceback" not in text_out else ": " + text_out[text_out.find("Traceback"):][:600]))
        check("pack-studio" in text_out and "Alpha" in text_out and "workspace" in text_out,
              "screen: drew the games, printed the workspace when it closed")
        check(choice_label(read_choices(w / "all").get("alpha/8951-1a2b3c4d")) in ("take-1", "chip-1", "ay-1", "original"),
              "screen: c chose through pick --set")

    if failures:
        print(f"{PROG} selftest: {len(failures)} failed: " + "; ".join(failures))
        return 1
    print(f"{PROG} selftest: all passed")
    return 0


def parse_args(argv: list[str] | None) -> argparse.Namespace:
    ap = argparse.ArgumentParser(prog=PROG, description="The packs of your own games: music per game, then the packs.",
                                 epilog="tools/pack-studio selftest checks the tool. Details: the docstring at the top of tools/pack-studio.")
    ap.add_argument("folder", metavar="games", help="the folder of your games (.sna, .z80, .tap, .tzx), or a games file (.toml) used as written")
    ap.add_argument("-o", dest="out", metavar="W", help="the workspace (default build/studio/<folder name>)")
    ap.add_argument("--sid-dir", metavar="PATH", help="the SID collection to use instead of downloading one")
    ap.add_argument("--ay-dir", metavar="PATH", help="the AY collection (.ay files) to use instead of downloading one")
    ap.add_argument("--offline", action="store_true", help="download nothing")
    ap.add_argument("--cache", metavar="DIR", help="tools/make-packages --cache DIR: another folder for the SDK files")
    ap.add_argument("--model", metavar="NAME", help="the generator for AI takes (tools/arrange-music generate --model)")
    ap.add_argument("--generate", metavar="METHODS", help="without the screen: mark and generate ai, sid, ay (comma-separated)")
    ap.add_argument("--game", metavar="ID", action="append", help="with --generate: only this game (again for more)")
    ap.add_argument("--build", action="store_true", help="build the packs without the screen")
    ap.add_argument("--status", action="store_true", help="print the games, methods, scores, candidates and choices")
    ap.add_argument("--try", dest="try_", metavar="N", type=int, nargs="?", const=1,
                    help="then the browser test bench on pack N (1 unless given): tools/web-demo --packages W/pack-N")
    a = ap.parse_args(argv)
    if a.try_ is not None and a.try_ < 1:
        ap.error("--try N: N counts from 1")
    return a


def main(argv: list[str] | None = None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    if argv[:1] == ["selftest"]:
        return cmd_selftest(argparse.Namespace())
    return cmd_studio(parse_args(argv))


if __name__ == "__main__":
    sys.exit(main())
