def workspace(folder: Path, out: str | None) -> Path:
    if out:
        return Path(out).expanduser().resolve()
    name = folder.stem if folder.is_file() else folder.name
    return ROOT / "build" / "studio" / name


def cmd_studio(a: argparse.Namespace) -> int:
    folder = Path(a.folder).expanduser().resolve()
    if not folder.exists():
        die(f"no {folder}")
    w = workspace(folder, a.out)
    w.mkdir(parents=True, exist_ok=True)
    headless = a.status or a.build
    runner = Runner(w / "studio.log", threaded=not headless, echo=bool(a.build))
    st = Studio(folder, w, a, runner)
    if a.status:
        if st.plan is None:
            st.startup(learn=True)
            runner.drain()
        if st.plan is None:
            die(f"no plan ({w / 'studio.log'} says why)")
        print("\n".join(st.status_lines()))
        return 0
    if a.build:
        st.startup(learn=False)
        runner.drain()
        if not st.tools.fmzx_pack_given and not os.access(st.tools.fmzx_pack, os.X_OK):
            die("fmzx-pack did not build (see the output above)")
        st.build()
        runner.drain()
        print("\n".join(st.summary or ["no build"]))
        return 0 if st.build_ok else 1
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        die("the studio needs a terminal (or --status, --build)")
    st.startup(learn=True)
    try:
        run_ui(st)
    finally:
        st.player.stop()
        runner.stop()
    lines = st.summary or pack_summary(w, st.plan)
    if lines:
        print("\n".join(lines))
    print(f"{PROG}: workspace {w}; log {w / 'studio.log'}")
    return 0


