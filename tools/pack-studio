HELP_GAMES = ("Enter open  a/s/y mark  g make-takes  J jobs  1-9/0 pack  f fill  p packs  b build-firmware  r re-learn  "
              "l log  ? help  q quit")
HELP_LIVE = "1-9/0 pack  J jobs  l log  ? help  q quit"
HELP_GAME = "Enter play/stop  c choose  a/s/y mark  g make-takes  J jobs  Esc back  l log  ? help"
HELP_PACKS = "1-9 pack  0/x none  f fill  Enter open  b build-firmware  J jobs  Esc back  l log  q quit"
