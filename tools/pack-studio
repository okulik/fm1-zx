def load_methods(w: Path) -> dict[str, set[str]]:
    doc = read_toml(w / "studio.toml")
    out = {}
    for gid, ms in doc.get("methods", {}).items():
        if isinstance(ms, list):
            out[str(gid)] = {m for m in ms if m in METHODS}
    return out


def load_packs(w: Path) -> dict[str, int]:
    """The pack each game is put in (1 to 9; a game not listed is in none)."""
    out = {}
    for gid, n in read_toml(w / "studio.toml").get("packs", {}).items():
        if isinstance(n, int) and not isinstance(n, bool) and 1 <= n <= PACKS_MAX:
            out[str(gid)] = n
    return out


def save_studio(w: Path, methods: dict[str, set[str]], packs: dict[str, int]) -> None:
    lines = ["# tools/pack-studio: the music methods marked per game (FM is always there)", "[methods]"]
    for gid in sorted(methods):
        ms = [m for m in METHODS if m in methods[gid]]
        if ms:
            lines.append(f"{json.dumps(gid)} = [{', '.join(json.dumps(m) for m in ms)}]")
    lines += ["", "# the pack each game goes in (1 to 9); a game not listed goes in none", "[packs]"]
    lines += [f"{json.dumps(gid)} = {packs[gid]}" for gid in sorted(packs) if 1 <= packs[gid] <= PACKS_MAX]
    w.mkdir(parents=True, exist_ok=True)
    tmp = w / "studio.toml.tmp"
    tmp.write_text("\n".join(lines) + "\n")
    tmp.replace(w / "studio.toml")


def save_methods(w: Path, methods: dict[str, set[str]]) -> None:
    save_studio(w, methods, load_packs(w))


def save_packs(w: Path, packs: dict[str, int]) -> None:
    save_studio(w, load_methods(w), packs)


# ---------------------------------------------------------------------------------------------
# The packs the owner fills: each game in pack 1 to 9 or in none (W/studio.toml [packs])


def fill_limit(plan: Plan) -> float:
    """The bytes of games a pack holds: the room minus the margin minus the pack's overhead (the
    split's limit)."""
    return plan.room * (1 - MARGIN) - plan.overhead()


def pack_fill(plan: Plan, packs: dict[str, int]) -> dict[int, list[Game]]:
    """The packed games in each pack that has any, in name order."""
    out: dict[int, list[Game]] = {}
    for g in plan.packed():
        n = packs.get(g.id)
        if n:
            out.setdefault(n, []).append(g)
    return dict(sorted(out.items()))


def unassigned(plan: Plan, packs: dict[str, int]) -> list[Game]:
    return [g for g in plan.packed() if not packs.get(g.id)]


def pack_total(games: list[Game]) -> int:
    return sum(g.packed or 0 for g in games)


def over_by(plan: Plan, packs: dict[str, int], gid: str, n: int) -> float:
    """How many bytes pack n would be over its limit with the game put in it (0: it fits)."""
    g = plan.game(gid)
    if g is None or g.left_out or n < 1:
        return 0
    total = sum(x.packed or 0 for x in plan.packed() if packs.get(x.id) == n and x.id != gid) + (g.packed or 0)
    return max(0.0, total - fill_limit(plan))


def auto_fill(plan: Plan, packs: dict[str, int]) -> tuple[dict[str, int], list[str]]:
    """Every packed game in no pack put in the first pack with room for it, in name order;
    returns the packs and the games that fit in none of the nine."""
    out = dict(packs)
    limit = fill_limit(plan)
    totals = {n: pack_total(gs) for n, gs in pack_fill(plan, out).items()}
    left = []
    for g in unassigned(plan, out):
        n = next((n for n in range(1, PACKS_MAX + 1) if totals.get(n, 0) + (g.packed or 0) <= limit), None)
        if n is None:
            left.append(g.id)
            continue
        out[g.id] = n
        totals[n] = totals.get(n, 0) + (g.packed or 0)
    return out, left


def packs_over(plan: Plan, packs: dict[str, int]) -> list[tuple[int, float]]:
    limit = fill_limit(plan)
    return [(n, pack_total(gs) - limit) for n, gs in pack_fill(plan, packs).items() if pack_total(gs) > limit]


def bar(frac: float, width: int, utf8: bool) -> str:
    full = max(0, min(width, round(frac * width)))
    return ("■" * full + "□" * (width - full)) if utf8 else ("#" * full + "." * (width - full))


def pack_lines(plan: Plan, packs: dict[str, int], width: int = 12, utf8: bool = False) -> list[tuple[int, str, bool]]:
    """The packs panel: (pack number, line, over) per pack with games, then (0, the games in no
    pack, False)."""
    limit = fill_limit(plan)
    out = []
    for n, gs in pack_fill(plan, packs).items():
        t = pack_total(gs)
        over = t > limit
        out.append((n, f"P{n} {t / 1024:6.1f}/{limit / 1024:.1f} KB {bar(t / limit if limit > 0 else 1, width, utf8)} "
                       f"{len(gs)} game{'s' if len(gs) != 1 else ''}" + (f"  {kb(t - limit)} over" if over else ""), over))
    un = unassigned(plan, packs)
    if not out:
        n = len(split_packs([(g.id, g.packed) for g in plan.packed()], plan.room, plan.overhead()))
        out.append((0, f"no game put in a pack: b builds the automatic split ({n} pack{'s' if n != 1 else ''}); "
                       "1-9 puts a game in a pack, f fills them", False))
    else:
        out.append((0, f"in no pack: {len(un)} game{'s' if len(un) != 1 else ''}, {kb(pack_total(un))}", False))
    return out


# ---------------------------------------------------------------------------------------------
# The progress bar: the running job's, on the screen's bottom line


SPIN_UTF8, SPIN_ASCII = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏", "|/-\\"  # a job whose progress is not known: a spinner


@dataclass
class Progress:
    """What the bar shows for a job: its label, how far it is (0 to 1; None: not known, a moving
    segment then), its figures ("12/45", "take 2/4 bass 38%") and the time left ("~4 min")."""
    label: str
    frac: float | None = None
    figures: str = ""
    left: str = ""
    spin: str = ""  # with a bar: the running step has no measure, the time it has run ("0:03"), after a spinner


def short_left(seconds: float) -> str:
    if seconds < 60:
        return "<1 min"
    if seconds < 90 * 60:
        return f"~{round(seconds / 60)} min"
    return f"~{seconds / 3600:.1f} h"


def spinner(now: float, utf8: bool) -> str:
    """The spinner's character at now (10 steps a second)."""
    chars = SPIN_UTF8 if utf8 else SPIN_ASCII
    return chars[int(now * 10) % len(chars)]


def render_bar(frac: float | None, width: int, utf8: bool, now: float = 0.0) -> list[tuple[str, bool]]:
    """The bar's cells as (text, filled) runs: frac of width filled, a square a cell (with UTF-8
    ■ filled, □ empty; else # and .), rounded to the nearest cell; frac None (not known): the
    spinner in the first cell, the rest blank."""
    width = max(0, width)
    if frac is None:
        return [r for r in ((spinner(now, utf8)[:width], True), (" " * max(0, width - 1), False)) if r[0]]
    full_ch, empty_ch = ("■", "□") if utf8 else ("#", ".")
    frac = max(0.0, min(1.0, frac))
    n = min(width, int(frac * width + 0.5))
    if 0 < frac and n == 0 and width:
        n = 1  # begun: one square
    runs = [(full_ch * n, True), (empty_ch * (width - n), False)]
    return [r for r in runs if r[0]]


def bar_text(frac: float | None, width: int, utf8: bool, now: float = 0.0) -> str:
    return "".join(t for t, _ in render_bar(frac, width, utf8, now))


BAR_MIN, BAR_SHORT = 10, 4  # the bar's cells before the figures go, and at the least


def progress_line(p: Progress, width: int, utf8: bool, now: float = 0.0) -> list[tuple[str, str]]:
    """The bottom line as (text, part) runs, part one of label, fill, track, figures, gap; at
    most width columns: "finding and judging ■■■□□□□ 12 of 31 games  4:10  ~6 min". On a narrow
    line the time left goes first, then the figures; the bar keeps at least 4 cells, the label
    cut to make room. Progress not known: no bar, the label, the spinner and the figures ("build
    fmzx-pack ⠹ 0:03")."""
    figs = "  ".join(x for x in (p.figures, p.left) if x)
    label = p.label
    if p.frac is None:
        runs = [(label, "label"), (" ", "gap"), (spinner(now, utf8), "fill")]
        if figs:
            runs += [(" ", "gap"), (figs, "figures")]
        out, used = [], 0
        for t, part in runs:  # cut at width
            t = t[:max(0, width - used)]
            if t:
                out.append((t, part))
                used += len(t)
        return out
    spin = f"{spinner(now, utf8)} {p.spin} " if p.spin else ""
    need = lambda f: len(label) + 1 + len(spin) + (1 + len(f) if f else 0)  # noqa: E731
    fig = next((f for f in (figs, p.figures, "") if width - need(f) >= BAR_MIN), "")
    bar_w = width - need(fig)
    if bar_w < BAR_SHORT:
        spin = spin if width - len(spin) - 1 - BAR_SHORT >= 3 else ""
        room = max(0, width - 1 - len(spin) - BAR_SHORT)
        label = label if len(label) <= room else label[:room - 1] + ("…" if utf8 else "~") if room >= 3 else ""
        bar_w = max(1, width - (len(label) + 1 if label else 0) - len(spin))
    runs: list[tuple[str, str]] = []
    if label:
        runs += [(label, "label"), (" ", "gap")]
    if spin:
        runs += [(spin[:-1], "fill"), (" ", "gap")]
    runs += [(t, "fill" if on else "track") for t, on in render_bar(p.frac, bar_w, utf8, now)]
    if fig:
        runs += [(" ", "gap"), (fig, "figures")]
    return runs


# ---------------------------------------------------------------------------------------------
# The learning's progress (fmzx-pack personal's lines on stderr) and the games list while it runs


PROGRESS_PLAN_RE = re.compile(r"^learning (\d+) games: (\d+) from the cache, (\d+) to learn, (\d+) at a time$")
PROGRESS_DONE_RE = re.compile(r"^(loaded|converted|learned|checked) (\d+)/(\d+): (.+)$")
PROGRESS_CHECK_RE = re.compile(r"^checking the chosen takes of (\d+) games?$")
PROGRESS_START_RE = re.compile(r"^(loading|converting|learning): (.+)$")
GAME_EXTS = (".sna", ".z80", ".tap", ".tzx")


def parse_progress(line: str) -> tuple | None:
    """A progress line as ("plan", games, from cache, to learn, at a time), ("check", games),
    ("done", verb, k, n, rest) or ("start", verb, name); None for any other line."""
    s = line.strip()
    if m := PROGRESS_CHECK_RE.match(s):
        return ("check", int(m[1]))
    if m := PROGRESS_PLAN_RE.match(s):
        return ("plan",) + tuple(int(x) for x in m.groups())
    if m := PROGRESS_DONE_RE.match(s):
        return ("done", m[1], int(m[2]), int(m[3]), m[4])
    if m := PROGRESS_START_RE.match(s):
        return ("start", m[1], m[2])
    return None


@dataclass
class LiveRow:
    name: str
    base: str  # the game file's name
    gid: str | None = None  # from the games file
    state: str = "waiting"  # waiting, converting, converted, learning, learned, cached, left out
    how: str = ""  # how it went in, or why it was left out
    seconds: float | None = None
    since: float = 0.0  # when its learning started
    size: int | None = None  # its converted file's bytes (approximate: before packing)
    loads: bool = False  # a "loading:" line named it: its tape load is a step of its own
    checks: bool = False  # it has chosen takes: their check is a step of its own
    done: set = field(default_factory=set)  # its steps done: load, convert, learn, check

    def steps(self) -> tuple[int, int, bool]:
        """Its steps done, its steps known (load when it loads, convert, learn, check when it has
        chosen takes) and whether it is finished (left out, or every step known done)."""
        known = (["load"] if self.loads else []) + ["convert", "learn"] + (["check"] if self.checks else [])
        done = sum(1 for s in known if s in self.done)
        return done, len(known), self.state == "left out" or done == len(known)

    def word(self) -> str:
        """What is in hand for it: loading, converting, learning, checking or waiting."""
        if self.state == "converting":
            return "loading" if self.loads and "load" not in self.done else "converting"
        if self.state == "learning":
            return "learning"
        if "learn" in self.done and self.checks and "check" not in self.done:
            return "checking"
        return "waiting"


def rows_from_folder(folder: Path) -> list[LiveRow]:
    try:
        files = [p for p in folder.iterdir() if p.suffix.lower() in GAME_EXTS and not p.name.startswith(".") and p.is_file()]
    except OSError:
        files = []
    return sorted((LiveRow(p.stem, p.name) for p in files), key=lambda r: (r.name.casefold(), r.base))


def rows_from_games_file(text: str) -> list[LiveRow]:
    try:
        games = tomllib.loads(text).get("game", [])
    except tomllib.TOMLDecodeError:
        return []
    rows = [LiveRow(str(g.get("name", g.get("id", "?"))), PurePosixPath(str(g.get("file", ""))).name, str(g.get("id", "")))
            for g in games if isinstance(g, dict)]
    return sorted(rows, key=lambda r: (r.name.casefold(), r.gid or ""))


def fmt_left(seconds: float) -> str:
    if seconds < 60:
        return "under a minute"
    if seconds < 90 * 60:
        return f"about {round(seconds / 60)} min"
    return f"about {seconds / 3600:.1f} h"


class Live:
    """The games list while fmzx-pack personal runs: a row per game, its state from the progress
    lines (apply), the header (header). Fed from the job's thread, read by the screen's."""

    def __init__(self, rows: list[LiveRow], checks: set[str] | None = None):
        self.lock = threading.Lock()
        self.checks = set(checks or ())  # the games (ids) with chosen takes: fmzx-pack checks them
        for r in rows:
            r.checks = r.checks or (r.gid or "") in self.checks
        self.rows = rows
        self.phase = "start"  # start, loading, converting, learning, checking, done, failed
        self.k = 0
        self.n = 0
        self.to_learn: int | None = None
        self.threads = 1

    def set_rows(self, rows: list[LiveRow]) -> None:
        """New rows (the games file written), each keeping the state of the row of its file (or
        of its name, a row a progress line made); an old row with no new one stays when left out."""
        with self.lock:
            old = list(self.rows)
            for r in rows:
                o = next((o for o in old if o.base == r.base), None) or next((o for o in old if o.name == r.name), None)
                if o:
                    old.remove(o)
                    r.state, r.how, r.seconds, r.since, r.size = o.state, o.how, o.seconds, o.since, r.size or o.size
                    r.loads, r.done = o.loads, set(o.done)
                r.checks = r.checks or (r.gid or "") in self.checks
            self.rows = rows + [o for o in old if o.state == "left out"]

    def _find(self, rest: str, done: bool) -> tuple[LiveRow, str]:
        best, state, best_len = None, "", -1
        for r in self.rows:
            for key in (r.name, r.base):
                if not key:
                    continue
                hit = rest.startswith(key + " (") and rest.endswith(")") if done else rest == key
                if hit and (len(key) > best_len or (len(key) == best_len and best.state in ("learned", "cached", "left out"))):
                    best, best_len = r, len(key)
                    state = rest[len(key) + 2:-1] if done else ""
        if best is None:
            if done and " (" in rest and rest.endswith(")"):
                name, state = rest[:-1].rsplit(" (", 1)
            else:
                name = rest
            best = LiveRow(name, name)
            self.rows.append(best)
        return best, state

    def apply(self, line: str, now: float | None = None) -> bool:
        """Takes a line of the job's output; True when it was a progress line."""
        p = parse_progress(line)
        if p is None:
            return False
        now = time.monotonic() if now is None else now
        with self.lock:
            if p[0] == "plan":
                self.phase, self.n, self.k, self.to_learn, self.threads = "learning", p[1], 0, p[3], max(1, p[4])
            elif p[0] == "check":
                self.phase, self.n, self.k = "checking", p[1], 0
            elif p[0] == "done" and p[1] == "checked":
                self.phase, self.k, self.n = "checking", p[2], p[3]  # the games' states stay as they are
                r, _ = self._find(p[4], True)
                r.checks = True
                r.done.add("check")
            elif p[0] == "start":
                r, _ = self._find(p[2], False)
                if p[1] == "learning":
                    r.state, r.since = "learning", now
                else:
                    r.state = "converting"
                    r.loads = r.loads or p[1] == "loading"
                    self.phase = "loading" if p[1] == "loading" else "converting"
            else:
                _, verb, k, n, rest = p
                r, state = self._find(rest, True)
                self.k, self.n = k, n
                if verb == "learned":
                    self.phase = "learning"
                    r.done.update({"convert", "learn"})
                    if state == "cached":
                        r.state = "cached"
                    else:
                        r.state = "learned"
                        with contextlib.suppress(ValueError):
                            r.seconds = float(state.split()[0])
                else:
                    self.phase = "loading" if verb == "loaded" else "converting"
                    if verb == "loaded":
                        r.loads = True
                    r.done.add("load" if verb == "loaded" else "convert")
                    if state.startswith("left out: "):
                        r.state, r.how = "left out", state[len("left out: "):]
                    else:
                        r.state, r.how = "converted", state
        return True

    def fraction(self) -> float:
        """The steps done of the steps known, over every game (a game left out counts as done)."""
        with self.lock:
            done = known = 0
            for r in self.rows:
                d, k, fin = r.steps()
                done, known = done + (k if fin else d), known + k
        return done / known if known else 0.0

    def estimate(self, now: float) -> float | None:
        """Seconds the learning has left: the games still to learn, at the average time of the
        ones learned (not from the cache), so many at a time; None before one is learned."""
        secs = [r.seconds for r in self.rows if r.state == "learned" and r.seconds is not None]
        if self.to_learn is None or not secs:
            return None
        avg = sum(secs) / len(secs)
        left = self.to_learn - len(secs)
        if left <= 0:
            return 0.0
        busy = [r for r in self.rows if r.state == "learning"]
        work = sum(max(avg * 0.1, avg - (now - r.since)) for r in busy) + max(0, left - len(busy)) * avg
        return work / max(1, min(self.threads, left))

    def header(self, now: float | None = None, dash: str = "-") -> str:
        now = time.monotonic() if now is None else now
        with self.lock:
            if self.phase == "loading":
                return "loading the new game files" + (f": {self.k} of {self.n}" if self.n else "")
            if self.phase == "converting":
                return f"converting {self.k} of {self.n} games" if self.n else "converting the games"
            if self.phase == "learning":
                head = f"learning {self.k} of {self.n} games"
                est = self.estimate(now)
                if est is not None:
                    return head + (f" {dash} {fmt_left(est)} left" if est > 0 else f" {dash} finishing")
                if self.to_learn:
                    return head + f" {dash} {self.to_learn} not learned before: timing the first"
                return head
            if self.phase == "checking":
                return f"checking the chosen takes: {self.k} of {self.n} games"
            if self.phase == "failed":
                return "the learning failed (l: the log)"
            return ""

    def progress(self, now: float | None = None) -> Progress:
        """The bar: the steps done of the steps known over every game (fraction: each game's
        load, conversion, learning and check, as the lines report them, a step being done not
        counted until it is), its phase's label and figures (files or games done of all), and,
        while learning, the time left (estimate)."""
        now = time.monotonic() if now is None else now
        frac = 1.0 if self.phase == "done" else self.fraction()
        with self.lock:
            figs = f"{self.k}/{self.n}" if self.n else ""
            label = {"loading": "loading game files", "converting": "converting games",
                     "checking": "checking chosen takes"}.get(self.phase, "learning games")
            if self.phase == "start":
                return Progress(label, frac, "starting")
            if self.phase == "failed":
                return Progress(label, frac, "failed")
        left = ""
        if self.phase == "learning":
            est = self.estimate(now)
            left = short_left(est) if est else ""
        return Progress(label, frac, figs, left)

    def snapshot(self) -> list[LiveRow]:
        with self.lock:
            return [LiveRow(**vars(r)) for r in self.rows]


LIVE_GLYPHS = {"waiting": ("·", "."), "run": ("▸", ">"), "ok": ("✓", "+"), "cached": ("✓", "+"), "out": ("✗", "x")}
LIVE_LEGEND = (("waiting", "waiting"), ("run", "converting or learning"), ("ok", "learned"), ("cached", "from the cache"),
               ("out", "left out"))


def live_glyph(r: LiveRow, utf8: bool) -> tuple[str, str]:
    """A live row's state as a glyph and its kind (for its colour): waiting (· or ., a converted
    game too), run (▸ or >: converting, learning), ok (✓ or +), cached (✓ or +, dim) and out (✗ or x)."""
    kind = {"converting": "run", "learning": "run", "learned": "ok", "cached": "cached", "left out": "out"}.get(r.state, "waiting")
    return LIVE_GLYPHS[kind][0 if utf8 else 1], kind


