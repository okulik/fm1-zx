HELP_GAMES = "jk move  Enter open  a/s/y AI/SID/AY  A/S/Y all  g generate  r re-learn  b build  l log  ? help  q quit"
HELP_GAME = "jk move  Enter play  space/Esc stop  c choose  a/s/y mark AI/SID/AY  g generate  h/Left back  l log"
HELP_TEXT = "jk/PgUp/PgDn scroll  Home/End  q/Esc back"


def run_ui(st: Studio) -> None:
    import curses
    import locale

    locale.setlocale(locale.LC_ALL, "")
    os.environ.setdefault("ESCDELAY", "25")  # a lone Esc (stop, back) without a second's wait
    curses.wrapper(lambda scr: UI(scr, st, curses).loop())


class UI:
    def __init__(self, scr, st: Studio, curses):
        self.c = curses
        self.scr = scr
        self.st = st
        self.screen = "games"
        self.gi = 0  # games screen cursor
        self.gtop = 0
        self.game: Game | None = None
        self.ci = 0  # game screen cursor (index into its candidate rows)
        self.ctop = 0
        self.text_lines: list[str] = []
        self.text_from = "games"
        self.text_off = 0  # lines up from the end (log) or down from the top (others)
        self.text_kind = ""
        self.confirm_quit = False
        self.quit = False
        with contextlib.suppress(curses.error):
            curses.curs_set(0)
        scr.timeout(200)
        scr.keypad(True)
        self.attr = {"dim": curses.A_DIM, "bold": curses.A_BOLD, "rev": curses.A_REVERSE, "mark": curses.A_BOLD,
                     "warn": curses.A_BOLD}
        if curses.has_colors():
            with contextlib.suppress(curses.error):
                curses.use_default_colors()
                curses.init_pair(1, curses.COLOR_GREEN, -1)
                curses.init_pair(2, curses.COLOR_YELLOW, -1)
                self.attr["mark"] = curses.color_pair(1) | curses.A_BOLD
                self.attr["warn"] = curses.color_pair(2) | curses.A_BOLD

    # -- drawing

    def put(self, y: int, x: int, s: str, attr: int = 0) -> None:
        h, w = self.scr.getmaxyx()
        if y < 0 or y >= h or x >= w or x < 0:
            return
        room = w - x - (1 if y == h - 1 else 0)
        if room <= 0:
            return
        with contextlib.suppress(self.c.error):
            self.scr.addstr(y, x, s.replace("\t", " ")[:room], attr)

    def draw(self) -> None:
        self.scr.erase()
        h, w = self.scr.getmaxyx()
        if h < 4 or w < 16:
            self.put(0, 0, "too small")
            self.scr.refresh()
            return
        getattr(self, f"draw_{'text' if self.screen == 'text' else self.screen}")(h, w)
        self.draw_status(h, w)
        self.scr.refresh()

    def draw_status(self, h: int, w: int) -> None:
        r = self.st.runner
        if self.confirm_quit:
            msg = "jobs are running: quit and stop them? (y/n)"
        elif r.current is not None:
            j = r.current
            msg = f"[{j.title}] " + (f"+{r.waiting()} waiting  " if r.waiting() else "") + (j.progress or r.last_line)
        elif time.monotonic() - self.st.flash_at < 8 and self.st.flash_msg:
            msg = self.st.flash_msg
        else:
            msg = "idle" + (f"  {self.st.flash_msg}" if self.st.flash_msg else "")
        self.put(h - 1, 0, msg.ljust(w), self.attr["rev"])

    def draw_games(self, h: int, w: int) -> None:
        st, p = self.st, self.st.plan
        head = f"pack-studio  {st.folder.name}"
        if p:
            n = len(split_packs([(g.id, g.packed) for g in p.packed()], p.room, p.overhead()))
            head += f"  {len(p.games)} games, {kb(p.used)}, room {kb(p.room)}: {n} pack{'s' if n != 1 else ''}"
        head += f"  ->  {st.w}"
        self.put(0, 0, head, self.attr["bold"])
        self.put(1, 0, "methods: F FM (always)  A AI  S SID  Y AY; a capital: marked", self.attr["dim"])
        self.put(h - 2, 0, HELP_GAMES, self.attr["dim"])
        if not p:
            self.put(3, 2, "learning the games... (the list appears when the plan is ready; l shows the log)")
            return
        rows = h - 5
        if rows <= 0:
            return
        self.gi = max(0, min(self.gi, len(p.games) - 1))
        self.gtop = min(max(self.gtop, self.gi - rows + 1), self.gi)
        self.gtop = max(0, self.gtop)
        for k, g in enumerate(p.games[self.gtop:self.gtop + rows]):
            i = self.gtop + k
            y = 3 + k
            sel = i == self.gi
            base = self.attr["dim"] if g.left_out else 0
            if sel:
                base |= self.attr["rev"]
            line = f"{'>' if sel else ' '} {g.name[:28]:<28} {g.how[:12]:<12} {kb(g.packed):>9}  "
            self.put(y, 0, line.ljust(w), base)
            x = len(line)
            ms = st.marked(g.id)
            for letter, on, can in (("F", True, not g.left_out), ("A", "ai" in ms, g.can_arrange),
                                    ("S", "sid" in ms, g.can_arrange), ("Y", "ay" in ms, g.can_arrange)):
                a = (self.attr["mark"] if on and can else self.attr["dim"]) | (self.attr["rev"] if sel else 0)
                self.put(y, x, letter if on and can else letter.lower(), a)
                x += 2
            self.put(y, x + 1, st.choice_summary(g) + ("" if g.left_out or not g.scores else f"   {g.music}"), base)

    def game_rows(self) -> list[tuple[str, Score | None, str, Candidate | None]]:
        """("head", score, key, None) and ("cand", score, key, candidate) rows."""
        g = self.game
        rows = []
        for s in g.scores or [None]:
            key = s.key if s else WHOLE_GAME
            rows.append(("head", s, key, None))
            rows += [("cand", s, key, c) for c in self.st.candidates(g, s)]
        return rows

    def draw_game(self, h: int, w: int) -> None:
        st = self.st
        if st.plan and st.plan.game(self.game.id):
            self.game = st.plan.game(self.game.id)  # the plan read again
        g = self.game
        self.put(0, 0, f"{g.name}  ({g.id})  {g.how}  {kb(g.packed)}", self.attr["bold"])
        self.put(1, 0, g.music)
        ms = st.marked(g.id)
        if g.can_arrange:
            ml = (f"methods: F FM (always)   A AI {'[x]' if 'ai' in ms else '[ ]'}   "
                  f"S SID {'[x]' if 'sid' in ms else '[ ]'}   Y AY {'[x]' if 'ay' in ms else '[ ]'}")
        else:
            ml = f"{g.plays()}: no score, so no AI, SID or AY; listen to the whole game below"
        self.put(2, 0, ml, self.attr["dim"] if not g.can_arrange else 0)
        self.put(h - 2, 0, HELP_GAME, self.attr["dim"])
        rows = self.game_rows()
        cands = [i for i, r in enumerate(rows) if r[0] == "cand"]
        if not cands:
            return
        self.ci = max(0, min(self.ci, len(cands) - 1))
        sel_row = cands[self.ci]
        avail = h - 6
        if avail <= 0:
            return
        if sel_row - 1 < self.ctop:
            self.ctop = max(0, sel_row - 1)
        if sel_row >= self.ctop + avail:
            self.ctop = sel_row - avail + 1
        ch = st.choices()
        for k, (kind, s, key, c) in enumerate(rows[self.ctop:self.ctop + avail]):
            y = 4 + k
            if kind == "head":
                if s is None:
                    self.put(y, 0, "the whole game (nothing to choose; to listen)", self.attr["bold"])
                else:
                    self.put(y, 0, f"score {s.key}  {s.seconds:.1f} s{'  shadow: replaces the live version when chosen' if s.shadow else ''}"
                             f"   plan: {s.status or '-'}", self.attr["bold"])
                continue
            sel = self.ctop + k == sel_row
            chosen = s is not None and c.choice is not None and ch.get(f"{g.id}/{s.key}", 0) == c.choice
            state = st.state_of(g, key, c)
            if s is not None and f"{g.id}/{s.key}" in st.choosing and c.choice is not None:
                state = "choosing..."
            a = self.attr["rev"] if sel else 0
            self.put(y, 0, (f"{'>' if sel else ' '} {'*' if chosen else ' '} {c.label[:26]:<26} ").ljust(w), a)
            x = 32
            if state:
                st_attr = self.attr["warn"] if state in ("playing", "rendering...", "choosing...") else self.attr["dim"]
                self.put(y, x, f"[{state}] ", st_attr | a)
                x += len(state) + 3
            self.put(y, x, c.info, (self.attr["dim"] if not sel else 0) | a)
            if chosen:
                self.put(y, 2, "*", self.attr["mark"] | a)

    def open_text(self, kind: str) -> None:
        self.text_from = self.screen if self.screen != "text" else self.text_from
        self.screen = "text"
        self.text_kind = kind
        self.text_off = 0

    def text_content(self) -> list[str]:
        if self.text_kind == "log":
            try:
                with self.st.runner.log_path.open("rb") as f:
                    f.seek(0, 2)
                    size = f.tell()
                    f.seek(max(0, size - (256 << 10)))
                    return f.read().decode("utf-8", "replace").splitlines()
            except OSError:
                return ["(no log yet)"]
        if self.text_kind == "summary":
            return self.st.summary or ["(no build yet)"]
        return (__doc__ or "").splitlines()

    def draw_text(self, h: int, w: int) -> None:
        lines = self.text_content()
        title = {"log": f"log: {self.st.runner.log_path}", "summary": "the build", "help": "help"}[self.text_kind]
        self.put(0, 0, title, self.attr["bold"])
        self.put(h - 2, 0, HELP_TEXT, self.attr["dim"])
        rows = h - 3
        if rows <= 0:
            return
        span = max(0, len(lines) - rows)
        self.text_off = max(0, min(self.text_off, span))
        top = span - self.text_off if self.text_kind == "log" else self.text_off
        for k, ln in enumerate(lines[top:top + rows]):
            self.put(1 + k, 0, ln)

    # -- keys

    def key(self, ch: int) -> None:
        c = self.c
        if ch == c.KEY_RESIZE:
            with contextlib.suppress(Exception):
                c.update_lines_cols()
            return
        if self.confirm_quit:
            if ch in (ord("y"), ord("Y")):
                self.quit = True
            self.confirm_quit = False
            return
        getattr(self, f"key_{self.screen}")(ch)

    def ask_quit(self) -> None:
        if self.st.runner.busy():
            self.confirm_quit = True
        else:
            self.quit = True

    def move(self, ch: int, i: int, n: int, page: int) -> int:
        c = self.c
        if ch in (c.KEY_DOWN, ord("j")):
            i += 1
        elif ch in (c.KEY_UP, ord("k")):
            i -= 1
        elif ch == c.KEY_NPAGE:
            i += page
        elif ch == c.KEY_PPAGE:
            i -= page
        elif ch == c.KEY_HOME:
            i = 0
        elif ch == c.KEY_END:
            i = n - 1
        return max(0, min(i, n - 1))

    def key_games(self, ch: int) -> None:
        st, p, c = self.st, self.st.plan, self.c
        h, _ = self.scr.getmaxyx()
        g = p.games[self.gi] if p and p.games and self.gi < len(p.games) else None
        if ch in (ord("q"), ord("Q")):
            self.ask_quit()
        elif ch == ord("l"):
            self.open_text("log")
        elif ch == ord("?"):
            self.open_text("help")
        elif ch == ord("r"):
            st.relearn()
        elif ch == ord("b"):
            st.build()
        elif ch == ord("A"):
            st.toggle_all("ai")
        elif ch == ord("S"):
            st.toggle_all("sid")
        elif ch == ord("Y"):
            st.toggle_all("ay")
        elif ch == ord("g"):
            st.generate()
        elif not g:
            return
        elif ch in (c.KEY_DOWN, c.KEY_UP, c.KEY_NPAGE, c.KEY_PPAGE, c.KEY_HOME, c.KEY_END, ord("j"), ord("k")):
            self.gi = self.move(ch, self.gi, len(p.games), max(1, h - 6))
        elif ch == ord("a"):
            st.toggle(g.id, "ai")
        elif ch == ord("s"):
            st.toggle(g.id, "sid")
        elif ch == ord("y"):
            st.toggle(g.id, "ay")
        elif ch in (10, 13, c.KEY_ENTER, c.KEY_RIGHT):
            if g.left_out:
                st.flash(f"{g.name}: left out ({g.reason or g.how})")
            else:
                self.game, self.ci, self.ctop, self.screen = g, 0, 0, "game"

    def key_game(self, ch: int) -> None:
        st, c, g = self.st, self.c, self.game
        rows = self.game_rows()
        cands = [r for r in rows if r[0] == "cand"]
        h, _ = self.scr.getmaxyx()
        cur = cands[self.ci] if cands and self.ci < len(cands) else None
        if ch in (c.KEY_LEFT, ord("h"), c.KEY_BACKSPACE, 127, 8) or (ch == 27 and st.player.what is None and not st.want_play):
            self.screen = "games"
        elif ch in (27, ord(" ")):
            st.stop()
        elif ch in (ord("q"), ord("Q")):
            self.ask_quit()
        elif ch == ord("l"):
            self.open_text("log")
        elif ch == ord("?"):
            self.open_text("help")
        elif ch == ord("a"):
            st.toggle(g.id, "ai")
        elif ch == ord("s"):
            st.toggle(g.id, "sid")
        elif ch == ord("y"):
            st.toggle(g.id, "ay")
        elif ch == ord("Y"):
            st.toggle_all("ay")
        elif ch == ord("g"):
            st.generate([g.id])
        elif ch == ord("b"):
            st.build()
        elif ch in (c.KEY_DOWN, c.KEY_UP, c.KEY_NPAGE, c.KEY_PPAGE, c.KEY_HOME, c.KEY_END, ord("j"), ord("k")):
            self.ci = self.move(ch, self.ci, len(cands), max(1, h - 8))
        elif cur and ch in (10, 13, c.KEY_ENTER):
            st.play(g, cur[2], cur[3])
        elif cur and ch == ord("c"):
            if cur[1] is None:
                st.flash("the whole game: nothing to choose")
            else:
                st.choose(g, cur[1], cur[3])

    def key_text(self, ch: int) -> None:
        c = self.c
        h, _ = self.scr.getmaxyx()
        page = max(1, h - 4)
        sign = 1 if self.text_kind == "log" else -1  # the log counts from its end
        if ch in (ord("q"), ord("Q"), 27, ord("l"), ord("?"), c.KEY_LEFT, ord("h")):
            self.screen = self.text_from
        elif ch in (c.KEY_UP, ord("k")):
            self.text_off += sign
        elif ch in (c.KEY_DOWN, ord("j")):
            self.text_off -= sign
        elif ch == c.KEY_PPAGE:
            self.text_off += sign * page
        elif ch in (c.KEY_NPAGE, ord(" ")):
            self.text_off -= sign * page
        elif ch == c.KEY_HOME:
            self.text_off = 1 << 30 if sign > 0 else 0
        elif ch == c.KEY_END:
            self.text_off = 0 if sign > 0 else 1 << 30
        self.text_off = max(0, self.text_off)

    def loop(self) -> None:
        st = self.st
        shown = None
        while not self.quit:
            if st.runner.pump() and st.summary is not None and st.summary is not shown:
                shown = st.summary
                self.open_text("summary")
            st.player.poll()
            self.draw()
            try:
                ch = self.scr.getch()
            except KeyboardInterrupt:
                self.ask_quit()
                continue
            if ch != -1:
                self.key(ch)
        st.player.stop()
        st.runner.stop()


