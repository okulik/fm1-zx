def workspace(folder: Path, out: str | None) -> Path:
    """-o W, else: a games file that is a workspace's all/personal-games.toml, that workspace;
    else build/studio/<folder name, or the games file's name without .toml>."""
    if out:
        return Path(out).expanduser().resolve()
    if folder.is_file():
        if folder.name == "personal-games.toml" and folder.parent.name == "all":
            return folder.parent.parent
        return ROOT / "build" / "studio" / folder.stem
    return ROOT / "build" / "studio" / folder.name


def parse_assigns(items: list[str]) -> list[tuple[str, int]]:
    out = []
    for it in items:
        gid, eq, n = it.rpartition("=")
        if not eq or not gid or not n.isdigit() or int(n) > PACKS_MAX:
            die(f"--assign {it}: give GAME=N, N a pack from 1 to {PACKS_MAX} (0: in none)")
        out.append((gid, int(n)))
    return out


def parse_methods(text: str) -> list[str]:
    ms = [m.strip().lower() for m in text.split(",") if m.strip()]
    bad = [m for m in ms if m not in METHODS]
    if bad or not ms:
        die(f"--generate {text}: give one or more of {', '.join(METHODS)}, comma-separated")
    return [m for m in METHODS if m in ms]


def run_try(st: Studio, n: int) -> int:
    d = st.w / f"pack-{n}"
    if not (d / "fmzx.fwsc").is_file():
        print(f"{PROG}: no {d / 'fmzx.fwsc'}: build the packs first (--build)", file=sys.stderr)
        return 1
    print(f"{PROG}: the browser test bench on pack {n}: {st.tools.web_demo} --packages {d}", flush=True)
    try:
        return subprocess.call([st.tools.web_demo, "--packages", str(d)])
    except KeyboardInterrupt:
        return 130


class Terminal:
    """Without the screen, on a terminal: a line per game as its work goes. A game's line
    appears when its work begins (its name, its bar, what is in hand) and is redrawn in place
    while the game is worked on; when the game is done its line is printed for good, the bar
    full (where it stopped when a step failed) and the game's result in place of what was in
    hand, and scrolls up as any output. Only the lines of the games in hand and the activity's
    bar under them are redrawn (five times a second); at the end they are cleared, the printed
    lines stay. A game with nothing to do (the learning takes it from the cache) gets no line.
    Nothing is drawn when stdout is not a terminal."""

    def __init__(self, st: Studio, out=None):
        self.st = st
        self.out = out or sys.stdout
        enc = (getattr(self.out, "encoding", "") or "").upper().replace("UTF8", "UTF-8")
        self.utf8 = "UTF-8" in enc
        self.color = color_wanted(os.environ, os.environ.get("TERM", "") not in ("", "dumb"))
        self.drawn = 0  # the lines drawn last time (redrawn the next)
        self.lock = threading.Lock()
        self.halt: threading.Event | None = None
        self.act = 0  # the activity whose games are printed
        self.printed: set[str] = set()
        self.noted = 0  # the studio's notes printed

    def paint(self, runs: list[tuple[str, str]], kind: str) -> str:
        if not self.color:
            return "".join(t for t, _ in runs)
        bright = {"run": "\x1b[33m", "ok": "\x1b[32m", "err": "\x1b[31m"}.get(kind, "\x1b[2m")
        col = {"fill": bright, "label": bright, "track": "\x1b[2m", "word": "\x1b[2m", "err": "\x1b[31m"}
        return "".join(f"{col[p]}{t}\x1b[0m" if col.get(p) else t for t, p in runs)

    def game_line(self, gb: GameBar | None, name: str, nw: int, width: int, text: str, kind: str) -> str:
        """A game's line: its name, its bar (TERM_BAR cells; none for a note), then text: what is
        in hand (run, dim) or its result (ok; err in red; off dim)."""
        runs = [(f"  {name[:nw]:<{nw}} ", "")]
        if gb is not None:
            runs += [(t, "fill" if on else "track") for t, on in render_bar(1.0 if gb.state == "done" else gb.frac, TERM_BAR, self.utf8)]
        else:
            runs += [(" " * TERM_BAR, "")]
        room = max(0, width - sum(len(t) for t, _ in runs) - 1)
        if len(text) > room:
            text = text[:max(0, room - 1)] + ("…" if self.utf8 else "~")
        if text:
            runs.append((" " + text, {"run": "word", "err": "err", "off": "word"}.get(kind, "")))
        return self.paint(runs, kind)

    def frame(self, now: float, width: int) -> tuple[list[str], list[str]]:
        """The lines to print for good (the games done since the last frame, in the order they
        finished, and the studio's notes) and those to redraw (the games in hand, then the
        activity's bar; none when idle)."""
        a = self.st.activity(now)
        printed = set() if a.key != self.act else self.printed
        nw = min(TERM_NAME, max((len(gb.name) for gb in a.games.values()), default=0))
        keep, new = [], set()
        done = [gb for gb in a.games.values() if gb.state in ("done", "failed") and gb.key not in printed
                and (gb.work or gb.state == "failed")]
        for gb in sorted(done, key=lambda gb: (gb.ended or 0.0, gb.name)):
            res = self.st.result_of(a, gb)
            if res is None:
                continue
            new.add(gb.key)
            keep.append(self.game_line(gb, gb.name, nw, width, res[0], "err" if gb.state == "failed" else res[1]))
        notes = list(self.st.notes)
        for name, text in notes[self.noted:]:
            keep.append(self.game_line(None, name, max(nw, min(TERM_NAME, len(name))), width, text, "ok"))
        live = []
        if a.state != "idle":
            hand = sorted((gb for gb in a.games.values() if gb.state == "run"), key=lambda gb: (gb.started or 0.0, gb.name))
            live = [self.game_line(gb, gb.name, nw, width, " ".join(x for x in (gb.word, gb.figures) if x), "run") for gb in hand]
            kind = {"run": "run", "done": "ok", "failed": "err"}.get(a.state, "")
            live.append(self.paint(progress_line(activity_progress(a, now), width, self.utf8, now), kind))
        self.act, self.printed, self.noted = a.key, printed | new, len(notes)  # the frame is whole: what it printed counts
        return keep, live

    def draw(self, final: bool = False) -> None:
        width = max(16, min(shutil.get_terminal_size((80, 24)).columns - 1, 100))
        with self.lock:
            if self.halt is None and not final:
                return
            try:
                keep, live = self.frame(time.monotonic(), width)
            except Exception:  # noqa: BLE001 - a frame that cannot be drawn is skipped
                return
            if final:
                live = []
            buf = f"\x1b[{self.drawn}F" if self.drawn else ""
            buf += "".join(f"\x1b[2K{ln}\n" for ln in keep + live)
            extra = self.drawn - len(keep) - len(live)
            if extra > 0:
                buf += "\x1b[J" if final else "\x1b[2K\n" * extra + f"\x1b[{extra}F"
            self.drawn = len(live)
            with contextlib.suppress(OSError, ValueError):
                self.out.write(buf)
                self.out.flush()

    def start(self) -> None:
        if self.halt is not None:
            return
        self.halt = threading.Event()

        def loop(halt: threading.Event) -> None:
            while not halt.wait(0.2):
                self.draw()
        threading.Thread(target=loop, args=(self.halt,), daemon=True).start()

    def stop(self) -> None:
        """Stops drawing: the games done since the last frame printed, the lines redrawn cleared."""
        if self.halt is not None:
            with self.lock:
                self.halt.set()
                self.halt = None
        self.draw(final=True)


TERM_NAME, TERM_BAR = 20, 12  # a game's name and its bar on its line without the screen, at most


def cmd_studio(a: argparse.Namespace) -> int:
    folder = Path(a.folder).expanduser().resolve()
    if not folder.exists():
        die(f"no {folder}")
    if folder.is_file() and folder.suffix.lower() != ".toml":
        die(f"{folder}: give a folder of games or a games file (.toml)")
    if a.game and not a.generate and not a.auto:
        die("--game goes with --generate or --auto")
    methods = parse_methods(a.generate) if a.generate else []
    assigns = parse_assigns(a.assign or [])
    w = workspace(folder, a.out)
    w.mkdir(parents=True, exist_ok=True)
    packing = bool(assigns) or a.auto_fill
    headless = a.status or a.build or bool(a.generate) or a.auto or a.try_ is not None or packing
    runner = Runner(w / "studio.log", threaded=not headless)
    log = runner.log_path
    runner.log.session(f"{PROG} {shlex.join(sys.argv[1:] if a.argv is None else a.argv)} (workspace {w})")
    st = Studio(folder, w, a, runner)
    if headless:
        term = Terminal(st) if sys.stdout.isatty() else None

        def drain() -> None:
            if term:
                term.start()
            try:
                runner.drain()
            finally:
                if term:
                    term.stop()

        def fail(msg: str) -> None:
            runner.log.write("studio", f"error: {msg}")
            die(f"{msg} (the log: {log})")
        if a.generate or a.auto or a.build or packing or (a.status and st.plan is None):
            # the learning first only when a step needs the plan before the build makes it
            st.startup(learn=st.plan is None and bool(a.generate or a.auto or packing or not a.build), preview=bool(a.status or a.auto))
            drain()
            start = [j for j in runner.failed if j.chain == "start"]
            if start and (a.generate or a.auto or a.build or packing):
                fail(f"{start[0].title} failed: {fail_reason(start[0])}")
            if not st.tools.fmzx_pack_given and not os.access(st.tools.fmzx_pack, os.X_OK):
                fail("fmzx-pack did not build")
        if packing:
            if st.plan is None:
                fail("no plan: the learning failed")
            for gid, n in assigns:
                if st.plan.game(gid) is None:
                    fail(f"--assign {gid}={n}: no such game (--status lists the ids)")
                st.over_ok = None
                if not st.assign(gid, n):
                    fail(f"--assign {gid}={n}: {st.flash_msg.split('; ')[0]}")
            if a.auto_fill and st.fill():
                print(f"{PROG}: {st.flash_msg}", file=sys.stderr)
            for _, ln, _ in pack_lines(st.plan, st.packs):
                print(ln)
        if a.generate:
            n0 = len(runner.failed)
            k0 = len(runner.jobs)
            st.generate_headless(methods, a.game or [])
            drain()
            if st.errors or runner.failed[n0:]:
                j = runner.failed[n0] if runner.failed[n0:] else None
                fail(f"--generate: {st.errors[0] if st.errors else f'{j.title} failed: {fail_reason(j)}'}")
            for j in runner.jobs[k0:] if term is None else []:  # on a terminal each game's line said it
                if j.kind in TAKES_LABEL and j.watch is not None and j.watch.summary is not None:
                    print(f"  {TAKES_LABEL[j.kind]} takes for {j.game}: {summary_text(j.kind, j.watch.summary)}")
            print(f"{PROG}: generated; choose a take per score on the screen or with tools/arrange-music pick {st.all}")
        if a.auto:
            n0 = len(runner.failed)
            st.auto_headless(a.game or [])
            drain()
            judges = ("judge", "settle")
            if st.errors and not any(j.kind in judges for j in runner.jobs) or any(j.kind in judges for j in runner.failed[n0:]):
                j = next((j for j in runner.failed[n0:] if j.kind in judges), None)
                fail(f"--auto: {st.errors[0] if st.errors else f'{j.title} failed: {fail_reason(j)}'}")
            st.changed()
            games = st.plan.games if st.plan else []
            bare = [g for g in games if not g.left_out and not g.scores and (not a.game or g.id in a.game)]
            if bare:
                print(f"  skipped (no score: nothing to find or judge): {', '.join(g.name for g in bare)}")
            n = {k: sum(st.tune_counts(g)[k] for g in games) for k in ("owner", "judge", "hear", "sure", "unjudged")}
            print(f"{PROG}: judged; {n['owner'] + n['judge']} scores settled ({n['owner']} by you, {n['judge']} by the judge), "
                  f"{n['hear']} to hear: listen on the screen (n: the next game to hear) or with tools/arrange-music pick {st.all}")
        if a.build:
            st.build()
            drain()
            print("\n".join(st.summary or ["no build"]))
            if not st.build_ok:
                print(f"{PROG}: the log: {log}")
                return 1
        if a.status:
            if st.plan is None:
                fail("no plan: the learning failed")
            print("\n".join(st.status_lines()))
        if a.generate or a.auto or a.build:
            print(f"{PROG}: the log: {log}")
        if a.try_ is not None:
            return run_try(st, a.try_)
        return 0
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        die("the studio needs a terminal (or --generate, --build, --status, --try)")
    st.startup(learn=True)
    try:
        run_ui(st)
    finally:
        st.player.stop()
        runner.stop()
    lines = st.summary or pack_summary(w, st.plan)
    if lines:
        print("\n".join(lines))
    print(f"{PROG}: workspace {w}; log {log}")
    return 0


