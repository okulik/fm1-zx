# Earlier learning: the sound caches of other personal packs under build/


CACHE_FILE_RE = re.compile(r"^[0-9a-f]{8}-[A-Za-z0-9._-]+\.bin$")  # fmzx-pack's <crc>-<version>.bin
REUSE_SKIP = {"sound-cache", "arrange", "converted", "previews", "hvsc", "ay", "node_modules", "CMakeFiles"}


def reuse_root() -> Path | None:
    v = os.environ.get("FMZX_REUSE_FROM")
    if v is not None:
        return Path(v) if v else None
    return ROOT / "build"


def earlier_caches(search: Path, exclude: Path, depth: int = 4) -> list[Path]:
    """The sound-cache folders (not links) under search, at most depth folders down, of a personal
    pack's folder (beside a personal-games.toml or a converted/manifest.toml), none inside exclude."""
    out = []
    try:
        ex = exclude.resolve()
    except OSError:
        ex = exclude
    base = len(search.parts)
    for dp, dns, _ in os.walk(search):
        d = Path(dp)
        sc = d / "sound-cache"
        if "sound-cache" in dns and not sc.is_symlink() and sc.is_dir() \
                and ((d / "personal-games.toml").is_file() or (d / "converted" / "manifest.toml").is_file()):
            r = sc.resolve()
            if r != ex and ex not in r.parents:
                out.append(sc)
        dns[:] = sorted(x for x in dns if len(d.parts) - base < depth and not x.startswith(".") and x not in REUSE_SKIP
                        and not (d / x).is_symlink())
    return out


def reuse_caches(search: Path, dest: Path, exclude: Path) -> list[tuple[Path, int]]:
    """Copies the cache files dest lacks from earlier_caches(search, exclude) into dest (never
    one dest has); returns (the folder, files copied) per folder that gave any. A cache file
    names its game by content (fmzx-pack: the converted file's CRC, its key script and overrides,
    and the learner's version), so a copy is the same game's music."""
    dest.mkdir(parents=True, exist_ok=True)
    have = {p.name for p in dest.iterdir()}
    out = []
    for sc in earlier_caches(search, exclude):
        n = 0
        for f in sorted(sc.iterdir()):
            if not CACHE_FILE_RE.match(f.name) or f.name in have or f.is_symlink() or not f.is_file():
                continue
            tmp, target = dest / f".{f.name}.reuse", dest / f.name
            try:
                shutil.copyfile(f, tmp)
                try:
                    os.link(tmp, target)  # fails when it is there: never overwritten
                except FileExistsError:
                    continue
                except OSError:  # no hard links there
                    if target.exists():
                        continue
                    os.replace(tmp, target)
            except OSError:
                continue
            finally:
                tmp.unlink(missing_ok=True)
            have.add(f.name)
            n += 1
        if n:
            out.append((sc.parent, n))
    return out


def shown_path(p: Path) -> str:
    try:
        return str(p.relative_to(ROOT))
    except ValueError:
        return str(p)


