def over_text(over: list[tuple[int, float]]) -> str:
    return "; ".join(f"pack {n} is {kb(b)} over its room" for n, b in over) + ": take a game out (0 on the games screen)"


class Studio:
    def __init__(self, folder: Path, w: Path, args: argparse.Namespace, runner: Runner, tools: Tools | None = None):
        self.folder = folder  # the games folder, or a games file used as written
        self.w = w
        self.all = w / "all"
        self.args = args
        self.runner = runner
        self.tools = tools or Tools.from_env()
        self.plan = load_plan(self.all / "plan.json")
        self.methods = load_methods(w)
        self.packs = load_packs(w)
        self.over_ok: tuple[str, int] | None = None  # the game and pack a second press puts it in over the room
        self.live: Live | None = None  # the games list while the learning runs
        self.live_src: tuple | None = None  # the games file the live rows come from, and its mtime
        self.player = Player()
        self.flash_msg = ""
        self.flash_kind = "info"  # info, ok, err: the bottom line's colour
        self.flash_at = 0.0
        self.version = 0  # counts finished jobs: the screen's caches follow it
        self.rendering: set[str] = set()
        self.failed: dict[str, str] = {}  # preview name -> why its render failed
        self.want_play: str | None = None
        self.choosing: set[str] = set()
        self.waiters: dict[str, list[Callable[[Path], None]]] = {}  # per collection being downloaded
        self.build_run: BuildRun | None = None
        self.summary: list[str] | None = None
        self.build_ok: bool | None = None
        self.errors: list[str] = []  # what stopped a step before it ran (the headless commands report them)
        self._cands: dict[tuple, list[Candidate]] = {}
        self._choices: tuple[int, dict] | None = None
        runner.after = self.job_finished

    # -- messages and data

    def flash(self, msg: str, kind: str = "info") -> None:
        self.flash_msg, self.flash_kind, self.flash_at = msg, kind, time.monotonic()
        if not self.runner.threaded:
            print(f"{PROG}: {msg}", file=sys.stderr, flush=True)

    def fail(self, msg: str) -> None:
        self.errors.append(msg)
        self.flash(msg, "err")

    def games_file(self) -> Path:
        """The games file the packs take their entries from: the one given, else the folder's."""
        return self.folder if self.folder.is_file() else self.all / "personal-games.toml"

    def changed(self, _job: Job | None = None) -> None:
        self.version += 1
        self._cands.clear()
        self._choices = None

    def reload_plan(self) -> None:
        self.plan = load_plan(self.all / "plan.json")
        self.changed()

    def choices(self) -> dict[str, int | str]:
        if self._choices is None or self._choices[0] != self.version:
            self._choices = (self.version, read_choices(self.all))
        return self._choices[1]

    def candidates(self, g: Game, sc: Score | None) -> list[Candidate]:
        k = (g.id, sc.key if sc else WHOLE_GAME)
        if k not in self._cands:
            self._cands[k] = score_candidates(self.all, g.id, sc)
        return self._cands[k]

    def choice_summary(self, g: Game) -> str:
        if g.left_out:
            return f"left out: {g.reason or g.how}"
        if not g.scores:
            return g.plays()
        ch = self.choices()
        return " / ".join(choice_label(ch.get(f"{g.id}/{s.key}", 0)) for s in g.scores)

    def marked(self, gid: str) -> set[str]:
        return self.methods.get(gid, set())

    def sid_dir(self) -> Path | None:
        if self.args.sid_dir:
            p = Path(self.args.sid_dir).expanduser()
            return (find_collection(p) or p) if p.is_dir() else None
        return downloaded_collection(hvsc_root())

    def ay_dir(self) -> Path | None:
        if self.args.ay_dir:
            p = Path(self.args.ay_dir).expanduser()
            return (find_ay_collection(p) or p) if p.is_dir() else None
        return downloaded_ay(ay_root())

    def uv_env(self) -> dict[str, str]:
        return {"UV_OFFLINE": "1"} if self.args.offline else {}

    # -- start and learning

    def startup(self, learn: bool = True, preview: bool = True) -> None:
        if os.environ.get("FMZX_SKIP_DEVICE_BUILD", "0") != "1":
            for preset in ("fm1", "fm1-preview"):
                self.runner.submit(Job(f"device build {preset} (configure)",
                                       [str(ROOT / "tools/fm1-docker"), "cmake", "--preset", preset], chain="start",
                                       kind="setup"))
                self.runner.submit(Job(f"device build {preset}",
                                       [str(ROOT / "tools/fm1-docker"), "cmake", "--build", "--preset", preset],
                                       chain="start", kind="setup"))
        if not self.tools.fmzx_pack_given:
            self.runner.submit(Job("build fmzx-pack", ["cargo", "build", "--release", "-p", "fmzx-pack"],
                                   cwd=ROOT / "host", chain="start", kind="setup"))
        if preview and not self.tools.preview_given:
            def preview_built(j: Job) -> None:
                self.changed()
                if j.rc != 0:
                    self.flash("music-preview did not build: playing the renders tools/arrange-music wrote")
            self.runner.submit(Job("build music-preview", ["cargo", "build", "--release", "-p", "music", "--bin",
                                                           "music-preview"], cwd=ROOT / "host", on_done=preview_built,
                                   kind="setup"))
        if learn:
            self.runner.submit(self.plan_job("start"))

    def plan_job(self, chain: str, then: Callable[[Job], None] | None = None) -> Job:
        """The learning's job (to submit); before a workspace's first plan, a job that copies
        the learning of other personal packs under build/ into W/all/sound-cache goes first."""
        argv = [self.tools.fmzx_pack, "personal", str(self.folder), "-o", str(self.all)]
        for a in apps():
            argv += ["--app", str(a)]
        argv.append("--plan")
        self.all.mkdir(parents=True, exist_ok=True)
        search = reuse_root()
        if search is not None and search.is_dir() and not (self.all / "plan.json").exists():
            def reuse(j: Job) -> int:
                got = reuse_caches(search, self.all / "sound-cache", self.w)
                for d, n in got:
                    j.out(f"reused {n} learned game{'s' if n != 1 else ''} from {shown_path(d)}")
                if not got:
                    j.out(f"no earlier learning to reuse under {shown_path(search)}")
                return 0
            self.runner.submit(Job("reuse earlier learning", fn=reuse, kind="reuse"))
        live = self.live = Live(self.live_rows())

        def done(j: Job) -> None:
            self.reload_plan()
            if j.rc != 0:
                live.phase = "failed"
                self.flash("learning failed (l: the log)", "err")
            elif self.plan is None:
                j.rc = 1
                live.phase = "failed"
                self.flash(f"no plan in {self.all / 'plan.json'} (l: the log)", "err")
            else:
                live.phase = "done"
                if self.live is live:
                    self.live = None
                if then is None:
                    n = len(self.plan.packed())
                    self.flash(f"learned: {len(self.plan.games)} games, {n} packed, {kb(self.plan.used)} "
                               f"for a room of {kb(self.plan.room)}", "ok")
            if then:
                then(j)
        return Job("learn the games (plan)", argv, chain=chain, on_done=done, on_line=live.apply, kind="learn",
                   what="learn the games", detail=lambda: live.header())

    def live_rows(self) -> list[LiveRow]:
        """The rows of the list while learning: the games file's entries when it is there,
        else the folder's game files."""
        gf = self.games_file()
        try:
            st_ = gf.stat()
            self.live_src = (gf, st_.st_mtime_ns)
            rows = rows_from_games_file(gf.read_text())
        except OSError:
            self.live_src = None
            rows = []
        return rows or (rows_from_folder(self.folder) if self.folder.is_dir() else [])

    def refresh_live(self) -> list[LiveRow]:
        """The live rows, the games file read again when it changed, the converted files' sizes
        added (the screen calls this as it draws)."""
        live = self.live
        if live is None:
            return []
        gf = self.games_file()
        try:
            m = gf.stat().st_mtime_ns
        except OSError:
            m = None
        if m is not None and self.live_src != (gf, m):
            live.set_rows(self.live_rows())
        rows = live.snapshot()
        conv = self.all / "converted"
        for r in rows:
            if r.gid and r.size is None and r.state not in ("waiting", "converting", "left out"):
                for ext in ("sna", "z80", "tap"):
                    with contextlib.suppress(OSError):
                        r.size = (conv / f"{r.gid}.{ext}").stat().st_size
                        break
                with live.lock:
                    for o in live.rows:
                        if o.gid == r.gid:
                            o.size = r.size
        return rows

    def relearn(self) -> None:
        self.runner.submit(self.plan_job("plan"))
        self.flash("learning again")

    # -- methods

    def toggle(self, gid: str, method: str) -> None:
        g = self.plan.game(gid) if self.plan else None
        if g is None:
            return
        if not g.can_arrange:
            self.flash(f"{g.name}: " + (f"left out ({g.reason})" if g.left_out else
                                        f"{g.plays()}: no score for AI, SID or AY"))
            return
        ms = self.methods.setdefault(gid, set())
        ms.symmetric_difference_update({method})
        save_methods(self.w, self.methods)

    def toggle_all(self, method: str) -> None:
        if not self.plan:
            return
        gs = [g for g in self.plan.games if g.can_arrange]
        if not gs:
            self.flash("no game has a score: nothing to arrange")
            return
        on = not all(method in self.marked(g.id) for g in gs)
        for g in gs:
            ms = self.methods.setdefault(g.id, set())
            (ms.add if on else ms.discard)(method)
        save_methods(self.w, self.methods)
        self.flash(f"{method.upper()} {'marked' if on else 'unmarked'} for {len(gs)} games")

    # -- packs

    def assigned(self) -> dict[int, list[Game]]:
        """The packs the owner filled (none: the build splits by itself)."""
        return pack_fill(self.plan, self.packs) if self.plan else {}

    def assign(self, gid: str, n: int, force: bool = False) -> bool:
        """Puts the game in pack n (0: in none). A pack it would take over its room refuses it,
        until the same game goes to the same pack again (or force)."""
        p = self.plan
        g = p.game(gid) if p else None
        name = g.name if g else gid
        if g is not None and g.left_out:
            self.flash(f"{g.name}: left out ({g.reason or g.how}), in no pack", "err")
            return False
        if n == 0:
            self.over_ok = None
            if self.packs.pop(gid, None) is not None:
                save_packs(self.w, self.packs)
            self.flash(f"{name}: in no pack")
            return True
        over = over_by(p, self.packs, gid, n) if p and g else 0
        if over > 0 and not force and self.over_ok != (gid, n):
            self.over_ok = (gid, n)
            self.flash(f"{name} ({kb(g.packed)}) does not fit in pack {n}: {kb(over)} over; {n} again: put it there anyway", "err")
            return False
        self.over_ok = None
        self.packs[gid] = n
        save_packs(self.w, self.packs)
        self.flash(f"{name}: pack {n}" + (f", {kb(over)} over its room: no build until a game goes" if over > 0 else ""),
                   "err" if over > 0 else "info")
        return True

    def fill(self) -> list[str]:
        """f: every packed game in no pack put in the first pack with room; returns the games
        that fit in none."""
        if not self.plan:
            self.fail("no plan yet: wait for the learning")
            return []
        new, left = auto_fill(self.plan, self.packs)
        added = sum(1 for g in new if g not in self.packs)
        self.packs = new
        save_packs(self.w, self.packs)
        names = ", ".join(self.plan.game(g).name for g in left)
        self.flash(f"filled: {added} game{'s' if added != 1 else ''} put in packs" + (f"; in none (no room in the {PACKS_MAX} packs): {names}" if left else ""),
                   "err" if left else "ok")
        return left

    def sizes_note(self) -> str:
        """Said when a take was chosen after the last plan (the sizes are the plan's)."""
        try:
            later = (self.all / "arrange" / "choices.toml").stat().st_mtime > (self.all / "plan.json").stat().st_mtime
        except OSError:
            later = False
        return "sizes as of the last learn (a take chosen since: r learns again)" if later else ""

    # -- generating

    def generate(self, ids: list[str] | None = None, methods: tuple[str, ...] = METHODS) -> None:
        """Queues the jobs for the marked methods among methods, for the games with scores (those
        of ids when given)."""
        if not self.plan:
            self.fail("no plan yet: wait for the learning")
            return
        gs = [g for g in self.plan.games if g.can_arrange and (ids is None or g.id in ids)]
        ai, sid, ay = ([g for g in gs if m in methods and m in self.marked(g.id)] for m in METHODS)
        if not ai and not sid and not ay:
            self.fail("nothing marked: a marks AI, s marks SID, y marks AY (FM needs nothing)")
            return
        if not self.tools.arrange_given() and not shutil.which("uv"):
            self.fail("AI, SID and AY takes need uv (https://docs.astral.sh/uv/): tools/arrange-music runs through it")
            return
        errors = len(self.errors)
        counts, total = [], 0
        for g in ai:
            argv = [self.tools.arrange, "generate", str(self.all), "--game", g.id]
            if self.args.model:
                argv += ["--model", self.args.model]
            if self.args.offline:
                argv += ["--offline"]
            self.runner.submit(Job(f"AI takes for {g.name}", argv, env=self.uv_env(), on_done=self.changed, kind="ai",
                                   what="AI takes", game=g.name, gid=g.id))
        if ai:
            counts.append(f"{len(ai)} AI")
            total += len(ai)
        downloads = 0
        for gs_, kind, cmd, opt in ((sid, "SID", "chip", "--sid-dir"), (ay, "AY", "ay", "--ay-dir")):
            if not gs_:
                continue
            state, d, why = self.collection(kind)
            if state == "fail":
                self.fail(why)
                continue
            jobs = [Job(f"{kind} takes for {g.name}", env=self.uv_env(), on_done=self.changed, kind=kind.lower(),
                        what=f"{kind} takes", game=g.name, gid=g.id) for g in gs_]

            def argv_of(j: Job, d: Path, cmd=cmd, opt=opt) -> list[str]:
                return [self.tools.arrange, cmd, str(self.all), "--game", j.gid, opt, str(d)]
            if state == "ready":
                for j in jobs:
                    j.argv = argv_of(j, d)
                    self.runner.submit(j)
            else:
                for j in jobs:
                    j.wait_note = f"after the {kind} collection's download"
                    self.runner.submit(j, hold=True)

                def go(d: Path | None, jobs=jobs, argv_of=argv_of, kind=kind) -> None:
                    for j in jobs:
                        if j.state != "waiting":
                            continue
                        if d is None:
                            self.runner.skip(j, f"the {kind} collection did not download")
                        else:
                            j.argv, j.wait_note = argv_of(j, d), ""
                            self.runner.release(j)
                downloads += self.download(kind, go)
            counts.append(f"{len(gs_)} {kind}")
            total += len(gs_)
        if downloads:
            counts.append(plural(downloads, "download"))
            total += downloads
        if not total:
            return
        msg = f"queued {plural(total, 'job')} ({', '.join(counts)})" + (": J shows them" if self.runner.threaded else "")
        if len(self.errors) > errors:
            self.flash(f"{msg}; {self.errors[-1]}", "err")
        else:
            self.flash(msg)

    def generate_headless(self, methods: list[str], ids: list[str]) -> None:
        """--generate: marks methods for the games given (every game with scores when none) and
        queues their jobs."""
        if not self.plan:
            return self.fail("no plan: the learning failed (see the log)")
        unknown = [g for g in ids if self.plan.game(g) is None]
        if unknown:
            return self.fail(f"--game {', '.join(unknown)}: no such game (--status lists the ids)")
        gs = [self.plan.game(g) for g in ids] if ids else [g for g in self.plan.games if g.can_arrange]
        for g in gs:
            if not g.can_arrange:
                return self.fail(f"--game {g.id}: " + (f"left out ({g.reason})" if g.left_out else
                                                        f"{g.plays()}: no score for AI, SID or AY"))
        if not gs:
            return self.fail("no game has a score: nothing to arrange")
        for g in gs:
            self.methods.setdefault(g.id, set()).update(methods)
        save_methods(self.w, self.methods)
        self.generate([g.id for g in gs], tuple(methods))

    def collection(self, kind: str) -> tuple[str, Path | None, str]:
        """The "SID" or "AY" collection: ("ready", its folder, ""), the one given (--sid-dir,
        --ay-dir) or downloaded before; ("download", None, ""); or ("fail", None, why)."""
        given, opt, find, root = ((self.args.sid_dir, "--sid-dir", self.sid_dir, hvsc_root()) if kind == "SID"
                                  else (self.args.ay_dir, "--ay-dir", self.ay_dir, ay_root()))
        d = find()
        if given:
            return ("ready", d, "") if d else ("fail", None, f"{opt} {given}: no such folder")
        if d:
            return "ready", d, ""
        if self.args.offline:
            return "fail", None, f"{kind}: --offline downloads nothing: give {opt} PATH, or put the collection in {root}"
        return "download", None, ""

    def download(self, kind: str, then: Callable[[Path | None], None]) -> int:
        """Runs then(the collection's folder, or None when it did not download) after the "SID"
        or "AY" collection's download job; returns 1 when it queued that job, 0 when one was
        queued before."""
        find, root = (self.sid_dir, hvsc_root()) if kind == "SID" else (self.ay_dir, ay_root())
        if kind in self.waiters:
            self.waiters[kind].append(then)
            return 0
        self.waiters[kind] = [then]

        def fetch(j: Job) -> int:
            def progress(s: str) -> None:
                j.check()
                j.progress = s
            (fetch_hvsc if kind == "SID" else fetch_ay)(root, progress, j.out)
            return 0

        def fetched(j: Job) -> None:
            waiters = self.waiters.pop(kind, [])
            d = find() if j.rc == 0 else None
            if d is None and not j.cancelled:
                self.flash(f"the {kind} collection did not download (J: its job, l: the log)", "err")
            for t in waiters:
                t(d)
        src = "HVSC" if kind == "SID" else "chris-y/AY"
        self.runner.submit(Job(f"download the {kind} collection ({src})", fn=fetch, on_done=fetched,
                               kind=f"dl-{kind.lower()}", what=f"download {kind} collection", game=src))
        return 1

    # -- the jobs

    def job_finished(self, j: Job) -> None:
        """Each finished job (after its on_done): a cancelled one said, a takes job's result."""
        if j.state == "cancelled":
            self.flash(f"cancelled: {j.title}" + (" (stopped while it ran)" if j.started else ""))
            return
        if j.kind not in TAKES_LABEL:
            return
        label, screen = TAKES_LABEL[j.kind], self.runner.threaded
        if j.rc != 0:
            self.flash(f"{label} takes for {j.game} failed" + (" (J: its output)" if screen else ""), "err")
            return
        sm = j.watch.summary if j.watch else None
        hint = "; Enter on the game to listen" if screen else ""
        if sm is None:
            self.flash(f"{label} takes for {j.game}: done{hint}", "ok")
            return
        n = int(sm["takes"]) if sm.get("takes", "").isdigit() else 0
        if n:
            best = f" (best match {sm['best']})" if sm.get("best", "-") != "-" else " written" if j.kind == "ai" else ""
            self.flash(f"{label} takes for {j.game}: {n}{best}{hint}", "ok")
        else:
            self.flash(f"{label} takes for {j.game}: {summary_text(j.kind, sm)}")

    def cancel_job(self, j: Job) -> None:
        what = self.runner.cancel(j)
        if what == "stopping":
            self.flash(f"stopping: {j.title}")
        elif not what:
            self.flash(f"{j.title}: {j.state}, nothing to cancel")

    def busy_games(self) -> dict[str, str]:
        """The games with a takes job waiting or running: id -> "running" or "waiting"."""
        out: dict[str, str] = {}
        for j in self.runner.jobs:
            if j.gid and j.kind in TAKES_LABEL and j.state in ("waiting", "running"):
                if out.get(j.gid) != "running":
                    out[j.gid] = j.state
        return out

    # -- listening and choosing

    def route(self, g: Game, key: str, c: Candidate) -> tuple[str, Path | None, str]:
        return play_route(self.w, g.id, key, c, self.tools.preview_ok())

    @staticmethod
    def cand_id(g: Game, key: str, c: Candidate) -> str:
        return f"{g.id}__{key}__{c.take}"

    def play(self, g: Game, key: str, c: Candidate) -> None:
        cid = self.cand_id(g, key, c)
        self.player.stop()
        self.want_play = None
        how, path, note = self.route(g, key, c)
        if how == "file":
            err = self.player.play(path, cid)
            self.flash(err or f"playing {c.label} ({note})")
        elif how == "none":
            self.flash(f"{c.label}: {note}")
        else:
            self.want_play = cid
            if cid in self.rendering:
                return
            self.rendering.add(cid)
            self.failed.pop(cid, None)
            path.parent.mkdir(parents=True, exist_ok=True)
            tmp = path.with_name(path.stem + ".tmp.wav")
            argv = preview_argv(self.tools.music_preview, self.all, g.id, key, c.take, tmp)

            def rendered(j: Job) -> None:
                self.rendering.discard(cid)
                if j.cancelled:
                    tmp.unlink(missing_ok=True)
                    if self.want_play == cid:
                        self.want_play = None
                    return
                ok = j.rc == 0 and tmp.is_file()
                if ok:
                    tmp.replace(path)
                else:
                    tmp.unlink(missing_ok=True)
                    lines = [ln.strip() for ln in j.tail if ln.strip() and not ln.startswith("==")]
                    self.failed[cid] = lines[-1] if lines else f"exit {j.rc}"
                if self.want_play != cid:
                    return
                self.want_play = None
                if ok:
                    err = self.player.play(path, cid)
                    self.flash(err or f"playing {c.label} (music-preview)")
                elif c.file and c.file.is_file():
                    err = self.player.play(c.file, cid)
                    self.flash(err or f"render failed ({self.failed[cid]}): playing {c.file.name}")
                else:
                    self.flash(f"{c.label}: render failed: {self.failed[cid]}")
            self.runner.submit(Job(f"render {g.name} {key} {c.take}", argv, on_done=rendered, kind="render", what="render",
                                   game=f"{g.name}: {c.label}", gid=g.id))
            self.flash(f"rendering {c.label}...")

    def stop(self) -> None:
        self.want_play = None
        self.player.stop()

    def state_of(self, g: Game, key: str, c: Candidate) -> str:
        cid = self.cand_id(g, key, c)
        if self.player.what == cid:
            return "playing"
        if cid in self.rendering:
            return "rendering..."
        if cid in self.failed:
            return f"render failed: {self.failed[cid]}"
        how, _, note = self.route(g, key, c)
        return note if how == "none" else ""

    def choose(self, g: Game, sc: Score, c: Candidate) -> None:
        if c.choice is None:
            self.flash(f"{c.label} is there to compare: not a choice")
            return
        sid = f"{g.id}/{sc.key}"
        try:
            write_choice(self.all, sid, c.choice)
        except OSError as e:
            self.flash(f"choosing failed: {e}", "err")
            return
        self.changed()
        with contextlib.suppress(OSError, ValueError):
            self.runner.log.write(f"== chose {choice_label(c.choice)} for {sid}\n")
            self.runner.log.flush()
        self.flash(f"{g.name}: {sc.key} plays {choice_label(c.choice)} (b builds with it)", "ok")

    def toggle_play(self, g: Game, key: str, c: Candidate) -> None:
        """Plays the candidate, or stops it when it is the one playing or being rendered to play."""
        cid = self.cand_id(g, key, c)
        if self.player.what == cid or self.want_play == cid:
            self.stop()
            self.flash(f"stopped {c.label}")
        else:
            self.play(g, key, c)

    # -- building

    def build(self) -> None:
        if self.build_run:
            self.flash("a build is running")
            return
        self.build_run = BuildRun()
        self.summary = None
        self.build_ok = None
        missing = [f for f in device_files() if not f.is_file()]
        if missing:
            return self._finish(f"no {missing[0]}: the device builds make it (FMZX_SKIP_DEVICE_BUILD=1 skipped them)"
                                if os.environ.get("FMZX_SKIP_DEVICE_BUILD", "0") == "1"
                                else f"no {missing[0]}: the device builds did not make it (see the log)")
        over = packs_over(self.plan, self.packs) if self.plan else []
        if over:
            return self._finish(over_text(over))
        self.runner.submit(self.plan_job("build", then=self._split))
        self.flash("building: the plan, then the packs")

    def _split(self, j: Job) -> None:
        br = self.build_run
        if j.rc != 0 or not self.plan:
            return self._finish("the learning failed (see the log)")
        packed = self.plan.packed()
        if not packed:
            return self._finish("no game to pack")
        try:
            br.text = self.games_file().read_text()
            split_games_file(br.text)
        except (OSError, ValueError) as e:
            return self._finish(str(e))
        fill = self.assigned()
        if fill:
            over = packs_over(self.plan, self.packs)
            if over:
                return self._finish(over_text(over) + " (the sizes of this plan)")
            br.assigned = True
            br.numbers = list(fill)
            br.packs = [[g.id for g in gs] for gs in fill.values()]
            br.unassigned = [g.id for g in unassigned(self.plan, self.packs)]
        else:
            br.packs = split_packs([(g.id, g.packed) for g in packed], self.plan.room, self.plan.overhead())
            br.numbers = list(range(1, len(br.packs) + 1))
        self._pack(0)

    def _pack(self, i: int) -> None:
        br = self.build_run
        n = br.numbers[i]
        try:
            src = "../all/personal-games.toml" if not self.folder.is_file() else str(self.folder)
            note = f"Pack {n} of the games in {src}, made by tools/pack-studio on every build:\nedit that file instead."
            text = subset_games_file(br.text, br.packs[i], self.games_file().parent, note)
            d = write_pack_folder(self.w, n, br.packs[i], text)
        except (OSError, ValueError) as e:
            return self._finish(str(e))
        argv = [self.tools.fmzx_pack, "personal", str(d / "personal-games.toml"), "-o", str(d)]
        for a in apps():
            argv += ["--app", str(a)]
        self.runner.submit(Job(f"pack {n} ({len(br.packs[i])} games)", argv, chain="build",
                               on_done=lambda j: self._packed(i, j), kind="pack", what=f"build pack {n}",
                               game=plural(len(br.packs[i]), "game")))

    def _packages(self, i: int) -> None:
        n = self.build_run.numbers[i]
        d = self.w / f"pack-{n}"
        argv = [self.tools.make_packages]
        if self.args.offline:
            argv.append("--offline")
        if self.args.cache:
            argv += ["--cache", str(Path(self.args.cache).expanduser().resolve())]
        env = {"FMZX_SKIP_DEVICE_BUILD": "1", "FMZX_PACKAGES_PACK": str(d / "games.bin"), "FMZX_PACKAGES_OUT": str(d)}

        def done(j: Job) -> None:
            if j.rc != 0:
                return self._finish(f"pack {n}'s packages failed (see the log)")
            self.build_run.built = i + 1
            return self._pack(i + 1) if i + 1 < len(self.build_run.packs) else self._finish(None)
        self.runner.submit(Job(f"pack {n}: the packages and their verify", argv, env=env, chain="build", on_done=done,
                               kind="pack", what=f"pack {n}'s packages", game="fmzx.fwsc, fmzx-preview.fwsc"))

    def _packed(self, i: int, j: Job) -> None:
        br = self.build_run
        n = br.numbers[i]
        if j.rc == 0:
            return self._packages(i)
        if NOT_FIT not in j.text():
            return self._finish(f"pack {n} failed (see the log)")
        if br.assigned:
            return self._finish(f"pack {n} does not fit (the log says by how much): take a game out of it")
        # the automatic split: the pack's last game goes to the next pack
        if len(br.packs[i]) == 1:
            br.too_big.append(br.packs.pop(i)[0])
            br.numbers = list(range(1, len(br.packs) + 1))
            return self._pack(i) if i < len(br.packs) else self._finish(None)
        last = br.packs[i].pop()
        if i + 1 == len(br.packs):
            br.packs.append([])
            br.numbers = list(range(1, len(br.packs) + 1))
        br.packs[i + 1].insert(0, last)
        self.runner._line(j, f"== pack {n} does not fit: {last} goes to pack {n + 1}")
        self._pack(i)

    def _finish(self, error: str | None) -> None:
        br = self.build_run
        br.error = error
        lines = []
        if error is None:
            for d in remove_stale_packs(self.w, set(br.numbers)):
                lines.append(f"removed {d} (not one of the packs built)")
        lines += pack_summary(self.w, self.plan)
        names = lambda ids: ", ".join((self.plan.game(g).name if self.plan and self.plan.game(g) else g) for g in ids)  # noqa: E731
        if br.too_big:
            lines.append(f"in no pack (too big for a pack of its own): {names(br.too_big)}")
        if br.unassigned and error is None:
            k = len(br.unassigned)
            lines.append(f"not built, in no pack: {k} game{'s' if k != 1 else ''}: {names(br.unassigned)}")
        if self.plan:
            out = [g for g in self.plan.games if g.left_out]
            if out:
                lines.append("left out: " + "; ".join(f"{g.name} ({g.reason or g.how})" for g in out))
        if error:
            lines.append(f"build failed: {error}")
        else:
            lines.append(f"built {len(br.packs)} pack{'s' if len(br.packs) != 1 else ''}: install a pack's fmzx.fwsc "
                         "as docs/install.md describes")
        self.summary = lines
        self.build_ok = error is None and not br.too_big
        self.build_run = None
        self.changed()
        self.flash("build done" if error is None else f"build failed: {error}", "ok" if error is None else "err")

    # -- text for --status

    def status_lines(self) -> list[str]:
        p = self.plan
        out = [f"workspace {self.w}"]
        if p is None:
            return out + ["no plan yet"]
        packed = p.packed()
        fill = self.assigned()
        if fill:
            est = [(n, [g.id for g in gs]) for n, gs in fill.items()]
        else:
            est = list(enumerate(split_packs([(g.id, g.packed) for g in packed], p.room, p.overhead()), 1))
        out.append(f"room {kb(p.room)}; all games {kb(p.used)}; a build makes {len(est)} pack{'s' if len(est) != 1 else ''}"
                   + (" (the packs filled)" if fill else " (the automatic split)"))
        sd = self.sid_dir()
        out.append("SID collection: " + (str(sd) if sd else "none: given with --sid-dir" if self.args.sid_dir
                                         else "none (--offline)" if self.args.offline
                                         else f"downloaded to {hvsc_root()} on the first SID job"))
        ad = self.ay_dir()
        out.append("AY collection: " + (str(ad) if ad else "none: given with --ay-dir" if self.args.ay_dir
                                        else "none (--offline)" if self.args.offline
                                        else f"downloaded to {ay_root()} on the first AY job"))
        out.append("listening: " + ("music-preview" if self.tools.preview_ok()
                                    else "tools/arrange-music's renders (music-preview is not built)"))
        ch = self.choices()
        for g in p.games:
            out.append("")
            if g.left_out:
                out.append(f"{g.name} ({g.id})  left out: {g.reason or g.how}")
                continue
            ms = ["FM"] + [m.upper() for m in METHODS if m in self.marked(g.id)]
            pk = self.packs.get(g.id)
            out.append(f"{g.name} ({g.id})  {g.how}  {kb(g.packed)}  methods: {' '.join(ms)}  pack: {f'P{pk}' if pk else '-'}")
            out.append(f"  {g.music}")
            groups = [(s, s.key) for s in g.scores] or [(None, WHOLE_GAME)]
            if not g.scores:
                out.append(f"  {g.plays()}")
            for s, key in groups:
                if s:
                    chosen = ch.get(f"{g.id}/{s.key}", 0)
                    out.append(f"  score {s.key}  {s.seconds:.1f} s{'  shadow' if s.shadow else ''}  "
                               f"plan: {s.status or '-'}  choice: {choice_label(chosen)}")
                else:
                    chosen = None
                for c in self.candidates(g, s):
                    how, path, note = self.route(g, key, c)
                    if how == "file":
                        play = f"plays {path.name if note != 'music-preview' else 'its preview'}"
                    else:
                        play = "plays a music-preview render" if how == "render" else note
                    mark = "*" if s and c.choice is not None and c.choice == chosen else " "
                    out.append(f"   {mark} {c.label:<26} {c.info}  [{play}]")
        out.append("")
        out.append("packs:" + (f" ({self.sizes_note()})" if self.sizes_note() else ""))
        out += [f"  {ln}" for _, ln, _ in pack_lines(p, self.packs)]
        out.append("a build makes:")
        names = {g.id: g.name for g in packed}
        sizes = {g.id: g.packed for g in packed}
        for n, ids in est:
            out.append(f"  pack {n}: {', '.join(names[g] for g in ids)} ({kb(sum(sizes[g] for g in ids) + p.overhead())})")
        if fill:
            un = unassigned(p, self.packs)
            if un:
                out.append(f"  not built, in no pack: {', '.join(g.name for g in un)}")
        built = pack_summary(self.w, p)
        if built:
            out.append("built:")
            out += [f"  {ln}" for ln in built]
        return out


