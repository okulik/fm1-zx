# ---------------------------------------------------------------------------------------------
# The plan (plan.json, written by fmzx-pack personal --plan)


@dataclass
class Score:
    key: str
    shadow: bool
    seconds: float
    status: str


@dataclass
class Game:
    id: str
    name: str
    file: str
    how: str
    packed: int | None
    reason: str | None
    music: str
    scores: list[Score]

    @property
    def left_out(self) -> bool:
        return self.packed is None

    @property
    def can_arrange(self) -> bool:
        return bool(self.scores) and not self.left_out

    @property
    def no_music(self) -> bool:
        """No music found: no score, no shadow score, no routine learned."""
        return not self.scores and self.music.startswith("no music")

    def plays(self) -> str:
        """What plays for a game with nothing to arrange."""
        if self.no_music:
            return "no music"
        return "nothing to arrange: FM from code" if self.music.startswith("music learned") else "beeper"


@dataclass
class Plan:
    room: int
    used: int
    games: list[Game]

    def game(self, gid: str) -> Game | None:
        return next((g for g in self.games if g.id == gid), None)

    def packed(self) -> list[Game]:
        """The packed games in name order (the picker's: A to Z, case not counting)."""
        return sorted((g for g in self.games if not g.left_out), key=lambda g: (g.name.casefold(), g.id))

    def overhead(self) -> int:
        """The pack's bytes beyond its games' (header, directory, shared tables)."""
        return max(0, self.used - sum(g.packed or 0 for g in self.games))


def parse_plan(doc: dict) -> Plan:
    games = []
    for r in doc.get("games", []):
        scores = [Score(str(s["key"]), bool(s.get("shadow", False)), float(s.get("seconds", 0.0)), str(s.get("status", "")))
                  for s in (r.get("scores") or [])]
        packed = r.get("packed")
        games.append(Game(str(r["id"]), str(r.get("name", r["id"])), str(r.get("file", "")), str(r.get("how", "")),
                          None if packed is None else int(packed), r.get("reason"), str(r.get("music", "")), scores))
    return Plan(int(doc.get("room", 0)), int(doc.get("used", 0)), games)


def load_plan(path: Path) -> Plan | None:
    try:
        return parse_plan(json.loads(path.read_text()))
    except (OSError, ValueError, KeyError, TypeError):
        return None


# ---------------------------------------------------------------------------------------------
# Choices, takes and candidates (W/all/arrange/, tools/arrange-music's layout)


def read_toml(path: Path) -> dict:
    try:
        with path.open("rb") as f:
            return tomllib.load(f)
    except (OSError, tomllib.TOMLDecodeError):
        return {}


def read_toml_head(path: Path) -> dict:
    """A take's arranged.toml without its notes: the keys and tables before the first [[...]]
    (the notes are most of the file, and the screens need only what comes before them)."""
    try:
        with path.open(encoding="utf-8") as f:
            head = []
            for line in f:
                if line.startswith("[["):
                    break
                head.append(line)
        return tomllib.loads("".join(head))
    except (OSError, UnicodeDecodeError, tomllib.TOMLDecodeError):
        return read_toml(path)


def parse_choice(v) -> int | str | None:
    if isinstance(v, bool):
        return None
    if isinstance(v, int):
        return v if v >= 0 else None
    if isinstance(v, str):
        if v.isdigit():
            return int(v)
        if re.fullmatch(r"(chip|ay)-[1-9][0-9]*", v):
            return v
    return None


def read_choice_tables(all_dir: Path) -> tuple[dict[str, int | str], dict[str, int | str]]:
    """all/arrange/choices.toml's [choices] (every choice) and [judged] (those tools/arrange-music
    judge --apply made: a choice is the judge's while [judged] holds the same value for it)."""
    doc = read_toml(all_dir / "arrange" / "choices.toml")
    out = []
    for table in ("choices", "judged"):
        t = {}
        for k, v in (doc.get(table) or {}).items():
            c = parse_choice(v)
            if c is not None:
                t[str(k)] = c
        out.append(t)
    return out[0], out[1]


def read_choices(all_dir: Path) -> dict[str, int | str]:
    return read_choice_tables(all_dir)[0]


def write_choice(all_dir: Path, sid: str, choice: int | str) -> None:
    """Sets "<game>/<key>" to choice in all/arrange/choices.toml as the owner's, as tools/arrange-music
    pick --set does (the other choices kept, sorted by key; 0 the original; the judge's mark on
    this one gone, its others kept), atomically."""
    path = all_dir / "arrange" / "choices.toml"
    ch, judged = read_choice_tables(all_dir)
    ch[sid] = choice
    judged = {k: v for k, v in judged.items() if k != sid and ch.get(k) == v}
    lines = ["[choices]"] + [f"{json.dumps(k)} = {json.dumps(v)}" for k, v in sorted(ch.items())]
    if judged:
        lines += ["", "[judged]"] + [f"{json.dumps(k)} = {json.dumps(v)}" for k, v in sorted(judged.items())]
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".toml.tmp")
    tmp.write_text("\n".join(lines) + "\n")
    tmp.replace(path)


def choice_label(c: int | str | None) -> str:
    if c in (None, 0):
        return "original"
    return f"take-{c}" if isinstance(c, int) else str(c)


def numbered(d: Path, prefix: str) -> list[tuple[int, Path]]:
    out = []
    for p in d.glob(prefix + "*"):
        n = p.name[len(prefix):]
        if n.isdigit() and (p / "arranged.toml").is_file():
            out.append((int(n), p))
    return sorted(out)


JUDGE_FILE = "judge.toml"  # tools/arrange-music judge's figures, beside each score.toml


def score_digest(path: Path) -> str:
    """score.toml's digest as tools/arrange-music takes it: SHA-256 of its lines but the comment
    lines, 16 hex digits."""
    import hashlib

    try:
        lines = path.read_bytes().splitlines(keepends=True)
    except OSError:
        return ""
    return hashlib.sha256(b"".join(ln for ln in lines if not ln.startswith(b"#"))).hexdigest()[:16]


def take_names(d: Path) -> list[tuple[str, Path]]:
    """A score's takes as the judge names them: take-<n>, chip-<n>, ay-<n>."""
    return [(f"{pre}{n}", p) for pre in ("take-", "chip-", "ay-") for n, p in numbered(d, pre)]


def read_judge(d: Path) -> dict:
    """A score's judge.toml (d: its folder), with "fresh": whether it still fits the score and
    its takes (the same score.toml, the same takes, each with the same arranged.toml); {} when
    there is none."""
    import hashlib

    doc = read_toml(d / JUDGE_FILE)
    if not doc or not isinstance(doc.get("take"), list):
        return {}
    rows = {str(t.get("name")): t for t in doc["take"]}
    takes = take_names(d)
    fresh = doc.get("score") == score_digest(d / "score.toml") and set(rows) == {"0"} | {n for n, _ in takes}
    for n, p in takes:
        if not fresh:
            break
        try:
            fresh = hashlib.sha256((p / "arranged.toml").read_bytes()).hexdigest()[:16] == rows[n].get("digest")
        except OSError:
            fresh = False
    doc["fresh"] = fresh
    doc["rows"] = rows
    return doc


def judge_text(j: dict, original: bool = False) -> str:
    """A take's judge figures in words: "close 97%, quality 62%, #1 the judge's pick; plays only
    a fragment: ..." (the original: no closeness)."""
    text = ("" if original else f"close {pct(j.get('closeness'))}, ") + f"quality {pct(j.get('quality'))}, #{j.get('rank', '?')}"
    if j.get("rank") == 1:
        text += " the judge's pick"
    faults = j.get("faults") or []
    return text + ("; " + "; ".join(faults) if faults else "")


def metrics_line(m: dict) -> str:
    f = lambda k: float(m.get(k, 0) or 0)  # noqa: E731
    return (f"key {m.get('key') or '?'}; consonance bass {f('bass_consonance'):.2f} pad {f('pad_consonance'):.2f}; "
            f"notes/s lead {m.get('lead_nps', 0)} bass {m.get('bass_nps', 0)} pad {m.get('pad_nps', 0)} "
            f"drums {m.get('drums_nps', 0)}")


@dataclass
class Candidate:
    label: str
    take: str  # the preview's take: "beeper", "fm" (the whole game), "0", "<n>", "chip-<n>", "c64-<n>", "ay-<n>", "zx128-<n>"
    choice: int | str | None  # the value for pick --set; None: not a choice
    info: str
    file: Path | None = None  # tools/arrange-music's render, played without music-preview
    source: Path | None = None  # a preview older than this is made again
    direct: bool = False  # always the file (the C64's or the Spectrum 128's own sound)
    judge: dict | None = None  # its row in the score's judge.toml (None: not judged)

    def text(self) -> str:
        """Its info as --status prints it: the judge's figures first."""
        if self.judge is None:
            return self.info
        return f"{judge_text(self.judge, original=self.take == '0')}; {self.info}"


CLOSE_SAME, CLOSE_PARTIAL = 0.5, 0.2  # the judge's closeness: the same tune from 50%, part of it from 20%
WEAK_CLOSE = CLOSE_PARTIAL  # a best closeness under this is probably another tune


def pct(x: float | str | None) -> str:
    """A figure (0 to 1) as a whole percentage: "73%", "<1%" under half a percent, "0%"."""
    try:
        v = float(x)
    except (TypeError, ValueError):
        return "-"
    if v <= 0:
        return "0%"
    return "<1%" if v < 0.005 else f"{whole_pct(v)}%"


def whole_pct(v: float) -> int:
    return int(v * 100 + 0.5 + 1e-9)  # half up: 0.005 is 1%


def close_band(x: float) -> str:
    """A closeness's colour on the game screen: ok (50% and up, the same tune), warn (20-49%,
    part of it), dim (under 20%, another tune)."""
    p = whole_pct(x)  # as shown
    return "ok" if p >= CLOSE_SAME * 100 else "warn" if p >= CLOSE_PARTIAL * 100 else "dim"


WHOLE_GAME = "game"  # the preview key of a game without scores


def score_candidates(all_dir: Path, gid: str, sc: Score | None) -> list[Candidate]:
    if sc is None:
        return [Candidate("beeper", "beeper", None, "the game's own sound"),
                Candidate("FM (from code/memory)", "fm", None, "what FM: engines plays")]
    d = all_dir / "arrange" / gid / sc.key
    rows = read_judge(d).get("rows", {})
    out = [Candidate("beeper", "beeper", None, "the game's own sound, to compare", source=d / "score.toml"),
           Candidate("FM (from code/memory)", "0", 0,
                     "take 0: the live version (the routine)" if sc.shadow else "take 0: the original",
                     d / "original.wav", d / "score.toml", judge=rows.get("0"))]
    for n, p in numbered(d, "take-"):
        doc = read_toml_head(p / "arranged.toml")
        gen = str(doc.get("generator", "")).split(" ")[0]
        out.append(Candidate(f"AI take-{n}" + (f" ({gen})" if gen else ""), str(n), n,
                             metrics_line(doc.get("metrics", {})), p / "fm1.wav", p / "arranged.toml", judge=rows.get(f"take-{n}")))
    for n, p in numbered(d, "chip-"):
        doc = read_toml_head(p / "arranged.toml")
        out.append(Candidate(f"SID chip-{n}", f"chip-{n}", f"chip-{n}", str(doc.get("source", "?")), p / "fm1.wav",
                             p / "arranged.toml", judge=rows.get(f"chip-{n}")))
        if (p / "chip.wav").is_file():
            out.append(Candidate(f"C64 original (chip-{n})", f"c64-{n}", None, "the C64's own sound (sidplayfp)",
                                 p / "chip.wav", direct=True))
    for n, p in numbered(d, "ay-"):
        doc = read_toml_head(p / "arranged.toml")
        out.append(Candidate(f"AY ay-{n}", f"ay-{n}", f"ay-{n}", str(doc.get("source", "?")), p / "fm1.wav",
                             p / "arranged.toml", judge=rows.get(f"ay-{n}")))
        if (p / "ay.wav").is_file():
            out.append(Candidate(f"Spectrum 128 original (ay-{n})", f"zx128-{n}", None, "the Spectrum 128's own sound (ffmpeg)",
                                 p / "ay.wav", direct=True))
    return out


def preview_path(w: Path, gid: str, key: str, take: str) -> Path:
    return w / "previews" / f"{gid}__{key}__{take}.wav"


def preview_argv(tool: str, all_dir: Path, gid: str, key: str, take: str, out: Path) -> list[str]:
    a = [tool, str(all_dir), "--game", gid]
    if key != WHOLE_GAME:
        a += ["--score", key]
    if take == "beeper":
        a += ["--beeper"]
    elif take != "fm":
        a += ["--take", take]
    return a + ["-o", str(out)]


SILENT_PEAK = 16 / 32768  # a render whose peak is under this (of full scale) is silent


def wav_level(path: Path) -> tuple[float, float] | None:
    """A PCM WAV's peak (0 to 1 of full scale) and its length in seconds; None when it does not
    read as one (then it is played, not judged)."""
    import array
    import wave

    try:
        with wave.open(str(path), "rb") as f:
            n, sw, rate = f.getnframes(), f.getsampwidth(), f.getframerate()
            data = f.readframes(n)
    except (OSError, EOFError, wave.Error):
        return None
    secs = n / rate if rate else 0.0
    if sw == 1:
        return (max((abs(b - 128) for b in data), default=0) / 128, secs)
    if sw not in (2, 4):
        return None
    a = array.array("h" if sw == 2 else "i")
    if a.itemsize != sw:
        return None
    a.frombytes(data[:len(data) // sw * sw])
    if sys.byteorder == "big":
        a.byteswap()
    return (max(max(a, default=0), -min(a, default=0)) / (1 << (8 * sw - 1)), secs)


def play_route(w: Path, gid: str, key: str, c: Candidate, preview_ok: bool,
               renderer_mtime: float = 0.0) -> tuple[str, Path | None, str]:
    """How a candidate plays: ("file", path, note), ("render", preview path, note) or
    ("none", None, why). A preview is rendered again when its take's (or score's) file, or the
    renderer (music-preview, renderer_mtime), is newer than it."""
    if c.direct:
        return ("file", c.file, c.file.name) if c.file and c.file.is_file() else ("none", None, f"no {c.file.name if c.file else 'file'}")
    if preview_ok:
        out = preview_path(w, gid, key, c.take)
        try:
            made = out.stat().st_mtime if out.is_file() else None
            fresh = made is not None and made >= renderer_mtime and (
                c.source is None or not c.source.exists() or made >= c.source.stat().st_mtime)
        except OSError:
            fresh = False
        return ("file", out, "music-preview") if fresh else ("render", out, "music-preview")
    if c.file and c.file.is_file():
        note = f"{c.file.name} (General MIDI render)" if c.file.name == "original.wav" else c.file.name
        return "file", c.file, note
    if c.file is None:
        return "none", None, "nothing to play: music-preview is not built"
    return "none", None, f"nothing to play: no {c.file.name} (music-preview is not built; FluidSynth renders)"


