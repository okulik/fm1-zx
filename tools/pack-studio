              and job_detail(j2, 0) == "taken off the queue",
              "jobs: the others run; a finished job cannot be cancelled; a held one skipped with why")
        rt = Runner(t / "jobs-threaded.log", threaded=True)
        slow = rt.submit(Job("slow", [py, "-c", "import time; print('started', flush=True); time.sleep(60)"]))

        def blocks(j: Job) -> int:
            for i in range(1200):
                j.out(f"block {i}")
                time.sleep(0.05)
            return 0
        fnj = rt.submit(Job("blocks", fn=blocks))
        after = rt.submit(Job("after", [py, "-c", "print('after')"]))

        def until(cond: Callable[[], bool], secs: float) -> bool:
            end = time.monotonic() + secs
            while time.monotonic() < end and not cond():
                time.sleep(0.02)
            return cond()
        ok = until(lambda: slow.state == "running" and "started" in slow.text(), 10)
        t0 = time.monotonic()
        stopping = rt.cancel(slow)
        ok = ok and until(lambda: fnj.state == "running", 10)
        took = time.monotonic() - t0
        check(ok and stopping == "stopping" and slow.state == "cancelled" and slow.rc != 0 and took < 5
              and job_detail(slow, 0) == "stopped while it ran" and "== slow: cancelled" in slow.text(),
              f"jobs: x then y on the running job stops its process ({took:.1f} s), marked cancelled; the next one starts")
        ok = until(lambda: "block 3" in fnj.text(), 10) and rt.cancel(fnj) == "stopping"
        check(ok and until(lambda: after.state == "done", 10) and fnj.state == "cancelled",
              "jobs: a function job (a download) stops at its next line; the queue goes on")
        rt.pump()

        # g: what it queues and says; SID takes held for the collection's download, skipped when it fails
        args = parse_args([str(games), "-o", str(w)])
        os.environ["FMZX_HVSC_DIR"], os.environ["FMZX_HVSC_API"] = str(t / "hvsc-none"), "http://127.0.0.1:9/none.json"
        rg = Runner(t / "jobs-g.log", threaded=False)
        sg = Studio(games.resolve(), w, args, rg)
        sg.methods = {"alpha": {"sid", "ai"}}
        with contextlib.redirect_stderr(io.StringIO()):
            sg.generate()
        sidj = next((j for j in rg.jobs if j.kind == "sid"), None)
        check(sg.flash_msg == "queued 3 jobs (1 AI, 1 SID, 1 download)" and sidj is not None and sidj.state == "waiting"
              and sidj not in rg.pending and sidj.wait_note == "after the SID collection's download"
              and [j.kind for j in rg.pending] == ["ai", "dl-sid"] and sg.busy_games() == {"alpha": "waiting"},
              f"g: says what it queued ({sg.flash_msg}); the SID job held for the download; the game marked")
        with contextlib.redirect_stderr(io.StringIO()), contextlib.redirect_stdout(io.StringIO()):
            rg.drain()
        dl = next(j for j in rg.jobs if j.kind == "dl-sid")
        check(dl.state == "failed" and sidj.state == "skipped" and sidj.skip_note == "the SID collection did not download"
              and sg.busy_games() == {} and job_detail(dl, 0).startswith("exit 1"),
              f"g: the download fails, the SID job skipped ({sidj.state}: {sidj.skip_note})")
        os.environ["FMZX_HVSC_DIR"] = env["FMZX_HVSC_DIR"]
        del os.environ["FMZX_HVSC_API"]
        rg.threaded = True  # the screen's words
        fin = Job("SID takes for Alpha", kind="sid", game="Alpha", gid="alpha")
        for ln in SAMPLE_SID.replace("@@\n", "").splitlines():
            fin.watch.feed(ln)
        fin.rc, fin.state = 0, "done"
        sg.job_finished(fin)
        msg1 = sg.flash_msg
        none = Job("SID takes for Bravo", kind="sid", game="Bravo", gid="bravo")
        for ln in SAMPLE_SID_NONE.splitlines():
            none.watch.feed(ln)
        none.rc, none.state = 0, "done"
        sg.job_finished(none)
        check(msg1 == "SID takes for Alpha: 3 (best match 0.73); Enter on the game to listen"
              and sg.flash_msg == "SID takes for Bravo: no C64 tune found by that name",
              f"jobs: a finished takes job says its result ({msg1}; {sg.flash_msg})")

        # -- the screen, in a pseudo-terminal: keys, a resize down to 3x10, quit
        import fcntl
        import pty
        import struct
        import termios

        def size(fd: int, rows: int, cols: int) -> None:
            fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", rows, cols, 0, 0))

        pid, fd = pty.fork()
        if pid == 0:
            os.environ["TERM"] = "xterm-256color"
            try:
                os.execv(sys.executable, [sys.executable, str(Path(__file__).resolve()), str(games), "-o", str(w)])
            finally:
                os._exit(127)
        size(fd, 24, 100)
        os.kill(pid, signal.SIGWINCH)
        out, status = _wait_pty(fd, pid, 2.0)
        keys = [b"j", b"k", b"y", b"y", b"\r", b"j", b"j", b"j", b"\r", b" ", b"c", b"y", b"y", b"l", b"k", b"q", b"h", b"?", b"q"]
        for k in keys:
            os.write(fd, k)
            o, status = _wait_pty(fd, pid, 0.15)
            out += o
        for rows, cols in ((10, 30), (3, 10), (1, 1), (30, 120)):
            size(fd, rows, cols)
            os.kill(pid, signal.SIGWINCH)
            o, status = _wait_pty(fd, pid, 0.4)
            out += o
        os.write(fd, b"\x1b[B\x1b[B\r")
        out += _wait_pty(fd, pid, 0.5)[0]
        os.write(fd, b"h")
        os.write(fd, b"q")
        o, status = _wait_pty(fd, pid, 1.0)
        out += o
        if status is None:
            os.write(fd, b"y")
            o, status = _wait_pty(fd, pid, 5.0)
            out += o
        if status is None:
            os.kill(pid, signal.SIGKILL)
            os.waitpid(pid, 0)
        os.close(fd)
        text_out = out.decode("utf-8", "replace")
        check(status is not None and os.WIFEXITED(status) and os.WEXITSTATUS(status) == 0 and "Traceback" not in text_out,
              "screen: keys, resizes down to 1x1, quit; exit 0" + ("" if status is not None else " (it hung)")
              + ("" if "Traceback" not in text_out else ": " + text_out[text_out.find("Traceback"):][:600]))
        check("pack-studio" in text_out and "Alpha" in text_out and "workspace" in text_out,
              "screen: drew the games, printed the workspace when it closed")
        check(choice_label(read_choices(w / "all").get("alpha/8951-1a2b3c4d")) in ("take-1", "chip-1", "ay-1", "original"),
              "screen: c chose through pick --set")
        check("P1" in text_out and "P2" in text_out and "in no pack" in text_out or "no game put in a pack" in text_out,
              "screen: the packs panel")

        # -- the jobs view at 80x24: g, J, a job's output, back
        wj = t / "w-jobs"
        wj.mkdir()
        (wj / "studio.toml").write_text('[methods]\nalpha = ["ai", "sid", "ay"]\n')
        pid, fd = pty.fork()
        if pid == 0:
            os.environ.update({"TERM": "xterm-256color", "LANG": "en_US.UTF-8", "LC_ALL": "en_US.UTF-8"})
            try:
                os.execv(sys.executable, [sys.executable, str(Path(__file__).resolve()), str(games), "-o", str(wj),
                                          "--sid-dir", str(t / "sids"), "--ay-dir", str(t / "ays")])
            finally:
                os._exit(127)
        size(fd, 24, 80)
        os.kill(pid, signal.SIGWINCH)
        out, status = _wait_pty(fd, pid, 2.0)
        steps = {}
        for k, label in ((b"g", "g"), (b"", "wait"), (b"J", "jobs"), (b"j", ""), (b"\r", "output"), (b"\x1b", "back"),
                         (b"x", "x"), (b"J", "games")):
            if k:
                os.write(fd, k)
            o, status = _wait_pty(fd, pid, 1.5 if label == "wait" else 0.4)
            out += o
            steps[label] = o.decode("utf-8", "replace")
        os.write(fd, b"q")
        o, status = _wait_pty(fd, pid, 1.0)
        if status is None:
            os.write(fd, b"y")
            o, status = _wait_pty(fd, pid, 5.0)
        if status is None:
            os.kill(pid, signal.SIGKILL)
            os.waitpid(pid, 0)
        os.close(fd)
        jt = out.decode("utf-8", "replace")
        check(status is not None and os.WIFEXITED(status) and os.WEXITSTATUS(status) == 0 and "Traceback" not in jt,
              "jobs view: exit 0" + ("" if "Traceback" not in jt else ": " + jt[jt.find("Traceback"):][:600]))
        check("queued 3 jobs (1 AI, 1 SID, 1 AY): J shows them" in steps["g"], "jobs view: g says what it queued and that J shows it")
        check("takes for Alpha: 1 (best match" in steps["g"] + steps["wait"], "jobs view: a finished takes job's result on the bottom line")
        jv = steps["jobs"]
        plain = re.sub(r"\x1b(\[[0-9;?]*[A-Za-z]|\([AB0])", "", jv)  # the colours out
        missing = [x for x in ("finished (5)", "done in", "SID takes", "AI takes", "AY takes", "learn the games",
                               "reuse earlier learning", "best melody match 0.42 (C64: Alpha by Someone (1987))",
                               "1 take written", "1 song skipped (48K beeper or CPC tunes)", "cancel/stop") if x not in plain]
        check(not missing and re.search(r"\x1b\[3[1-6]m", jv) is not None,
              f"jobs view: each job, its state, what and game, its result, in colour; its keys (missing: {missing})")
        check("chip done for alpha" in steps["output"] and "summary: kind=sid" in steps["output"],
              "jobs view: Enter shows the job's own output")
        check("nothing to cancel" in steps["x"], "jobs view: x on a finished job says there is nothing to cancel")
        check("Alpha" in steps["games"] or "pack-studio" in steps["games"], "jobs view: J goes back")

        # -- the screen while learning (a slow stand-in), with colours and with NO_COLOR
        def learn_screen(wd: Path, extra: dict) -> tuple[str, int | None, str]:
            pid, fd = pty.fork()
            if pid == 0:
                os.environ.update({"TERM": "xterm-256color", "FAKE_SLOW": "1.5", **extra})
                try:
                    os.execv(sys.executable, [sys.executable, str(Path(__file__).resolve()), str(games), "-o", str(wd)])
                finally:
                    os._exit(127)
            size(fd, 24, 80)
            os.kill(pid, signal.SIGWINCH)
            mid, status = _wait_pty(fd, pid, 1.0)
            out, status = _wait_pty(fd, pid, 3.5)
            os.write(fd, b"q")
            o, status = _wait_pty(fd, pid, 1.0)
            out += o
            if status is None:
                os.write(fd, b"y")
                o, status = _wait_pty(fd, pid, 5.0)
                out += o
            if status is None:
                os.kill(pid, signal.SIGKILL)
                os.waitpid(pid, 0)
            os.close(fd)
            return mid.decode("utf-8", "replace"), status, out.decode("utf-8", "replace")
        mid, status, after = learn_screen(t / "w-live", {})
        check(status is not None and os.WIFEXITED(status) and os.WEXITSTATUS(status) == 0 and "Traceback" not in mid + after,
              "screen while learning: exit 0" + ("" if "Traceback" not in mid + after else ": " + (mid + after)[(mid + after).find("Traceback"):][:600]))
        check("learning 1 of 3 games" in mid and "learned (cached)" in mid and "learning..." in mid and "left out: missing" in mid
              and "~" in mid, "screen while learning: the list at once, each game's state, the header, approximate sizes")
        check(re.search(r"\x1b\[3[1-6]m", mid) is not None and "learned" in after and "P1" in after or "no game put in a pack" in after,
              "screen while learning: in colour; the games list when the plan is there")
        mid_nc, status, _ = learn_screen(t / "w-live-nc", {"NO_COLOR": "1"})
        check(status is not None and "learned (cached)" in mid_nc and re.search(r"\x1b\[(3[0-7]|38;5;[0-9]+)m", mid_nc) is None,
              "screen with NO_COLOR: no colour, bold and reverse only")

    if failures:
        print(f"{PROG} selftest: {len(failures)} failed: " + "; ".join(failures))
        return 1
    print(f"{PROG} selftest: all passed")
    return 0


def parse_args(argv: list[str] | None) -> argparse.Namespace:
    ap = argparse.ArgumentParser(prog=PROG, description="The packs of your own games: music per game, then the packs.",
                                 epilog="tools/pack-studio selftest checks the tool. Details: the docstring at the top of tools/pack-studio.")
    ap.add_argument("folder", metavar="games", help="the folder of your games (.sna, .z80, .tap, .tzx), or a games file (.toml) used as written")
    ap.add_argument("-o", dest="out", metavar="W", help="the workspace (default build/studio/<folder name>)")
    ap.add_argument("--sid-dir", metavar="PATH", help="the SID collection to use instead of downloading one")
    ap.add_argument("--ay-dir", metavar="PATH", help="the AY collection (.ay files) to use instead of downloading one")
    ap.add_argument("--offline", action="store_true", help="download nothing")
    ap.add_argument("--cache", metavar="DIR", help="tools/make-packages --cache DIR: another folder for the SDK files")
    ap.add_argument("--model", metavar="NAME", help="the generator for AI takes (tools/arrange-music generate --model)")
    ap.add_argument("--generate", metavar="METHODS", help="without the screen: mark and generate ai, sid, ay (comma-separated)")
    ap.add_argument("--game", metavar="ID", action="append", help="with --generate: only this game (again for more)")
    ap.add_argument("--assign", metavar="GAME=N", action="append",
                    help="without the screen: put the game in pack N (1 to 9; 0: in none); again for more")
    ap.add_argument("--auto-fill", action="store_true",
                    help="without the screen: put every game in no pack in the first pack with room")
    ap.add_argument("--build", action="store_true", help="build the packs without the screen")
    ap.add_argument("--status", action="store_true", help="print the games, methods, scores, candidates and choices")
    ap.add_argument("--try", dest="try_", metavar="N", type=int, nargs="?", const=1,
                    help="then the browser test bench on pack N (1 unless given): tools/web-demo --packages W/pack-N")
    a = ap.parse_args(argv)
    if a.try_ is not None and a.try_ < 1:
        ap.error("--try N: N counts from 1")
    return a


def main(argv: list[str] | None = None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    if argv[:1] == ["selftest"]:
        return cmd_selftest(argparse.Namespace())
    return cmd_studio(parse_args(argv))


if __name__ == "__main__":
    sys.exit(main())
