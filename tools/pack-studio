        # -- generate, choose, listen (a Studio without the screen)
        args = parse_args([str(games), "-o", str(w), "--sid-dir", str(t / "sids"), "--ay-dir", str(t / "ays")])
        (t / "sids" / "C64Music" / "DOCUMENTS").mkdir(parents=True)
