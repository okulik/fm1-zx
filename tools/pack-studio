        # -- without the screen: on a terminal the bars drawn in place; piped, the summary alone
        wh = t / "w-headless"
        gen = [sys.executable, str(Path(__file__).resolve()), str(games), "--generate", "ai", "--game", "alpha"]
        r = subprocess.run(gen + ["-o", str(wh)], capture_output=True, text=True, env=dict(os.environ, FAKE_SLOW="0.3"))
        want = ["  AI takes for Alpha: 1 take written, 0 s",
                f"{PROG}: generated; choose a take per score on the screen or with tools/arrange-music pick {wh / 'all'}",
                f"{PROG}: the log: {wh / 'studio.log'}"]
        check(r.returncode == 0 and r.stdout.splitlines() == want and r.stderr == "",
              f"--generate piped: no bars, no tool output, the summary and the log's path alone ({r.stdout!r} {r.stderr!r})")
        hlog = (wh / "studio.log").read_text()
        check(re.search(r"#\d+ ai alpha +start: AI takes for Alpha: .*arrange-music generate .* --game alpha", hlog) is not None
              and re.search(r"#\d+ ai alpha +end: done, exit 0, \d+ s", hlog) is not None and "| planned 4 games" in hlog,
              "--generate: every job's lines in the log")

        def tty_run(wd: Path, extra: dict, argv: list[str] | None = None) -> tuple[str, int | None]:
            pid, fd = pty.fork()
            if pid == 0:
                os.environ.update({"TERM": "xterm-256color", "FAKE_SLOW": "0.6", **extra})
                try:
                    os.execv(sys.executable, (argv or gen) + ["-o", str(wd)])
                finally:
                    os._exit(127)
            size(fd, 24, 80)
            out, status = _wait_pty(fd, pid, 30.0)
            if status is None:
                os.kill(pid, signal.SIGKILL)
                os.waitpid(pid, 0)
            with contextlib.suppress(OSError):
                out += os.read(fd, 65536)
            os.close(fd)
            return out.decode("utf-8", "replace"), status

        def screen_of(raw: str) -> list[str]:
            """What a terminal holds, scrollback and all, after raw: the cursor moves (n lines up),
            the line and screen clears and the colours the bars use."""
            text = re.sub(r"\x1b\[[0-9;]*m", "", raw).replace("\r\n", "\n")
            lines, row = [""], 0
            for tok in re.split(r"(\x1b\[\d*[FKJ]|\n|\r)", text):
                if tok == "\n":
                    row += 1
                    if row == len(lines):
                        lines.append("")
                elif m := re.fullmatch(r"\x1b\[(\d*)F", tok):
                    row = max(0, row - int(m[1] or 1))
                elif tok == "\x1b[2K":
                    lines[row] = ""
                elif tok == "\x1b[J":
                    del lines[row + 1:]
                    lines[row] = ""
                elif tok and tok != "\r":
                    lines[row] += tok
            while lines and not lines[-1]:
                lines.pop()
            return lines

        def drawn(raw: str) -> list[str]:
            """Every line drawn, in turn (each starts with a line clear)."""
            text = re.sub(r"\x1b\[[0-9;]*m", "", raw).replace("\r\n", "\n")
            return [p.split("\n", 1)[0] for p in text.split("\x1b[2K")[1:]]
        out, status = tty_run(t / "w-tty", {"LANG": "en_US.UTF-8", "LC_ALL": "en_US.UTF-8", "FAKE_ARRANGE_SLOW": "0.6"})
        final = screen_of(out)
        lines_ = drawn(out)
        alpha_lines = [ln for ln in lines_ if ln.startswith("  Alpha ")]
        check(status is not None and os.WIFEXITED(status) and os.WEXITSTATUS(status) == 0 and re.search(r"\x1b\[33m", out)
              and any(ln.startswith("learning games ■") and re.search(r"\d of 5 games  0:0\d", ln) for ln in lines_)
              and any("AI takes" in ln for ln in alpha_lines) and "planned 4 games" not in out
              and [ln.split()[0] for ln in final[:-2]] == ["Gone", "bravo", "Charlie", "Alpha"]
              and final[0].endswith("left out: missing: the file is not there") and re.search(r"bravo +■{12} learned in \d+ s$", final[1])
              and final[3] == "  Alpha ■■■■■■■■■■■■ AI: 1 take written, 0 s" and final[-2].startswith(f"{PROG}: generated;")
              and final[-1] == f"{PROG}: the log: {t / 'w-tty' / 'studio.log'}" and not any("learning games" in ln for ln in final),
              f"--generate on a terminal: a line per game with work, drawn in place while it runs (in colour), kept when done "
              f"with its result (Alpha from the cache has no learning line), the bar cleared, then the summary ({final})")
        out, status = tty_run(t / "w-tty-plain", {"NO_COLOR": "1", "PYTHONIOENCODING": "ascii"})
        plain = re.sub(r"\x1b\[\d*[FJK]", "", out)
        check(status is not None and os.WIFEXITED(status) and os.WEXITSTATUS(status) == 0 and re.search(r"\x1b\[\d*m", out) is None
              and re.search(r"learning games [#.]+ ", plain) and "■" not in out and "  Alpha ############ AI: 1 take written" in plain,
              "--generate on a terminal with NO_COLOR and without UTF-8: no colour, the bars in # and .")

        # -- --auto on a terminal: game by game, each game's line moving while it is worked on, kept when done
        wa = t / "w-tty-auto"
        multi_ws(wa)
        out, status = tty_run(wa, {"LANG": "en_US.UTF-8", "LC_ALL": "en_US.UTF-8", "FAKE_NULL": "1", "FAKE_ARRANGE_SLOW": "0.25"},
                              [sys.executable, str(Path(__file__).resolve()), str(games), "--auto", "--sid-dir", str(t / "sids"),
                               "--ay-dir", str(t / "ays")])
        final = screen_of(out)
        lines_ = drawn(out)
        names_ = [nm for _, nm in mnames]
        bars = [ln for ln in lines_ if " of 3 games" in ln]
        ks = [int(m[1]) for ln in bars for m in [re.search(r" (\d) of 3 games", ln)] if m]
        kettle_live = [ln for ln in lines_ if ln.startswith("  Kettle Run") and ("SID takes" in ln or "AY takes" in ln or "judging" in ln)]
        kettle_done = [ln for ln in lines_ if ln.startswith("  Kettle Run") and "■" * 12 + " 1 C64" in ln]
        games_final = [ln for ln in final if any(nm in ln for nm in names_ + ["Quiet Hut"])]
        check(status is not None and os.WIFEXITED(status) and os.WEXITSTATUS(status) == 0
              and [ln[2:12] for ln in games_final[:5]] == ["Kettle Run", "Lamp Quest", "Mole Dig  ", "Kettle Run", "Lamp Quest"]
              and games_final[0].endswith("■" * 12 + " 1 C64, 1 128; to hear") and games_final[2].endswith(" 1 C64, 1 128; chosen by the judge")
              and games_final[3] == "  Kettle Run" + " " * 14 + "after the final pass: chosen by the judge"
              and "skipped (no score: nothing to find or judge): Quiet Hut" in games_final[5]
              and "judged; 3 scores settled (0 by you, 3 by the judge), 0 to hear" in "\n".join(final)
              and not any(" of 3 games" in ln for ln in final),
              f"--auto on a terminal: a line per game kept in turn with its result, the final pass's changes after them, the "
              f"game without a score in the summary alone, the bar cleared ({final})")
        check(len(kettle_live) >= 2 and len(kettle_done) == 1 and bars and not any(nm in ln for ln in bars for nm in names_)
              and all(ln.startswith(("finding and judging ", "final judge pass ")) for ln in bars)
              and ks == sorted(ks) and {0, 1, 2, 3} <= set(ks) and "job " not in out,
              f"--auto on a terminal: the game in hand redrawn in place ({len(kettle_live)} frames), printed once when done; "
              f"the bottom line names no game, its games done go 0 to 3 ({sorted(set(ks))}; {bars[:1]})")

    if failures:
        print(f"{PROG} selftest: {len(failures)} failed: " + "; ".join(failures))
        return 1
    print(f"{PROG} selftest: all passed")
    return 0


def parse_args(argv: list[str] | None) -> argparse.Namespace:
    ap = argparse.ArgumentParser(prog=PROG, description="The packs of your own games: music per game, then the packs.",
                                 epilog="tools/pack-studio selftest checks the tool. Details: the docstring at the top of tools/pack-studio.")
    ap.add_argument("folder", metavar="games", help="the folder of your games (.sna, .z80, .tap, .tzx), or a games file (.toml) used as written")
    ap.add_argument("-o", dest="out", metavar="W", help="the workspace (default build/studio/<folder name>)")
    ap.add_argument("--sid-dir", metavar="PATH", help="the SID collection to use instead of downloading one")
    ap.add_argument("--ay-dir", metavar="PATH", help="the AY collection (.ay files) to use instead of downloading one")
    ap.add_argument("--offline", action="store_true", help="download nothing")
    ap.add_argument("--cache", metavar="DIR", help="tools/make-packages --cache DIR: another folder for the SDK files")
    ap.add_argument("--model", metavar="NAME", help="the generator for AI takes (tools/arrange-music generate --model)")
    ap.add_argument("--generate", metavar="METHODS", help="without the screen: mark and generate ai, sid, ay (comma-separated)")
    ap.add_argument("--auto", action="store_true",
                    help="without the screen: find the C64 and Spectrum 128 versions, judge, choose where the judge is sure")
    ap.add_argument("--game", metavar="ID", action="append", help="with --generate or --auto: only this game (again for more)")
    ap.add_argument("--assign", metavar="GAME=N", action="append",
                    help="without the screen: put the game in pack N (1 to 9; 0: in none); again for more")
    ap.add_argument("--auto-fill", action="store_true",
                    help="without the screen: put every game in no pack in the first pack with room")
    ap.add_argument("--build", action="store_true", help="build the packs without the screen")
    ap.add_argument("--status", action="store_true", help="print the games, methods, scores, candidates and choices")
    ap.add_argument("--try", dest="try_", metavar="N", type=int, nargs="?", const=1,
                    help="then the browser test bench on pack N (1 unless given): tools/web-demo --packages W/pack-N")
    a = ap.parse_args(argv)
    a.argv = argv
    if a.try_ is not None and a.try_ < 1:
        ap.error("--try N: N counts from 1")
    return a


def main(argv: list[str] | None = None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    if argv[:1] == ["selftest"]:
        return cmd_selftest(argparse.Namespace())
    return cmd_studio(parse_args(argv))


if __name__ == "__main__":
    sys.exit(main())
