def workspace(folder: Path, out: str | None) -> Path:
    """-o W, else: a games file that is a workspace's all/personal-games.toml, that workspace;
    else build/studio/<folder name, or the games file's name without .toml>."""
    if out:
        return Path(out).expanduser().resolve()
    if folder.is_file():
        if folder.name == "personal-games.toml" and folder.parent.name == "all":
            return folder.parent.parent
        return ROOT / "build" / "studio" / folder.stem
    return ROOT / "build" / "studio" / folder.name


def parse_assigns(items: list[str]) -> list[tuple[str, int]]:
    out = []
    for it in items:
        gid, eq, n = it.rpartition("=")
        if not eq or not gid or not n.isdigit() or int(n) > PACKS_MAX:
            die(f"--assign {it}: give GAME=N, N a pack from 1 to {PACKS_MAX} (0: in none)")
        out.append((gid, int(n)))
    return out


def parse_methods(text: str) -> list[str]:
    ms = [m.strip().lower() for m in text.split(",") if m.strip()]
    bad = [m for m in ms if m not in METHODS]
    if bad or not ms:
        die(f"--generate {text}: give one or more of {', '.join(METHODS)}, comma-separated")
    return [m for m in METHODS if m in ms]


def run_try(st: Studio, n: int) -> int:
    d = st.w / f"pack-{n}"
    if not (d / "fmzx.fwsc").is_file():
        print(f"{PROG}: no {d / 'fmzx.fwsc'}: build the packs first (--build)", file=sys.stderr)
        return 1
    print(f"{PROG}: the browser test bench on pack {n}: {st.tools.web_demo} --packages {d}", flush=True)
    try:
        return subprocess.call([st.tools.web_demo, "--packages", str(d)])
    except KeyboardInterrupt:
        return 130


def cmd_studio(a: argparse.Namespace) -> int:
    folder = Path(a.folder).expanduser().resolve()
    if not folder.exists():
        die(f"no {folder}")
    if folder.is_file() and folder.suffix.lower() != ".toml":
        die(f"{folder}: give a folder of games or a games file (.toml)")
    if a.game and not a.generate:
        die("--game goes with --generate")
    methods = parse_methods(a.generate) if a.generate else []
    assigns = parse_assigns(a.assign or [])
    w = workspace(folder, a.out)
    w.mkdir(parents=True, exist_ok=True)
    packing = bool(assigns) or a.auto_fill
    headless = a.status or a.build or bool(a.generate) or a.try_ is not None or packing
    runner = Runner(w / "studio.log", threaded=not headless, echo=bool(a.build or a.generate), progress=headless)
    st = Studio(folder, w, a, runner)
    if headless:
        if a.generate or a.build or packing or (a.status and st.plan is None):
            # the learning first only when a step needs the plan before the build makes it
            st.startup(learn=st.plan is None and bool(a.generate or packing or not a.build), preview=bool(a.status))
            runner.drain()
            start = [j for j in runner.failed if j.chain == "start"]
            if start and (a.generate or a.build or packing):
                die(f"{start[0].title} failed (see the output above; {w / 'studio.log'})")
            if not st.tools.fmzx_pack_given and not os.access(st.tools.fmzx_pack, os.X_OK):
                die("fmzx-pack did not build (see the output above)")
        if packing:
            if st.plan is None:
                die(f"no plan ({w / 'studio.log'} says why)")
            for gid, n in assigns:
                if st.plan.game(gid) is None:
                    die(f"--assign {gid}={n}: no such game (--status lists the ids)")
                st.over_ok = None
                if not st.assign(gid, n):
                    die(f"--assign {gid}={n}: {st.flash_msg.split('; ')[0]}")
            if a.auto_fill and st.fill():
                print(f"{PROG}: {st.flash_msg}", file=sys.stderr)
            for _, ln, _ in pack_lines(st.plan, st.packs):
                print(ln)
        if a.generate:
            n0 = len(runner.failed)
            st.generate_headless(methods, a.game or [])
            runner.drain()
            if st.errors or runner.failed[n0:]:
                what = st.errors[0] if st.errors else f"{runner.failed[n0].title} failed"
                die(f"--generate: {what} (the log: {w / 'studio.log'})")
            print(f"{PROG}: generated; choose a take per score on the screen or with tools/arrange-music pick {st.all}")
        if a.build:
            st.build()
            runner.drain()
            print("\n".join(st.summary or ["no build"]))
            if not st.build_ok:
                return 1
        if a.status:
            if st.plan is None:
                die(f"no plan ({w / 'studio.log'} says why)")
            print("\n".join(st.status_lines()))
        if a.try_ is not None:
            return run_try(st, a.try_)
        return 0
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        die("the studio needs a terminal (or --generate, --build, --status, --try)")
    st.startup(learn=True)
    try:
        run_ui(st)
    finally:
        st.player.stop()
        runner.stop()
    lines = st.summary or pack_summary(w, st.plan)
    if lines:
        print("\n".join(lines))
    print(f"{PROG}: workspace {w}; log {w / 'studio.log'}")
    return 0


