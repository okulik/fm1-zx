def player_argv(path: Path) -> list[str] | None:
    given = os.environ.get("FMZX_PLAYER")
    if given:
        return shlex.split(given) + [str(path)]
    if sys.platform == "darwin" and shutil.which("afplay"):
        return ["afplay", str(path)]
    if shutil.which("ffplay"):
        return ["ffplay", "-nodisp", "-autoexit", "-loglevel", "quiet", str(path)]
    for p in ("paplay", "aplay"):
        if shutil.which(p):
            return [p, str(path)]
    return None


class Player:
    def __init__(self):
        self.proc: subprocess.Popen | None = None
        self.what: str | None = None  # the playing candidate's id

    def play(self, path: Path, what: str) -> str | None:
        self.stop()
        argv = player_argv(path)
        if argv is None:
            return "no player: install ffplay (ffmpeg), paplay or aplay, or set FMZX_PLAYER"
        self.proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                     stderr=subprocess.DEVNULL, start_new_session=True)
        self.what = what
        return None

    def poll(self) -> None:
        if self.proc and self.proc.poll() is not None:
            self.proc, self.what = None, None

    def stop(self) -> None:
        if self.proc and self.proc.poll() is None:
            with contextlib.suppress(OSError):
                os.killpg(self.proc.pid, signal.SIGTERM)
            with contextlib.suppress(subprocess.TimeoutExpired):
                self.proc.wait(timeout=2)
        self.proc, self.what = None, None


# ---------------------------------------------------------------------------------------------
# The studio: everything the screen and the commands do


@dataclass
class BuildRun:
    packs: list[list[str]] = field(default_factory=list)
    numbers: list[int] = field(default_factory=list)  # each pack's number (W/pack-<n>)
    assigned: bool = False  # the packs the owner filled (else the automatic split)
    unassigned: list[str] = field(default_factory=list)  # packed games in no pack: not built
    text: str = ""
    built: int = 0
    too_big: list[str] = field(default_factory=list)
    error: str | None = None
    rooms: dict[int, str] = field(default_factory=dict)  # each pack's room line from fmzx-pack ("used ... KB free")
    queued: set[tuple[int, int]] = field(default_factory=set)  # (pack index, 0 its fmzx-pack run or 1 its packages) queued


def over_text(over: list[tuple[int, float]]) -> str:
    return "; ".join(f"pack {n} is {kb(b)} over its room" for n, b in over) + ": take a game out (0 on the games screen)"


class Studio:
    def __init__(self, folder: Path, w: Path, args: argparse.Namespace, runner: Runner, tools: Tools | None = None):
        self.folder = folder  # the games folder, or a games file used as written
        self.w = w
        self.all = w / "all"
        self.args = args
        self.runner = runner
        self.tools = tools or Tools.from_env()
        self.plan = load_plan(self.all / "plan.json")
        self.methods = load_methods(w)
        self.packs = load_packs(w)
        self.over_ok: tuple[str, int] | None = None  # the game and pack a second press puts it in over the room
        self.live: Live | None = None  # the games list while the learning runs
        self.live_src: tuple | None = None  # the games file the live rows come from, and its mtime
        self.player = Player()
        self.flash_msg = ""
        self.flash_kind = "info"  # info, ok, err: the bottom line's colour
        self.flash_at = 0.0
        self.version = 0  # counts finished jobs: the screen's caches follow it
        self.rendering: set[str] = set()
        self.failed: dict[str, str] = {}  # preview name -> why its render failed
        self.want_play: str | None = None
        self.choosing: set[str] = set()
        self.waiters: dict[str, list[Callable[[Path], None]]] = {}  # per collection being downloaded
        self.build_run: BuildRun | None = None
        self.summary: list[str] | None = None
        self.build_ok: bool | None = None
        self.errors: list[str] = []  # what stopped a step before it ran (the headless commands report them)
        self._cands: dict[tuple, list[Candidate]] = {}
        self._choices: tuple[int, dict, dict] | None = None
        self._judges: dict[tuple[str, str], dict] = {}
        self.results: dict[tuple[int, str], tuple[str, str]] = {}  # (activity, game) -> its result in words, and ok, err or off
        self.notes: list[tuple[str, str]] = []  # (a game's name, a line about it) for the terminal to print
        self.game_failed: dict[str, str] = {}  # game key -> what failed for it last (its row's red mark)
        self.levels: dict[tuple[str, int], tuple[float, float]] = {}  # a sound file's (path, mtime) -> (peak, seconds)
        runner.after = self.job_finished

    # -- messages and data

    def event(self, text: str) -> None:
        """What the owner asked for, a choice, a message: to the log."""
        self.runner.log.write("studio", text)

    def flash(self, msg: str, kind: str = "info") -> None:
        """A message: on the key line for 3 s (the screen), always to the log."""
        self.flash_msg, self.flash_kind, self.flash_at = msg, kind, time.monotonic()
        self.event(("error: " if kind == "err" else "") + msg)

    def fail(self, msg: str) -> None:
        self.errors.append(msg)
        self.flash(msg, "err")

    def games_file(self) -> Path:
        """The games file the packs take their entries from: the one given, else the folder's."""
        return self.folder if self.folder.is_file() else self.all / "personal-games.toml"

    def changed(self, _job: Job | None = None) -> None:
        self.version += 1
        self._cands.clear()
        self._judges.clear()
        self._choices = None

    def reload_plan(self) -> None:
        self.plan = load_plan(self.all / "plan.json")
        self.changed()

    def choices(self) -> dict[str, int | str]:
        if self._choices is None or self._choices[0] != self.version:
            self._choices = (self.version, *read_choice_tables(self.all))
        return self._choices[1]

    def judged(self) -> dict[str, int | str]:
        """The choices the judge made (choices.toml's [judged] entries that still hold)."""
        ch = self.choices()
        return {k: v for k, v in self._choices[2].items() if ch.get(k) == v}

    def judge_doc(self, gid: str, key: str) -> dict:
        k = (gid, key)
        if k not in self._judges:
            self._judges[k] = read_judge(self.all / "arrange" / gid / key)
        return self._judges[k]

    def tune_state(self, g: Game, s: Score) -> tuple[str, str]:
        """A score's state and the judge's words: "owner" (the owner chose), "judge" (the judge
        chose), "hear" (the judge is not sure: the owner's ear is needed; its reasons), "sure"
        (the judge is sure but has not chosen: m chooses), "unjudged" (takes the judge has not
        weighed, or changed since), "none" (no takes: nothing to choose)."""
        sid = f"{g.id}/{s.key}"
        ch, jd = self.choices(), self.judged()
        doc = self.judge_doc(g.id, s.key)
        words = ""
        if doc.get("pick") is not None:
            words = (f"judge: {choice_label(0 if doc['pick'] == '0' else doc['pick'])} ({doc.get('confidence', '?')}"
                     + (f": {'; '.join(doc.get('flags', []))}" if doc.get("flags") else "") + ")"
                     + ("" if doc.get("fresh") else " (takes changed since: m judges again)"))
        if not any(c.choice not in (None, 0) for c in self.candidates(g, s)):
            return "none", words
        if sid in jd:
            return "judge", words
        if sid in ch:
            return "owner", words
        if not doc or not doc.get("fresh"):
            return "unjudged", words or "not judged yet (m finds, judges and chooses where sure)"
        return ("sure", words) if doc.get("confidence") == "high" else ("hear", words)

    def tune_counts(self, g: Game) -> dict[str, int]:
        out = {k: 0 for k in ("owner", "judge", "hear", "sure", "unjudged", "none")}
        if g.can_arrange:
            for s in g.scores:
                out[self.tune_state(g, s)[0]] += 1
        return out

    def candidates(self, g: Game, sc: Score | None) -> list[Candidate]:
        k = (g.id, sc.key if sc else WHOLE_GAME)
        if k not in self._cands:
            self._cands[k] = score_candidates(self.all, g.id, sc)
        return self._cands[k]

    def choice_summary(self, g: Game) -> str:
        """Per score its choice ("(judge)" after one the judge made), "listen" where the judge is
        not sure and nothing is chosen."""
        if g.left_out:
            return f"left out: {g.reason or g.how}"
        if not g.scores:
            return g.plays()
        ch = self.choices()
        out = []
        for s in g.scores:
            state = self.tune_state(g, s)[0]
            label = choice_label(ch.get(f"{g.id}/{s.key}", 0))
            out.append(f"{label} (judge)" if state == "judge" else "listen" if state == "hear" else label)
        return " / ".join(out)

    def marked(self, gid: str) -> set[str]:
        return self.methods.get(gid, set())

    def sid_dir(self) -> Path | None:
        if self.args.sid_dir:
            p = Path(self.args.sid_dir).expanduser()
            return (find_collection(p) or p) if p.is_dir() else None
        return downloaded_collection(hvsc_root())

    def ay_dir(self) -> Path | None:
        if self.args.ay_dir:
            p = Path(self.args.ay_dir).expanduser()
            return (find_ay_collection(p) or p) if p.is_dir() else None
        return downloaded_ay(ay_root())

    def uv_env(self) -> dict[str, str]:
        return {"UV_OFFLINE": "1"} if self.args.offline else {}

    # -- start and learning

    def device_builds(self, chain: str) -> None:
        """Both device builds (in Docker, a no-op when up to date, but a few seconds each),
        unless FMZX_SKIP_DEVICE_BUILD=1."""
        if os.environ.get("FMZX_SKIP_DEVICE_BUILD", "0") == "1":
            return
        for preset in ("fm1", "fm1-preview"):
            self.runner.submit(Job(f"device build {preset} (configure)",
                                   [str(ROOT / "tools/fm1-docker"), "cmake", "--preset", preset], chain=chain,
                                   kind="setup"))
            self.runner.submit(Job(f"device build {preset}",
                                   [str(ROOT / "tools/fm1-docker"), "cmake", "--build", "--preset", preset],
                                   chain=chain, kind="setup"))

    def startup(self, learn: bool = True, preview: bool = True) -> None:
        # the learning needs the app images only for the room they leave: the device builds run
        # at start only when there are none yet, else before each build (b)
        if any(not f.is_file() for f in device_files()):
            self.device_builds("start")
        if not self.tools.fmzx_pack_given:
            self.runner.submit(Job("build fmzx-pack", ["cargo", "build", "--release", "-p", "fmzx-pack"],
                                   cwd=ROOT / "host", chain="start", kind="setup"))
        if preview and not self.tools.preview_given:
            def preview_built(j: Job) -> None:
                self.changed()
                if j.rc != 0:
                    self.flash("music-preview did not build: playing the renders tools/arrange-music wrote")
            self.runner.submit(Job("build music-preview", ["cargo", "build", "--release", "-p", "music", "--bin",
                                                           "music-preview"], cwd=ROOT / "host", on_done=preview_built,
                                   kind="setup"))
        if learn:
            self.runner.submit(self.plan_job("start"))

    def plan_job(self, chain: str, then: Callable[[Job], None] | None = None) -> Job:
        """The learning's job (to submit); before a workspace's first plan, a job that copies
        the learning of other personal packs under build/ into W/all/sound-cache goes first."""
        argv = [self.tools.fmzx_pack, "personal", str(self.folder), "-o", str(self.all)]
        for a in apps():
            argv += ["--app", str(a)]
        argv.append("--plan")
        self.all.mkdir(parents=True, exist_ok=True)
        search = reuse_root()
        if search is not None and search.is_dir() and not (self.all / "plan.json").exists():
            def reuse(j: Job) -> int:
                got = reuse_caches(search, self.all / "sound-cache", self.w)
                for d, n in got:
                    j.out(f"reused {n} learned game{'s' if n != 1 else ''} from {shown_path(d)}")
                if not got:
                    j.out(f"no earlier learning to reuse under {shown_path(search)}")
                return 0
            self.runner.submit(Job("reuse earlier learning", fn=reuse, kind="reuse"))
        live = self.live = Live(self.live_rows(), self.checked_ids())

        def done(j: Job) -> None:
            self.reload_plan()
            if j.rc != 0:
                live.phase = "failed"
                self.flash("learning failed (l: the log)", "err")
            elif self.plan is None:
                j.rc = 1
                live.phase = "failed"
                self.flash(f"no plan in {self.all / 'plan.json'} (l: the log)", "err")
            else:
                live.phase = "done"
                if self.live is live:
                    self.live = None
                if then is None:
                    n = len(self.plan.packed())
                    self.flash(f"learned: {len(self.plan.games)} games, {n} packed, {kb(self.plan.used)} "
                               f"for a room of {kb(self.plan.room)}", "ok")
            if then:
                then(j)
        return Job("learn the games (plan)", argv, chain=chain, on_done=done, on_line=live.apply, kind="learn",
                   what="learn the games", detail=lambda: live.header(), live=live)

    def checked_ids(self) -> set[str]:
        """The games whose chosen takes fmzx-pack checks: those with an entry in choices.toml."""
        return {k.split("/", 1)[0] for k in self.choices()}

    def live_rows(self) -> list[LiveRow]:
        """The rows of the list while learning: the games file's entries when it is there,
        else the folder's game files."""
        gf = self.games_file()
        try:
            st_ = gf.stat()
            self.live_src = (gf, st_.st_mtime_ns)
            rows = rows_from_games_file(gf.read_text())
        except OSError:
            self.live_src = None
            rows = []
        return rows or (rows_from_folder(self.folder) if self.folder.is_dir() else [])

    def refresh_live(self) -> list[LiveRow]:
        """The live rows, the games file read again when it changed, the converted files' sizes
        added (the screen calls this as it draws)."""
        live = self.live
        if live is None:
            return []
        gf = self.games_file()
        try:
            m = gf.stat().st_mtime_ns
        except OSError:
            m = None
        if m is not None and self.live_src != (gf, m):
            live.set_rows(self.live_rows())
        rows = live.snapshot()
        conv = self.all / "converted"
        for r in rows:
            if r.gid and r.size is None and r.state not in ("waiting", "converting", "left out"):
                for ext in ("sna", "z80", "tap"):
                    with contextlib.suppress(OSError):
                        r.size = (conv / f"{r.gid}.{ext}").stat().st_size
                        break
                with live.lock:
                    for o in live.rows:
                        if o.gid == r.gid:
                            o.size = r.size
        return rows

    def relearn(self) -> None:
        self.runner.submit(self.plan_job("plan"))
        self.flash("learning again")

    # -- methods

    def toggle(self, gid: str, method: str) -> None:
        g = self.plan.game(gid) if self.plan else None
        if g is None:
            return
        if not g.can_arrange:
            self.flash(f"{g.name}: " + (f"left out ({g.reason})" if g.left_out else
                                        f"{g.plays()}: no score for AI, SID or AY"))
            return
        ms = self.methods.setdefault(gid, set())
        ms.symmetric_difference_update({method})
        save_methods(self.w, self.methods)
        self.event(f"{g.name}: {method.upper()} {'marked' if method in ms else 'unmarked'}")

    def toggle_all(self, method: str) -> None:
        if not self.plan:
            return
        gs = [g for g in self.plan.games if g.can_arrange]
        if not gs:
            self.flash("no game has a score: nothing to arrange")
            return
        on = not all(method in self.marked(g.id) for g in gs)
        for g in gs:
            ms = self.methods.setdefault(g.id, set())
            (ms.add if on else ms.discard)(method)
        save_methods(self.w, self.methods)
        self.flash(f"{method.upper()} {'marked' if on else 'unmarked'} for {len(gs)} games")

    # -- packs

    def assigned(self) -> dict[int, list[Game]]:
        """The packs the owner filled (none: the build splits by itself)."""
        return pack_fill(self.plan, self.packs) if self.plan else {}

    def assign(self, gid: str, n: int, force: bool = False) -> bool:
        """Puts the game in pack n (0: in none). A pack it would take over its room refuses it,
        until the same game goes to the same pack again (or force)."""
        p = self.plan
        g = p.game(gid) if p else None
        name = g.name if g else gid
        if g is not None and g.left_out:
            self.flash(f"{g.name}: left out ({g.reason or g.how}), in no pack", "err")
            return False
        if n == 0:
            self.over_ok = None
            if self.packs.pop(gid, None) is not None:
                save_packs(self.w, self.packs)
            self.flash(f"{name}: in no pack")
            return True
        over = over_by(p, self.packs, gid, n) if p and g else 0
        if over > 0 and not force and self.over_ok != (gid, n):
            self.over_ok = (gid, n)
            self.flash(f"{name} ({kb(g.packed)}) does not fit in pack {n}: {kb(over)} over; {n} again: put it there anyway", "err")
            return False
        self.over_ok = None
        self.packs[gid] = n
        save_packs(self.w, self.packs)
        self.flash(f"{name}: pack {n}" + (f", {kb(over)} over its room: no build until a game goes" if over > 0 else ""),
                   "err" if over > 0 else "info")
        return True

    def fill(self) -> list[str]:
        """f: every packed game in no pack put in the first pack with room; returns the games
        that fit in none."""
        if not self.plan:
            self.fail("no plan yet: wait for the learning")
            return []
        new, left = auto_fill(self.plan, self.packs)
        added = sum(1 for g in new if g not in self.packs)
        self.packs = new
        save_packs(self.w, self.packs)
        names = ", ".join(self.plan.game(g).name for g in left)
        self.flash(f"filled: {added} game{'s' if added != 1 else ''} put in packs" + (f"; in none (no room in the {PACKS_MAX} packs): {names}" if left else ""),
                   "err" if left else "ok")
        return left

    def sizes_note(self) -> str:
        """Said when a take was chosen after the last plan (the sizes are the plan's)."""
        try:
            later = (self.all / "arrange" / "choices.toml").stat().st_mtime > (self.all / "plan.json").stat().st_mtime
        except OSError:
            later = False
        return "sizes as of the last learn (a take chosen since: r learns again)" if later else ""

    # -- generating

    def generate(self, ids: list[str] | None = None, methods: tuple[str, ...] = METHODS) -> list[Job]:
        """Queues the jobs for the marked methods among methods, for the games with scores (those
        of ids when given), game by game (takes_jobs); returns them (the downloads among them)."""
        if not self.plan:
            self.fail("no plan yet: wait for the learning")
            return []
        gs = [g for g in self.plan.games if g.can_arrange and (ids is None or g.id in ids)]
        per = {m: {g.id for g in gs if m in methods and m in self.marked(g.id)} for m in METHODS}
        if not any(per.values()):
            self.fail("nothing marked: a marks AI, s marks SID, y marks AY (FM needs nothing)")
            return []
        if not self.tools.arrange_given() and not shutil.which("uv"):
            self.fail("AI, SID and AY takes need uv (https://docs.astral.sh/uv/): tools/arrange-music runs through it")
            return []
        errors = len(self.errors)
        queued, counts, total = self.takes_jobs(gs, per)
        if not total:
            return queued
        msg = f"queued {plural(total, 'job')} ({', '.join(counts)})" + (": J shows them" if self.runner.threaded else "")
        if len(self.errors) > errors:
            self.flash(f"{msg}; {self.errors[-1]}", "err")
        else:
            self.flash(msg)
        return queued

    def takes_jobs(self, gs: list[Game], per: dict[str, set[str]], judge: bool = False,
                   judge_flags: tuple[str, ...] = ()) -> tuple[list[Job], list[str], int]:
        """Queues the takes jobs of per (method -> the game ids marked for it), game by game in the
        plan's order (its AI, SID and AY jobs, then, with judge, its judge job, which waits for
        them), so a game is done before the next begins; a collection to download first, its jobs
        held until it is there. Returns the jobs (the downloads among them), the counts in words
        and the jobs counted."""
        queued: list[Job] = []
        counts: list[str] = []
        total = 0
        ready: dict[str, Path] = {}
        held: dict[str, list[Job]] = {"sid": [], "ay": []}
        opts = {"sid": ("SID", "chip", "--sid-dir"), "ay": ("AY", "ay", "--ay-dir")}

        def argv_of(m: str, gid: str, d: Path) -> list[str]:
            _, cmd, opt = opts[m]
            return [self.tools.arrange, cmd, str(self.all), "--game", gid, opt, str(d)]
        downloads = 0
        for m in ("sid", "ay"):
            if not per[m]:
                continue
            kind = opts[m][0]
            state, d, why = self.collection(kind)
            if state == "fail":
                self.fail(why)
                per[m] = set()
            elif state == "ready":
                ready[m] = d
            else:
                def go(d: Path | None, m=m, kind=kind) -> None:
                    for j in held[m]:
                        if j.state != "waiting":
                            continue
                        if d is None:
                            self.runner.skip(j, f"the {kind} collection did not download")
                        else:
                            j.argv, j.wait_note = argv_of(m, j.gid, d), ""
                            self.runner.release(j)
                downloads += self.download(kind, go, queued)
        for g in gs:
            mine: list[Job] = []
            if g.id in per["ai"]:
                argv = [self.tools.arrange, "generate", str(self.all), "--game", g.id]
                if self.args.model:
                    argv += ["--model", self.args.model]
                if self.args.offline:
                    argv += ["--offline"]
                mine.append(self.runner.submit(Job(f"AI takes for {g.name}", argv, env=self.uv_env(), on_done=self.changed,
                                                   kind="ai", what="AI takes", game=g.name, gid=g.id)))
            for m in ("sid", "ay"):
                if g.id not in per[m]:
                    continue
                kind = opts[m][0]
                j = Job(f"{kind} takes for {g.name}", env=self.uv_env(), on_done=self.changed, kind=m, what=f"{kind} takes",
                        game=g.name, gid=g.id)
                if m in ready:
                    j.argv = argv_of(m, g.id, ready[m])
                    self.runner.submit(j)
                else:
                    j.wait_note = f"after the {kind} collection's download"
                    held[m].append(self.runner.submit(j, hold=True))
                mine.append(j)
            if judge:
                mine.append(self.runner.submit(Job(f"judge {g.name}", [self.tools.arrange, "judge", str(self.all), "--game", g.id,
                                                                       "--apply", *judge_flags],
                                                   env=self.uv_env(), on_done=self.changed, kind="judge", what="judge",
                                                   game=g.name, gid=g.id, after=list(mine),
                                                   wait_note="after the game's SID and AY jobs" if mine else "")))
            queued += mine
        for m, label in (("ai", "AI"), ("sid", "SID"), ("ay", "AY")):
            if per[m]:
                counts.append(f"{len(per[m])} {label}")
                total += len(per[m])
        if downloads:
            counts.append(plural(downloads, "download"))
            total += downloads
        return queued, counts, total

    def auto(self, ids: list[str] | None = None) -> None:
        """m (M: every game): for the games given (every game with scores when None), game by
        game, finds and converts the C64 and Spectrum 128 versions (SID and AY marked, their jobs
        as g queues them), then judges the game's scores and chooses where the judge is sure and
        the owner has not chosen (tools/arrange-music judge --game ID --apply); with more than one
        game, those judges are provisional and the judge's final pass (judge --apply over the
        same games) settles the figures where another game's takes changed what a score is
        compared with, as one judge over them all would. The screen reads it all again."""
        if not self.plan:
            self.fail("no plan yet: wait for the learning")
            return
        gs = [g for g in self.plan.games if g.can_arrange and (ids is None or g.id in ids)]
        bare = [g for g in self.plan.games if not g.left_out and not g.scores and (ids is None or g.id in ids)]
        if bare:  # no score: no tune for a C64 or Spectrum 128 version to replace, nothing to judge
            self.event(f"find and judge: skipped {plural(len(bare), 'game')} with no music (no score to replace or judge): "
                       + ", ".join(g.name for g in bare))
        if not gs:
            g = self.plan.game(ids[0]) if ids and len(ids) == 1 else None
            if bare:
                self.flash((f"{g.name}: no score" if g is not None else "no score in these games") + ": nothing to find or judge")
            else:
                self.fail(f"{g.name}: left out ({g.reason})" if g else "no game has a score: nothing to judge")
            return
        if not self.tools.arrange_given() and not shutil.which("uv"):
            self.fail("AI, SID and AY takes need uv (https://docs.astral.sh/uv/): tools/arrange-music runs through it")
            return
        for g in gs:
            self.methods.setdefault(g.id, set()).update({"sid", "ay"})
        save_methods(self.w, self.methods)
        errors = len(self.errors)
        many = len(gs) > 1
        ids_ = {g.id for g in gs}
        queued, _, _ = self.takes_jobs(gs, {"ai": set(), "sid": set(ids_), "ay": set(ids_)}, judge=True,
                                       judge_flags=("--provisional",) if many else ())
        n = len(queued)
        if many:
            argv = [self.tools.arrange, "judge", str(self.all)]
            for g in (gs if ids is not None else []):
                argv += ["--game", g.id]
            self.runner.submit(Job("the judge's final pass", argv + ["--apply"], env=self.uv_env(),
                                   on_done=lambda j: self.settled(j, gs), kind="settle", what="final judge pass",
                                   game=f"{len(gs)} games", after=list(queued), wait_note="after every game's judge"))
            n += 1
        msg = (f"queued {plural(n, 'job')} (game by game: the C64 and Spectrum 128 versions, then the judge"
               + ("; then its final pass" if many else "") + ")" + (": J shows them" if self.runner.threaded else ""))
        if len(self.errors) > errors:
            self.flash(f"{msg}; {self.errors[-1]}", "err")
        else:
            self.flash(msg)

    def settled(self, j: Job, gs: list[Game]) -> None:
        """The judge's final pass done: the games whose tunes it settled otherwise than their own
        judge had, said (a line each on a terminal: notes) and in a message."""
        self.changed()
        if j.rc != 0:
            if not j.cancelled:
                self.flash(f"the judge's final pass failed: {fail_reason(j)} (the log: {self.runner.log_path.name})", "err")
            return
        key = self.activity_key(j)
        moved = []
        for g in gs:
            words = self.tune_words(g)
            old = self.results.get((key, g.id))
            if old is not None and old[1] == "ok" and old[0] != words:
                moved.append(g)
                self.results[(key, g.id)] = (words, "ok")
                self.notes.append((g.name, f"after the final pass: {words.split('; ', 1)[-1]}"))
        self.flash("the judge's final pass: " + (f"{plural(len(moved), 'game')} settled otherwise: " + ", ".join(g.name for g in moved)
                                                 if moved else "every game as judged"), "ok")

    def tune_words(self, g: Game) -> str:
        """A game's C64 and Spectrum 128 versions found (distinct tune files among its takes) and
        what became of its tunes, in the summary line's words: "3 C64, 1 128; chosen by the
        judge", "2 C64; 1 by the judge, 1 by you, 2 to hear", "no C64 or 128 version; plays its
        own"."""
        files: dict[str, set[str]] = {"chip-": set(), "ay-": set()}
        for s in g.scores:
            d = self.all / "arrange" / g.id / s.key
            for pre, seen in files.items():
                for _, p in numbered(d, pre):
                    h = read_toml_head(p / "arranged.toml")
                    seen.add(str(h.get("sid_file") or h.get("ay_file") or h.get("source") or p.name))
        c64, zx = len(files["chip-"]), len(files["ay-"])
        found = ", ".join(x for x in (f"{c64} C64" if c64 else "", f"{zx} 128" if zx else "") if x) or "no C64 or 128 version"
        n = self.tune_counts(g)
        words = (("judge", "chosen by the judge", "by the judge"), ("owner", "chosen by you", "by you"),
                 ("hear", "to hear", "to hear"), ("sure", "sure, not chosen", "sure, not chosen"),
                 ("unjudged", "not judged", "not judged"), ("none", "plays its own", "play their own"))
        parts = [(k, one, many) for k, one, many in words if n[k]]
        if not parts:
            return found
        fate = parts[0][1] if sum(n.values()) == 1 else ", ".join(f"{n[k]} {many}" for k, _, many in parts)
        return f"{found}; {fate}"

    def auto_headless(self, ids: list[str]) -> None:
        """--auto: auto for the games given (every game with scores when none)."""
        if not self.plan:
            return self.fail("no plan: the learning failed (see the log)")
        unknown = [g for g in ids if self.plan.game(g) is None]
        if unknown:
            return self.fail(f"--game {', '.join(unknown)}: no such game (--status lists the ids)")
        for gid in ids:
            g = self.plan.game(gid)
            if g.left_out:
                return self.fail(f"--game {g.id}: left out ({g.reason})")
        self.auto(ids or None)

    def generate_headless(self, methods: list[str], ids: list[str]) -> None:
        """--generate: marks methods for the games given (every game with scores when none) and
        queues their jobs."""
        if not self.plan:
            return self.fail("no plan: the learning failed (see the log)")
        unknown = [g for g in ids if self.plan.game(g) is None]
        if unknown:
            return self.fail(f"--game {', '.join(unknown)}: no such game (--status lists the ids)")
        gs = [self.plan.game(g) for g in ids] if ids else [g for g in self.plan.games if g.can_arrange]
        for g in gs:
            if not g.can_arrange:
                return self.fail(f"--game {g.id}: " + (f"left out ({g.reason})" if g.left_out else
                                                        f"{g.plays()}: no score for AI, SID or AY"))
        if not gs:
            return self.fail("no game has a score: nothing to arrange")
        for g in gs:
            self.methods.setdefault(g.id, set()).update(methods)
        save_methods(self.w, self.methods)
        self.generate([g.id for g in gs], tuple(methods))

    def collection(self, kind: str) -> tuple[str, Path | None, str]:
        """The "SID" or "AY" collection: ("ready", its folder, ""), the one given (--sid-dir,
        --ay-dir) or downloaded before; ("download", None, ""); or ("fail", None, why)."""
        given, opt, find, root = ((self.args.sid_dir, "--sid-dir", self.sid_dir, hvsc_root()) if kind == "SID"
                                  else (self.args.ay_dir, "--ay-dir", self.ay_dir, ay_root()))
        d = find()
        if given:
            return ("ready", d, "") if d else ("fail", None, f"{opt} {given}: no such folder")
        if d:
            return "ready", d, ""
        if self.args.offline:
            return "fail", None, f"{kind}: --offline downloads nothing: give {opt} PATH, or put the collection in {root}"
        return "download", None, ""

    def download(self, kind: str, then: Callable[[Path | None], None], queued: list[Job] | None = None) -> int:
        """Runs then(the collection's folder, or None when it did not download) after the "SID"
        or "AY" collection's download job (added to queued); returns 1 when it queued that job, 0
        when one was queued before."""
        find, root = (self.sid_dir, hvsc_root()) if kind == "SID" else (self.ay_dir, ay_root())
        if kind in self.waiters:
            self.waiters[kind].append(then)
            return 0
        self.waiters[kind] = [then]

        def fetch(j: Job) -> int:
            def progress(s: str) -> None:
                j.check()
                j.progress = s
            (fetch_hvsc if kind == "SID" else fetch_ay)(root, progress, j.out)
            return 0

        def fetched(j: Job) -> None:
            waiters = self.waiters.pop(kind, [])
            d = find() if j.rc == 0 else None
            if d is None and not j.cancelled:
                self.flash(f"the {kind} collection did not download (J: its job, l: the log)", "err")
            for t in waiters:
                t(d)
        src = "HVSC" if kind == "SID" else "chris-y/AY"
        job = self.runner.submit(Job(f"download the {kind} collection ({src})", fn=fetch, on_done=fetched,
                                     kind=f"dl-{kind.lower()}", what=f"download {kind} collection", game=src))
        if queued is not None:
            queued.append(job)
        return 1

    # -- the jobs

    def activity_key(self, j: Job) -> int:
        """The key of the activity j is in (Activity.key)."""
        with self.runner.lock:
            act = list(self.runner.activity)
        return act[0].n if j in act else j.n

    def job_finished(self, j: Job) -> None:
        """Each finished job (after its on_done): a cancelled one said, a takes or judge job's
        result; when it was a game's last job of the activity, the game's result (results)."""
        for u in job_units(j, time.monotonic()):
            if j.state == "failed" and not (j.live is not None and u.frac >= 1.0):
                self.game_failed[u.key] = f"{j.what or j.title} failed"
            elif j.state == "done":
                self.game_failed.pop(u.key, None)
        if j.kind in GAME_KINDS and j.gid:
            with self.runner.lock:
                act = list(self.runner.activity)
            mine = [x for x in act if x.kind in GAME_KINDS and j.gid in x.game_ids()]
            if all(x.closed or x is j for x in mine):
                self.results[(act[0].n if j in act else j.n, j.gid)] = self.game_result(j.gid, mine)
        if j.state == "cancelled":
            self.flash(f"cancelled: {j.title}" + (" (stopped while it ran)" if j.started else ""))
            return
        if j.kind == "judge":
            sm = j.watch.summary if j.watch else None
            if j.rc != 0:
                self.flash(f"the judge failed for {j.game}: {fail_reason(j)} (the log: {self.runner.log_path.name})", "err")
            elif sm is not None:
                hint = "; n goes to the next game to hear" if self.runner.threaded and sm.get("flagged", "0") != "0" else ""
                self.flash(f"judge, {j.game}: {summary_text('judge', sm)}{hint}", "ok")
            return
        if j.kind not in TAKES_LABEL:
            return
        label, screen = TAKES_LABEL[j.kind], self.runner.threaded
        if j.rc != 0:
            self.flash(f"{label} takes for {j.game} failed: {fail_reason(j)} (the log: {self.runner.log_path.name})", "err")
            return
        sm = j.watch.summary if j.watch else None
        hint = "; Enter on the game to listen" if screen else ""
        if sm is None:
            self.flash(f"{label} takes for {j.game}: done{hint}", "ok")
            return
        n = int(sm["takes"]) if sm.get("takes", "").isdigit() else 0
        if n:
            best = (f" (best closeness {pct(sm['best'])})" if sm.get("best", "-") != "-"
                    else " written" if j.kind == "ai" else "")
            self.flash(f"{label} takes for {j.game}: {n}{best}{hint}", "ok")
        else:
            self.flash(f"{label} takes for {j.game}: {summary_text(j.kind, sm)}")

    def game_result(self, gid: str, jobs: list[Job]) -> tuple[str, str]:
        """A game's result once its jobs of the activity are over, in words, and ok, err (a job
        failed: its words) or off (cancelled): with a judge, what was found and what became of
        its tunes (tune_words); else each takes job's result."""
        bad = next((x for x in jobs if x.state == "failed"), None)
        if bad is not None:
            return f"{bad.what or bad.title} failed: {fail_words(bad, 50) or f'exit {bad.rc}'}", "err"
        if any(x.state == "cancelled" for x in jobs):
            return "cancelled", "off"
        g = self.plan.game(gid) if self.plan else None
        if g is not None and any(x.kind == "judge" for x in jobs):
            return self.tune_words(g), "ok"
        parts = []
        for x in jobs:
            if x.kind in TAKES_LABEL:
                sm = x.watch.summary if x.watch else None
                parts.append(f"{TAKES_LABEL[x.kind]}: " + (summary_text(x.kind, sm) if sm is not None else x.skip_note or x.state))
        return "; ".join(parts) or "done", "ok" if all(x.state in ("done", "skipped") for x in jobs) else "off"

    def row_result(self, gb: GameBar) -> tuple[str, str]:
        """A game's result from its rows of the learning (and a build's pack): learned (in so
        many seconds), from the cache, left out (why), loaded; its pack."""
        row = None
        pack = ""
        for x in gb.jobs:
            if x.live is not None:
                with x.live.lock:
                    r = next((r for r in x.live.rows if (r.gid or r.name) == gb.key), None)
                    row = LiveRow(**vars(r)) if r is not None else row
            if x.kind == "pack" and x.stage:
                pack = f"pack {x.stage[0]}"
        if gb.state == "failed":
            return ": ".join(x for x in (gb.why, gb.reason) if x) or "failed", "err"
        if row is None:
            return pack or "done", "ok"
        if row.state == "left out":
            return f"left out: {row.how}" if row.how else "left out", "off"
        words = ("loaded, " if "load" in row.done else "") + (
            f"learned in {fmt_secs(row.seconds)}" if row.state == "learned" and row.seconds is not None
            else "learned" if row.state == "learned" else "from the cache")
        return words + (f", {pack}" if pack else ""), "ok"

    def result_of(self, a: Activity, gb: GameBar) -> tuple[str, str] | None:
        """A finished game's line: its result (results) or, for a game of the learning alone, its
        rows'; None while its result is not there yet."""
        got = self.results.get((a.key, gb.key))
        if got is not None:
            return got
        mine = [x for x in gb.jobs if x.kind in GAME_KINDS]
        if not mine:
            return self.row_result(gb)
        if all(x.closed for x in mine):
            got = self.results[(a.key, gb.key)] = self.game_result(gb.key, mine)  # its last jobs skipped: no job_finished
            return got
        return None

    def cancel_job(self, j: Job) -> None:
        what = self.runner.cancel(j)
        if what == "stopping":
            self.flash(f"stopping: {j.title}")
        elif not what:
            self.flash(f"{j.title}: {j.state}, nothing to cancel")

    def busy_games(self) -> dict[str, str]:
        """The games with a takes job waiting or running: id -> "running" or "waiting"."""
        out: dict[str, str] = {}
        for j in self.runner.jobs:
            if j.gid and (j.kind in TAKES_LABEL or j.kind == "judge") and j.state in ("waiting", "running"):
                if out.get(j.gid) != "running":
                    out[j.gid] = j.state
        return out

    def names(self) -> dict[str, str]:
        """The games' names by key (id; a row's name before the games file gives ids)."""
        out = {}
        if self.live is not None:
            out.update({r.gid or r.name: r.name for r in self.live.snapshot()})
        if self.plan:
            out.update({g.id: g.name for g in self.plan.games})
        return out

    def activity(self, now: float | None = None) -> Activity:
        """The activity: a bar per game with work in it, and the whole (activity_of)."""
        r = self.runner
        with r.lock:
            jobs = list(r.activity)
        ahead = []
        br = self.build_run
        if br is not None and br.packs:
            for i, ids in enumerate(br.packs):
                for sub in (0, 1):
                    if (i, sub) not in br.queued:
                        ahead += [Unit(gid, gid, 0.0, False, "waiting", False) for gid in ids]
        return activity_of(jobs, self.names(), time.monotonic() if now is None else now, r.current, ahead)

    # -- listening and choosing

    def route(self, g: Game, key: str, c: Candidate) -> tuple[str, Path | None, str]:
        return play_route(self.w, g.id, key, c, self.tools.preview_ok(), self.tools.preview_mtime())

    @staticmethod
    def cand_id(g: Game, key: str, c: Candidate) -> str:
        return f"{g.id}__{key}__{c.take}"

    def level(self, path: Path) -> tuple[float, float] | None:
        """A sound file's peak and seconds (wav_level), kept for the file as it is: in memory, and
        for a preview in W/previews/<name>.wav.level beside it (not measured again until the
        preview is made again)."""
        try:
            m = path.stat().st_mtime_ns
        except OSError:
            return None
        k = (str(path), m)
        if k in self.levels:
            return self.levels[k]
        side = path.with_name(path.name + ".level")
        kept = path.parent == self.w / "previews"
        got = None
        if kept:
            with contextlib.suppress(OSError, ValueError):
                if side.stat().st_mtime_ns >= m:
                    peak, secs = (float(x) for x in side.read_text().split())
                    got = (peak, secs)
        if got is None:
            got = wav_level(path)
            if got is not None and kept:
                with contextlib.suppress(OSError):
                    side.write_text(f"{got[0]:.6f} {got[1]:.2f}\n")
        if got is not None:
            self.levels[k] = got
        return got

    def silent(self, path: Path) -> float | None:
        """The file's seconds when it is silent (its peak under SILENT_PEAK), else None."""
        lv = self.level(path)
        return lv[1] if lv is not None and lv[0] < SILENT_PEAK else None

    @staticmethod
    def silent_text(key: str, c: Candidate, secs: float) -> str:
        if key == WHOLE_GAME:
            return f"silent: this game makes no sound in its first {secs:.0f} s"
        return f"silent: {c.label} makes no sound in its {secs:.0f} s"

    def start_playing(self, g: Game, key: str, c: Candidate, path: Path, note: str) -> None:
        """Plays the file unless it is silent (then says so; no player starts)."""
        secs = self.silent(path)
        if secs is not None:
            self.flash(self.silent_text(key, c, secs))
            return
        err = self.player.play(path, self.cand_id(g, key, c))
        self.flash(err or f"playing {c.label} ({note})")

    def play(self, g: Game, key: str, c: Candidate) -> None:
        cid = self.cand_id(g, key, c)
        self.player.stop()
        self.want_play = None
        how, path, note = self.route(g, key, c)
        if how == "file":
            self.start_playing(g, key, c, path, note)
        elif how == "none":
            self.flash(f"{c.label}: {note}")
        else:
            self.want_play = cid
            if cid in self.rendering:
                return
            self.rendering.add(cid)
            self.failed.pop(cid, None)
            path.parent.mkdir(parents=True, exist_ok=True)
            tmp = path.with_name(path.stem + ".tmp.wav")
            argv = preview_argv(self.tools.music_preview, self.all, g.id, key, c.take, tmp)

            def rendered(j: Job) -> None:
                self.rendering.discard(cid)
                if j.cancelled:
                    tmp.unlink(missing_ok=True)
                    if self.want_play == cid:
                        self.want_play = None
                    return
                ok = j.rc == 0 and tmp.is_file()
                if ok:
                    tmp.replace(path)
                else:
                    tmp.unlink(missing_ok=True)
                    lines = [ln.strip() for ln in j.tail if ln.strip() and not ln.startswith("==")]
                    self.failed[cid] = lines[-1] if lines else f"exit {j.rc}"
                if self.want_play != cid:
                    return
                self.want_play = None
                if ok:
                    self.start_playing(g, key, c, path, "music-preview")
                elif c.file and c.file.is_file():
                    self.start_playing(g, key, c, c.file, f"render failed ({self.failed[cid]}): {c.file.name}")
                else:
                    self.flash(f"{c.label}: render failed: {self.failed[cid]}")
            self.runner.submit(Job(f"render {g.name} {key} {c.take}", argv, on_done=rendered, kind="render", what="render",
                                   game=f"{g.name}: {c.label}", gid=g.id))
            self.flash(f"rendering {c.label}...")

    def stop(self) -> None:
        self.want_play = None
        self.player.stop()

    def state_of(self, g: Game, key: str, c: Candidate) -> str:
        cid = self.cand_id(g, key, c)
        if self.player.what == cid:
            return "playing"
        if cid in self.rendering:
            return "rendering..."
        if cid in self.failed:
            return f"render failed: {self.failed[cid]}"
        how, path, note = self.route(g, key, c)
        if how == "file" and (secs := self.silent(path)) is not None:
            return f"silent: no sound in {secs:.0f} s"
        return note if how == "none" else ""

    def whole_game_sound(self, g: Game) -> str:
        """For a game with no music, what its whole-game renders tell: "effects" (one has sound),
        "silent" (those rendered are silent; with their seconds), or "" (none rendered yet)."""
        secs = []
        for c in score_candidates(self.all, g.id, None):
            how, path, _ = self.route(g, WHOLE_GAME, c)
            if how != "file":
                continue
            s = self.silent(path)
            if s is None and self.level(path) is not None:
                return "effects"
            if s is not None:
                secs.append(s)
        return f"silent {min(secs):.0f}" if secs else ""

    def choose(self, g: Game, sc: Score, c: Candidate) -> None:
        if c.choice is None:
            self.flash(f"{c.label} is there to compare: not a choice")
            return
        sid = f"{g.id}/{sc.key}"
        try:
            write_choice(self.all, sid, c.choice)
        except OSError as e:
            self.flash(f"choosing failed: {e}", "err")
            return
        self.changed()
        self.event(f"chose {choice_label(c.choice)} for {sid} ({g.name}), as the owner's choice")
        self.flash(f"{g.name}: {sc.key} plays {choice_label(c.choice)} (b builds with it)", "ok")

    def toggle_play(self, g: Game, key: str, c: Candidate) -> None:
        """Plays the candidate, or stops it when it is the one playing or being rendered to play."""
        cid = self.cand_id(g, key, c)
        if self.player.what == cid or self.want_play == cid:
            self.stop()
            self.flash(f"stopped {c.label}")
        else:
            self.play(g, key, c)

    # -- building

    def build(self) -> None:
        if self.build_run:
            self.flash("a build is running")
            return
        self.build_run = BuildRun()
        self.summary = None
        self.build_ok = None
        over = packs_over(self.plan, self.packs) if self.plan else []
        if over:  # refused at once, before the device builds
            return self._finish(over_text(over))
        self.device_builds("build")

        def go(j: Job) -> int:
            self._build_after_device()
            return 0
        self.runner.submit(Job("check the device builds", fn=go, chain="build", kind="setup"))
        self.flash("building: the device builds, the plan, then the packs")

    def _build_after_device(self) -> None:
        """The build once the device builds are done: their files there, then the plan and the
        packs."""
        missing = [f for f in device_files() if not f.is_file()]
        if missing:
            return self._finish(f"no {missing[0]}: the device builds make it (FMZX_SKIP_DEVICE_BUILD=1 skipped them)"
                                if os.environ.get("FMZX_SKIP_DEVICE_BUILD", "0") == "1"
                                else f"no {missing[0]}: the device builds did not make it (see the log)")
        self.runner.submit(self.plan_job("build", then=self._split))

    def _split(self, j: Job) -> None:
        br = self.build_run
        if j.rc != 0 or not self.plan:
            return self._finish("the learning failed (see the log)")
        packed = self.plan.packed()
        if not packed:
            return self._finish("no game to pack")
        try:
            br.text = self.games_file().read_text()
            split_games_file(br.text)
        except (OSError, ValueError) as e:
            return self._finish(str(e))
        fill = self.assigned()
        if fill:
            over = packs_over(self.plan, self.packs)
            if over:
                return self._finish(over_text(over) + " (the sizes of this plan)")
            br.assigned = True
            br.numbers = list(fill)
            br.packs = [[g.id for g in gs] for gs in fill.values()]
            br.unassigned = [g.id for g in unassigned(self.plan, self.packs)]
        else:
            br.packs = split_packs([(g.id, g.packed) for g in packed], self.plan.room, self.plan.overhead())
            br.numbers = list(range(1, len(br.packs) + 1))
        self._pack(0)

    def _pack(self, i: int) -> None:
        br = self.build_run
        n = br.numbers[i]
        try:
            src = "../all/personal-games.toml" if not self.folder.is_file() else str(self.folder)
            note = f"Pack {n} of the games in {src}, made by tools/pack-studio on every build:\nedit that file instead."
            text = subset_games_file(br.text, br.packs[i], self.games_file().parent, note)
            d = write_pack_folder(self.w, n, br.packs[i], text)
        except (OSError, ValueError) as e:
            return self._finish(str(e))
        argv = [self.tools.fmzx_pack, "personal", str(d / "personal-games.toml"), "-o", str(d)]
        for a in apps():
            argv += ["--app", str(a)]
        rows = []
        for gid in br.packs[i]:
            g = self.plan.game(gid) if self.plan else None
            rows.append(LiveRow(g.name if g else gid, PurePosixPath(g.file).name if g else gid, gid))
        live = Live(rows, self.checked_ids())
        br.queued = {q for q in br.queued if q[0] < i} | {(i, 0)}  # a pack built again: its packages again too
        self.runner.submit(Job(f"pack {n} ({len(br.packs[i])} games)", argv, chain="build",
                               on_done=lambda j: self._packed(i, j), on_line=live.apply, kind="pack", what=f"build pack {n}",
                               game=plural(len(br.packs[i]), "game"), gids=list(br.packs[i]), live=live,
                               stage=(i + 1, len(br.packs), 0)))

    def _packages(self, i: int) -> None:
        n = self.build_run.numbers[i]
        d = self.w / f"pack-{n}"
        argv = [self.tools.make_packages]
        if self.args.offline:
            argv.append("--offline")
        if self.args.cache:
            argv += ["--cache", str(Path(self.args.cache).expanduser().resolve())]
        env = {"FMZX_SKIP_DEVICE_BUILD": "1", "FMZX_PACKAGES_PACK": str(d / "games.bin"), "FMZX_PACKAGES_OUT": str(d)}
        self.build_run.queued.add((i, 1))

        def done(j: Job) -> None:
            if j.rc != 0:
                return self._finish(f"pack {n}'s packages failed: {fail_reason(j)}")
            self.build_run.built = i + 1
            return self._pack(i + 1) if i + 1 < len(self.build_run.packs) else self._finish(None)
        self.runner.submit(Job(f"pack {n}: the packages and their verify", argv, env=env, chain="build", on_done=done,
                               kind="pack", what=f"pack {n}'s packages", game="fmzx.fwsc, fmzx-preview.fwsc",
                               gids=list(self.build_run.packs[i]), stage=(i + 1, len(self.build_run.packs), 1)))

    def _packed(self, i: int, j: Job) -> None:
        br = self.build_run
        n = br.numbers[i]
        if j.rc == 0:
            room = next((ln.strip() for ln in reversed(j.tail) if RE_ROOM.match(ln.strip())), "")
            if room:
                br.rooms[n] = room
            return self._packages(i)
        if NOT_FIT not in j.text():
            return self._finish(f"pack {n} failed: {fail_reason(j)}")
        if br.assigned:
            return self._finish(f"pack {n} does not fit (the log says by how much): take a game out of it")
        # the automatic split: the pack's last game goes to the next pack
        if len(br.packs[i]) == 1:
            br.too_big.append(br.packs.pop(i)[0])
            br.numbers = list(range(1, len(br.packs) + 1))
            return self._pack(i) if i < len(br.packs) else self._finish(None)
        last = br.packs[i].pop()
        if i + 1 == len(br.packs):
            br.packs.append([])
            br.numbers = list(range(1, len(br.packs) + 1))
        br.packs[i + 1].insert(0, last)
        self.runner.note(j, f"pack {n} does not fit: {last} goes to pack {n + 1}")
        self._pack(i)

    def _finish(self, error: str | None) -> None:
        br = self.build_run
        br.error = error
        lines = []
        if error is None:
            for d in remove_stale_packs(self.w, set(br.numbers)):
                lines.append(f"removed {d} (not one of the packs built)")
        lines += pack_summary(self.w, self.plan, br.rooms)
        names = lambda ids: ", ".join((self.plan.game(g).name if self.plan and self.plan.game(g) else g) for g in ids)  # noqa: E731
        if br.too_big:
            lines.append(f"in no pack (too big for a pack of its own): {names(br.too_big)}")
        if br.unassigned and error is None:
            k = len(br.unassigned)
            lines.append(f"not built, in no pack: {k} game{'s' if k != 1 else ''}: {names(br.unassigned)}")
        if self.plan:
            out = [g for g in self.plan.games if g.left_out]
            if out:
                lines.append("left out: " + "; ".join(f"{g.name} ({g.reason or g.how})" for g in out))
        if error:
            lines.append(f"build failed: {error}")
        else:
            lines.append(f"built {len(br.packs)} pack{'s' if len(br.packs) != 1 else ''}: install a pack's fmzx.fwsc "
                         "as docs/install.md describes")
        self.summary = lines
        self.build_ok = error is None and not br.too_big
        self.build_run = None
        self.changed()
        self.flash("build done" if error is None else f"build failed: {error}", "ok" if error is None else "err")

    # -- text for --status

    def status_lines(self) -> list[str]:
        p = self.plan
        out = [f"workspace {self.w}"]
        if p is None:
            return out + ["no plan yet"]
        packed = p.packed()
        fill = self.assigned()
        if fill:
            est = [(n, [g.id for g in gs]) for n, gs in fill.items()]
        else:
            est = list(enumerate(split_packs([(g.id, g.packed) for g in packed], p.room, p.overhead()), 1))
        out.append(f"room {kb(p.room)}; all games {kb(p.used)}; a build makes {len(est)} pack{'s' if len(est) != 1 else ''}"
                   + (" (the packs filled)" if fill else " (the automatic split)"))
        sd = self.sid_dir()
        out.append("SID collection: " + (str(sd) if sd else "none: given with --sid-dir" if self.args.sid_dir
                                         else "none (--offline)" if self.args.offline
                                         else f"downloaded to {hvsc_root()} on the first SID job"))
        ad = self.ay_dir()
        out.append("AY collection: " + (str(ad) if ad else "none: given with --ay-dir" if self.args.ay_dir
                                        else "none (--offline)" if self.args.offline
                                        else f"downloaded to {ay_root()} on the first AY job"))
        out.append("listening: " + ("music-preview" if self.tools.preview_ok()
                                    else "tools/arrange-music's renders (music-preview is not built)"))
        tot = {k: sum(self.tune_counts(g)[k] for g in p.games) for k in ("owner", "judge", "hear", "sure", "unjudged")}
        out.append(f"scores with takes: {tot['owner'] + tot['judge']} settled ({tot['owner']} by you, {tot['judge']} by the judge), "
                   f"{tot['hear']} to hear, {tot['sure'] + tot['unjudged']} for the judge (m, --auto)")
        ch = self.choices()
        for g in p.games:
            out.append("")
            if g.left_out:
                out.append(f"{g.name} ({g.id})  left out: {g.reason or g.how}")
                continue
            ms = ["FM"] + [m.upper() for m in METHODS if m in self.marked(g.id)]
            pk = self.packs.get(g.id)
            n = self.tune_counts(g)
            tunes = (f"  scores: {n['owner'] + n['judge']} settled, {n['hear']} to hear"
                     + (f", {n['sure'] + n['unjudged']} for the judge" if n["sure"] + n["unjudged"] else "")
                     if sum(n.values()) - n["none"] else "")
            out.append(f"{g.name} ({g.id})  {g.how}  {kb(g.packed)}  methods: {' '.join(ms)}  pack: {f'P{pk}' if pk else '-'}{tunes}")
            out.append(f"  {g.music}")
            groups = [(s, s.key) for s in g.scores] or [(None, WHOLE_GAME)]
            if not g.scores:
                out.append(f"  {g.plays()}")
            for s, key in groups:
                if s:
                    chosen = ch.get(f"{g.id}/{s.key}", 0)
                    tstate, words = self.tune_state(g, s)
                    out.append(f"  score {s.key}  {s.seconds:.1f} s{'  shadow' if s.shadow else ''}  "
                               f"plan: {s.status or '-'}  choice: {choice_label(chosen)}"
                               + (" (the judge's)" if tstate == "judge" else "") + (f"  {TUNE_STATES[tstate][0]}" if tstate != "none" else ""))
                    if words:
                        out.append(f"    {words}")
                else:
                    chosen = None
                for c in self.candidates(g, s):
                    how, path, note = self.route(g, key, c)
                    if how == "file":
                        play = f"plays {path.name if note != 'music-preview' else 'its preview'}"
                    else:
                        play = "plays a music-preview render" if how == "render" else note
                    mark = (("j" if self.judged().get(f"{g.id}/{s.key}") == chosen else "*")
                            if s and c.choice is not None and c.choice == chosen else " ")
                    out.append(f"   {mark} {c.label:<26} {c.text()}  [{play}]")
        out.append("")
        out.append("packs:" + (f" ({self.sizes_note()})" if self.sizes_note() else ""))
        out += [f"  {ln}" for _, ln, _ in pack_lines(p, self.packs)]
        out.append("a build makes:")
        names = {g.id: g.name for g in packed}
        sizes = {g.id: g.packed for g in packed}
        for n, ids in est:
            out.append(f"  pack {n}: {', '.join(names[g] for g in ids)} ({kb(sum(sizes[g] for g in ids) + p.overhead())})")
        if fill:
            un = unassigned(p, self.packs)
            if un:
                out.append(f"  not built, in no pack: {', '.join(g.name for g in un)}")
        built = pack_summary(self.w, p)
        if built:
            out.append("built:")
            out += [f"  {ln}" for ln in built]
        return out


