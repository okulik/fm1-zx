@dataclass
class BuildRun:
    packs: list[list[str]] = field(default_factory=list)
    numbers: list[int] = field(default_factory=list)  # each pack's number (W/pack-<n>)
    assigned: bool = False  # the packs the owner filled (else the automatic split)
    unassigned: list[str] = field(default_factory=list)  # packed games in no pack: not built
