        g = st.plan.game("alpha")
        sc = g.scores[0]
        labels = [c.label for c in st.candidates(g, sc)]
        check(labels == ["beeper", "FM (from code/memory)", "AI take-1 (rules)", "SID chip-1", "C64 original (chip-1)", "AY ay-1",
                         "Spectrum 128 original (ay-1)"], f"candidates: {labels}")
        cands = {c.take: c for c in st.candidates(g, sc)}
        check("consonance bass 0.71 pad 0.66" in cands["1"].info and "melody match 0.42; C64: Alpha" in cands["chip-1"].info,
              "candidates: the take's metrics, the chip take's source and match")
        check("melody match 0.37; Spectrum 128: Alpha by Someone, song 2" in cands["ay-1"].info and cands["ay-1"].choice == "ay-1"
              and cands["zx128-1"].choice is None and cands["zx128-1"].direct, "candidates: the AY take's source and match, its own sound")
        st.choose(g, sc, cands["ay-1"])
        runner.drain()
        check(["pick", str(w / "all"), "--set", "alpha/8951-1a2b3c4d=ay-1"] in [json.loads(ln) for ln in calls.read_text().splitlines()]
              and read_choices(w / "all") == {"alpha/8951-1a2b3c4d": "ay-1"} and st.choice_summary(g) == "ay-1",
              "choose: pick --set GAME/KEY=ay-1, read back")
        check(preview_argv("mp", w / "all", "alpha", sc.key, "ay-1", Path("o.wav"))[-4:] == ["--take", "ay-1", "-o", "o.wav"],
              "listen: an AY take through music-preview --take ay-<n>")
        st.choose(g, sc, cands["chip-1"])
        runner.drain()
        check(["pick", str(w / "all"), "--set", "alpha/8951-1a2b3c4d=chip-1"] in
              [json.loads(ln) for ln in calls.read_text().splitlines()], "choose: pick --set GAME/KEY=chip-1")
        check(read_choices(w / "all") == {"alpha/8951-1a2b3c4d": "chip-1"} and st.choice_summary(g) == "chip-1",
              "choose: the choice read back")
        st.choose(g, sc, cands["beeper"])
        check(not runner.pending, "choose: the beeper is not a choice")
        st.play(g, sc.key, cands["1"])
        runner.drain()
        prev = preview_path(w, "alpha", sc.key, "1")
        check(prev.is_file() and prev.read_bytes()[:4] == b"RIFF" and not prev.with_name(prev.stem + ".tmp.wav").exists(),
              "listen: a music-preview render, cached by name")
        check(st.route(g, sc.key, cands["1"])[0] == "file", "listen: the cached render plays at once")
        os.utime(cands["1"].source, (time.time() + 5, time.time() + 5))
        check(st.route(g, sc.key, cands["1"])[0] == "render", "listen: a changed take is rendered again")
        os.environ["FMZX_MUSIC_PREVIEW"] = str(t / "none")
        st.tools = Tools.from_env()
        r = [play_route(w, "alpha", sc.key, c, False)[0] for c in st.candidates(g, sc)]
        check(r == ["none", "none", "file", "none", "file", "none", "file"], f"listen without music-preview: arrange-music's files ({r})")
        os.environ["FMZX_MUSIC_PREVIEW"] = env["FMZX_MUSIC_PREVIEW"]
        st.tools = Tools.from_env()
        bg = st.plan.game("bravo")
        st.play(bg, WHOLE_GAME, st.candidates(bg, None)[1])
        runner.drain()
        check(preview_path(w, "bravo", WHOLE_GAME, "fm").is_file(), "listen: the whole game of a game without scores")

        # -- the build: a pack that does not fit gives its last game to the next
        (w / "pack-4").mkdir()
        (w / "pack-4" / MARKER).write_text("{}")
        (w / "pack-9").mkdir()
        (w / "pack-9" / "mine.txt").write_text("not the studio's")
        os.environ["FAKE_ROOM"] = "71000"
        buf = io.StringIO()
        with contextlib.redirect_stdout(buf):
            rc = main([str(games), "-o", str(w), "--build"])
        s = buf.getvalue()
        packs = {n: json.loads((d / MARKER).read_text())["games"] for n, d in pack_folders(w) if is_studio_pack(d)}
        check(rc == 0 and packs == {1: ["alpha"], 2: ["bravo"], 3: ["charlie"]}, f"build: retries move games on ({packs})")
        check(not (w / "pack-4").exists() and (w / "pack-9" / "mine.txt").is_file(),
              "build: the studio's stale pack-4 removed, a folder not its own kept")
        p1 = w / "pack-1"
        check(os.readlink(p1 / "sound-cache") == "../all/sound-cache" and os.readlink(p1 / "arrange") == "../all/arrange"
              and (p1 / "arrange" / "choices.toml").is_file(), "build: the links into W/all")
        g1 = (p1 / "personal-games.toml").read_text()
        check(g1.startswith(SELFTEST_HEADER.rstrip("\n")) and alpha in g1 and "bravo" not in g1,
              "build: the pack's games file, alpha's entry verbatim")
        check((w / "pack-3" / "fmzx.fwsc").read_bytes() == b"FWSCcharlie" and str(w / "pack-3" / "fmzx.fwsc") in s,
              "build: the packages, and the summary names them")
        os.environ["FAKE_ROOM"] = "100000"
        with contextlib.redirect_stdout(io.StringIO()):
            rc = main([str(games), "-o", str(w), "--build"])
        packs = {n: json.loads((d / MARKER).read_text())["games"] for n, d in pack_folders(w) if is_studio_pack(d)}
        check(rc == 0 and packs == {1: ["alpha", "bravo"], 2: ["charlie"]} and not (w / "pack-3").exists(),
              f"build: fewer packs, pack-3 removed ({packs})")
        check((w / "all" / "sound-cache").is_dir() and (w / "all" / "arrange" / "choices.toml").is_file(),
              "build: the shared folders survive the removal")
        os.environ["FAKE_ROOM"] = "50000"
        buf = io.StringIO()
        with contextlib.redirect_stdout(buf):
            rc = main([str(games), "-o", str(w), "--build"])
        check(rc == 1 and "in no pack (too big for a pack of its own): Charlie" in buf.getvalue(),
              "build: a game too big for any pack is named, exit 1")
        os.environ["FAKE_ROOM"] = "100000"

        # -- the SID collection: safe unpacking, and the download from 127.0.0.1
        import py7zr

        src = t / "web"
        src.mkdir()
        with py7zr.SevenZipFile(src / "HVSC_85-all-of-them.7z", "w") as z:
            z.writestr(b"STIL\n", "C64Music/DOCUMENTS/STIL.txt")
            z.writestr(b"PSID", "C64Music/MUSICIANS/S/Someone/Alpha.sid")
        with py7zr.SevenZipFile(t / "evil.7z", "w") as z:
            z.writestr(b"ok", "C64Music/ok.txt")
            z._writestr(b"x", "../escaped.txt")  # the writer refuses such a path; the test needs one
        try:
            safe_extract_7z(t / "evil.7z", t / "evil-out")
            check(False, "unpack: a member escaping its folder refuses the archive")
        except ValueError:
            check(not (t / "escaped.txt").exists() and not (t / "evil-out").exists()
                  and not (t / ".evil-out.tmp").exists(), "unpack: a member escaping its folder refuses the archive")
        if external_unpacker(src / "HVSC_85-all-of-them.7z", t) is None:
            print("skip  unpack with bsdtar or 7-Zip: neither is installed")
        else:
            how = safe_extract_7z(src / "HVSC_85-all-of-them.7z", t / "ext" / "85", external=True)
            check(find_collection(t / "ext") == t / "ext" / "85" / "C64Music"
                  and (t / "ext/85/C64Music/MUSICIANS/S/Someone/Alpha.sid").read_bytes() == b"PSID",
                  f"unpack with {how} (for methods py7zr does not read)")
        check(not member_ok("/abs") and not member_ok("a/../../b") and not member_ok("C:x") and member_ok("C64Music/a b.sid"),
              "unpack: the path checks")
        import http.server

        class Quiet(http.server.SimpleHTTPRequestHandler):
            def __init__(self, *a, **k):
                super().__init__(*a, directory=str(src), **k)

            def log_message(self, *a):
                pass
        srv = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Quiet)
        threading.Thread(target=srv.serve_forever, daemon=True).start()
        base = f"http://127.0.0.1:{srv.server_address[1]}"
        (src / "api.json").write_text(json.dumps({"version": 85, "complete": {"url": f"{base}/HVSC_85-all-of-them.7z"}}))
        seen = []
        try:
            coll = fetch_hvsc(t / "hvsc", seen.append, lambda s: None, api=f"{base}/api.json")
        finally:
            srv.shutdown()
        check(coll == t / "hvsc" / "85" / "C64Music" and (coll / "MUSICIANS/S/Someone/Alpha.sid").is_file(),
              "download: unpacked into build/hvsc/<version>/, the collection found")
        check(not list((t / "hvsc").glob("*.7z*")) and any("unpacking" in x for x in seen),
              "download: the archive removed after unpacking, progress shown")
        check(downloaded_collection(t / "hvsc") == coll and find_collection(t / "hvsc") == coll,
              "download: found again on the next start")
        check(not url_ok("http://example.org/x.7z") and url_ok("https://example.org/x.7z"), "download: https only (or 127.0.0.1)")

        # -- the AY collection: the download from 127.0.0.1, only music/ay unpacked, a bad archive refused
        import tarfile

        sha = "0123456789abcdef0123456789abcdef01234567"
        top = f"AY-{sha}"

        def tgz(path: Path, members: list[tuple[str, bytes | None, str]]) -> None:
            with tarfile.open(path, "w:gz") as tf:
                for name, data, kind in members:
                    ti = tarfile.TarInfo(name)
                    if kind == "dir":
                        ti.type = tarfile.DIRTYPE
                        tf.addfile(ti)
                    elif kind == "link":
                        ti.type, ti.linkname = tarfile.SYMTYPE, "/etc/passwd"
                        tf.addfile(ti)
                    else:
                        ti.size = len(data)
                        tf.addfile(ti, io.BytesIO(data))

        (src / "tar").mkdir()
        tgz(src / "tar" / sha, [(top, None, "dir"), (f"{top}/README.md", b"readme", "file"),
                                (f"{top}/screenshots/a.png", b"png", "file"), (f"{top}/music/ay/games", None, "dir"),
                                (f"{top}/music/ay/games/Alpha.ay", b"ZXAYEMUL", "file"),
                                (f"{top}/music/ay/misc/Other.ay", b"ZXAYEMUL", "file")])
        (src / "commits.json").write_text(json.dumps({"sha": sha, "commit": {"message": "x"}}))
        tgz(t / "evil-ay.tar.gz", [(f"{top}/music/ay/games/ok.ay", b"ok", "file"), (f"{top}/music/ay/../../../escaped.txt", b"x", "file")])
        tgz(t / "link-ay.tar.gz", [(f"{top}/music/ay/games/ok.ay", b"ok", "file"), (f"{top}/music/ay/games/l.ay", None, "link")])
        for bad, why in (("evil-ay.tar.gz", "a path escaping its folder"), ("link-ay.tar.gz", "a link")):
            try:
                safe_extract_ay(t / bad, t / "ay-out")
                check(False, f"AY unpack: {why} refuses the archive")
            except ValueError:
                check(not (t / "escaped.txt").exists() and not (t / "ay-out").exists() and not (t / ".ay-out.tmp").exists(),
                      f"AY unpack: {why} refuses the archive")
        srv = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Quiet)
        threading.Thread(target=srv.serve_forever, daemon=True).start()
        base = f"http://127.0.0.1:{srv.server_address[1]}"
        seen = []
        try:
            acoll = fetch_ay(t / "ay", seen.append, lambda s: None, api=f"{base}/commits.json", tarball=f"{base}/tar/{{sha}}")
            again = fetch_ay(t / "ay", seen.append, lambda s: None, api=f"{base}/commits.json", tarball=f"{base}/nowhere/{{sha}}")
        finally:
            srv.shutdown()
        dest = t / "ay" / sha[:12]
        check(acoll == dest / "music" / "ay" and (acoll / "games" / "Alpha.ay").read_bytes() == b"ZXAYEMUL"
              and (acoll / "misc" / "Other.ay").is_file(), "AY download: music/ay unpacked into build/ay/<commit>/")
        check(not (dest / "screenshots").exists() and not (dest / "README.md").exists() and not list((t / "ay").glob("*.tar.gz*"))
              and any("unpacking" in x for x in seen), "AY download: the rest of the repository skipped, the archive removed, progress shown")
        check(again == acoll and downloaded_ay(t / "ay") == acoll and find_ay_collection(dest) == acoll,
              "AY download: the commit there already is not downloaded again; found on the next start")

        # -- --status on the workspace the steps above left
        buf = io.StringIO()
        with contextlib.redirect_stdout(buf):
            main([str(games), "-o", str(w), "--status"])
        s = buf.getvalue()
        check("methods: FM AI SID AY" in s and "* SID chip-1" in s and "  AY ay-1  " in s and "choice: chip-1" in s and "built:" in s
              and "pack 2: 1 game," in s and f"AY collection: {t / 'ay' / sha[:12] / 'music' / 'ay'}" in s
              and "not available" not in s, "--status: methods (AY among them), the chosen candidate, the built packs, the AY collection")
        print("\n".join("      " + ln for ln in s.splitlines()[:14]))

        # -- the screen, in a pseudo-terminal: keys, a resize down to 3x10, quit
        import fcntl
        import pty
        import struct
        import termios

        def size(fd: int, rows: int, cols: int) -> None:
            fcntl.ioctl(fd, termios.TIOCSWINSZ, struct.pack("HHHH", rows, cols, 0, 0))

        pid, fd = pty.fork()
        if pid == 0:
            os.environ["TERM"] = "xterm-256color"
            try:
                os.execv(sys.executable, [sys.executable, str(Path(__file__).resolve()), str(games), "-o", str(w)])
            finally:
                os._exit(127)
        size(fd, 24, 100)
        os.kill(pid, signal.SIGWINCH)
        out, status = _wait_pty(fd, pid, 2.0)
        keys = [b"j", b"k", b"y", b"y", b"\r", b"j", b"j", b"j", b"\r", b" ", b"c", b"y", b"y", b"l", b"k", b"q", b"h", b"?", b"q"]
        for k in keys:
            os.write(fd, k)
            o, status = _wait_pty(fd, pid, 0.15)
            out += o
        for rows, cols in ((10, 30), (3, 10), (1, 1), (30, 120)):
            size(fd, rows, cols)
            os.kill(pid, signal.SIGWINCH)
            o, status = _wait_pty(fd, pid, 0.4)
            out += o
        os.write(fd, b"\x1b[B\x1b[B\r")
        out += _wait_pty(fd, pid, 0.5)[0]
        os.write(fd, b"h")
        os.write(fd, b"q")
        o, status = _wait_pty(fd, pid, 1.0)
        out += o
        if status is None:
            os.write(fd, b"y")
            o, status = _wait_pty(fd, pid, 5.0)
            out += o
        if status is None:
            os.kill(pid, signal.SIGKILL)
            os.waitpid(pid, 0)
        os.close(fd)
        text_out = out.decode("utf-8", "replace")
        check(status is not None and os.WIFEXITED(status) and os.WEXITSTATUS(status) == 0 and "Traceback" not in text_out,
              "screen: keys, resizes down to 1x1, quit; exit 0" + ("" if status is not None else " (it hung)")
              + ("" if "Traceback" not in text_out else ": " + text_out[text_out.find("Traceback"):][:600]))
        check("pack-studio" in text_out and "Alpha" in text_out and "workspace" in text_out,
              "screen: drew the games, printed the workspace when it closed")
        check(choice_label(read_choices(w / "all").get("alpha/8951-1a2b3c4d")) in ("take-1", "chip-1", "ay-1", "original"),
              "screen: c chose through pick --set")

    if failures:
        print(f"{PROG} selftest: {len(failures)} failed: " + "; ".join(failures))
        return 1
    print(f"{PROG} selftest: all passed")
    return 0


def parse_args(argv: list[str] | None) -> argparse.Namespace:
    ap = argparse.ArgumentParser(prog=PROG, description="A terminal studio for your own games: music per game, then the packs.",
                                 epilog="tools/pack-studio selftest checks the tool. Details: the docstring at the top of tools/pack-studio.")
    ap.add_argument("folder", help="the folder of your games (.sna, .z80, .tap, .tzx)")
    ap.add_argument("-o", dest="out", metavar="W", help="the workspace (default build/studio/<folder name>)")
    ap.add_argument("--sid-dir", metavar="PATH", help="the SID collection to use instead of downloading one")
    ap.add_argument("--ay-dir", metavar="PATH", help="the AY collection (.ay files) to use instead of downloading one")
    ap.add_argument("--offline", action="store_true", help="download nothing")
    ap.add_argument("--model", metavar="NAME", help="the generator for AI takes (tools/arrange-music generate --model)")
    m = ap.add_mutually_exclusive_group()
    m.add_argument("--status", action="store_true", help="print the games, methods, scores, candidates and choices")
    m.add_argument("--build", action="store_true", help="build the packs without the screen")
    return ap.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    argv = sys.argv[1:] if argv is None else argv
    if argv[:1] == ["selftest"]:
        return cmd_selftest(argparse.Namespace())
    return cmd_studio(parse_args(argv))


if __name__ == "__main__":
    sys.exit(main())
