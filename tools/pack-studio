def _script(path: Path, body: str, consts: dict) -> str:
    pre = "".join(f"{k} = {v!r}\n" for k, v in consts.items())
    path.write_text(f"#!{sys.executable}\n{pre}{body}")
    path.chmod(0o755)
    return str(path)


def _wait_pty(fd: int, pid: int, seconds: float) -> tuple[bytes, int | None]:
    import select

    out = b""
    end = time.monotonic() + seconds
    status = None
    while time.monotonic() < end:
        r, _, _ = select.select([fd], [], [], 0.05)
        if r:
            try:
                b = os.read(fd, 65536)
            except OSError:
                b = b""
            out += b
        done, st_ = os.waitpid(pid, os.WNOHANG)
        if done:
            status = st_
            break
    return out, status


