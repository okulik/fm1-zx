#
# Build the update packages with your own games (BUILDING.md, "Your own games"):
#   tools/make-personal-pack <folder | games.toml> [-o DIR] [--try] [--offline] [--cache DIR]
# From a folder, DIR/personal-games.toml lists its games; a re-run keeps your edits to it. From a
# games file (such as that one, after you deleted some entries), the file is used as written.
# Writes DIR/fmzx.fwsc and DIR/fmzx-preview.fwsc (DIR is build/personal unless -o says otherwise),
# prints a table of the games, and verifies both packages as tools/make-packages does.
#   -o DIR       the output folder
#   --try        then run the browser test bench on these packages (tools/web-demo --packages DIR)
#   --offline, --cache DIR   as for tools/make-packages
# Runs both device builds first (presets fm1 and fm1-preview, in Docker through tools/fm1-docker; a
# no-op when they are up to date), so one command goes from a clean build/ to the packages.
# FMZX_SKIP_DEVICE_BUILD=1 skips them (build/fm1 and build/fm1-preview must then exist).
# Your games are only read; everything is written under DIR.
set -eu

usage() {
    sed -n '5,15s/^# \{0,1\}//p' "$0" >&2
    exit 2
}

root=$(cd "$(dirname "$0")/.." && pwd)
b="$root/build/fm1"
p="$root/build/fm1-preview"
out="$root/build/personal"
input=
try=0
offline=
cache=
while [ $# -gt 0 ]; do
    case $1 in
    -o)
        [ $# -ge 2 ] || usage
        out=$2
        shift
        ;;
    --try) try=1 ;;
    --offline) offline=--offline ;;
    --cache)
        [ $# -ge 2 ] || usage
        cache=$2
        shift
        ;;
    -h | --help) usage ;;
    -*)
        echo "tools/make-personal-pack: unknown option: $1" >&2
        usage
        ;;
    *)
        [ -z "$input" ] || usage
        input=$1
        ;;
    esac
    shift
done
[ -n "$input" ] || usage

die() {
    echo "tools/make-personal-pack: $*" >&2
    exit 1
}

if [ "${FMZX_SKIP_DEVICE_BUILD:-0}" != 1 ]; then
    for preset in fm1 fm1-preview; do
        "$root/tools/fm1-docker" cmake --preset "$preset" >/dev/null
        "$root/tools/fm1-docker" cmake --build --preset "$preset"
    done
fi
for f in "$b/platform/fm1/fmzx_app.bin" "$p/platform/fm1/fmzx_app.bin" "$b/third_party/felucca-loader/loader.bin"; do
    [ -f "$f" ] || die "no $f: build the firmware first (tools/make-packages)"
done
[ -e "$input" ] || die "no $input"
mkdir -p "$out"
out=$(cd "$out" && pwd)
abs() {
    case $1 in
    /*) echo "$1" ;;
    *) echo "$(pwd)/$1" ;;
    esac
}
input=$(abs "$input")

(cd "$root/host" && cargo build --quiet --release -p fmzx-pack)
"$root/host/target/release/fmzx-pack" personal "$input" -o "$out" \
    --app "$b/platform/fm1/fmzx_app.bin" --app "$p/platform/fm1/fmzx_app.bin"

# the packages and their verify, as tools/make-packages makes them (its arguments for fmzx-pack
# fwsc in "$@")
set -- $offline
[ -z "$cache" ] || set -- "$@" --cache "$(abs "$cache")"
FMZX_SKIP_DEVICE_BUILD=1 FMZX_PACKAGES_PACK="$out/games.bin" FMZX_PACKAGES_OUT="$out" \
    "$root/tools/make-packages" "$@"
echo "$out/fmzx.fwsc: your package; docs/install.md says how to install it"

if [ "$try" = 1 ]; then
    exec "$root/tools/web-demo" --packages "$out"
fi
