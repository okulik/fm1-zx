def make_handler(d: Path) -> type:
    arrange_dir = (d / "arrange").resolve()

    class Handler(http.server.BaseHTTPRequestHandler):
        def log_message(self, *args) -> None:
            pass

        def _send(self, code: int, body: bytes, ctype: str, extra: dict | None = None) -> None:
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            for k, v in (extra or {}).items():
                self.send_header(k, v)
            self.end_headers()
            if self.command != "HEAD":
                self.wfile.write(body)

        def _json(self, code: int, obj: dict) -> None:
            self._send(code, json.dumps(obj).encode(), "application/json")

        def _host_ok(self) -> bool:
            host = (self.headers.get("Host") or "").rsplit(":", 1)[0]
            return host in ("127.0.0.1", "localhost")

        def do_HEAD(self) -> None:
            self.do_GET()

        def do_GET(self) -> None:
            if not self._host_ok():
                return self._send(403, b"forbidden", "text/plain")
            path = urllib.parse.urlparse(self.path).path
            if path == "/":
                data = json.dumps(score_entries(d)).replace("<", "\\u003c")
                return self._send(200, PAGE.replace("__DATA__", data).encode(), "text/html; charset=utf-8")
            if path.startswith("/audio/"):
                rel = urllib.parse.unquote(path[len("/audio/"):])
                f = (arrange_dir / rel).resolve()
                if f.suffix != ".wav" or not f.is_relative_to(arrange_dir) or not f.is_file():
                    return self._send(404, b"not found", "text/plain")
                return self._file(f)
            self._send(404, b"not found", "text/plain")

        def _file(self, f: Path) -> None:
            size = f.stat().st_size
            rng = self.headers.get("Range")
            start, end = 0, size - 1
            code = 200
            if rng and rng.startswith("bytes="):
                a, _, b = rng[6:].split(",")[0].partition("-")
                try:
                    if a:
                        start = int(a)
                        end = min(int(b), size - 1) if b else size - 1
                    else:
                        start = max(size - int(b), 0)
                except ValueError:
                    start, end = 0, size - 1
                if start > end or start >= size:
                    return self._send(416, b"", "text/plain", {"Content-Range": f"bytes */{size}"})
                code = 206
            with f.open("rb") as fh:
                fh.seek(start)
                body = fh.read(end - start + 1)
            extra = {"Accept-Ranges": "bytes"}
            if code == 206:
                extra["Content-Range"] = f"bytes {start}-{end}/{size}"
            self._send(code, body, "audio/wav", extra)

        def do_POST(self) -> None:
            if not self._host_ok() or urllib.parse.urlparse(self.path).path != "/save":
                return self._json(404, {"error": "not found"})
            if not (self.headers.get("Content-Type") or "").startswith("application/json"):
                return self._json(415, {"error": "expected JSON"})
            n = int(self.headers.get("Content-Length") or 0)
            if n > 1 << 20:
                return self._json(413, {"error": "too large"})
            try:
                req = json.loads(self.rfile.read(n))
                choices = req["choices"]
                assert isinstance(choices, dict)
            except (ValueError, KeyError, AssertionError):
                return self._json(400, {"error": "bad request"})
            entries = {e["id"]: e for e in score_entries(d)}
            update = {}
            for sid, v in choices.items():
                c = parse_choice(v) if isinstance(v, (int, str)) else None
                if sid not in entries or c is None or not choice_ok(entries[sid], c):
                    return self._json(400, {"error": f"no take {v} for {sid}"})
                update[sid] = c
            write_choices(d, update)
            self._json(200, {"path": str(choices_path(d)), "choices": update})

    return Handler


def serve(d: Path, port: int) -> http.server.ThreadingHTTPServer:
    handler = make_handler(d)
    try:
        return http.server.ThreadingHTTPServer(("127.0.0.1", port), handler)
    except OSError:
        if port == 0:
            raise
        return http.server.ThreadingHTTPServer(("127.0.0.1", 0), handler)


def cmd_pick(a: argparse.Namespace) -> int:
    d = Path(a.dir)
    if not (d / "arrange").is_dir():
        die(f"no {d / 'arrange'}: learn the games first (tools/pack-studio; DIR is its W/all)")
    if a.set:
        apply_set(d, a.set)
    if a.list or not a.set:
        scores = find_scores(d)
        print(f"{PROG}: judging the takes of {len(scores)} scores (quick once they are judged)", flush=True)
        docs = judge_scores(d, scores, log=False)
        for sid, doc in docs.items():
            for t in doc["take"]:
                if t["name"] != "0" and t.get("faults"):
                    print(f"{PROG}: warning: {sid} {t['name']}: {'; '.join(t['faults'])}", flush=True)
    if a.list:
        print_list(d)
    if a.set or a.list:
        return 0
    srv = serve(d, a.port)
    url = f"http://127.0.0.1:{srv.server_address[1]}/"
    print(f"{PROG}: listen and choose at {url} (Ctrl-C to stop); choices go to {choices_path(d)}", flush=True)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        srv.server_close()
    return 0


