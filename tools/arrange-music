                  "page save of a chip take")
            body = json.dumps({"choices": {f"test-game/{keys[0]}": "chip-7"}}).encode()
            req = urllib.request.Request(base + "/save", data=body, headers={"Content-Type": "application/json"})
            try:
                urllib.request.urlopen(req)
                check(False, "page save of a missing chip take refused")
            except urllib.error.HTTPError as e:
                check(e.code == 400, "page save of a missing chip take refused")
        finally:
            srv.shutdown()
            srv.server_close()
    print(f"selftest: {'FAILED, ' + str(len(fails)) + ' checks' if fails else 'all checks passed'}")
    return 1 if fails else 0


# ---------------------------------------------------------------------------------------------


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(prog=PROG, description="Arranged takes for a personal pack's scores.",
                                 epilog="Details: the docstring at the top of tools/arrange-music.")
    sub = ap.add_subparsers(dest="cmd", required=True)
    g = sub.add_parser("generate", help="generate takes for the scores without them")
    g.add_argument("dir", help="the personal pack's folder (tools/make-personal-pack -o DIR)")
    g.add_argument("--takes", type=int, default=4, help="takes per score (default 4)")
    g.add_argument("--game", action="append", help="only this game's scores (repeatable)")
    g.add_argument("--force", action="store_true", help="regenerate scores that have takes")
    g.add_argument("--jobs", type=int, default=1, help="scores at once, in separate processes (default 1)")
    g.add_argument("--model", default="amt", help=f"the generator: {', '.join(sorted(GENERATORS))} (default amt)")
    g.add_argument("--soundfont", help="the .sf2 for renders (default: Homebrew fluid-synth's)")
    g.add_argument("--seed", type=int, default=1, help="the seed the takes derive from (default 1)")
    g.add_argument("--offline", action="store_true", help="fetch nothing: only the cached model")
    c = sub.add_parser("chip", help="takes from the games' C64 tunes, in a SID collection you have")
    c.add_argument("dir")
    c.add_argument("--sid-dir", required=True, help="the SID collection's folder (such as HVSC's C64Music); nothing is downloaded")
    c.add_argument("--game", action="append", help="only this game's scores (repeatable)")
    c.add_argument("--max", type=int, default=3, help="chip takes per score (default 3)")
    c.add_argument("--force", action="store_true", help="search again for scores that have chip takes (and index the collection again)")
    c.add_argument("--fmzx-pack", help="the fmzx-pack with chip-notes (default $FMZX_PACK, else host/target/release/fmzx-pack)")
    c.add_argument("--soundfont", help="the .sf2 for renders (default: Homebrew fluid-synth's)")
    p = sub.add_parser("pick", help="listen and choose a take per score")
    p.add_argument("dir")
    p.add_argument("--port", type=int, default=8765, help="the page's port on 127.0.0.1 (default 8765, else a free one)")
    p.add_argument("--set", action="extend", nargs="+", metavar="GAME/KEY=N", help="choose take N (0: the original; chip-N: a chip take) without the page; several at once, or --set again")
    p.add_argument("--list", action="store_true", help="print the scores, their takes and choices")
    sub.add_parser("selftest", help="check generate, chip and pick in a temporary folder")
    a = ap.parse_args(argv)
    return {"generate": cmd_generate, "chip": cmd_chip, "pick": cmd_pick, "selftest": cmd_selftest}[a.cmd](a)


if __name__ == "__main__":
    sys.exit(main())
