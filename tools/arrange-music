        summed("judge", str(d3), "--game", "brick-town", "--provisional")
        again = read_toml(bt)
        summed("judge", str(d3), "--game", "brick-town")
        final = read_toml(bt)
        bt.unlink()
        summed("judge", str(d3), "--game", "brick-town")
        fresh = read_toml(bt)
        check(made.get("null_provisional") is True and again.get("null_provisional") is True and again["null"] == tampered["null"]
              and "null_provisional" not in final and final["null"] == made["null"] == fresh["null"]
              and final == fresh,
              "judge --provisional: its null marked; reused by another provisional run; made again by a judge without it, "
              "which leaves what a judge from nothing leaves")

        # engine: the game's own music read from its engine (through the stand-in reader)
        de = d / "eng"
        ek = "9CE0-3901e61d"
        for g in ("test-game", "live-game", "plain-game", "wide-game"):
            selftest_score(de / "arrange" / g / ek / "score.toml", g, ek, shadow=g == "live-game", name=g.replace("-", " ").title())
        elog = conv.parent / "engine-calls.log"
        rc, sm, out = summed("engine", str(de), "--fmzx-pack", str(conv))
        check(rc == 0 and {k: v for k, v in sm.items() if k != "seconds"}
              == {"kind": "engine", "game": "all", "scores": "4", "pending": "4", "takes": "2", "live": "1", "unknown": "1", "failed": "0",
                  "engines": "ntropic", "source": "ntropic, 2 channels + drums; ntropic, 4 channels + drums"},
              f"engine: its summary line: 2 takes, one already exact, one with no known engine ({sm})")
        check("[live-game/9CE0-3901e61d] already exact, no engine take: ntropic, 2 channels + drums; a built-in entry" in out
              and not (de / "arrange" / "live-game" / ek / "engine-1").exists(), "engine: a score a built-in entry plays exactly gets no take, and says so")
        check("[plain-game/9CE0-3901e61d] no engine take: no known engine in its run" in out, "engine: a score no known engine plays says so")
        check(all(f"progress: engine {g}/{ek}" in out for g in ("test-game", "live-game", "plain-game", "wide-game")), "engine: a progress line per score")
        sdir = de / "arrange" / "test-game" / ek
        score = load_score(sdir / "score.toml")
        e1 = read_toml(sdir / "engine-1" / "arranged.toml")
        for f in ("game", "name", "key", "clock_hz", "intro_t", "loop_t"):
            check(e1.get(f) == score.header[f], f"engine-1: {f} as the score's (its timeline)")
        check(e1.get("take") == "engine-1" and e1.get("generator") == "engine ntropic" and "timeline" not in e1
              and e1.get("source") == "ntropic, read exactly: its rows at 9C9Ch" and e1.get("score_digest") == score.digest()
              and e1.get("channel_roles") == ["bass", "lead"] and e1.get("voices") == 3 and e1.get("roles") == TAKE_ROLES,
              "engine-1: take, generator, source, the score's digest, each channel's voice (the higher the lead, the lower under E3 the bass)")
        notes = e1.get("note", [])
        by = {v: sorted((x for x in notes if x["voice"] == v), key=lambda x: x["start_t"]) for v in range(4)}
        lead = [(x.start_t, x.end_t, x.period_t) for x in score.notes if x.voice == 2]
        check([(x["start_t"], x["end_t"], x["period_t"]) for x in by[0]] == lead and all(x["level"] == 200 for x in by[0]),
              "engine-1: the melody channel's notes exactly, on the lead at its level")
        bass = by[1]
        check(bass and all(a_["end_t"] <= b_["start_t"] for a_, b_ in zip(bass, bass[1:])) and not by[2]
              and all(x["level"] == 210 for x in bass), "engine-1: the bass channel on the bass, no pad")
        same = [(a_, b_) for a_, b_ in zip(bass, bass[1:]) if a_["period_t"] == b_["period_t"]]
        check(same and all(b_["start_t"] - a_["end_t"] == ENGINE_RESTRIKE_T for a_, b_ in same),
              f"engine-1: a same-pitch note right after another ends {ENGINE_RESTRIKE_T} T early, so it strikes again")
        dr = by[3]
        check(all(a_["end_t"] + DRUM_GAP_T <= b_["start_t"] and b_["start_t"] - a_["start_t"] >= score.tstate(DRUM_SPACING_S) - 1
                  for a_, b_ in zip(dr, dr[1:])) and all(x["end_t"] - x["start_t"] <= score.tstate(DRUM_HIT_S) for x in dr),
              "engine-1: the drum hits within the drum rules")
        beat = 875000
        check([(x["start_t"], x["level"]) for x in dr[:3]] == [(0, ENGINE_DRUM_LEVEL["kick"]), (beat // 2, ENGINE_DRUM_LEVEL["hat"]),
                                                               (beat, ENGINE_DRUM_LEVEL["kick"])],
              "engine-1: a drum's strength by its kind; a noise 10 ms after a kick merged into it, the stronger kept")
        check(all(0 <= x["start_t"] < x["end_t"] <= score.total_t for x in notes), "engine-1: notes inside the score's timeline")
        w1 = read_toml(de / "arrange" / "wide-game" / ek / "engine-1" / "arranged.toml")
        pad = sorted((x for x in w1.get("note", []) if x["voice"] == 2), key=lambda x: x["start_t"])
        check(w1.get("channel_roles") == ["bass", "lead", "pad", "pad"] and pad and all(a_["end_t"] <= b_["start_t"] for a_, b_ in zip(pad, pad[1:]))
              and len(pad) > len([x for x in load_score(de / "arrange" / "wide-game" / ek / "score.toml").notes if x.voice == 1]),
              "engine: more than 3 channels: the highest the lead, the lowest the bass, the others share the pad (a newer note cuts the one sounding)")
        jd = read_toml(sdir / JUDGE_FILE)
        row = next((t for t in jd.get("take", []) if t["name"] == "engine-1"), {})
        check(jd.get("pick") == "engine-1" and jd.get("confidence") == "high" and jd.get("exact") is True and jd.get("flags") == []
              and row.get("closeness") == 1.0 and row.get("provenance") == 1.0 and "z" not in row,
              f"engine: the judge picks the engine take, sure: the same tune by construction, provenance 1 ({jd.get('pick')}, {jd.get('confidence')})")
        calls = elog.read_text().splitlines()
        rc, sm, _ = summed("engine", str(de), "--fmzx-pack", str(conv))
        check(rc == 0 and sm.get("pending") == "0" and sm.get("takes") == "0" and elog.read_text().splitlines() == calls,
              f"engine again: the scores with their engine take, or whose reading needs none, for their score.toml as it is are left alone ({sm})")
        rc, sm, _ = summed("engine", str(de), "--fmzx-pack", str(conv), "--force", "--game", "test-game")
        check(rc == 0 and sm.get("pending") == "1" and sm.get("takes") == "1" and elog.read_text().splitlines() == calls
              and read_toml(sdir / "engine-1" / "arranged.toml") == e1,
              "engine --force: the take written again, the same, from the reader's cached notes")
        sp = sdir / "score.toml"
        sp.write_text(sp.read_text().replace("level = 116", "level = 120", 1))
        rc, sm, _ = summed("engine", str(de), "--fmzx-pack", str(conv))
        check(rc == 0 and sm.get("pending") == "1" and sm.get("takes") == "1" and elog.read_text().splitlines()[len(calls):] == [f"test-game/{ek}"],
              f"engine: a changed score.toml is read again ({sm})")
        rc, sm, _ = summed("judge", str(de), "--apply")
        ch, judged = read_choice_tables(de)
        check(ch.get(f"test-game/{ek}") == "engine-1" and judged.get(f"test-game/{ek}") == "engine-1", "engine: judge --apply chooses the engine take")
        apply_set(de, [f"wide-game/{ek}=0"])
        rc, sm, _ = summed("judge", str(de), "--apply")
        ch, judged = read_choice_tables(de)
        check(ch.get(f"wide-game/{ek}") == 0 and f"wide-game/{ek}" not in judged, "engine: the owner's choice of the original is kept")
        (mp.parent / "refuse.txt").write_text(f"test-game/{ek} engine-1\n")
        (sdir / JUDGE_FILE).unlink()
        rc, sm, _ = summed("judge", str(de), "--game", "test-game", "--apply")
        jd = read_toml(sdir / JUDGE_FILE)
        check(jd.get("pick") == "0" and not jd.get("exact") and any("refused" in f for t in jd["take"] if t["name"] == "engine-1" for f in t["faults"]),
              "engine: a faulty engine take (the renderer refuses it) is not picked for being exact")
        (mp.parent / "refuse.txt").unlink()
        apply_set(de, [f"test-game/{ek}=engine-1"])
        check(read_choices(de).get(f"test-game/{ek}") == "engine-1", "pick --set GAME/KEY=engine-1")
        buf = io.StringIO()
        with contextlib.redirect_stdout(buf):
            print_list(de)
        check("engine-1: ntropic, read exactly: its rows at 9C9Ch" in buf.getvalue(), "pick --list: the engine take and its source")

        # the summary when no file names the game
        d2 = d / "nomatch"
        selftest_score(d2 / "arrange" / "nothing-alike" / keys[0] / "score.toml", "nothing-alike", keys[0], name="Nothing Alike")
        rc, sm, _ = summed("chip", str(d2), "--sid-dir", str(coll), "--game", "nothing-alike", "--fmzx-pack", str(conv))
        rc2, sm2, _ = summed("ay", str(d2), "--ay-dir", str(acoll), "--game", "nothing-alike", "--fmzx-pack", str(conv))
        check(rc == 0 and rc2 == 0 and sm.get("game") == "nothing-alike" and sm.get("pending") == "1" and sm.get("candidates") == "0"
              and sm.get("takes") == "0" and sm.get("best") == "-" and sm2.get("kind") == "ay" and sm2.get("candidates") == "0",
              f"chip and ay: the summary when no file names the game ({sm}; {sm2})")
        rc, sm, _ = summed("generate", str(d2), "--model", "rules", "--game", "nobody")
        check(rc == 0 and sm.get("scores") == "0" and sm.get("game") == "nobody", f"generate: the summary with no scores ({sm})")
    print(f"selftest: {'FAILED, ' + str(len(fails)) + ' checks' if fails else 'all checks passed'}")
    return 1 if fails else 0


# ---------------------------------------------------------------------------------------------


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(prog=PROG, description="Arranged takes for a personal pack's scores.",
                                 epilog="Details: the docstring at the top of tools/arrange-music.")
    sub = ap.add_subparsers(dest="cmd", required=True)
    g = sub.add_parser("generate", help="generate takes for the scores without them")
    g.add_argument("dir", help="the learning's folder (tools/pack-studio's W/all)")
    g.add_argument("--takes", type=int, default=4, help="takes per score (default 4)")
    g.add_argument("--game", action="append", help="only this game's scores (repeatable)")
    g.add_argument("--force", action="store_true", help="regenerate scores that have takes")
    g.add_argument("--jobs", type=int, default=1, help="scores at once, in separate processes (default 1)")
    g.add_argument("--model", default="amt", help=f"the generator: {', '.join(sorted(GENERATORS))} (default amt)")
    g.add_argument("--soundfont", help="the .sf2 for renders (default: Homebrew fluid-synth's)")
    g.add_argument("--seed", type=int, default=1, help="the seed the takes derive from (default 1)")
    g.add_argument("--offline", action="store_true", help="fetch nothing: only the cached model")
    c = sub.add_parser("chip", help="takes from the games' C64 tunes, in a SID collection you have")
    c.add_argument("dir")
    c.add_argument("--sid-dir", required=True, help="the SID collection's folder (such as HVSC's C64Music); nothing is downloaded")
    c.add_argument("--game", action="append", help="only this game's scores (repeatable)")
    c.add_argument("--max", type=int, default=3, help="chip takes per score (default 3)")
    c.add_argument("--force", action="store_true", help="search again for scores that have chip takes (and index the collection again)")
    c.add_argument("--fmzx-pack", help="the fmzx-pack with chip-notes (default $FMZX_PACK, else host/target/release/fmzx-pack)")
    c.add_argument("--soundfont", help="the .sf2 for renders (default: Homebrew fluid-synth's)")
    y = sub.add_parser("ay", help="takes from the games' Spectrum 128 tunes, in a collection of .ay files you have")
    y.add_argument("dir")
    y.add_argument("--ay-dir", required=True, help="the .ay collection's folder (such as Project AY's); nothing is downloaded")
    y.add_argument("--game", action="append", help="only this game's scores (repeatable)")
    y.add_argument("--max", type=int, default=3, help="ay takes per score (default 3)")
    y.add_argument("--force", action="store_true", help="search again for scores that have ay takes (and index the collection again)")
    y.add_argument("--fmzx-pack", help="the fmzx-pack with chip-notes (default $FMZX_PACK, else host/target/release/fmzx-pack)")
    y.add_argument("--soundfont", help="the .sf2 for renders (default: Homebrew fluid-synth's)")
    p = sub.add_parser("pick", help="listen and choose a take per score")
    p.add_argument("dir")
    p.add_argument("--port", type=int, default=8765, help="the page's port on 127.0.0.1 (default 8765, else a free one)")
    p.add_argument("--set", action="extend", nargs="+", metavar="GAME/KEY=N", help="choose take N (0: the original; engine-N, chip-N, ay-N: an engine, chip or ay take) without the page; several at once, or --set again")
    p.add_argument("--list", action="store_true", help="print the scores, their takes and choices")
    e = sub.add_parser("engine", help="takes of the games' own music, read exactly from their music engines")
    e.add_argument("dir")
    e.add_argument("--game", action="append", help="only this game's scores (repeatable)")
    e.add_argument("--force", action="store_true", help="read again the scores that have their engine take")
    e.add_argument("--fmzx-pack", help="the fmzx-pack with engine-notes (default $FMZX_PACK, else host/target/release/fmzx-pack)")
    e.add_argument("--soundfont", help="the .sf2 for renders (default: Homebrew fluid-synth's)")
    j = sub.add_parser("judge", help="weigh each score's takes from their notes; with --apply, choose where sure")
    j.add_argument("dir")
    j.add_argument("--game", action="append", help="only this game's scores (repeatable)")
    j.add_argument("--apply", action="store_true", help="write the judge's pick to choices.toml where it is sure and you have not chosen")
    j.add_argument("--provisional", action="store_true",
                   help="mark the nulls this run makes provisional: a later judge without it makes them again")
    sub.add_parser("selftest", help="check generate, engine, chip, ay, judge and pick in a temporary folder")
    a = ap.parse_args(argv)
    return {"generate": cmd_generate, "engine": cmd_engine, "chip": cmd_chip, "ay": cmd_ay, "pick": cmd_pick, "judge": cmd_judge,
            "selftest": cmd_selftest}[a.cmd](a)


if __name__ == "__main__":
    sys.exit(main())
