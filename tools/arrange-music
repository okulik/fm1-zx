# ---------------------------------------------------------------------------------------------
# Scores


@dataclass
class Note:
    voice: int
    start_t: int
    end_t: int
    period_t: int
    level: int


@dataclass
class Score:
    path: Path
    header: dict
    notes: list[Note]

    @property
    def game(self) -> str:
        return str(self.header["game"])

    @property
    def key(self) -> str:
        return str(self.header["key"])

    @property
    def id(self) -> str:
        return f"{self.game}/{self.key}"

    @property
    def name(self) -> str:
        return str(self.header.get("name", self.game))

    @property
    def clock_hz(self) -> int:
        return int(self.header.get("clock_hz", 3500000))

    @property
    def roles(self) -> list[str]:
        return list(self.header.get("roles", []))

    @property
    def shadow(self) -> bool:
        """A shadow score: music a learned or built-in routine plays live, packed only with a take
        chosen for it."""
        return self.header.get("shadow", False) is True

    @property
    def total_t(self) -> int:
        t = int(self.header.get("intro_t", 0)) + int(self.header.get("loop_t", 0))
        return t if t > 0 else max((n.end_t for n in self.notes), default=0)

    @property
    def seconds(self) -> float:
        return self.total_t / self.clock_hz

    @property
    def dir(self) -> Path:
        return self.path.parent

    def sec(self, t: int) -> float:
        return t / self.clock_hz

    def tstate(self, s: float) -> int:
        return int(round(s * self.clock_hz))

    def tonal(self) -> list[Note]:
        return [n for n in self.notes if n.period_t > 0 and n.voice < 3]

    def midi(self, n: Note) -> float:
        return midi_of_period(self.clock_hz, n.period_t)

    def melody_voice(self) -> int | None:
        """The score's voice with role "lead" (the longest-sounding one if several), else its
        highest voice on average (duration-weighted MIDI pitch)."""
        dur: dict[int, float] = {}
        pitch: dict[int, float] = {}
        for n in self.tonal():
            d = max(n.end_t - n.start_t, 1)
            dur[n.voice] = dur.get(n.voice, 0) + d
            pitch[n.voice] = pitch.get(n.voice, 0) + d * self.midi(n)
        if not dur:
            return None
        roles = self.roles
        leads = [v for v in dur if v < len(roles) and roles[v] == "lead"]
        if leads:
            return max(leads, key=lambda v: dur[v])
        return max(dur, key=lambda v: pitch[v] / dur[v])

    def digest(self) -> str:
        return hashlib.sha256(self.path.read_bytes()).hexdigest()[:16]


def load_score(path: Path) -> Score:
    with path.open("rb") as f:
        doc = tomllib.load(f)
    for k in ("game", "key"):
        if k not in doc:
            raise ValueError(f"{path}: no {k}")
    notes = [
        Note(int(n["voice"]), int(n["start_t"]), int(n["end_t"]), int(n.get("period_t", 0)), int(n.get("level", 128)))
        for n in doc.get("note", [])
    ]
    header = {k: v for k, v in doc.items() if k != "note"}
    return Score(path, header, notes)


def midi_of_period(clock_hz: int, period_t: int) -> float:
    return 69 + 12 * math.log2(clock_hz / period_t / 440.0)


def period_of_midi(clock_hz: int, pitch: int) -> int:
    return max(1, int(round(clock_hz / (440.0 * 2 ** ((pitch - 69) / 12)))))


def vel_of_level(level: int) -> int:
    return max(1, min(127, int(round(30 + level * 97 / 255))))


def find_scores(d: Path, games: list[str] | None = None) -> list[Score]:
    out = []
    for p in sorted((d / "arrange").glob("*/*/score.toml")):
        if games and p.parent.parent.name not in games:
            continue
        try:
            out.append(load_score(p))
        except (ValueError, KeyError, tomllib.TOMLDecodeError) as e:
            print(f"{PROG}: skipping {p}: {e}", file=sys.stderr)
    return out


def take_dirs(score_dir: Path) -> list[tuple[int, Path]]:
    out = []
    for p in score_dir.glob("take-*"):
        n = p.name[5:]
        if n.isdigit() and (p / "arranged.toml").is_file():
            out.append((int(n), p))
    return sorted(out)


