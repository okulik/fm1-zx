def toml_value(v) -> str:
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, (int, float)):
        return repr(v)
    if isinstance(v, str):
        return json.dumps(v, ensure_ascii=False)
    if isinstance(v, list):
        return "[" + ", ".join(toml_value(x) for x in v) + "]"
    raise TypeError(f"no TOML for {type(v).__name__}")


def toml_dumps(doc: dict) -> str:
    """TOML for the files this tool writes: keys and values first, then tables ([name]), then
    arrays of tables ([[name]]), one level deep."""
    key = lambda k: k if k.replace("_", "").replace("-", "").isalnum() and k.isascii() else json.dumps(k)  # noqa: E731
    out = [f"{key(k)} = {toml_value(v)}" for k, v in doc.items() if not isinstance(v, dict)
           and not (isinstance(v, list) and v and all(isinstance(x, dict) for x in v))]
    for k, v in doc.items():
        if isinstance(v, dict):
            out += ["", f"[{key(k)}]"]
            for k2, v2 in v.items():
                if isinstance(v2, dict):
                    out += ["", f"[{key(k)}.{key(k2)}]"] + [f"{key(k3)} = {toml_value(v3)}" for k3, v3 in v2.items()]
                else:
                    out.append(f"{key(k2)} = {toml_value(v2)}")
    for k, v in doc.items():
        if isinstance(v, list) and v and all(isinstance(x, dict) for x in v):
            for x in v:
                out += ["", f"[[{key(k)}]]"] + [f"{key(k2)} = {toml_value(v2)}" for k2, v2 in x.items()]
    return "\n".join(out) + "\n"


def dump_toml(path: Path, doc: dict) -> None:
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(toml_dumps(doc))
    tmp.replace(path)


def read_toml(path: Path) -> dict:
    try:
        with path.open("rb") as f:
            return tomllib.load(f)
    except (OSError, tomllib.TOMLDecodeError):
        return {}


def arranged_doc(score: Score, n: int, take: Take, voices: dict[int, list[Note]], m: dict) -> dict:
    doc = dict(score.header)
    doc["voices"] = 3
    doc["roles"] = list(TAKE_ROLES)
    doc["take"] = n
    doc["generator"] = take.generator
    doc["metrics"] = m
    notes = sorted((x for v in voices.values() for x in v), key=lambda x: (x.start_t, x.voice))
    doc["note"] = [asdict(x) for x in notes]
    return doc


def write_take(score: Score, n: int, take: Take, renderer: Renderer) -> dict:
    voices = arrange(score, take)
    m = metrics(score, voices, len(take.notes))
    final = score.dir / f"take-{n}"
    tmp = score.dir / f".take-{n}.tmp"
    shutil.rmtree(tmp, ignore_errors=True)
    tmp.mkdir()
    dump_toml(tmp / "arranged.toml", arranged_doc(score, n, take, voices, m))
    full_midi(score, take, tmp / "full.mid")
    fm1_midi(score, voices, tmp / "fm1.mid")
    renderer.render(tmp / "full.mid", tmp / "full.wav", score.seconds)
    renderer.render(tmp / "fm1.mid", tmp / "fm1.wav", score.seconds)
    shutil.rmtree(final, ignore_errors=True)
    tmp.replace(final)
    return m


def takes_state(score: Score, settings: Settings, digest: str) -> tuple[bool, set[int]]:
    """From takes.toml: whether the score has its takes (all of 1..N, for this score.toml, by
    any generator), and the takes done by this generator and seed (to resume)."""
    st = read_toml(score.dir / "takes.toml")
    if st.get("score") != digest and st.get("score") not in score.file_digests():
        return False, set()
    done = {int(t) for t in st.get("done", {}) if (score.dir / f"take-{t}" / "arranged.toml").is_file()}
    complete = all(n in done for n in range(1, settings.takes + 1))
    same = st.get("model") == settings.model and st.get("seed") == settings.seed
    return complete, done if same else set()


def generate_score(path: str, settings: Settings, force: bool) -> dict:
    score = load_score(Path(path))
    settings.prefix = f"[{score.id}] "
    renderer = Renderer(settings.soundfont)
    digest = score.digest()
    complete, done = takes_state(score, settings, digest)
    if complete and not force:
        return {"id": score.id, "skipped": True, "takes": 0}
    if force:
        done = set()
    todo = [n for n in range(1, settings.takes + 1) if n not in done]
    if force or not done:
        for _, p in take_dirs(score.dir):
            shutil.rmtree(p)
        (score.dir / "takes.toml").unlink(missing_ok=True)
    if not score.tonal():
        settings.log("no notes: skipped")
        return {"id": score.id, "skipped": True, "takes": 0}
    est = estimate_seconds(score, settings)
    settings.log(f"{score.name}: {score.seconds:.1f} s of music, {len(score.notes)} notes; {len(todo)} takes with {settings.model}"
                 + (f", roughly {fmt_dur(est)} a take" if est else ""))
    orig_mid = score.dir / "original.mid"
    write_midi(orig_mid, original_tracks(score, all_lead=False))
    if renderer.ok:
        renderer.render(orig_mid, score.dir / "original.wav", score.seconds)
    state = read_toml(score.dir / "takes.toml") if done else {}
    state.update({"score": digest, "model": settings.model, "seed": settings.seed})
    state.setdefault("done", {})
    fn = GENERATORS[settings.model]
    for n in todo:
        t0 = time.time()
        take = fn(score, n, take_rng(settings, score, n), settings)
        m = write_take(score, n, take, renderer)
        secs = time.time() - t0
        settings.log(f"take {n}/{settings.takes} in {fmt_dur(secs)}: {metrics_line(m)}")
        state["done"][str(n)] = {"generator": take.generator, "seconds": round(secs, 1), **({"info": json.dumps(take.info)} if take.info else {})}
        dump_toml(score.dir / "takes.toml", state)
    return {"id": score.id, "skipped": False, "takes": len(todo)}


def _worker(path: str, settings: dict, force: bool) -> dict:
    return generate_score(path, Settings(**settings), force)


def summary_line(kind: str, games: list[str] | None, t0: float, **fields) -> str:
    """A command's last line, for tools/pack-studio's jobs view (the docstring, "The summary
    line"): `summary: kind=K game=G k=v ... seconds=S [source=...]`, source last, to the line's
    end; the other values hold no spaces."""
    source = fields.pop("source", None)
    parts = [f"kind={kind}", f"game={','.join(games) if games else 'all'}"]
    parts += [f"{k}={v}" for k, v in fields.items()]
    parts.append(f"seconds={time.time() - t0:.0f}")
    return "summary: " + " ".join(parts) + (f" source={source}" if source else "")


def cmd_generate(a: argparse.Namespace) -> int:
    t0 = time.time()
    d = Path(a.dir)
    if a.model not in GENERATORS:
        die(f"unknown model {a.model} (have: {', '.join(sorted(GENERATORS))})")
    if a.takes < 1:
        die("--takes must be at least 1")
    if a.offline:
        os.environ["HF_HUB_OFFLINE"] = "1"
        os.environ["TRANSFORMERS_OFFLINE"] = "1"
    scores = find_scores(d, a.game)
    if not scores:
        print(f"{PROG}: no scores under {d / 'arrange'}")
        print(summary_line("ai", a.game, t0, scores=0, pending=0, takes=0, model=a.model), flush=True)
        return 0
    settings = Settings(model=a.model, takes=a.takes, seed=a.seed, offline=a.offline, soundfont=a.soundfont)
    renderer = Renderer(a.soundfont)
    if not renderer.ok:
        print(f"{PROG}: {renderer.why_not()}")
    pending = [s for s in scores if a.force or not takes_state(s, settings, s.digest())[0]]
    if pending and a.model == "amt":
        amt_ensure_model(settings)
    print(f"{PROG}: {len(scores)} scores, {len(pending)} to arrange ({a.takes} takes each, {a.model}, seed {a.seed})", flush=True)
    est = [estimate_seconds(s, settings) for s in pending]
    if pending and est[0] is not None:
        total = sum(e or 0 for e in est) * a.takes / max(a.jobs, 1)
        print(f"{PROG}: {sum(s.seconds for s in pending):.0f} s of music; roughly {fmt_dur(total)} in all", flush=True)
    made = 0
    if a.jobs <= 1 or len(pending) <= 1:
        for s in pending:
            made += generate_score(str(s.path), Settings(**asdict(settings)), a.force)["takes"]
    else:
        ctx = mp.get_context("spawn")
        with ProcessPoolExecutor(max_workers=a.jobs, mp_context=ctx) as ex:
            futs = [ex.submit(_worker, str(s.path), asdict(settings), a.force) for s in pending]
            for f in as_completed(futs):
                made += f.result()["takes"]
    if pending:
        judge_scores(d, pending)
        print(f"{PROG}: done; listen and choose with: {PROG} pick {d}")
    print(summary_line("ai", a.game, t0, scores=len(scores), pending=len(pending), takes=made, model=a.model), flush=True)
    return 0


# ---------------------------------------------------------------------------------------------
# chip: a game's tune from its C64 version, as a take
#
# The collection (HVSC or any folder of .sid files; nothing is fetched) is indexed once into
# DIR/arrange/.chip-index.json: every .sid's path, its PSID/RSID header (title, author, released,
# songs, start song) and its STIL entries (DOCUMENTS/STIL.txt: the file's and each subtune's TITLE,
# NAME, ARTIST, AUTHOR and COMMENT). A score's candidates are the files whose name, header title
# or STIL text names the game; their subtunes are checked for closeness to the score's tune with the
# converter's notes (fmzx-pack chip-notes), ranked, and the best become chip-<n>/ takes.

CHIP_T_HZ = 3_500_000  # the converter's times and periods: Spectrum T-states
CHIP_FULL_S = 180  # seconds converted for the closeness check and for a take
CHIP_CANDIDATES = 12  # (file, subtune) pairs checked per score
CHIP_INDEX_VERSION = 1
STIL_FIELDS = ("TITLE", "NAME", "ARTIST", "AUTHOR", "COMMENT")
ROMAN = {"ii": "2", "iii": "3", "iv": "4", "vi": "6", "vii": "7", "viii": "8", "ix": "9"}


def name_tokens(s: str) -> list[str]:
    """Lowercase ASCII words of s, & as "and", roman numerals ii-ix as digits, "the" dropped."""
    import re
    import unicodedata

    s = unicodedata.normalize("NFKD", s).encode("ascii", "ignore").decode().lower().replace("&", " and ")
    return [ROMAN.get(w, w) for w in re.split(r"[^a-z0-9]+", s) if w and w != "the"]


def contains_seq(hay: list[str], needle: list[str]) -> bool:
    k = len(needle)
    return k > 0 and any(hay[i:i + k] == needle for i in range(len(hay) - k + 1))


def psid_header(data: bytes) -> dict | None:
    """The PSID/RSID header's fields (big-endian; strings Latin-1, zero-padded), or None."""
    if len(data) < 0x76 or data[:4] not in (b"PSID", b"RSID"):
        return None
    u16 = lambda o: int.from_bytes(data[o:o + 2], "big")  # noqa: E731
    text = lambda o: data[o:o + 32].split(b"\0", 1)[0].decode("latin-1").strip()  # noqa: E731
    return {"rsid": data[:4] == b"RSID", "version": u16(4), "songs": max(1, u16(0x0E)), "start": max(1, u16(0x10)),
            "title": text(0x16), "author": text(0x36), "released": text(0x56)}


def find_stil(sid_dir: Path) -> Path | None:
    """The collection's DOCUMENTS/STIL.txt: in the folder given or up to three folders below it
    (a collection unpacked into a folder of its own, e.g. <dir>/<name>/C64Music), the shallowest."""
    for depth in range(4):
        found = sorted(sid_dir.glob("/".join(["*"] * depth + ["DOCUMENTS", "STIL.txt"])))
        if found:
            return found[0]
    return None


def parse_stil(text: str) -> dict[str, dict[str, list[list[str]]]]:
    """STIL.txt as {"/path/file.sid": {"0" (the whole file) or "<subtune>": [[field, text], ...]}}.
    Entries start with a line "/path"; "(#n)" starts subtune n; "FIELD: text" lines, continued
    by indented lines; "#" lines are comments; directory entries (paths ending "/") are skipped."""
    import re

    out: dict[str, dict[str, list[list[str]]]] = {}
    cur: dict[str, list[list[str]]] | None = None
    sub = "0"
    field_re = re.compile(r"^\s*([A-Z]+):\s?(.*)$")
    for line in text.splitlines():
        if line.startswith("#"):
            continue
        if line.startswith("/"):
            path = line.strip()
            cur = None if path.endswith("/") else out.setdefault(path, {})
            sub = "0"
            continue
        if cur is None:
            continue
        s = line.strip()
        if not s:
            continue
        m = re.fullmatch(r"\(#(\d+)\)", s)
        if m:
            sub = m.group(1)
            continue
        m = field_re.match(line)
        if m and m.group(1) in STIL_FIELDS:
            cur.setdefault(sub, []).append([m.group(1), m.group(2).strip()])
        elif line[:1].isspace() and cur.get(sub):
            cur[sub][-1][1] += " " + s
    return out


def chip_index(d: Path, sid_dir: Path, rebuild: bool = False) -> dict:
    """The collection's index, from DIR/arrange/.chip-index.json while its key (the collection's
    path and modification times) holds, else built and saved."""
    sid_dir = sid_dir.resolve()
    stil = find_stil(sid_dir)
    key = {"version": CHIP_INDEX_VERSION, "path": str(sid_dir), "mtime": sid_dir.stat().st_mtime_ns,
           "stil": str(stil) if stil else "", "stil_mtime": stil.stat().st_mtime_ns if stil else 0}
    cache = d / "arrange" / ".chip-index.json"
    if not rebuild and cache.is_file():
        try:
            idx = json.loads(cache.read_text())
            if idx.get("key") == key:
                return idx
        except (OSError, ValueError):
            pass
    print(f"{PROG}: indexing {sid_dir}", flush=True)
    files = []
    for root, dirs, names in os.walk(sid_dir):
        dirs.sort()
        for nm in sorted(names):
            if not nm.lower().endswith(".sid"):
                continue
            p = Path(root) / nm
            try:
                with p.open("rb") as f:
                    h = psid_header(f.read(0x76))
            except OSError:
                continue
            if h:
                files.append({"path": p.relative_to(sid_dir).as_posix(), **{k: h[k] for k in ("title", "author", "released", "songs", "start", "rsid")}})
    stil_by: dict[str, dict] = {}
    if stil:
        base = stil.parent.parent  # STIL's paths start at the collection's C64Music folder
        for path, entry in parse_stil(stil.read_text(encoding="latin-1")).items():
            try:
                rel = (base / path.lstrip("/")).relative_to(sid_dir).as_posix()
            except ValueError:
                continue
            stil_by[rel] = entry
    for f in files:
        if f["path"] in stil_by:
            f["stil"] = stil_by[f["path"]]
    idx = {"key": key, "files": files}
    cache.parent.mkdir(parents=True, exist_ok=True)
    tmp = cache.with_suffix(".tmp")
    tmp.write_text(json.dumps(idx))
    tmp.replace(cache)
    print(f"{PROG}: {len(files)} SID files, {len(stil_by)} STIL entries", flush=True)
    return idx


def name_match(names: list[list[str]], t: str, exact: float, prefix: float) -> float:
    """How well t (a file name's or title's words, joined) names the game: exact when it is one
    of the names', prefix when one runs on from the other (at least 5 letters in common)."""
    best = 0.0
    for n in names:
        c = "".join(n)
        if not c or not t:
            continue
        if t == c:
            best = max(best, exact)
        elif min(len(t), len(c)) >= 5 and (t.startswith(c) or c.startswith(t)):
            best = max(best, prefix)
    return best


def stil_match(names: list[list[str]], block: tuple[list[str], str]) -> tuple[float, bool, str]:
    """(match, spectrum, text) for one STIL block (its words, its text): 0.8 when a TITLE, NAME or
    COMMENT names the game (its words in a row), 1.0 when that block also mentions the Spectrum."""
    toks, text = block
    if not any(len("".join(n)) >= 3 and contains_seq(toks, n) for n in names):
        return 0.0, False, ""
    spectrum = "spectrum" in toks
    return (1.0 if spectrum else 0.8), spectrum, text


def index_words(idx: dict) -> list[tuple[dict, str, str, dict[str, tuple[list[str], str]]]]:
    """Per indexed file, once a run: (the entry, its file name's words joined, its title's, and
    per STIL block its TITLE, NAME and COMMENT words and text)."""
    if "_words" not in idx:
        out = []
        for f in idx.get("files", []):
            blocks = {}
            for s, lines in f.get("stil", {}).items():
                text = " ".join(t for k, t in lines if k in ("TITLE", "NAME", "COMMENT"))
                if text:
                    blocks[s] = (name_tokens(text), text)
            out.append((f, "".join(name_tokens(Path(f["path"]).stem)), "".join(name_tokens(f.get("title", ""))), blocks))
        idx["_words"] = out
    return idx["_words"]


@dataclass
class ChipCandidate:
    file: dict  # the index's entry
    subtune: int
    title_match: float
    spectrum: bool = False
    stil: str = ""
    prior: float = 0.0
    closeness: float = 0.0  # to the score's tune (the judge's closeness)
    rank: float = 0.0
    error: str = ""


def chip_candidates(score: Score, idx: dict, limit: int = CHIP_CANDIDATES) -> list[ChipCandidate]:
    """The (file, subtune) pairs to check for the score, at most limit: files whose file name or
    header title names the game (the score's name or its id), or whose STIL entry does; files in
    order of how well, a subtune of each file in turn (a subtune STIL names first, then the start
    song, then the rest in order)."""
    names = [n for n in (name_tokens(score.name), name_tokens(score.game.replace("-", " "))) if n]
    names = [n for i, n in enumerate(names) if n not in names[:i]]
    per_file: list[tuple[float, list[ChipCandidate]]] = []
    for f, stem, title, stil in index_words(idx):
        base = max(name_match(names, stem, 1.0, 0.6), name_match(names, title, 1.0, 0.6))
        fm, fsp, ftext = stil_match(names, stil["0"]) if "0" in stil else (0.0, False, "")
        subs = {}
        for s, block in stil.items():
            if s != "0" and s.isdigit() and 1 <= int(s) <= f["songs"]:
                m, sp, text = stil_match(names, block)
                if m:
                    subs[int(s)] = (m, sp, text)
        file_match = max(base, fm)
        if file_match < 0.5 and not subs:
            continue
        cands = []
        for s in range(1, f["songs"] + 1):
            m, sp, text = subs.get(s, (0.0, False, ""))
            tm = max(file_match, m)
            if tm < 0.5:
                continue
            c = ChipCandidate(f, s, round(tm, 3), sp or fsp, text or ftext)
            c.prior = tm + (1.0 if s in subs else 0.0) + (0.3 if c.spectrum else 0.0) + (0.2 if s == f["start"] else 0.0) - s * 1e-3
            cands.append(c)
        if cands:
            cands.sort(key=lambda c: -c.prior)
            per_file.append((cands[0].prior, cands))
    per_file.sort(key=lambda x: (-x[0], x[1][0].file["path"]))
    out: list[ChipCandidate] = []
    rnd = 0
    while len(out) < limit and any(rnd < len(cs) for _, cs in per_file):
        for _, cs in per_file:
            if rnd < len(cs) and len(out) < limit:
                out.append(cs[rnd])
        rnd += 1
    return out


def chip_rank(c: ChipCandidate) -> float:
    """Closeness decides; a title match and a STIL entry naming the Spectrum break ties."""
    return round(c.closeness + 0.1 * c.title_match + (0.1 if c.spectrum else 0.0), 4)


def repo_root() -> Path:
    return Path(__file__).resolve().parent.parent


def find_converter(given: str | None) -> str:
    """fmzx-pack with chip-notes: --fmzx-pack, $FMZX_PACK, else host/target/release/fmzx-pack."""
    fp = given or os.environ.get("FMZX_PACK") or str(repo_root() / "host" / "target" / "release" / "fmzx-pack")
    hint = "build it with: cd host && cargo build --release -p fmzx-pack"
    if not Path(fp).is_file():
        die(f"no {fp}: {hint} (or --fmzx-pack PATH)")
    r = subprocess.run([fp, "chip-notes", "--help"], capture_output=True, text=True)
    if "chip-notes" not in r.stdout + r.stderr:
        die(f"{fp} has no chip-notes command: {hint}")
    return fp


def run_converter(fp: str, sid: Path, subtune: int, seconds: int, out: Path) -> tuple[dict | None, str]:
    """The converter's notes for (sid, subtune) over `seconds`, cached at out (the result, or the
    converter's refusal, kept while the SID file and the converter are unchanged): (the notes
    TOML, "") or (None, why not)."""
    stamp = out.with_suffix(".src")
    src = f"{sid} {sid.stat().st_mtime_ns} {subtune} {seconds} {fp} {Path(fp).stat().st_mtime_ns}\n"
    old = stamp.read_text() if stamp.is_file() else ""
    if old.startswith(src):
        if old[len(src):].startswith("refused: "):
            return None, old[len(src) + 9:].strip()
        doc = read_toml(out) if out.is_file() else {}
        if doc:
            return doc, ""
    out.parent.mkdir(parents=True, exist_ok=True)
    out.unlink(missing_ok=True)
    r = subprocess.run([fp, "chip-notes", str(sid), "--subtune", str(subtune), "--seconds", str(seconds), "-o", str(out)],
                       capture_output=True, text=True)
    if r.returncode != 0 or not out.is_file():
        lines = (r.stderr or r.stdout).strip().splitlines()
        why = lines[-1] if lines else f"exit {r.returncode}"
        stamp.write_text(f"{src}refused: {why}\n")
        return None, why
    stamp.write_text(src)
    doc = read_toml(out)
    return (doc, "") if doc else (None, "unreadable notes")


def own_notes_cache(d: Path, kind: OwnKind, c: ChipCandidate, seconds: int) -> Path:
    h = hashlib.sha256(f"{c.file['path']}#{c.subtune}#{seconds}".encode()).hexdigest()[:16]
    return d / "arrange" / f".{kind.prefix}-notes" / f"{h}.toml"


def chip_voices(score: Score, notes_doc: dict) -> tuple[dict[int, list[Note]], int, int]:
    """The converter's notes on the take's voices, on the score's clock (its voices are already
    the take's: 0 the lead, the highest chip voice on average; 1 the bass, the lowest; 2 the pad;
    3 the drum). Returns (voices, own_intro_t, own_loop_t); notes past one pass of the loop are
    dropped, notes on a voice trimmed not to overlap, drum hits to end DRUM_GAP_T before the next."""
    k = score.clock_hz / CHIP_T_HZ
    loop_t = int(round(int(notes_doc.get("loop_t", 0)) * k))
    intro_t = int(round(int(notes_doc.get("intro_t", 0)) * k))
    if loop_t <= 0:
        loop_t = 0
        if intro_t <= 0:
            intro_t = int(round(float(notes_doc.get("seconds", CHIP_FULL_S)) * score.clock_hz))
    total = intro_t + loop_t
    raw = []
    for n in notes_doc.get("note", []):
        v, s, e = int(n["voice"]), int(round(int(n["start_t"]) * k)), int(round(int(n["end_t"]) * k))
        per = int(round(int(n.get("period_t", 0)) * k))
        if 0 <= v <= 3 and 0 <= s < total:
            raw.append((v, s, min(e, total), per if v < 3 else 0, max(1, min(255, int(n.get("level", 128))))))
    voices: dict[int, list[Note]] = {0: [], 1: [], 2: [], 3: []}
    for v, s, e, p, lv in raw:
        if v == 3 or p > 0:
            voices[v].append(Note(v, s, e, p, lv))
    for v, ns in voices.items():
        ns.sort(key=lambda n: (n.start_t, n.end_t))
        kept = []
        for i, n in enumerate(ns):
            if i + 1 < len(ns):
                n.end_t = min(n.end_t, ns[i + 1].start_t - (DRUM_GAP_T if v == 3 else 0))
            if n.end_t > n.start_t:
                kept.append(n)
        voices[v] = kept
    return voices, intro_t, loop_t


def clean_field(f: dict, k: str) -> str:
    """An index entry's text field on one line; HVSC's "<?>" (unknown) as "?"."""
    return " ".join((f.get(k) or "").replace("<?>", "?").split()).strip()


def chip_source(c: ChipCandidate) -> str:
    """"C64: <title> by <author> (<released>), subtune N, <file>"."""
    f = c.file
    author = clean_field(f, "author")
    return (f"C64: {clean_field(f, 'title') or Path(f['path']).stem} by {'unknown' if author in ('', '?') else author} "
            f"({clean_field(f, 'released') or '?'}), subtune {c.subtune}, {f['path']}")


def ay_source(c: ChipCandidate) -> str:
    """"Spectrum 128: <title> by <author>, song N, <file>": the song's name, else the file's misc
    string, else its file name."""
    f = c.file
    titles = f.get("titles", [])
    title = " ".join((titles[c.subtune - 1] if c.subtune <= len(titles) else "").split()) or clean_field(f, "misc") or Path(f["path"]).stem
    author = clean_field(f, "author")
    return f"Spectrum 128: {title} by {'unknown' if author in ('', '?') else author}, song {c.subtune}, {f['path']}"


def sid_renderer() -> str | None:
    return shutil.which("sidplayfp")


def render_sid(sid: Path, subtune: int, seconds: int, out: Path) -> bool:
    sp = sid_renderer()
    return bool(sp) and subprocess.run([sp, f"-w{out}", f"-o{subtune}", f"-t{seconds}", str(sid)], capture_output=True, check=False).returncode == 0


_AY_RENDERER: list[str | None] = []


def ay_renderer() -> str | None:
    """ffmpeg, when it reads .ay files (its libgme demuxer); else None."""
    if not _AY_RENDERER:
        import re

        ff = shutil.which("ffmpeg")
        if ff:
            r = subprocess.run([ff, "-hide_banner", "-formats"], capture_output=True, text=True, check=False)
            ff = ff if re.search(r"^\s*D\S*\s+libgme\b", r.stdout, re.MULTILINE) else None
        _AY_RENDERER.append(ff)
    return _AY_RENDERER[0]


def render_ay(ay: Path, subtune: int, seconds: int, out: Path) -> bool:
    ff = ay_renderer()
    return bool(ff) and subprocess.run([ff, "-y", "-loglevel", "error", "-f", "libgme", "-track_index", str(subtune - 1), "-i", str(ay),
                                        "-t", str(seconds), str(out)], capture_output=True, check=False).returncode == 0


@dataclass(frozen=True)
class OwnKind:
    """A kind of take on its own timeline: a tune from another version of the game."""
    prefix: str  # the takes' folders, <prefix>-<n>/
    generator: str  # arranged.toml's generator
    label: str  # "C64 take"
    file_key: str  # arranged.toml's key naming the tune's file
    sound: str  # the other version's own sound, beside fm1.wav
    sound_label: str  # its label on the page
    collection: str  # what the collection holds, for messages
    source: Callable[[ChipCandidate], str]
    render: Callable[[Path, int, int, Path], bool]
    quiet_refusals: bool  # tunes the converter refuses are only counted, not each logged


CHIP = OwnKind("chip", "chip sid", "C64 take", "sid_file", "chip.wav", "C64", "SID", chip_source, render_sid, False)
AY = OwnKind("ay", "chip ay", "Spectrum 128 take", "ay_file", "ay.wav", "Spectrum 128", "AY", ay_source, render_ay, True)
OWN_KINDS = (CHIP, AY)


def own_dirs(score_dir: Path, kind: OwnKind) -> list[tuple[int, Path]]:
    out = []
    for p in score_dir.glob(f"{kind.prefix}-*"):
        n = p.name[len(kind.prefix) + 1:]
        if n.isdigit() and (p / "arranged.toml").is_file():
            out.append((int(n), p))
    return sorted(out)


def chip_dirs(score_dir: Path) -> list[tuple[int, Path]]:
    return own_dirs(score_dir, CHIP)


def write_own_take(kind: OwnKind, score: Score, n: int, c: ChipCandidate, notes_doc: dict, tune: Path, renderer: Renderer) -> dict:
    voices, own_intro, own_loop = chip_voices(score, notes_doc)
    secs = max(score.sec(own_intro + own_loop), 1e-6)
    m = {"closeness": c.closeness, "title_match": c.title_match, "rank": c.rank}
    if kind is CHIP:
        m["stil_spectrum"] = c.spectrum
    for v, nm in ((0, "lead"), (1, "bass"), (2, "pad"), (3, "drums")):
        m[f"{nm}_nps"] = round(len(voices[v]) / secs, 2)
    doc = dict(score.header)
    doc["voices"] = 3
    doc["roles"] = list(TAKE_ROLES)
    doc["take"] = f"{kind.prefix}-{n}"
    doc["generator"] = kind.generator
    doc["timeline"] = "own"
    doc["own_intro_t"] = own_intro
    doc["own_loop_t"] = own_loop
    doc["source"] = kind.source(c)
    doc[kind.file_key] = c.file["path"]
    doc["subtune"] = c.subtune
    if c.stil:
        doc["stil"] = c.stil[:300]
    doc["metrics"] = m
    doc["note"] = [asdict(x) for x in sorted((x for v in voices.values() for x in v), key=lambda x: (x.start_t, x.voice))]
    final = score.dir / f"{kind.prefix}-{n}"
    tmp = score.dir / f".{kind.prefix}-{n}.tmp"
    shutil.rmtree(tmp, ignore_errors=True)
    tmp.mkdir()
    dump_toml(tmp / "arranged.toml", doc)
    fm1_midi(score, voices, tmp / "fm1.mid")
    renderer.render(tmp / "fm1.mid", tmp / "fm1.wav", secs)
    if not kind.render(tune, c.subtune, min(int(math.ceil(secs)), CHIP_FULL_S), tmp / kind.sound):
        (tmp / kind.sound).unlink(missing_ok=True)
    shutil.rmtree(final, ignore_errors=True)
    tmp.replace(final)
    return m


@dataclass
class OwnResult:
    """What own_score did for a score."""
    takes: int = 0  # takes written
    refused: set = field(default_factory=set)  # the (file, subtune) pairs the converter refused
    candidates: int = 0
    checked: int = 0  # candidates converted and compared
    best: ChipCandidate | None = None  # the take written with the best closeness


def own_score(kind: OwnKind, d: Path, score: Score, cands: list[ChipCandidate], coll: Path, fp: str, keep: int, force: bool,
              renderer: Renderer, jg: Judge | None = None) -> OwnResult:
    """The score's takes of this kind from its candidates (jg: the run's judge, for the null)."""
    log = lambda msg: print(f"[{score.id}] {msg}", flush=True)  # noqa: E731
    res = OwnResult(candidates=len(cands))
    if own_dirs(score.dir, kind) and not force:
        return OwnResult()
    for _, p in own_dirs(score.dir, kind):
        shutil.rmtree(p)
    if jg is not None:
        jg.forget_takes()
    if score.melody_voice() is None:
        log("no notes: skipped")
        return res
    if not cands:
        log(f"{score.name}: no {kind.collection} file names the game")
        return res
    log(f"{score.name}: {len(cands)} candidates to check")
    orig = rendition(read_toml(score.path), "0")
    olines = {k: v[:J_ORIG_NOTES] for k, v in voice_lines(orig.notes, 6).items()}
    if not olines:
        log("  the original has no line long enough to compare with: closeness 0 for every candidate")
    own_files = {c.file["path"] for c in cands} | {str(toml_head(p / "arranged.toml").get(k.file_key, ""))
                                                   for k in OWN_KINDS for _, p in own_dirs(score.dir, k)}
    null, real = score_null(jg or Judge(d, render_check=False), score, orig, olines, own_files)
    srch = search_s(orig)
    checked = []
    refused = set()

    def convert(c: ChipCandidate, seconds: int) -> dict | None:
        doc, why = run_converter(fp, coll / c.file["path"], c.subtune, seconds, own_notes_cache(d, kind, c, seconds))
        if doc is None:
            refused.add((c.file["path"], c.subtune))
            if not kind.quiet_refusals:
                log(f"  {c.file['path']} #{c.subtune}: not converted ({why})")
        return doc

    docs = {}
    for c in cands:
        doc = convert(c, CHIP_FULL_S)
        if doc is None:
            continue
        r = own_rendition(score, doc, kind.prefix)
        if not (r.notes[:, 0] < 3).any():
            log(f"  {c.file['path']} #{c.subtune}: no notes in {CHIP_FULL_S} s")
            continue
        z = 0.0
        if olines:
            c.closeness, z = calibrated(best_align(olines, cut_lines(voice_lines(unrolled(r, J_CAND_S)), srch)), null, real)
            c.closeness = round(c.closeness, 3)
        c.rank = chip_rank(c)
        log(f"  {c.file['path']} #{c.subtune}: closeness {c.closeness * 100:.0f}% (z {z:.1f}), title match {c.title_match:.2f}"
            f"{', STIL: Spectrum' if c.spectrum else ''}")
        docs[id(c)] = doc
        checked.append(c)
    checked.sort(key=lambda c: (-c.rank, c.file["path"], c.subtune))
    n = 0
    for c in checked[:keep]:
        n += 1
        write_own_take(kind, score, n, c, docs[id(c)], coll / c.file["path"], renderer)
        log(f"{kind.prefix}-{n}: {kind.source(c)}; closeness {c.closeness * 100:.0f}%")
        if res.best is None or c.closeness > res.best.closeness:
            res.best = c
    if jg is not None:
        jg.forget_takes()
    said = f", {len(refused)} refused by the converter" if refused else ""
    log(f"{score.name}: {len(cands)} candidates, {len(checked)} checked{said}, {n} {kind.prefix} takes")
    res.takes, res.refused, res.checked = n, refused, len(checked)
    return res


def own_pending(a: argparse.Namespace, kind: OwnKind) -> tuple[Path, list[Score], list[Score]]:
    """The workspace, its scores (those of --game) and the scores to search for takes of this
    kind, after the common checks."""
    d = Path(a.dir)
    if a.max < 1:
        die("--max must be at least 1")
    scores = find_scores(d, a.game)
    if not scores:
        print(f"{PROG}: no scores under {d / 'arrange'}")
        return d, [], []
    pending = [s for s in scores if a.force or not own_dirs(s.dir, kind)]
    print(f"{PROG}: {len(scores)} scores, {len(pending)} to search for {kind.prefix} takes (up to {a.max} each)", flush=True)
    return d, scores, pending


def own_summary(kind: OwnKind, a: argparse.Namespace, t0: float, scores: list[Score], pending: list[Score],
                results: list[OwnResult]) -> str:
    """chip's or ay's summary line: the takes written, the candidates, those checked, the songs
    the converter refused, and the best take's closeness and source."""
    best = max((r.best for r in results if r.best), key=lambda c: c.closeness, default=None)
    refused = set().union(*(r.refused for r in results))
    return summary_line("sid" if kind is CHIP else "ay", a.game, t0, scores=len(scores), pending=len(pending),
                        takes=sum(r.takes for r in results), candidates=sum(r.candidates for r in results),
                        checked=sum(r.checked for r in results), refused=len(refused),
                        best=f"{best.closeness:.2f}" if best else "-", source=kind.source(best) if best else None)


def cmd_chip(a: argparse.Namespace) -> int:
    t0 = time.time()
    sid_dir = Path(a.sid_dir).expanduser()
    if not sid_dir.is_dir():
        die(f"no folder {sid_dir} (--sid-dir: the SID collection you downloaded, such as HVSC's C64Music)")
    d, scores, pending = own_pending(a, CHIP)
    if not pending:
        print(own_summary(CHIP, a, t0, scores, pending, []), flush=True)
        return 0
    fp = find_converter(a.fmzx_pack)
    idx = chip_index(d, sid_dir, rebuild=a.force)
    renderer = Renderer(a.soundfont)
    if not renderer.ok:
        print(f"{PROG}: {renderer.why_not()}")
    if not sid_renderer():
        print(f"{PROG}: no sidplayfp on PATH: no chip.wav (the C64's own sound); fm1.wav only")
    jg = Judge(d)
    results = [own_score(CHIP, d, s, chip_candidates(s, idx), sid_dir.resolve(), fp, a.max, a.force, renderer, jg) for s in pending]
    judge_scores(d, pending, jg=jg)
    print(f"{PROG}: {sum(r.takes for r in results)} chip takes; listen and choose with: {PROG} pick {d}")
    print(own_summary(CHIP, a, t0, scores, pending, results), flush=True)
    return 0


# ---------------------------------------------------------------------------------------------
# ay: a game's tune from its Spectrum 128 version, as a take
#
# The collection (any folder of ZXAYEMUL .ay files, such as Project AY's: games/ and misc/;
# nothing is fetched) is indexed once into DIR/arrange/.ay-index.json: every .ay's path, its
# author and misc strings, its songs' names, the number of songs and the first song. A score's
# candidates are the files whose file name, misc string or a song's name names the game; they are
# checked and ranked as chip's, and the best become ay-<n>/ takes.

AY_INDEX_VERSION = 1


def ay_header(data: bytes) -> dict | None:
    """A ZXAYEMUL header's fields: author, misc, songs, start (1-based) and the songs' names
    (pointers big-endian, signed, from their own position; strings Latin-1, NUL-terminated, at
    most 255 bytes), or None when it is not one."""
    if len(data) < 20 or data[:8] != b"ZXAYEMUL":
        return None

    def ptr(at: int) -> int | None:
        """Where the pointer at `at` points (one landing before the file's start read unsigned,
        as files over 32 KB need); None for 0 or past the end."""
        if at + 2 > len(data):
            return None
        raw = int.from_bytes(data[at:at + 2], "big", signed=True)
        p = at + raw if at + raw >= 0 else at + (raw & 0xFFFF)
        return p if raw and p < len(data) else None

    def text(at: int) -> str:
        p = ptr(at)
        if p is None:
            return ""
        return " ".join(data[p:p + 255].split(b"\0", 1)[0].decode("latin-1").split())

    songs = data[16] + 1
    table = ptr(18)
    if table is None:
        return None
    titles = [text(table + 4 * k) for k in range(songs)]
    return {"author": text(12), "misc": text(14), "songs": songs, "start": min(data[17] + 1, songs), "titles": titles}


def ay_index(d: Path, ay_dir: Path, rebuild: bool = False) -> dict:
    """The collection's index, from DIR/arrange/.ay-index.json while its key (the collection's
    path and modification time) holds, else built and saved."""
    ay_dir = ay_dir.resolve()
    key = {"version": AY_INDEX_VERSION, "path": str(ay_dir), "mtime": ay_dir.stat().st_mtime_ns}
    cache = d / "arrange" / ".ay-index.json"
    if not rebuild and cache.is_file():
        try:
            idx = json.loads(cache.read_text())
            if idx.get("key") == key:
                return idx
        except (OSError, ValueError):
            pass
    print(f"{PROG}: indexing {ay_dir}", flush=True)
    files = []
    for root, dirs, names in os.walk(ay_dir):
        dirs.sort()
        for nm in sorted(names):
            if not nm.lower().endswith(".ay"):
                continue
            p = Path(root) / nm
            try:
                h = ay_header(p.read_bytes())
            except OSError:
                continue
            if h:
                files.append({"path": p.relative_to(ay_dir).as_posix(), **h})
    idx = {"key": key, "files": files}
    cache.parent.mkdir(parents=True, exist_ok=True)
    tmp = cache.with_suffix(".tmp")
    tmp.write_text(json.dumps(idx))
    tmp.replace(cache)
    print(f"{PROG}: {len(files)} AY files", flush=True)
    return idx


def ay_candidates(score: Score, idx: dict, limit: int = CHIP_CANDIDATES) -> list[ChipCandidate]:
    """The (file, song) pairs to check for the score, at most limit: files whose file name or misc
    string names the game (1.0, or 0.6 when one name runs on from the other), or one of whose
    songs' names does; files in order of how well (at a tie, one under games/ first, then one
    under misc/, then the path), a song of each file in turn (a song named for the game first, then the first song,
    then the rest in order)."""
    names = [n for n in (name_tokens(score.name), name_tokens(score.game.replace("-", " "))) if n]
    names = [n for i, n in enumerate(names) if n not in names[:i]]
    if "_words" not in idx:
        idx["_words"] = [(f, "".join(name_tokens(Path(f["path"]).stem)), "".join(name_tokens(f.get("misc", ""))),
                          ["".join(name_tokens(t)) for t in f.get("titles", [])]) for f in idx.get("files", [])]
    per_file: list[tuple[float, bool, str, list[ChipCandidate]]] = []
    for f, stem, misc, titles in idx["_words"]:
        file_match = max(name_match(names, stem, 1.0, 0.6), name_match(names, misc, 1.0, 0.6))
        song_match = {s: name_match(names, t, 1.0, 0.6) for s, t in enumerate(titles, 1)}
        cands = []
        for s in range(1, f["songs"] + 1):
            tm = max(file_match, song_match.get(s, 0.0))
            if tm < 0.5:
                continue
            c = ChipCandidate(f, s, round(tm, 3))
            c.prior = tm + (1.0 if song_match.get(s, 0.0) >= 0.5 else 0.0) + (0.2 if s == f["start"] else 0.0) - s * 1e-3
            cands.append(c)
        if cands:
            cands.sort(key=lambda c: -c.prior)
            folder = f["path"].split("/", 1)[0] if "/" in f["path"] else ""
            per_file.append((cands[0].prior, {"games": 0, "misc": 1}.get(folder, 2), f["path"], cands))
    per_file.sort(key=lambda x: (-x[0], x[1], x[2]))
    out: list[ChipCandidate] = []
    rnd = 0
    while len(out) < limit and any(rnd < len(x[3]) for x in per_file):
        for x in per_file:
            if rnd < len(x[3]) and len(out) < limit:
                out.append(x[3][rnd])
        rnd += 1
    return out


def cmd_ay(a: argparse.Namespace) -> int:
    t0 = time.time()
    ay_dir = Path(a.ay_dir).expanduser()
    if not ay_dir.is_dir():
        die(f"no folder {ay_dir} (--ay-dir: a collection of .ay files, such as Project AY's)")
    d, scores, pending = own_pending(a, AY)
    if not pending:
        print(own_summary(AY, a, t0, scores, pending, []), flush=True)
        return 0
    fp = find_converter(a.fmzx_pack)
    idx = ay_index(d, ay_dir, rebuild=a.force)
    renderer = Renderer(a.soundfont)
    if not renderer.ok:
        print(f"{PROG}: {renderer.why_not()}")
    if not ay_renderer():
        print(f"{PROG}: no ffmpeg that reads .ay files (libgme): no ay.wav (the Spectrum 128's own sound); fm1.wav only")
    jg = Judge(d)
    results = [own_score(AY, d, s, ay_candidates(s, idx), ay_dir.resolve(), fp, a.max, a.force, renderer, jg) for s in pending]
    judge_scores(d, pending, jg=jg)
    k = len(set().union(*(r.refused for r in results)))
    said = (f" ({k} candidate song{'s' if k != 1 else ''} skipped: the converter refuses them, such as 48K beeper tunes"
            " and Amstrad CPC songs)") if k else ""
    print(f"{PROG}: {sum(r.takes for r in results)} ay takes{said}; listen and choose with: {PROG} pick {d}")
    print(own_summary(AY, a, t0, scores, pending, results), flush=True)
    return 0


# ---------------------------------------------------------------------------------------------
# engine: the game's own music read exactly from its music engine, as a take
#
# fmzx-pack engine-notes runs the score's own run (the one that recorded it, as music-preview plays
# it) with a known engine's state tapped at its row read, and writes each channel's notes and the
# drum hits on the score's timeline. engine_voices puts them on the FM-1's voices: each channel
# keeps one voice for the whole take, the highest on average the lead, the lowest the bass (with
# two channels, only when it lies below ENGINE_BASS_BELOW), the others the pad (more than one
# channel there: a newer note cuts the one sounding); the drum hits on the drum by kind. The take
# is on the score's timeline (its key, intro_t and loop_t), so it plays in step with the beeper
# as an AI take does.

ENGINE_PREFIX = "engine"
ENGINE_BASS_BELOW = 52.0  # MIDI (E3): with two channels, the lower is the bass under it, else the pad
ENGINE_LEVEL = {"lead": 200, "bass": 210, "pad": 150}  # a voice's level for a note of full level
ENGINE_LEVEL_MIN = 48
ENGINE_DRUM_LEVEL = {**DRUM_LEVEL, "tone": 200, "noise": 120}  # tone and noise: an engine's tone burst and noise
ENGINE_RESTRIKE_T = 128  # a same-pitch note right after another on a voice ends this early, so it strikes again
ENGINE_SAME_PITCH = 1 / 32  # a period within this share of the one before is the same pitch (the FM-1 glides on)


def engine_dirs(score_dir: Path) -> list[tuple[int, Path]]:
    out = []
    for p in score_dir.glob(f"{ENGINE_PREFIX}-*"):
        n = p.name[len(ENGINE_PREFIX) + 1:]
        if n.isdigit() and (p / "arranged.toml").is_file():
            out.append((int(n), p))
    return sorted(out)


def engine_notes_cache(d: Path, score: Score) -> Path:
    return d / "arrange" / ".engine-notes" / f"{score.game}__{score.key}.toml"


def run_engine_reader(fp: str, d: Path, score: Score) -> tuple[dict | None, str, bool]:
    """fmzx-pack engine-notes for the score, cached in DIR/arrange/.engine-notes/ (the result, or
    why no engine plays it, kept while the score, the converted games' manifest and fmzx-pack are
    unchanged): (the notes TOML, "", True), (None, why, True) when no known engine plays it, or
    (None, why, False) when the reader failed."""
    out = engine_notes_cache(d, score)
    stamp = out.with_suffix(".src")
    src = engine_stamp(fp, d, score)
    old = stamp.read_text() if stamp.is_file() else ""
    if old.startswith(src):
        rest = old[len(src):]
        if rest.startswith("none: "):
            return None, rest[6:].strip(), True
        doc = read_toml(out) if out.is_file() else {}
        if doc:
            return doc, "", True
    out.parent.mkdir(parents=True, exist_ok=True)
    out.unlink(missing_ok=True)
    r = subprocess.run([fp, "engine-notes", str(d), "--game", score.game, "--score", score.key, "-o", str(out)],
                       capture_output=True, text=True, check=False)
    lines = (r.stderr or r.stdout).strip().splitlines()
    why = lines[-1].removeprefix("fmzx-pack: ").removeprefix("no engine: ") if lines else f"exit {r.returncode}"
    why = why.removeprefix(f"{score.id}: ")
    if r.returncode == 3:
        stamp.write_text(f"{src}none: {why}\n")
        return None, why, True
    if r.returncode != 0 or not out.is_file():
        return None, why, False
    stamp.write_text(src)
    doc = read_toml(out)
    return (doc, "", True) if doc else (None, "unreadable notes", False)


def engine_stamp(fp: str, d: Path, score: Score) -> str:
    """The key the reader's cached result holds for: the score, the converted games' manifest and
    fmzx-pack."""
    man = d / "converted" / "manifest.toml"
    fp_t = Path(fp).stat().st_mtime_ns if Path(fp).is_file() else 0
    return f"{score.digest()} {man.stat().st_mtime_ns if man.is_file() else 0} {fp} {fp_t}\n"


def engine_settled(fp: str, d: Path, score: Score) -> bool:
    """Whether the reader's cached result for the score as it is says it needs no take: no known
    engine plays it, or a built-in entry plays it exactly."""
    out = engine_notes_cache(d, score)
    stamp = out.with_suffix(".src")
    old = stamp.read_text() if stamp.is_file() else ""
    src = engine_stamp(fp, d, score)
    if not old.startswith(src):
        return False
    return old[len(src):].startswith("none: ") or bool(read_toml(out).get("live"))


def engine_roles(doc: dict) -> dict[int, str]:
    """Each channel's voice for the whole take (see the section's comment), by the duration-weighted
    mean of its notes' pitches."""
    dur: dict[int, float] = {}
    pitch: dict[int, float] = {}
    for n in doc.get("note", []):
        c, d = int(n["channel"]), max(int(n["end_t"]) - int(n["start_t"]), 1)
        dur[c] = dur.get(c, 0.0) + d
        pitch[c] = pitch.get(c, 0.0) + d * float(n["midi"])
    by = sorted(dur, key=lambda c: -pitch[c] / dur[c])
    roles: dict[int, str] = {}
    if not by:
        return roles
    roles[by[0]] = "lead"
    rest = by[1:]
    if len(rest) == 1:
        roles[rest[0]] = "bass" if pitch[rest[0]] / dur[rest[0]] < ENGINE_BASS_BELOW else "pad"
    elif rest:
        roles[rest[-1]] = "bass"
        for c in rest[:-1]:
            roles[c] = "pad"
    return roles


def engine_voices(score: Score, doc: dict) -> tuple[dict[int, list[Note]], dict[int, str]]:
    """The reader's notes on the take's voices (0 lead, 1 bass, 2 pad, 3 drum) and each channel's
    role: levels by voice times the note's level, a newer note cutting an older one on a voice, a
    same-pitch note right after another made to strike again, the drum hits one at a time within
    the drum rules (the stronger kind wins a clash)."""
    roles = engine_roles(doc)
    total = score.total_t
    voices: dict[int, list[Note]] = {0: [], 1: [], 2: [], 3: []}
    for n in doc.get("note", []):
        role = roles.get(int(n["channel"]))
        if role is None:
            continue
        v = TAKE_ROLES.index(role)
        s, e = int(n["start_t"]), min(int(n["end_t"]), total)
        p = max(64, min(0xFFFFFF, int(n["period_t"])))
        lv = max(ENGINE_LEVEL_MIN, min(255, round(ENGINE_LEVEL[role] * int(n.get("level", 255)) / 255)))
        if e > s:
            voices[v].append(Note(v, s, e, p, lv))
    for v in range(3):
        ns = sorted(voices[v], key=lambda n: (n.start_t, -n.end_t))
        kept: list[Note] = []
        for n in ns:
            if kept and kept[-1].start_t == n.start_t:
                continue  # two channels sharing the pad start together: the longer note keeps it
            if kept and kept[-1].end_t > n.start_t:
                kept[-1].end_t = n.start_t
            if kept and kept[-1].end_t == n.start_t and abs(kept[-1].period_t - n.period_t) <= kept[-1].period_t * ENGINE_SAME_PITCH:
                kept[-1].end_t = n.start_t - ENGINE_RESTRIKE_T
            kept.append(n)
        voices[v] = [n for n in kept if n.end_t - n.start_t >= 64]
    hits: list[list[int]] = []
    spacing, hit = score.tstate(DRUM_SPACING_S), score.tstate(DRUM_HIT_S)
    for dr in sorted(doc.get("drum", []), key=lambda x: int(x["start_t"])):
        s = int(dr["start_t"])
        lv = ENGINE_DRUM_LEVEL.get(str(dr.get("kind", "")), DRUM_OTHER_LEVEL)
        if s >= total:
            continue
        if hits and s - hits[-1][0] < spacing:
            hits[-1][1] = max(hits[-1][1], lv)
            continue
        hits.append([s, lv])
    for i, (s, lv) in enumerate(hits):
        e = min(s + hit, total, hits[i + 1][0] - DRUM_GAP_T if i + 1 < len(hits) else total)
        if e - s >= 64:
            voices[3].append(Note(3, s, e, 0, lv))
    return voices, roles


def engine_source(doc: dict) -> str:
    """"ntropic, read exactly: its rows at 9C9Ch (...)"."""
    return f"{doc.get('engine', '?')}, read exactly: {doc.get('read', '')}"


def engine_shape(doc: dict) -> str:
    """"ntropic, 2 channels + drums"."""
    return f"{doc.get('engine', '?')}, {doc.get('channels', '?')} channels" + (" + drums" if doc.get("drum") else "")


def write_engine_take(score: Score, doc: dict, renderer: Renderer) -> dict:
    voices, roles = engine_voices(score, doc)
    secs = max(score.seconds, 1e-6)
    m = {f"{nm}_nps": round(len(voices[v]) / secs, 2) for v, nm in ((0, "lead"), (1, "bass"), (2, "pad"), (3, "drums"))}
    m["notes"] = len(doc.get("note", []))
    m["drum_hits"] = len(doc.get("drum", []))
    out = dict(score.header)
    out.pop("shadow", None)
    out["voices"] = 3
    out["roles"] = list(TAKE_ROLES)
    out["take"] = f"{ENGINE_PREFIX}-1"
    out["generator"] = f"engine {doc.get('engine', '?')}"
    out["source"] = engine_source(doc)
    out["engine"] = str(doc.get("engine", ""))
    out["channels"] = int(doc.get("channels", 0))
    out["channel_roles"] = [roles.get(c, "") for c in range(int(doc.get("channels", 0)))]
    out["score_digest"] = score.digest()
    out["metrics"] = m
    out["note"] = [asdict(x) for x in sorted((x for v in voices.values() for x in v), key=lambda x: (x.start_t, x.voice))]
    final = score.dir / f"{ENGINE_PREFIX}-1"
    tmp = score.dir / f".{ENGINE_PREFIX}-1.tmp"
    shutil.rmtree(tmp, ignore_errors=True)
    tmp.mkdir()
    dump_toml(tmp / "arranged.toml", out)
    fm1_midi(score, voices, tmp / "fm1.mid")
    renderer.render(tmp / "fm1.mid", tmp / "fm1.wav", secs)
    for _, p in engine_dirs(score.dir):
        shutil.rmtree(p)
    tmp.replace(final)
    return m


def engine_current(score: Score) -> bool:
    """Whether the score has its engine take for its score.toml as it is."""
    return any(toml_head(p / "arranged.toml").get("score_digest") == score.digest() for _, p in engine_dirs(score.dir))


@dataclass
class EngineResult:
    """What engine_score did for a score."""
    take: bool = False  # an engine take written
    live: bool = False  # a built-in entry already plays it exactly: no take
    unknown: bool = False  # no known engine plays it
    failed: str = ""  # the reader failed: why
    engine: str = ""
    shape: str = ""


def engine_score(fp: str, d: Path, score: Score, renderer: Renderer) -> EngineResult:
    log = lambda msg: print(f"[{score.id}] {msg}", flush=True)  # noqa: E731
    print(f"progress: engine {score.id}", flush=True)
    doc, why, known = run_engine_reader(fp, d, score)
    if doc is None:
        if known:
            log(f"no engine take: {why}")
            return EngineResult(unknown=True)
        log(f"the engine reader failed: {why}")
        return EngineResult(failed=why)
    res = EngineResult(engine=str(doc.get("engine", "")), shape=engine_shape(doc))
    if doc.get("live"):
        log(f"already exact, no engine take: {res.shape}; {doc['live']}")
        res.live = True
        return res
    m = write_engine_take(score, doc, renderer)
    log(f"{ENGINE_PREFIX}-1: engine: {res.shape}; {m['notes']} notes, {m['drum_hits']} drum hits, read exactly")
    res.take = True
    return res


def cmd_engine(a: argparse.Namespace) -> int:
    t0 = time.time()
    d = Path(a.dir)
    scores = find_scores(d, a.game)
    if not scores:
        print(f"{PROG}: no scores under {d / 'arrange'}")
        print(summary_line("engine", a.game, t0, scores=0, pending=0, takes=0, live=0, unknown=0, failed=0, engines="-"), flush=True)
        return 0
    fp = engine_reader_path(a.fmzx_pack)
    pending = [s for s in scores if a.force or not (engine_current(s) or engine_settled(fp, d, s))]
    print(f"{PROG}: {len(scores)} scores, {len(pending)} to read from their engines", flush=True)
    results: list[EngineResult] = []
    if pending:
        fp = find_engine_reader(a.fmzx_pack)
        renderer = Renderer(a.soundfont)
        if not renderer.ok:
            print(f"{PROG}: {renderer.why_not()}")
        results = [engine_score(fp, d, s, renderer) for s in pending]
        judge_scores(d, pending)
    takes = sum(r.take for r in results)
    live = sum(r.live for r in results)
    engines = sorted({r.engine for r in results if r.engine})
    shapes = sorted({r.shape for r in results if r.take})
    print(f"{PROG}: {takes} engine takes" + (f", {live} already exact (a built-in entry plays them live)" if live else "")
          + (f"; listen and choose with: {PROG} pick {d}" if takes else ""))
    print(summary_line("engine", a.game, t0, scores=len(scores), pending=len(pending), takes=takes, live=live,
                       unknown=sum(r.unknown for r in results), failed=sum(bool(r.failed) for r in results),
                       engines=",".join(engines) or "-", source="; ".join(shapes) or None), flush=True)
    return 0


def engine_reader_path(given: str | None) -> str:
    """fmzx-pack's path: --fmzx-pack, $FMZX_PACK, else host/target/release/fmzx-pack."""
    return given or os.environ.get("FMZX_PACK") or str(repo_root() / "host" / "target" / "release" / "fmzx-pack")


def find_engine_reader(given: str | None) -> str:
    """fmzx-pack with engine-notes (engine_reader_path), checked."""
    fp = engine_reader_path(given)
    hint = "build it with: cd host && cargo build --release -p fmzx-pack"
    if not Path(fp).is_file():
        die(f"no {fp}: {hint} (or --fmzx-pack PATH)")
    r = subprocess.run([fp, "engine-notes"], capture_output=True, text=True, check=False)
    if "engine-notes" not in r.stdout + r.stderr:
        die(f"{fp} has no engine-notes command: {hint}")
    return fp


# ---------------------------------------------------------------------------------------------
# judge: which take a score plays, from the notes
#
# Per score, every take (and the original, take 0) is measured from its notes as the FM-1 plays
# them: how close it is to the original's tune (closeness), how full and sound it is (quality:
# polyphony, harmony, rhythm section) over the seconds the device can play, and its faults (the
# renderer refuses it, silence, gaps, stuck notes, extreme registers, shorter than what plays).
# combined = quality x fault multiplier x (0.3 + 0.7 x closeness), closeness raised to 0.6 x
# provenance when the take's source is the game's own period music; the highest combined is
# the judge's pick, and a confidence (high, medium, low) with the reasons says whether the owner
# needs to listen. The figures go to judge.toml beside score.toml, kept while the score and its
# takes stay the same.

JUDGE_VERSION = 1
JUDGE_FILE = "judge.toml"
J_TICK = 0.01  # the quality measures' grid (10 ms)
J_QUALITY_S = 60.0  # seconds of a take the quality measures look at (its loop repeated)
J_CAND_S = 150.0  # seconds of a take the closeness search looks through
J_ORIG_NOTES = 160  # notes of each original line aligned (its first pass)
J_ORNAMENT_S = 0.045  # notes shorter than this are ornaments to a melody line
J_NULL = 30  # unrelated controls each score's closeness is calibrated against
J_NULL_MIN = 4  # fewer and closeness is not calibrated (0)
J_SELF = 1.5  # a perfect copy's alignment score per note (match + rhythm bonus)
J_SAME, J_PARTIAL = 0.5, 0.2  # closeness from which a take is shown to be the same tune, partly
J_PARTIAL_TOP = 0.8  # below this a match is partial
J_CLOSE_CALL = 0.15  # the pick's lead over the next, as a share of its combined, below which it is a close call
J_CHECKABLE_Z = 5.0  # the original against itself, in null standard deviations: below, too plain to check
J_FAULT_SHOWN = 0.05  # a fault's penalty from which it is named
J_RENDER_S = "2"  # seconds music-preview renders to check that a take plays
# graded consonance of an interval class (semitones mod 12) between two sounding voices
J_CONS = (1.0, 0.0, 0.35, 0.85, 0.9, 0.7, 0.25, 1.0, 0.8, 0.85, 0.45, 0.1)


@dataclass
class Rendition:
    """A take's notes as seconds: (voice, start, end, midi) rows, the drum's midi NaN."""
    name: str  # "0", "take-1", "chip-1", "ay-2"
    total: float  # seconds of its timeline (intro and one pass of the loop)
    intro: float
    loop: float  # seconds of a pass of the loop; 0: none
    notes: object  # numpy (k, 4)
    meta: dict = field(default_factory=dict)


def rendition(doc: dict, name: str) -> Rendition:
    """A score's or take's notes (the doc read from score.toml or arranged.toml), on its own
    timeline for a take that has one."""
    import numpy as np

    clock = float(doc.get("clock_hz", 3500000))
    if doc.get("timeline") == "own":
        intro, loop = int(doc.get("own_intro_t", 0)), int(doc.get("own_loop_t", 0))
    else:
        intro, loop = int(doc.get("intro_t", 0)), int(doc.get("loop_t", 0))
    rows = []
    for n in doc.get("note", []):
        p = int(n.get("period_t", 0))
        v = int(n["voice"])
        m = 69.0 + 12.0 * math.log2(clock / p / 440.0) if p > 0 and v < 3 else float("nan")
        rows.append((v, int(n["start_t"]) / clock, int(n["end_t"]) / clock, m))
    notes = np.array(rows, dtype=float).reshape(-1, 4)
    total = (intro + loop) / clock
    if total <= 0 and len(notes):
        total = float(notes[:, 2].max())
    return Rendition(name, total, intro / clock, loop / clock, notes, {k: v for k, v in doc.items() if k != "note"})


def unrolled(r: Rendition, seconds: float):
    """Its notes over `seconds`, the loop pass repeated as the device repeats it."""
    import numpy as np

    out = [r.notes]
    if r.loop > 0:
        lp = r.notes[r.notes[:, 1] >= r.intro - 1e-9]
        k = 1
        while r.intro + k * r.loop < seconds:
            c = lp.copy()
            c[:, 1:3] += k * r.loop
            out.append(c)
            k += 1
    a = np.concatenate(out)
    a = a[a[:, 1] < seconds]
    a[:, 2] = np.minimum(a[:, 2], seconds)
    return a[np.lexsort((a[:, 0], a[:, 1]))]


def line_of(notes):
    """A monophonic line (onset, ioi, midi): ornaments dropped, repeated pitches merged, stray
    notes far from the line's register dropped."""
    import numpy as np

    if len(notes) == 0:
        return np.zeros((0, 3))
    n = notes[np.argsort(notes[:, 1], kind="stable")]
    dur = n[:, 2] - n[:, 1]
    n = n[dur >= min(J_ORNAMENT_S, 0.5 * float(np.median(dur)))]
    out = []
    for s, e, m in n[:, 1:4]:
        p = int(round(m))
        if out and out[-1][2] == p and s - out[-1][3] < 0.25:
            out[-1][3] = e
            continue
        out.append([s, 0.0, p, e])
    if not out:
        return np.zeros((0, 3))
    mid = float(np.median([o[2] for o in out]))
    kept = [o for o in out if abs(o[2] - mid) <= 14]
    if len(kept) >= 0.6 * len(out):
        out = []
        for o in kept:
            if out and out[-1][2] == o[2] and o[0] - out[-1][3] < 0.25:
                out[-1][3] = o[3]
            else:
                out.append(o)
    a = np.array(out, dtype=float)
    a[:-1, 1] = np.diff(a[:, 0])
    a[-1, 1] = a[-1, 3] - a[-1, 0]
    return a[:, :3]


def skyline(notes):
    """The top tonal pitch at each onset, as notes."""
    import numpy as np

    t = notes[notes[:, 0] < 3]
    if len(t) == 0:
        return np.zeros((0, 4))
    onsets = np.unique(t[:, 1])
    rows = []
    for i, s in enumerate(onsets):
        snd = t[(t[:, 1] <= s + 1e-9) & (t[:, 2] > s + 1e-9)]
        if len(snd) == 0:
            continue
        top = snd[np.argmax(snd[:, 3])]
        e = onsets[i + 1] if i + 1 < len(onsets) else top[2]
        rows.append((-1, s, min(e, top[2]) if top[2] > s else e, top[3]))
    return np.array(rows, dtype=float).reshape(-1, 4)


def voice_lines(notes, min_notes: int = 8) -> dict:
    """The melody lines to align: each tonal voice's and the top line's."""
    out = {}
    for v in (0, 1, 2):
        ln = line_of(notes[notes[:, 0] == v])
        if len(ln) >= min_notes:
            out[f"v{v}"] = ln
    sk = line_of(skyline(notes))
    if len(sk) >= min_notes:
        out["top"] = sk
    return out


def sw_align(a, b) -> float:
    """Smith-Waterman local alignment of two lines by pitch class under all 12 transpositions,
    with a bonus where the notes' lengths relative to their line's median agree: octave,
    transposition and tempo do not count, an added or missing note costs a gap. The best score."""
    import numpy as np

    rel = lambda ln: np.log2(np.clip(ln[:, 1], 0.02, 4.0) / np.median(np.clip(ln[:, 1], 0.02, 4.0)))  # noqa: E731
    pa, pb = a[:, 2].astype(int) % 12, b[:, 2].astype(int) % 12
    ra, rb = rel(a), rel(b)
    m = len(pb)
    pbt = (pb[None, :] + np.arange(12)[:, None]) % 12
    idx = np.arange(m, dtype=float)
    H = np.zeros((12, m + 1))
    best = np.zeros(12)
    for i in range(len(pa)):
        S = np.where(pbt == pa[i], 1.0 + 0.5 * (np.abs(rb - ra[i]) < 0.6), -1.0)
        E = np.maximum(np.maximum(H[:, :-1] + S, H[:, 1:] - 1.0), 0.0)
        Hn = np.maximum.accumulate(E + idx, axis=1) - idx
        H = np.concatenate([np.zeros((12, 1)), Hn], axis=1)
        best = np.maximum(best, Hn.max(axis=1))
    return float(best.max())


def cut_lines(lines: dict, seconds: float) -> dict:
    return {k: v for k, v in ((k, v[v[:, 0] < seconds]) for k, v in lines.items()) if len(v) >= 8}


def best_align(olines: dict, clines: dict) -> float:
    """The best alignment of any original line against any of the take's, per original note."""
    best = 0.0
    for ol in olines.values():
        for cl in clines.values():
            best = max(best, sw_align(ol, cl) / len(ol))
    return best


def plays_s(orig: Rendition) -> float:
    """Seconds of a take the device can play: a looping score goes on while the beeper agrees
    (the quality window); one without a loop only for its own length."""
    return J_QUALITY_S if orig.loop > 0 else min(J_QUALITY_S, orig.total)


def search_s(orig: Rendition) -> float:
    """Seconds of a take the closeness search looks through: what can play, with room for
    another tempo."""
    return J_CAND_S if orig.loop > 0 else min(J_CAND_S, 1.4 * orig.total + 2.0)


def calibrate(raw: float, null: list[float]) -> tuple[float, float]:
    """(closeness 0..1, z): the raw alignment against unrelated music's, as a logistic of its z
    (0.5 at 3 standard deviations above their mean)."""
    import numpy as np

    if len(null) < J_NULL_MIN:
        return 0.0, 0.0
    mu, sd = float(np.mean(null)), max(float(np.std(null)), 0.03)
    z = (raw - mu) / sd
    return float(1.0 / (1.0 + math.exp(-(z - 3.0) / 0.7))), z


def key_fit(hist) -> float:
    import numpy as np

    if hist.sum() <= 0 or hist.std() == 0:
        return 0.0
    return float(max(np.corrcoef(hist, np.roll(np.array(p), k))[0, 1] for p in (KS_MAJOR, KS_MINOR) for k in range(12)))


def pulse_clarity(onset_sig) -> float:
    """The onset signal's normalised autocorrelation peak at beat-like lags (0.25-1.5 s)."""
    import numpy as np

    x = onset_sig.astype(float)
    if x.sum() < 8:
        return 0.0
    x = np.convolve(x, np.ones(3), mode="same")
    x = x - x.mean()
    n = len(x)
    f = np.fft.rfft(x, 2 * n)
    ac = np.fft.irfft(f * np.conj(f))[:n]
    if ac[0] <= 0:
        return 0.0
    ac = ac / ac[0]
    lo, hi = int(0.25 / J_TICK), min(int(1.5 / J_TICK), n - 1)
    return float(max(ac[lo:hi].max(), 0.0)) if hi > lo else 0.0


def clip01(x: float) -> float:
    return float(min(1.0, max(0.0, x)))


def quality(r: Rendition, window: float, refused: str = "") -> dict:
    """Polyphony, harmony, rhythm and faults over the first `window` seconds (what the device
    plays of it): quality = (0.3 polyphony + 0.35 harmony + 0.35 rhythm) x the fault multiplier.
    faults: (plain words, penalty 0..1) each."""
    import numpy as np

    seconds = max(window, 1.0)
    notes = unrolled(r, seconds)
    n = int(seconds / J_TICK)
    pitch = np.full((3, n), np.nan)
    onsets = np.zeros((4, n))
    for v, s, e, m in notes:
        a, b = int(s / J_TICK), min(int(e / J_TICK), n)
        if a >= n:
            continue
        if v < 3:
            pitch[int(v), a:max(b, a + 1)] = m
        onsets[int(v), a] += 1
    snd = ~np.isnan(pitch)
    nv = snd.sum(axis=0)
    held = snd.copy()  # a staccato voice counts as sounding until its next onset within 0.4 s
    for v in range(3):
        on = np.flatnonzero(onsets[v])
        for a, b in zip(on, on[1:]):
            if b - a <= 40:
                held[v, a:b] = True
    active = held.any(axis=0)
    act = float(active.mean()) if active.size else 0.0
    q: dict = {}
    mean_v = float(nv[active].mean()) if active.any() else 0.0
    multi = nv >= 2
    pcs = np.where(snd, np.round(np.nan_to_num(pitch)) % 12, -1)
    distinct = np.array([len(set(pcs[snd[:, j], j])) for j in np.flatnonzero(multi)]) if multi.any() else np.zeros(0)
    indep = float((distinct >= 2).mean()) if len(distinct) else 0.0
    q["polyphony"] = clip01((mean_v - 1.0) / 1.5) * (0.5 + 0.5 * indep)
    cons, pair_steps = 0.0, 0
    clash_mask = np.zeros(n, dtype=bool)
    for i in range(3):
        for j in range(i + 1, 3):
            both = snd[i] & snd[j]
            if not both.any():
                continue
            ic = np.round(np.abs(pitch[i, both] - pitch[j, both])).astype(int) % 12
            cons += np.array(J_CONS)[ic].sum()
            pair_steps += int(both.sum())
            cm = np.zeros_like(both)
            cm[both] = (ic == 1) | (ic == 11)
            clash_mask |= cm
    long_clash, run = 0, 0  # minor-second clashes held 150 ms or more
    for c in np.append(clash_mask, False):
        if c:
            run += 1
        else:
            if run >= 15:
                long_clash += run
            run = 0
    clash = long_clash / max(int(active.sum()), 1)
    hist = np.zeros(12)
    for v in range(3):
        m = pitch[v, snd[v]]
        if len(m):
            np.add.at(hist, np.round(m).astype(int) % 12, 1)
    cons_s = clip01((cons / pair_steps - 0.5) / 0.35) if pair_steps else 0.0
    q["harmony"] = (0.6 * cons_s + 0.4 * clip01((key_fit(hist) - 0.5) / 0.4)) * (1 - clip01(clash * 5))
    lead_mean = np.nanmean(pitch[0]) if snd[0].any() else np.nan
    bass_share = float(snd[1][active].mean()) if active.any() else 0.0
    bass_low = bool(snd[1].any() and (math.isnan(lead_mean) or np.nanmean(pitch[1]) <= lead_mean - 5))
    bass_notes = notes[notes[:, 0] == 1]
    bass_pcs = len(set(np.round(bass_notes[:, 3]).astype(int) % 12)) if len(bass_notes) else 0
    bass_nps = len(bass_notes) / seconds
    bass = clip01(bass_share / 0.5) * clip01((bass_pcs - 1) / 3) * (1.0 if 0.3 <= bass_nps <= 10 else 0.4) * (1.0 if bass_low else 0.5)
    drums = clip01(onsets[3].sum() / seconds / 2.0)
    pulse = clip01((pulse_clarity(onsets.sum(axis=0)) - 0.3) / 0.5)
    q["rhythm"] = 0.45 * bass + 0.25 * drums + 0.3 * pulse
    gaps, run = [], 0
    for a in np.append(active, True):
        if not a:
            run += 1
        else:
            if run:
                gaps.append(run * J_TICK)
            run = 0
    max_gap = max(gaps) if gaps else 0.0
    tonal = notes[notes[:, 0] < 3]
    stuck = int(((tonal[:, 2] - tonal[:, 1]) > min(8.0, 0.5 * seconds)).sum()) if len(tonal) else 0
    if len(tonal):
        w = tonal[:, 2] - tonal[:, 1]
        extreme = float(w[(tonal[:, 3] < 26) | (tonal[:, 3] > 100)].sum() / max(w.sum(), 1e-9))
    else:
        extreme = 1.0
    covered = min(r.total if r.loop == 0 else float("inf"), seconds) / seconds
    faults = []
    if refused:
        faults.append((f"refused by the renderer: {refused}", 1.0))
    if act < 0.6:
        faults.append((f"mostly silent: sounds {act * 100:.0f}% of the time", clip01((0.6 - act) / 0.5) * 0.6))
    if max_gap > 2.0:
        faults.append((f"a silent gap of {max_gap:.1f} s", clip01((max_gap - 2.0) / 8.0) * 0.3))
    if stuck:
        faults.append((f"{stuck} stuck note{'s' if stuck != 1 else ''} (held over {min(8.0, 0.5 * seconds):.0f} s)", min(0.5, 0.2 * stuck)))
    if extreme > 0.05:
        faults.append((f"{extreme * 100:.0f}% of its sound in extreme registers", clip01(extreme * 2) * 0.6))
    if covered < 0.85:
        faults.append((f"plays only a fragment: {r.total:.1f} s of the {seconds:.1f} s that play", clip01((0.85 - covered) / 0.85)))
    mult = 1.0
    for _, p in faults:
        mult *= 1.0 - p
    q["fault"] = mult
    q["faults"] = faults
    q["quality"] = (0.3 * q["polyphony"] + 0.35 * q["harmony"] + 0.35 * q["rhythm"]) * mult
    return q


def provenance(meta: dict) -> float:
    """0..1: how likely a take is the game's own period music rather than a remix, a demo or a
    later cover, from its source line, its file's folder and the title match. A STIL entry
    naming the Spectrum counts fully."""
    import re

    mt = meta.get("metrics", {}) if isinstance(meta.get("metrics"), dict) else {}
    if mt.get("stil_spectrum"):
        return 1.0
    src = str(meta.get("source", ""))
    if not src:
        return 0.0
    tm = float(mt.get("title_match", 0.0) or 0.0)
    title = 1.0 if tm >= 1.0 else 0.5 if tm >= 0.8 else 0.2
    if src.startswith("Spectrum 128"):
        era = 1.0 if str(meta.get("ay_file", "")).startswith("games/") else 0.2
    else:
        m = re.search(r"\((\d{3}[\d?])[ )]", src)
        y = m.group(1) if m else ""
        era = (1.0 if int(y) <= 1990 else 0.15) if y.isdigit() else 1.0 if y.startswith("198") else 0.4 if y.startswith("199") else 0.3
        if "/DEMOS/" in "/" + str(meta.get("sid_file", "")):
            era = min(era, 0.3)
    return title * era


def combined(closeness: float, prov: float, qual: float, original: bool) -> float:
    """quality x (0.3 + 0.7 closeness), closeness raised to 0.6 x provenance: another tune has to
    sound much better to win, the game's own period music less so."""
    c = 1.0 if original else max(closeness, 0.6 * prov)
    return qual * (0.3 + 0.7 * c)


# The null: what unrelated music's alignment with the original looks like. Up to J_NULL takes of
# other games (another family: "-2", "-3", "-ii" and the like stripped from the id; none from a
# file the score's own takes come from), sampled with the score's id as the seed; then other
# games' originals; then, to make up J_NULL, controls built from nothing but the score: copies of
# the original with each voice's pitches shuffled (its rhythm and pitch classes kept) and made-up
# tunes, alternately. Built controls vary less than real music, so with any of them the spread
# is at least 0.4 x the mean (on 190 real takes that matched the real null's verdict on every one).

J_BUILT_SPREAD = 0.4
J_REAL_FOR_HIGH = 10  # fewer real controls and the judge does not claim high confidence
J_MAJOR = (0, 2, 4, 5, 7, 9, 11)
J_MINOR = (0, 2, 3, 5, 7, 8, 10)


def family(game: str) -> str:
    import re

    return re.sub(r"-(\d+|ii|iii|iv|v|vi)$", "", game)


def made_up_tune(rng: random.Random, seconds: float):
    """A made-up tune: phrases of a lead on a scale, repeated with variations (A A' B A), over a
    bass on chord roots."""
    import numpy as np

    beat = rng.uniform(0.25, 0.6)
    tonic = rng.randrange(12)
    scale = J_MAJOR if rng.random() < 0.6 else J_MINOR
    base = 60 + tonic - (12 if tonic > 6 else 0)

    def phrase(n: int) -> list[tuple[int, float]]:
        out, deg = [], rng.randrange(0, 5)
        for _ in range(n):
            r = rng.random()
            step = rng.choice((-1, 1)) * (rng.choice((3, 4, 5)) if r < 0.15 else rng.choice((1, 1, 2)) if r < 0.85 else 0)
            deg = max(-3, min(10, deg + step))
            out.append((deg, rng.choice((0.5, 0.5, 1, 1, 1, 1.5, 2))))
        return out

    n = rng.choice((6, 8, 8, 12))
    a, b = phrase(n), phrase(n)
    form = [a, a[:-3] + phrase(3), b, a]
    rows, t, k = [], 0.0, 0
    while t < seconds:
        for deg, d in form[k % 4]:
            o, i = divmod(deg, 7)
            rows.append((0, t, t + d * beat * 0.9, float(base + 12 * o + scale[i])))
            t += d * beat
        k += 1
    t = 0.0
    while t < seconds:
        rows.append((1, t, t + 2 * beat * 0.95, float(36 + tonic + scale[rng.choice((0, 0, 3, 4, 5))])))
        t += 2 * beat
    arr = np.array(rows, dtype=float)
    arr = arr[arr[:, 1] < seconds]
    return arr[np.lexsort((arr[:, 0], arr[:, 1]))]


def shuffled_original(orig: Rendition, seconds: float, rng: random.Random):
    """The original over `seconds`, each voice's pitches shuffled among its notes."""
    import numpy as np

    a = unrolled(orig, max(seconds, 1.0)).copy()
    for v in (0, 1, 2):
        idx = np.flatnonzero(a[:, 0] == v)
        perm = idx.copy()
        rng.shuffle(perm)
        a[idx, 3] = a[perm, 3]
    return a


def toml_head(path: Path) -> dict:
    """An arranged.toml's header fields, read up to its first note."""
    lines = []
    try:
        with path.open(encoding="utf-8") as f:
            for ln in f:
                if ln.startswith("[[note]]"):
                    break
                lines.append(ln)
        return tomllib.loads("".join(lines))
    except (OSError, UnicodeDecodeError, tomllib.TOMLDecodeError):
        return {}


def judged_takes(score_dir: Path) -> list[tuple[str, Path]]:
    """A score's takes the judge weighs, by name: take-<n>, engine-<n>, chip-<n>, ay-<n>."""
    out = [(f"take-{n}", p) for n, p in take_dirs(score_dir)]
    out += [(f"{ENGINE_PREFIX}-{n}", p) for n, p in engine_dirs(score_dir)]
    for kind in OWN_KINDS:
        out += [(f"{kind.prefix}-{n}", p) for n, p in own_dirs(score_dir, kind)]
    return out


def file_digest(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()[:16]


def music_preview_path() -> str:
    """The renderer the refusal check runs: $FMZX_MUSIC_PREVIEW, else host/target/release/music-preview."""
    return os.environ.get("FMZX_MUSIC_PREVIEW") or str(repo_root() / "host" / "target" / "release" / "music-preview")


class Judge:
    """One run of the judge over a workspace: what it reads once (the other games' takes as
    unrelated music, the lines of each take) and the renderer it checks with."""

    def __init__(self, d: Path, render_check: bool = True, provisional: bool = False):
        self.d = d
        self.provisional = provisional  # the nulls this run makes are marked provisional (judge --provisional)
        self.made: set[str] = set()  # the scores whose null this run made
        self.lines: dict[tuple, dict] = {}
        self.nulls: dict[str, tuple[str, list[float], int]] = {}  # per score id: (its digest, null, real controls)
        self.verdicts: dict[tuple[str, str, str], tuple[str, bool]] = {}  # (score id, take, digest): render()'s
        self._pool: list[tuple[str, str, Path, str]] | None = None
        self._origs: list[tuple[str, Path]] | None = None
        mp = music_preview_path()
        self.mp = mp if render_check and os.access(mp, os.X_OK) else None
        self.mp_stamp = ""
        if self.mp:
            st = os.stat(self.mp)
            self.mp_stamp = f"{st.st_mtime_ns}-{st.st_size}"
        self.render_note = "music-preview" if self.mp else (f"not checked: no {mp} (cd host && cargo build --release -p music)"
                                                            if render_check else "not checked")

    def pool(self) -> list[tuple[str, str, Path, str]]:
        """Every take of the workspace: (score id, take name, its arranged.toml, its tune's file)."""
        if self._pool is None:
            out = []
            for sp in sorted((self.d / "arrange").glob("*/*/score.toml")):
                sid = f"{sp.parent.parent.name}/{sp.parent.name}"
                for name, p in judged_takes(sp.parent):
                    h = toml_head(p / "arranged.toml")
                    out.append((sid, name, p / "arranged.toml", str(h.get("sid_file") or h.get("ay_file") or "")))
            self._pool = sorted(out, key=lambda x: (x[0], x[1]))
        return self._pool

    def forget_takes(self) -> None:
        """The workspace's takes changed: read them again when next needed."""
        self._pool = None

    def originals(self) -> list[tuple[str, Path]]:
        if self._origs is None:
            self._origs = [(f"{p.parent.parent.name}/{p.parent.name}", p) for p in sorted((self.d / "arrange").glob("*/*/score.toml"))]
        return self._origs

    def take_lines(self, path: Path, name: str) -> dict:
        """A take's (or an original's) melody lines over J_CAND_S, kept while its file is the same."""
        st = path.stat()
        k = (path, st.st_mtime_ns, st.st_size)
        if k not in self.lines:
            self.lines[k] = voice_lines(unrolled(rendition(read_toml(path), name), J_CAND_S))
        return self.lines[k]

    def null(self, score: Score, orig: Rendition, olines: dict, own_files: set[str]) -> tuple[list[float], int]:
        """The unrelated alignments the score's closeness is calibrated against, and how many of
        them are real music (the rest are built from the score)."""
        fam = family(score.game)
        srch = search_s(orig)
        takes = [(sid, name, p) for sid, name, p, f in self.pool()
                 if family(sid.split("/")[0]) != fam and f not in own_files and p.is_file()]
        keys = random.Random(score.id).sample(takes, min(J_NULL, len(takes)))
        null = [best_align(olines, cut_lines(self.take_lines(p, name), srch)) for _, name, p in keys]
        if len(null) < J_NULL:
            others = [(sid, p) for sid, p in self.originals() if family(sid.split("/")[0]) != fam]
            for _, p in random.Random(score.id).sample(others, min(J_NULL - len(null), len(others))):
                null.append(best_align(olines, cut_lines(self.take_lines(p, "0"), srch)))
        real = len(null)
        rng = random.Random(f"null/{score.id}")
        while len(null) < J_NULL:
            notes = shuffled_original(orig, srch, rng) if (len(null) - real) % 2 == 0 else made_up_tune(rng, J_CAND_S)
            null.append(best_align(olines, cut_lines(voice_lines(notes), srch)))
        return null, real

    def real_controls(self, score: Score, own_files: set[str]) -> int:
        """How many real controls the null could have (to know when a null built with fewer
        would gain from more games)."""
        fam = family(score.game)
        n = sum(1 for sid, _, _, f in self.pool() if family(sid.split("/")[0]) != fam and f not in own_files)
        if n < J_NULL:
            n += sum(1 for sid, _ in self.originals() if family(sid.split("/")[0]) != fam)
        return min(n, J_NULL)

    def prefetch(self, scores: list[Score], progress: bool = True) -> None:
        """The renderer's verdicts for every take of the scores that needs one, as many at a time
        as there are cores (the first of each game before the others: a game the renderer has
        not learned is learned once)."""
        if not self.mp:
            return
        from concurrent.futures import ThreadPoolExecutor

        firsts, rest, seen = [], [], set()
        for sc in scores:
            for name, dg in render_todo(self, sc):
                (rest if sc.game in seen else firsts).append((sc, name, dg))
                seen.add(sc.game)
        with ThreadPoolExecutor(max_workers=max(1, os.cpu_count() or 1)) as ex:
            for batch in (firsts, rest):
                for (sc, name, dg), got in zip(batch, ex.map(lambda x: self.render(x[0], x[1]), batch)):
                    self.verdicts[(sc.id, name, dg)] = got
                    if progress:
                        print(f"progress: rendered {sc.id} {name}", flush=True)

    def plan_lines(self, scores: list[Score]) -> None:
        """The progress lines' plan: "progress: score <game>/<key> renders=N" for each score with
        takes, N its takes the renderer checks first (0 without the renderer)."""
        for sc in scores:
            if judged_takes(sc.dir):
                print(f"progress: score {sc.id} renders={len(render_todo(self, sc)) if self.mp else 0}", flush=True)

    def render(self, score: Score, name: str) -> tuple[str, bool]:
        """Whether music-preview plays the take: (its refusal, "" when it plays; whether it was
        checked: False when the renderer could not run)."""
        take = "0" if name == "0" else name.removeprefix("take-")
        with tempfile.TemporaryDirectory(prefix="judge-render-") as tmp:
            r = subprocess.run([self.mp, str(self.d), "--game", score.game, "--score", score.key, "--take", take,
                                "--seconds", J_RENDER_S, "-o", str(Path(tmp) / "x.wav")], capture_output=True, text=True)
        why = " ".join((r.stderr or r.stdout).split())
        if r.returncode == 3:
            return why.removeprefix("refused: ") or "refused", True
        return "", r.returncode == 0


def calibrated(raw: float, null: list[float], real: int) -> tuple[float, float]:
    """calibrate(), the spread at least J_BUILT_SPREAD x the mean when the null has built controls."""
    import numpy as np

    if real >= len(null):
        return calibrate(raw, null)
    if len(null) < J_NULL_MIN:
        return 0.0, 0.0
    mu = float(np.mean(null))
    sd = max(float(np.std(null)), 0.03, J_BUILT_SPREAD * mu)
    z = (raw - mu) / sd
    return float(1.0 / (1.0 + math.exp(-(z - 3.0) / 0.7))), z


def choice_name(c: Choice) -> str:
    """A choice as the judge names takes: "0", "take-<n>", "chip-<n>", "ay-<n>"."""
    return c if isinstance(c, str) else "0" if c == 0 else f"take-{c}"


def name_choice(name: str) -> Choice:
    if name == "0":
        return 0
    return int(name[5:]) if name.startswith("take-") else name


def score_null(jg: Judge, score: Score, orig: Rendition, olines: dict, own_files: set[str]) -> tuple[list[float], int]:
    """The score's null and its real controls: judge.toml's while the score is the same (unless
    it has built controls and more real ones are there, or it is provisional and this run is
    not), else this run's, else made."""
    if not olines:
        return [], 0
    digest = score.digest()
    old = read_toml(score.dir / JUDGE_FILE)
    if (old.get("version") == JUDGE_VERSION and old.get("score") == digest and old.get("null")
            and (jg.provisional or not old.get("null_provisional"))):
        real = int(old.get("null_real", 0))
        if real >= J_NULL or jg.real_controls(score, own_files) <= real:
            return [float(x) for x in old["null"]], real
    got = jg.nulls.get(score.id)
    if got and got[0] == digest:
        return got[1], got[2]
    null, real = jg.null(score, orig, olines, own_files)
    jg.nulls[score.id] = (digest, null, real)
    if jg.provisional:
        jg.made.add(score.id)
    return null, real


def own_rendition(score: Score, notes_doc: dict, name: str) -> Rendition:
    """A converter's notes as the take chip_voices makes of them, on its own timeline."""
    voices, intro, loop = chip_voices(score, notes_doc)
    return rendition({"clock_hz": score.clock_hz, "timeline": "own", "own_intro_t": intro, "own_loop_t": loop,
                      "note": [asdict(n) for v in voices.values() for n in v]}, name)


def render_todo(jg: Judge, score: Score) -> list[tuple[str, str]]:
    """The score's takes the renderer has to check: (name, digest of its arranged.toml) for each
    that judge.toml holds no verdict on for this arranged.toml and this music-preview."""
    old = read_toml(score.dir / JUDGE_FILE)
    prev = ({t.get("name"): t for t in old.get("take", [])}
            if old.get("version") == JUDGE_VERSION and old.get("score") == score.digest() else {})
    out = []
    for name, p in judged_takes(score.dir):
        dg = file_digest(p / "arranged.toml")
        pv = prev.get(name, {})
        if not (pv.get("digest") == dg and pv.get("rendered") and (not jg.mp or pv.get("rendered") == jg.mp_stamp)):
            out.append((name, dg))
    return out


def is_exact(name: str) -> bool:
    """Whether a take is an engine take: the game's own tune read exactly from its engine."""
    return name.startswith(f"{ENGINE_PREFIX}-")


def exact_ok(row: dict) -> bool:
    """Whether a judged take is an engine take with no fault: the judge's pick, with high confidence."""
    return is_exact(row["name"]) and not row.get("faults") and not row.get("refused")


def judge_score(jg: Judge, score: Score) -> dict | None:
    """The judge's figures for the score's takes, written to judge.toml beside score.toml and
    reused while the score, a take's arranged.toml and the renderer stay the same; None for a
    score with no takes."""
    import numpy as np
    from concurrent.futures import ThreadPoolExecutor

    path = score.dir / JUDGE_FILE
    takes = judged_takes(score.dir)
    if not takes:
        path.unlink(missing_ok=True)
        return None
    old = read_toml(path)
    digest = score.digest()
    same = old.get("version") == JUDGE_VERSION and old.get("score") == digest
    prev = {t.get("name"): t for t in old.get("take", [])} if same else {}
    orig = rendition(read_toml(score.path), "0")
    olines = {k: v[:J_ORIG_NOTES] for k, v in voice_lines(orig.notes, 6).items()}
    heads = {name: toml_head(p / "arranged.toml") for name, p in takes}
    own_files = {str(h.get("sid_file") or h.get("ay_file")) for h in heads.values() if h.get("sid_file") or h.get("ay_file")}
    null, real = score_null(jg, score, orig, olines, own_files)
    if null != [float(x) for x in old.get("null", [])]:
        prev = {k: {"refused": v.get("refused", ""), "rendered": v.get("rendered", ""), "digest": v.get("digest")}
                for k, v in prev.items()}  # another null: every closeness again, the renderer's verdicts kept
    mu, sd = (float(np.mean(null)), max(float(np.std(null)), 0.03)) if null else (0.0, 0.03)
    if null and real < len(null):
        sd = max(sd, J_BUILT_SPREAD * mu)
    checkable = (J_SELF - mu) / sd if null else 0.0
    win, srch = plays_s(orig), search_s(orig)
    entries = [("0", score.path, digest)] + [(n, p / "arranged.toml", file_digest(p / "arranged.toml")) for n, p in takes]
    # the renderer's verdict: kept for an unchanged take while music-preview is the same (or not there)
    verdict: dict[str, tuple[str, str]] = {}
    to_check = []
    for name, _, dg in entries[1:]:
        pv = prev.get(name, {})
        if pv.get("digest") == dg and pv.get("rendered") and (not jg.mp or pv.get("rendered") == jg.mp_stamp):
            verdict[name] = (str(pv.get("refused", "")), str(pv["rendered"]))
        elif jg.mp:
            to_check.append(name)
        else:
            verdict[name] = ("", "")
    digests = {name: dg for name, _, dg in entries}
    checked = {n: jg.verdicts[(score.id, n, digests[n])] for n in to_check if (score.id, n, digests[n]) in jg.verdicts}
    to_check = [n for n in to_check if n not in checked]
    if to_check:
        first, rest = to_check[0], to_check[1:]  # the first alone: a game the renderer has not learned is learned once
        checked[first] = jg.render(score, first)
        with ThreadPoolExecutor(max_workers=min(4, os.cpu_count() or 1)) as ex:
            checked.update(zip(rest, ex.map(lambda n: jg.render(score, n), rest)))
    for name, (why, ok) in checked.items():
        verdict[name] = (why, jg.mp_stamp if ok else "")
    rows = []
    for name, p, dg in entries:
        refused, rendered = verdict.get(name, ("", ""))
        pv = prev.get(name)
        if pv and "combined" in pv and pv.get("digest") == dg and str(pv.get("refused", "")) == refused:
            rows.append(dict(pv, rendered=rendered))
            continue
        r = orig if name == "0" else rendition(read_toml(p), name)
        q = quality(r, win, refused)
        z = None
        if name == "0" or is_exact(name):
            clo, raw = 1.0, J_SELF  # the original, or the game's own tune read exactly: the same tune by construction
        elif olines:
            raw = best_align(olines, cut_lines(jg.take_lines(p, name), srch))
            clo, z = calibrated(raw, null, real)
        else:
            clo, raw, z = 0.0, 0.0, 0.0
        h = heads.get(name, {})
        prov = 1.0 if name == "0" or is_exact(name) else provenance(h)
        row = {"name": name, "digest": dg, "closeness": round(clo, 3), "raw": round(raw, 3), "provenance": round(prov, 3),
               "quality": round(q["quality"], 3), "polyphony": round(q["polyphony"], 3), "harmony": round(q["harmony"], 3),
               "rhythm": round(q["rhythm"], 3), "fault": round(q["fault"], 3),
               "faults": [w for w, pen in q["faults"] if pen >= J_FAULT_SHOWN or w.startswith("refused")],
               "combined": round(combined(clo, prov, q["quality"], name == "0"), 4), "refused": refused, "rendered": rendered,
               "source": "the original" if name == "0" else str(h.get("source") or h.get("generator") or "")}
        if z is not None:
            row["z"] = round(z, 2)
        rows.append(row)
    # an engine take without faults first: it is the game's own tune, read exactly, where the
    # original is a transcription of it and the other takes are built on that or on another version
    rows.sort(key=lambda t: (not exact_ok(t), -t["combined"], t["name"]))
    for i, t in enumerate(rows, 1):
        t["rank"] = i
    top = rows[0]
    rel = (top["combined"] - rows[1]["combined"]) / max(top["combined"], 1e-6) if len(rows) > 1 else 1.0
    flags = []
    if rel < J_CLOSE_CALL:
        flags.append("close call")
    if checkable < J_CHECKABLE_Z:
        flags.append("original too plain to check closeness")
    if top["name"] != "0" and top["closeness"] < J_SAME:
        flags.append("winner not shown to be the same tune")
    if any(J_PARTIAL <= t["closeness"] < J_PARTIAL_TOP for t in rows if t["name"] != "0"):
        flags.append("partial melodic match")
    if real < J_REAL_FOR_HIGH:
        flags.append(f"few other games to compare with ({real} real controls)")
    if top["refused"]:
        flags.append("the pick is refused by the renderer")
    conf = ("low" if rel < J_CLOSE_CALL or (checkable < J_CHECKABLE_Z and top["name"] != "0") or top["refused"]
            else "medium" if flags else "high")
    if exact_ok(top):  # the game's own tune read exactly, with no fault: no closeness or margin to doubt
        flags, conf, rel = [], "high", max(rel, 0.0)
    doc = {"version": JUDGE_VERSION, "score": digest, "plays": round(win, 1), "search": round(srch, 1),
           "checkable_z": round(checkable, 1), "null_real": real, "null_built": len(null) - real,
           "null": [float(x) for x in null]}
    if jg.provisional and (score.id in jg.made or (old.get("null_provisional") and null == [float(x) for x in old.get("null", [])])):
        doc["null_provisional"] = True
    doc.update({"renderer": jg.render_note, "pick": top["name"], "confidence": conf, "flags": flags, "margin": round(rel, 3),
                "order": [t["name"] for t in rows], "take": rows})
    if exact_ok(top):
        doc["exact"] = True
    dump_toml(path, doc)
    return doc


def judge_scores(d: Path, scores: list[Score], log: bool = True, jg: Judge | None = None) -> dict[str, dict]:
    """judge_score for each score with takes: {score id: its judge.toml} (jg: the run's judge,
    whose nulls it reuses)."""
    jg = jg or Judge(d)
    if not jg.mp and any(judged_takes(s.dir) for s in scores):
        print(f"{PROG}: renderer {jg.render_note}: takes it refuses are not found", flush=True)
    out = {}
    if log:
        jg.plan_lines(scores)
    jg.prefetch(scores, progress=log)
    for s in scores:
        doc = judge_score(jg, s)
        if doc is not None:
            out[s.id] = doc
            if log:
                print(f"[{s.id}] judged: {pick_words(doc)}", flush=True)
    return out


def pct(x: float) -> str:
    return f"{float(x) * 100:.0f}%"


def pick_words(doc: dict) -> str:
    """"chip-1 (high)", "0 (low: close call; ...)"."""
    flags = doc.get("flags", [])
    return f"{label_of(doc['pick'])} ({doc['confidence']}{': ' + '; '.join(flags) if flags else ''})"


def label_of(name: str) -> str:
    return "original" if name == "0" else name


def judge_table(e: str, doc: dict, choice: Choice | None, by_judge: bool) -> list[str]:
    """A score's lines in judge's table."""
    rows = doc.get("take", [])
    ch = "-" if choice is None else f"{label_of(choice_name(choice))} ({'the judge' if by_judge else 'yours'})"
    out = [f"{e}  plays {doc.get('plays')} s; original checkable z {doc.get('checkable_z')}; null {doc.get('null_real')} real"
           + (f" + {doc.get('null_built')} built" if doc.get("null_built") else "") + " controls",
           f"  judge: {pick_words(doc)}   choice: {ch}",
           f"  {'take':9s} {'close':>5s} {'z':>5s} {'prov':>4s} {'qual':>4s} {'poly':>4s} {'harm':>4s} {'rhy':>4s} {'flt':>4s} {'score':>6s}  faults / source"]
    for t in rows:
        z = f"{t['z']:.1f}" if "z" in t else "-"
        faults = "; ".join(t.get("faults", []))
        out.append(f"  {label_of(t['name']):9s} {t['closeness']:5.2f} {z:>5s} {t['provenance']:4.2f} {t['quality']:4.2f} {t['polyphony']:4.2f} "
                   f"{t['harmony']:4.2f} {t['rhythm']:4.2f} {t['fault']:4.2f} {t['combined']:6.3f}  "
                   + (f"[{faults}] " if faults else "") + str(t.get("source", ""))[:90])
    if choice is not None and not by_judge:
        mine = next((t for t in rows if t["name"] == choice_name(choice)), None)
        if mine and mine.get("faults"):
            out.append(f"  your choice {label_of(mine['name'])}: " + "; ".join(mine["faults"])
                       + ("; the pack plays the original in its place" if mine.get("refused") else ""))
    return out


def cmd_judge(a: argparse.Namespace) -> int:
    t0 = time.time()
    d = Path(a.dir)
    if not (d / "arrange").is_dir():
        die(f"no {d / 'arrange'}: learn the games first (tools/pack-studio; DIR is its W/all)")
    scores = find_scores(d, a.game)
    print(f"{PROG}: judging {len(scores)} scores", flush=True)
    jg = Judge(d, provisional=a.provisional)
    jg.plan_lines(scores)
    if not jg.mp:
        print(f"{PROG}: renderer {jg.render_note}: takes it refuses are not found", flush=True)
    else:
        jg.prefetch(scores)
    docs = {}
    for s in scores:
        doc = judge_score(jg, s)
        if doc is not None:
            docs[s.id] = doc
            print(f"[{s.id}] judged: {pick_words(doc)}", flush=True)
    choices, judged = read_choice_tables(d)
    new = {}
    gone = []
    for sid, doc in docs.items():
        by_judge = sid in judged and judged[sid] == choices.get(sid)
        if sid in choices and not by_judge:
            continue
        if doc["confidence"] == "high":
            c = name_choice(doc["pick"])
            if not by_judge or choices.get(sid) != c:
                new[sid] = c
        elif by_judge:
            gone.append(sid)
    if a.apply and (new or gone):
        write_choices(d, {}, judge=new, unjudge=gone)
        choices, judged = read_choice_tables(d)
    print()
    for sid, doc in docs.items():
        by_judge = sid in judged and judged[sid] == choices.get(sid)
        print("\n".join(judge_table(sid, doc, choices.get(sid), by_judge)))
        print()
    owner = sum(1 for sid in docs if sid in choices and not (sid in judged and judged[sid] == choices[sid]))
    picked = sum(1 for sid in docs if sid in choices and sid in judged and judged[sid] == choices[sid])
    sure = sum(1 for sid, doc in docs.items() if doc["confidence"] == "high"
               and not (sid in choices and not (sid in judged and judged[sid] == choices[sid])))
    flagged = sum(1 for sid, doc in docs.items() if doc["confidence"] != "high" and sid not in choices)
    faults = sum(1 for doc in docs.values() for t in doc["take"] if t["name"] != "0" and t.get("faults"))
    if a.apply:
        print(f"{PROG}: {len(new)} choices made by the judge, {len(gone)} of its earlier ones taken back (no longer sure); "
              f"your own choices left alone")
    elif sure - picked:
        print(f"{PROG}: --apply would choose for {sure - picked} scores the judge is sure of")
    print(summary_line("judge", a.game, t0, tunes=len(docs), owner=owner, picked=picked, applied=len(new) if a.apply else 0, sure=sure,
                       flagged=flagged, faults=faults, renderer="checked" if jg.mp else "skipped"), flush=True)
    return 0


