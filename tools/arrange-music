# Metrics

KS_MAJOR = (6.35, 2.23, 3.48, 2.33, 4.38, 4.09, 2.52, 5.19, 2.39, 3.66, 2.29, 2.88)
KS_MINOR = (6.33, 2.68, 3.52, 5.38, 2.60, 3.53, 2.54, 4.75, 3.98, 2.69, 3.34, 3.17)
PC_NAMES = "C C# D D# E F F# G G# A A# B".split()


def key_of(score: Score) -> tuple[str, list[int], float]:
    import numpy as np

    w = np.zeros(12)
    for n in score.tonal():
        w[int(round(score.midi(n))) % 12] += n.end_t - n.start_t
    if w.sum() <= 0 or w.std() == 0:
        return "", [], 0.0
    best = max(
        (float(np.corrcoef(np.roll(np.array(prof), k), w)[0, 1]), k, m)
        for m, prof in (("maj", KS_MAJOR), ("min", KS_MINOR))
        for k in range(12)
    )
    r, k, m = best
    steps = (0, 2, 4, 5, 7, 9, 11) if m == "maj" else (0, 2, 3, 5, 7, 8, 10)
    return f"{PC_NAMES[k]} {m}", [(k + s) % 12 for s in steps], r


def metrics(score: Score, voices: dict[int, list[Note]], generated: int) -> dict:
    import numpy as np

    ticks = max(int(math.ceil(score.seconds * TICKS_PER_S)), 1)

    def line(v: int) -> np.ndarray:
        arr = np.full(ticks, -1, dtype=np.int64)
        for n in voices[v]:
            a = int(score.sec(n.start_t) * TICKS_PER_S)
            b = min(int(score.sec(n.end_t) * TICKS_PER_S), ticks)
            if n.period_t > 0:
                arr[a:b] = int(round(score.midi(n)))
        return arr

    key, scale, r = key_of(score)
    lead = line(0)
    m: dict = {"key": key, "key_r": round(r, 3)}
    for v, nm in ((1, "bass"), (2, "pad")):
        x = line(v)
        on = x >= 0
        m[f"{nm}_in_key"] = round(float(np.isin(x[on] % 12, scale).mean()) if on.any() and scale else 0.0, 3)
        both = on & (lead >= 0)
        m[f"{nm}_consonance"] = round(float(np.isin((lead[both] - x[both]) % 12, CONSONANT).mean()) if both.any() else 0.0, 3)
    lead_on = np.array(sorted(score.sec(n.start_t) for n in voices[0]))
    others = [score.sec(n.start_t) for v in (1, 2, 3) for n in voices[v]]
    if len(lead_on) and others:
        o = np.array(others)
        pos = np.clip(np.searchsorted(lead_on, o), 1, len(lead_on) - 1) if len(lead_on) > 1 else np.zeros(len(o), dtype=int)
        near = np.minimum(np.abs(lead_on[pos] - o), np.abs(lead_on[np.maximum(pos - 1, 0)] - o))
        m["on_lead_onsets"] = round(float((near <= 0.03).mean()), 3)
    else:
        m["on_lead_onsets"] = 0.0
    secs = max(score.seconds, 1e-6)
    for v, nm in ((0, "lead"), (1, "bass"), (2, "pad"), (3, "drums")):
        m[f"{nm}_nps"] = round(len(voices[v]) / secs, 2)
    m["generated"] = generated
    return m


def metrics_line(m: dict) -> str:
    return (f"key {m.get('key') or '?'} (r {m.get('key_r', 0):.2f}); consonance bass {m.get('bass_consonance', 0):.2f} "
            f"pad {m.get('pad_consonance', 0):.2f}; in key bass {m.get('bass_in_key', 0):.2f} pad {m.get('pad_in_key', 0):.2f}; "
            f"on lead onsets {m.get('on_lead_onsets', 0):.2f}; notes/s lead {m.get('lead_nps', 0)} bass {m.get('bass_nps', 0)} "
            f"pad {m.get('pad_nps', 0)} drums {m.get('drums_nps', 0)}")


