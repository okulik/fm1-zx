             "unrelated": close(made_up_tune(random.Random(77), 30.0)), "shuffled": close(shuf)}
        check(c["transposed"] >= J_PARTIAL_TOP and c["tempo"] >= J_PARTIAL_TOP and c["moved"] >= J_PARTIAL_TOP,
              f"judge: a transposed copy, a faster one a tone up, the lead on another voice under a band: the same tune ({c})")
        check(c["unrelated"] < J_PARTIAL and c["shuffled"] < J_SAME, "judge: an unrelated tune and the pitches shuffled: not the same tune")
        band = lambda **kw: Rendition("x", 32.0, 32.0, 0.0, selftest_band(random.Random(7), **kw))  # noqa: E731
        full, alone, clash = quality(band(), 32.0), quality(band(bass=False, pad=False, drums=False), 32.0), quality(band(pad_shift=1), 32.0)
        check(full["quality"] > alone["quality"] + 0.3 and full["polyphony"] > alone["polyphony"] and full["rhythm"] > alone["rhythm"],
              f"judge: a full band sounds fuller than its lead alone ({full['quality']:.2f} > {alone['quality']:.2f})")
        check(clash["harmony"] < 0.2 < full["harmony"] and clash["quality"] < full["quality"], "judge: a pad a semitone off kills the harmony")
        nb = selftest_band(random.Random(7))
