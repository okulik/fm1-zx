def selftest_band(rng: random.Random, bars: int = 16, lead: bool = True, bass: bool = True, pad: bool = True, drums: bool = True,
                  pad_shift: int = 0, beat: float = 0.5):
    """A made-up band over C F G C: a lead on chord tones and the scale, a bass on roots and
    fifths, a pad, a drum on each beat; (voice, start s, end s, midi) rows."""
    import numpy as np

    prog = ((0, 4, 7), (5, 9, 0), (7, 11, 2), (0, 4, 7))
    rows = []
    for bar in range(bars):
        ch, t0 = prog[bar % 4], bar * 4 * beat
        t = t0
        while lead and t < t0 + 4 * beat - 1e-9:
            d = beat if rng.random() < 0.5 else beat / 2
            rows.append((0, t, t + d * 0.9, 72 + (rng.choice(ch) if rng.random() < 0.7 else rng.choice(J_MAJOR))))
            t += d
        for b in range(4):
            tb = t0 + b * beat
            if bass:
                rows.append((1, tb, tb + beat * 0.9, 36 + (ch[0] if b % 2 == 0 else ch[2])))
            if drums:
                rows.append((3, tb, tb + 0.05, float("nan")))
        if pad:
            rows.append((2, t0, t0 + 4 * beat - 0.01, 60 + ch[1] + pad_shift))
    a = np.array(rows, dtype=float)
    return a[np.lexsort((a[:, 0], a[:, 1]))]


def selftest_notes_doc(notes, clock: int = 3500000) -> list[dict]:
    """(voice, start s, end s, midi) rows as score.toml's [[note]] tables, one note at a time per voice."""
    out = []
    last: dict[int, int] = {}
    for v, s_, e, m in sorted(notes.tolist(), key=lambda n: (n[1], n[0])):
        v, st, en = int(v), int(round(s_ * clock)), int(round(e * clock))
        st = max(st, last.get(v, 0))
        if en <= st:
            continue
        last[v] = en
        out.append({"voice": v, "start_t": st, "end_t": en, "period_t": 0 if v == 3 else period_of_midi(clock, int(round(m))), "level": 120})
    return sorted(out, key=lambda n: (n["start_t"], n["voice"]))


def selftest_judge_game(root: Path, game: str, key: str, orig, total: float, takes: dict) -> None:
    """A made-up game's score (orig: its notes, no loop) and takes on their own timeline (name ->
    (notes, seconds, source, title match))."""
    sd = root / "arrange" / game / key
    sd.mkdir(parents=True, exist_ok=True)
    head = {"game": game, "name": game.replace("-", " ").title(), "key": key, "clock_hz": 3500000,
            "intro_t": int(total * 3500000), "loop_t": 0, "voices": 3, "roles": ["lead", "bass", "pad"]}
    dump_toml(sd / "score.toml", dict(head, note=selftest_notes_doc(orig)))
    for name, (notes, secs, source, tm) in takes.items():
        (sd / name).mkdir(exist_ok=True)
        dump_toml(sd / name / "arranged.toml", dict(head, take=name, generator="chip sid", timeline="own", own_intro_t=int(secs * 3500000),
                                                    own_loop_t=0, source=source, sid_file=source.rsplit(", ", 1)[-1], subtune=1,
                                                    metrics={"closeness": 0.0, "title_match": tm}, note=selftest_notes_doc(notes)))



def selftest_summary(out: str) -> dict:
    """The summary line's fields in a command's output ({} without one)."""
    lines = [ln for ln in out.splitlines() if ln.startswith("summary: ")]
    if len(lines) != 1:
        return {}
    body, _, source = lines[0][len("summary: "):].partition(" source=")
    doc = dict(kv.split("=", 1) for kv in body.split())
    if source:
        doc["source"] = source
    return doc


