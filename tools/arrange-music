def selftest_score(path: Path, game: str, key: str, shadow: bool = False, name: str = "Test tune") -> None:
    """A small invented tune: an intro and a loop, a melody, a bass voice and a pad voice; a shadow
    score's when `shadow`."""
    clock = 3500000
    beat = int(0.25 * clock)
    intro_t, loop_t = 4 * beat, 32 * beat
    melody = [60, 64, 67, 72, 71, 67, 64, 62]
    notes = []
    for i in range(36):
        p = melody[i % len(melody)] + (5 if (i // 8) % 2 else 0)
        notes.append({"voice": 2, "start_t": i * beat, "end_t": i * beat + beat - 20000, "period_t": period_of_midi(clock, p), "level": 116})
        if i % 4 == 0:
            notes.append({"voice": 0, "start_t": i * beat, "end_t": i * beat + 4 * beat - 1, "period_t": period_of_midi(clock, 36 + (5 if (i // 8) % 2 else 0)), "level": 90})
        if i % 8 == 0:
            notes.append({"voice": 1, "start_t": i * beat, "end_t": min(i * beat + 8 * beat, intro_t + loop_t), "period_t": period_of_midi(clock, 55), "level": 60})
    notes.sort(key=lambda n: (n["start_t"], n["voice"]))
    path.parent.mkdir(parents=True, exist_ok=True)
    doc = {"game": game, "name": name, "key": key, "clock_hz": clock, "intro_t": intro_t, "loop_t": loop_t,
           "voices": 3, "roles": ["bass", "pad", "lead"]}
    if shadow:
        doc["shadow"] = True
    doc["note"] = notes
    dump_toml(path, doc)


SELFTEST_MELODY = [60, 64, 67, 72, 71, 67, 64, 62]  # selftest_score's lead: these, then these + 5


def selftest_sid(path: Path, title: str, author: str, released: str, songs: dict[str, list[int]], start: int = 1,
                 rsid: bool = False) -> None:
    """A made-up SID file: a version 2 PSID (or RSID) header, then, as its "data", the melodies of
    its subtunes as JSON, which only the stand-in converter reads."""
    h = bytearray(0x7C)
    h[0:4] = b"RSID" if rsid else b"PSID"
    for off, v in ((4, 2), (6, 0x7C), (8, 0x1000), (0x0A, 0x1000), (0x0C, 0x1003), (0x0E, len(songs)), (0x10, start)):
        h[off:off + 2] = v.to_bytes(2, "big")
    for off, txt in ((0x16, title), (0x36, author), (0x56, released)):
        b = txt.encode("latin-1")[:32]
        h[off:off + len(b)] = b
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(bytes(h) + json.dumps(songs).encode())


