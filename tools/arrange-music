def choices_path(d: Path) -> Path:
    return d / "arrange" / "choices.toml"


Choice = int | str  # a take's number (0: the original) or an engine, chip or ay take's dir, "engine-<n>", "chip-<n>", "ay-<n>"


def parse_choice(v) -> Choice | None:
    """A choices.toml value: a number (an arranged take, 0 the original), "engine-<n>", "chip-<n>" or "ay-<n>"."""
    if isinstance(v, bool):
        return None
    if isinstance(v, int):
        return v if v >= 0 else None
    if isinstance(v, str):
        if v.isdigit():
            return int(v)
        for prefix in [ENGINE_PREFIX] + [k.prefix for k in OWN_KINDS]:
            n = v.removeprefix(f"{prefix}-")
            if n != v and n.isdigit() and int(n) > 0:
                return f"{prefix}-{int(n)}"
    return None


def read_choice_tables(d: Path) -> tuple[dict[str, Choice], dict[str, Choice]]:
    """choices.toml's [choices] and [judged] tables: every choice, and those the judge made (a
    choice is the judge's while [judged] holds the same value for it; fmzx-pack reads only
    [choices])."""
    doc = read_toml(choices_path(d))
    out = []
    for table in ("choices", "judged"):
        t = {}
        for k, v in (doc.get(table) or {}).items():
            c = parse_choice(v)
            if c is not None:
                t[str(k)] = c
        out.append(t)
    return out[0], out[1]


def read_choices(d: Path) -> dict[str, Choice]:
    return read_choice_tables(d)[0]


def write_choices(d: Path, update: dict[str, Choice], judge: dict[str, Choice] | None = None,
                  unjudge: list[str] | None = None) -> dict[str, Choice]:
    """Sets the owner's choices (update: no longer the judge's), the judge's (judge: marked in
    [judged]) and takes back the judge's (unjudge: the score plays the original again); the
    other choices kept. A [judged] entry whose choice the owner changed by hand is dropped."""
    ch, judged = read_choice_tables(d)
    for k, v in update.items():
        ch[k] = v
        judged.pop(k, None)
    for k, v in (judge or {}).items():
        ch[k] = judged[k] = v
    for k in unjudge or []:
        ch.pop(k, None)
        judged.pop(k, None)
    judged = {k: v for k, v in judged.items() if ch.get(k) == v}
    choices_path(d).parent.mkdir(parents=True, exist_ok=True)
    doc = {"choices": dict(sorted(ch.items()))}
    if judged:
        doc["judged"] = dict(sorted(judged.items()))
    dump_toml(choices_path(d), doc)
    return ch


def judge_of(doc: dict, name: str) -> dict:
    """A take's figures in a judge.toml, for the list and the page: closeness, quality, rank,
    faults; {} when the judge has not weighed it."""
    t = next((t for t in doc.get("take", []) if t.get("name") == name), None)
    if t is None:
        return {}
    return {"closeness": t.get("closeness", 0.0), "quality": t.get("quality", 0.0), "rank": t.get("rank", 0),
            "faults": list(t.get("faults", [])), "pick": doc.get("pick") == name}


def judge_line(j: dict, original: bool = False) -> str:
    """"close 97%, quality 62%, #1 (the judge's pick); plays only a fragment: ..." for a take."""
    if not j:
        return "not judged"
    text = ("" if original else f"close {pct(j['closeness'])}, ") + f"quality {pct(j['quality'])}, #{j['rank']}"
    text += " (the judge's pick)" if j["pick"] else ""
    return text + ("; " + "; ".join(j["faults"]) if j["faults"] else "")


def score_entries(d: Path) -> list[dict]:
    choices, judged = read_choice_tables(d)
    out = []
    for s in find_scores(d):
        jd = read_toml(s.dir / JUDGE_FILE)
        takes = []
        for n, p in take_dirs(s.dir):
            doc = read_toml(p / "arranged.toml")
            takes.append({"n": n, "generator": doc.get("generator", ""), "metrics": doc.get("metrics", {}),
                          "fm1": (p / "fm1.wav").is_file(), "full": (p / "full.wav").is_file(), "judge": judge_of(jd, f"take-{n}")})
        chips = []  # the engine takes (the game's own tune, read exactly), then those on their own timeline: chip-<n>, ay-<n>
        for n, p in engine_dirs(s.dir):
            doc = toml_head(p / "arranged.toml")
            name = f"{ENGINE_PREFIX}-{n}"
            chips.append({"name": name, "label": "engine take", "source": doc.get("source", ""), "stil": "", "title_match": 1.0,
                          "judge": judge_of(jd, name), "fm1": (p / "fm1.wav").is_file(), "own": "", "own_label": ""})
        for kind in OWN_KINDS:
            for n, p in own_dirs(s.dir, kind):
                doc = read_toml(p / "arranged.toml")
                mt = doc.get("metrics", {})
                name = f"{kind.prefix}-{n}"
                chips.append({"name": name, "label": kind.label, "source": doc.get("source", ""), "stil": doc.get("stil", ""),
                              "title_match": mt.get("title_match", 0.0), "judge": judge_of(jd, name),
                              "fm1": (p / "fm1.wav").is_file(), "own": kind.sound if (p / kind.sound).is_file() else "",
                              "own_label": kind.sound_label})
        ch = choices.get(s.id, 0)
        verdict = (f"{label_of(jd['pick'])} ({jd.get('confidence')}" + (f": {'; '.join(jd.get('flags', []))}" if jd.get("flags") else "")
                   + ")") if jd.get("pick") is not None and (takes or chips) else ""
        out.append({"id": s.id, "game": s.game, "name": s.name, "key": s.key, "seconds": round(s.seconds, 1), "shadow": s.shadow,
                    "original": (s.dir / "original.wav").is_file(), "takes": takes, "chips": chips, "choice": ch,
                    "by_judge": s.id in judged and judged[s.id] == choices.get(s.id), "verdict": verdict,
                    "judge0": judge_of(jd, "0")})
    return out


def choice_ok(entry: dict, v: Choice) -> bool:
    if isinstance(v, str):
        return v in {c["name"] for c in entry["chips"]}
    return v == 0 or v in {t["n"] for t in entry["takes"]}


def chip_line(c: dict) -> str:
    return f"{c['source']} \u2014 {judge_line(c['judge'])}"


def apply_set(d: Path, sets: list[str]) -> None:
    entries = {e["id"]: e for e in score_entries(d)}
    update = {}
    for s in sets:
        sid, eq, n = s.rpartition("=")
        n_ = parse_choice(n) if eq else None
        if n_ is None:
            die(f"--set {s}: expected GAME/KEY=N, GAME/KEY=engine-N, GAME/KEY=chip-N or GAME/KEY=ay-N")
        if sid not in entries:
            die(f"--set {s}: no score {sid} under {d / 'arrange'}")
        if not choice_ok(entries[sid], n_):
            die(f"--set {s}: {sid} has no take {n_}")
        update[sid] = n_
    write_choices(d, update)
    for sid, n_ in update.items():
        print(f"{sid} = {n_}" + (" (the original)" if n_ == 0 else ""))


SHADOW_MARK = "(replaces the live version when chosen)"


def print_list(d: Path) -> None:
    entries = score_entries(d)
    if not entries:
