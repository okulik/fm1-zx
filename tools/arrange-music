def selftest_score(path: Path, game: str, key: str, shadow: bool = False) -> None:
    """A small invented tune: an intro and a loop, a melody, a bass voice and a pad voice; a shadow
    score's when `shadow`."""
    clock = 3500000
    beat = int(0.25 * clock)
    intro_t, loop_t = 4 * beat, 32 * beat
    melody = [60, 64, 67, 72, 71, 67, 64, 62]
    notes = []
    for i in range(36):
        p = melody[i % len(melody)] + (5 if (i // 8) % 2 else 0)
        notes.append({"voice": 2, "start_t": i * beat, "end_t": i * beat + beat - 20000, "period_t": period_of_midi(clock, p), "level": 116})
        if i % 4 == 0:
            notes.append({"voice": 0, "start_t": i * beat, "end_t": i * beat + 4 * beat - 1, "period_t": period_of_midi(clock, 36 + (5 if (i // 8) % 2 else 0)), "level": 90})
        if i % 8 == 0:
            notes.append({"voice": 1, "start_t": i * beat, "end_t": min(i * beat + 8 * beat, intro_t + loop_t), "period_t": period_of_midi(clock, 55), "level": 60})
    notes.sort(key=lambda n: (n["start_t"], n["voice"]))
    path.parent.mkdir(parents=True, exist_ok=True)
    doc = {"game": game, "name": "Test tune", "key": key, "clock_hz": clock, "intro_t": intro_t, "loop_t": loop_t,
           "voices": 3, "roles": ["bass", "pad", "lead"]}
    if shadow:
        doc["shadow"] = True
    doc["note"] = notes
    dump_toml(path, doc)


SELFTEST_MELODY = [60, 64, 67, 72, 71, 67, 64, 62]  # selftest_score's lead: these, then these + 5


def selftest_sid(path: Path, title: str, author: str, released: str, songs: dict[str, list[int]], start: int = 1,
                 rsid: bool = False) -> None:
    """A made-up SID file: a version 2 PSID (or RSID) header, then, as its "data", the melodies of
    its subtunes as JSON, which only the stand-in converter reads."""
    h = bytearray(0x7C)
    h[0:4] = b"RSID" if rsid else b"PSID"
    for off, v in ((4, 2), (6, 0x7C), (8, 0x1000), (0x0A, 0x1000), (0x0C, 0x1003), (0x0E, len(songs)), (0x10, start)):
        h[off:off + 2] = v.to_bytes(2, "big")
    for off, txt in ((0x16, title), (0x36, author), (0x56, released)):
        b = txt.encode("latin-1")[:32]
        h[off:off + len(b)] = b
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(bytes(h) + json.dumps(songs).encode())


SELFTEST_CONVERTER = r'''
import json, sys
from pathlib import Path
a = sys.argv[1:]
if not a or a[0] != "chip-notes" or "--help" in a:
    print("usage: fmzx-pack chip-notes <file.sid> [--subtune N] [--seconds S] -o <notes.toml>")
    sys.exit(0 if a and a[0] == "chip-notes" else 2)
f, sub, secs, out = a[1], int(a[a.index("--subtune") + 1]), int(a[a.index("--seconds") + 1]), a[a.index("-o") + 1]
with open(Path(__file__).with_name("calls.log"), "a") as lg:
    lg.write(f"{Path(f).name} {sub} {secs}\n")
data = Path(f).read_bytes()
if data[:4] == b"RSID":
    print("chip-notes: RSID tunes are not supported", file=sys.stderr)
    sys.exit(1)
text = lambda o: data[o:o + 32].split(b"\0")[0].decode("latin-1")
mel = json.loads(data[int.from_bytes(data[6:8], "big"):])[str(sub)]
beat = 875000
period = lambda p: round(3500000 / (440 * 2 ** ((p - 69) / 12)))
lines = [f"file = {json.dumps(f)}", f"subtune = {sub}", f"title = {json.dumps(text(0x16))}", f"author = {json.dumps(text(0x36))}",
         f"released = {json.dumps(text(0x56))}", "clock_hz = 985248", f"seconds = {secs}", "intro_t = 0", f"loop_t = {len(mel) * beat}"]
t, i = 0, 0
while t < secs * 3500000:
    p = mel[i % len(mel)]
    notes = [(0, t, t + beat - 20000, period(p), 120), (3, t, t + 100000, 0, 150)]
    if i % 4 == 0:
        notes.append((1, t, t + 4 * beat - 20000, period(p - 24), 90))
    for v, s, e, per, lv in sorted(notes, key=lambda n: n[0]):
        lines += ["", "[[note]]", f"voice = {v}", f"start_t = {s}", f"end_t = {e}", f"period_t = {per}", f"level = {lv}"]
    t, i = t + beat, i + 1
Path(out).write_text("\n".join(lines) + "\n")
'''


def selftest_collection(root: Path) -> Path:
    """A small made-up collection under root/C64Music, with a STIL; returns its folder."""
    c = root / "C64Music"
    m = SELFTEST_MELODY
    both = m + [x + 5 for x in m]
    selftest_sid(c / "GAMES" / "S-Z" / "Test_Tune.sid", "Test Tune", "Ann Example", "1985 Nobody Soft",
                 {"1": [60, 62, 60, 65, 64, 60, 67, 65, 63, 58], "2": [x + 3 for x in both]})
    selftest_sid(c / "MUSICIANS" / "E" / "Example_Bob" / "Cover.sid", "Some Cover", "Bob Example", "1999 Example Group",
                 {"1": [50, 52, 50, 53], "2": [x + 12 for x in m]})
    selftest_sid(c / "GAMES" / "A-F" / "Another_Game.sid", "Another Game", "Cy Example", "1986 Nobody Soft", {"1": m})
    selftest_sid(c / "MUSICIANS" / "R" / "Rs_Example" / "Test_Tune.sid", "Test Tune", "Di Example", "1987", {"1": m}, rsid=True)
    (c / "DOCUMENTS").mkdir(parents=True, exist_ok=True)
    (c / "DOCUMENTS" / "STIL.txt").write_text(
        "#############\n#  STIL (made up)\n#############\n\n### /GAMES/A-F/ #####\n\n"
        "/GAMES/A-F/Another_Game.sid\nCOMMENT: Music from the Spectrum version of\n         another game.\n\n"
        "/MUSICIANS/E/\nCOMMENT: A folder entry.\n\n"
        "/MUSICIANS/E/Example_Bob/Cover.sid\n(#1)\n  TITLE: Something Else\n(#2)\n  TITLE: Test Tune (title)\n"
        " ARTIST: Ann Example\nCOMMENT: Covers the title music of the Spectrum\n         game.\n", encoding="latin-1")
    return c


