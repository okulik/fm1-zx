# MIDI and renders


def write_midi(path: Path, tracks: list[tuple[str, int, bool, list[tuple[float, float, int, int]]]]) -> None:
    """tracks: (name, GM program, drums?, [(start s, end s, pitch, velocity)]), at 120 bpm."""
    import mido

    mid = mido.MidiFile(ticks_per_beat=480)
    meta = mido.MidiTrack()
    meta.append(mido.MetaMessage("set_tempo", tempo=500000, time=0))
    mid.tracks.append(meta)
    tonal_ch = [c for c in range(16) if c != 9]
    ci = 0
    for name, program, drums, notes in tracks:
        if drums:
            ch = 9
        else:
            ch = tonal_ch[ci % len(tonal_ch)]
            ci += 1
        tr = mido.MidiTrack()
        tr.append(mido.MetaMessage("track_name", name=name, time=0))
        if not drums:
            tr.append(mido.Message("program_change", channel=ch, program=program, time=0))
        ev = []
        for s, e, p, v in notes:
            if not 0 <= p <= 127:
                continue
            a, b = int(round(s * 960)), int(round(e * 960))
            b = max(b, a + 1)
            ev.append((a, 1, p, v))
            ev.append((b, 0, p, 0))
        ev.sort()
        now = 0
        for t, on, p, v in ev:
            msg = "note_on" if on else "note_off"
            tr.append(mido.Message(msg, channel=ch, note=p, velocity=v if on else 0, time=t - now))
            now = t
        mid.tracks.append(tr)
    mid.save(str(path))


def original_tracks(score: Score, all_lead: bool) -> list:
    """The score's notes, a track per voice: as the FM-1 plays them (roles' instruments), or all
    as one square lead (the generator's view, in full.mid)."""
    tracks = []
    roles = score.roles
    for v in sorted({n.voice for n in score.notes}):
        ns = [n for n in score.notes if n.voice == v]
        if ns and ns[0].period_t == 0:
            tracks.append(("original drum", 0, True, [(score.sec(n.start_t), score.sec(n.end_t), 38, vel_of_level(n.level)) for n in ns]))
            continue
        role = roles[v] if v < len(roles) and roles[v] in GM_PROGRAM else "lead"
        prog = GM_PROGRAM["lead"] if all_lead else GM_PROGRAM[role]
        tracks.append((f"original voice {v}", prog, False,
                       [(score.sec(n.start_t), score.sec(n.end_t), int(round(score.midi(n))), vel_of_level(n.level)) for n in ns if n.period_t > 0]))
    return tracks


def full_midi(score: Score, take: Take, path: Path) -> None:
    tracks = original_tracks(score, all_lead=True)
    for prog in sorted({g.program for g in take.notes}):
        ns = [(g.start, g.end, g.pitch, g.velocity) for g in take.notes if g.program == prog]
        part = next(g.part for g in take.notes if g.program == prog)
        tracks.append((f"{part} {prog}" if prog < 128 else "drums", 0 if prog == 128 else prog, prog == 128, ns))
    write_midi(path, tracks)


def fm1_midi(score: Score, voices: dict[int, list[Note]], path: Path) -> None:
    tracks = []
    for v, role in enumerate(TAKE_ROLES):
        tracks.append((role, GM_PROGRAM[role], False,
                       [(score.sec(n.start_t), score.sec(n.end_t), int(round(score.midi(n))), vel_of_level(n.level)) for n in voices[v]]))
    tracks.append(("drums", 0, True, [(score.sec(n.start_t), score.sec(n.end_t), drum_key_of_level(n.level), vel_of_level(n.level)) for n in voices[3]]))
    write_midi(path, tracks)


def default_soundfont() -> str | None:
    dirs = []
    fs = shutil.which("fluidsynth")
    if fs:
        dirs.append(Path(fs).resolve().parent.parent / "share" / "fluid-synth" / "sf2")
    for prefix in ("/opt/homebrew", "/usr/local"):
        dirs += [Path(prefix) / "opt" / "fluid-synth" / "share" / "fluid-synth" / "sf2", Path(prefix) / "share" / "fluid-synth" / "sf2",
                 Path(prefix) / "share" / "soundfonts"]
    dirs += [Path("/usr/share/sounds/sf2"), Path("/usr/share/soundfonts")]
    for d in dirs:
        if not d.is_dir():
            continue
        found = sorted(p for p in d.glob("*.sf2") if p.name.isascii() and p.name.replace("-", "").replace("_", "").replace(".", "").isalnum())
        if found:
            return str(found[0])
    return None


class Renderer:
    def __init__(self, soundfont: str | None):
        self.fluidsynth = shutil.which("fluidsynth")
        self.ffmpeg = shutil.which("ffmpeg")
        self.soundfont = soundfont or (default_soundfont() if self.fluidsynth else None)
        if self.soundfont and not Path(self.soundfont).is_file():
            die(f"no soundfont {self.soundfont}")

    @property
    def ok(self) -> bool:
        return bool(self.fluidsynth and self.soundfont)

    def why_not(self) -> str:
        if not self.fluidsynth:
            return "no fluidsynth on PATH (Homebrew: brew install fluid-synth): no renders"
        return "no soundfont found (--soundfont PATH): no renders"

    def render(self, mid: Path, wav: Path, seconds: float) -> None:
        if not self.ok:
            return
        raw = wav.with_suffix(".raw.wav")
        subprocess.run([self.fluidsynth, "-ni", "-q", "-g", "0.5", "-r", "44100", "-F", str(raw), self.soundfont, str(mid)],
                       check=True, capture_output=True)
        if self.ffmpeg:
            subprocess.run([self.ffmpeg, "-y", "-loglevel", "error", "-i", str(raw), "-t", f"{seconds + 1.0:.2f}",
                            "-af", "loudnorm=I=-16:TP=-1.5:LRA=11", "-ar", "44100", str(wav)], check=True)
            raw.unlink()
        else:
            raw.replace(wav)


