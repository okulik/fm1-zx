def selftest_ay(path: Path, author: str, misc: str, songs: list[tuple[str, list[int] | None]], first: int = 0) -> None:
    """A made-up .ay file: a ZXAYEMUL header, its author and misc strings, its songs' table (each
    song's name, and a data pointer to a stub), then, after "\\0JSON", the songs' melodies (None: a
    tune the stand-in converter refuses, as a 48K beeper tune), which only the stand-in reads."""
    b = bytearray(b"ZXAYEMUL") + bytes([3, 3, 0, 0]) + bytes(4) + bytes([len(songs) - 1, first]) + bytes(2)
    rel = lambda at, to: b.__setitem__(slice(at, at + 2), (to - at).to_bytes(2, "big", signed=True))  # noqa: E731
    table = len(b)
    b += bytes(4 * len(songs))
    stub = len(b)
    b += bytes(14)
    for at, txt in [(12, author), (14, misc)] + [(table + 4 * k, name) for k, (name, _) in enumerate(songs)]:
        rel(at, len(b))
        b += txt.encode("latin-1") + b"\0"
    rel(18, table)
    for k in range(len(songs)):
        rel(table + 4 * k + 2, stub)
    b += b"\0JSON" + json.dumps({str(k + 1): mel for k, (_, mel) in enumerate(songs)}).encode()
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(bytes(b))


