def choices_path(d: Path) -> Path:
    return d / "arrange" / "choices.toml"


Choice = int | str  # a take's number (0: the original) or a chip take's dir, "chip-<n>"


def parse_choice(v) -> Choice | None:
    """A choices.toml value: a number (an arranged take, 0 the original) or "chip-<n>"."""
    if isinstance(v, bool):
        return None
    if isinstance(v, int):
        return v if v >= 0 else None
    if isinstance(v, str):
        if v.isdigit():
            return int(v)
        if v.startswith("chip-") and v[5:].isdigit() and int(v[5:]) > 0:
            return f"chip-{int(v[5:])}"
    return None


def read_choices(d: Path) -> dict[str, Choice]:
    out = {}
    for k, v in read_toml(choices_path(d)).get("choices", {}).items():
        c = parse_choice(v)
        if c is not None:
            out[str(k)] = c
    return out


def write_choices(d: Path, update: dict[str, Choice]) -> dict[str, Choice]:
    ch = read_choices(d)
    ch.update(update)
    choices_path(d).parent.mkdir(parents=True, exist_ok=True)
    dump_toml(choices_path(d), {"choices": dict(sorted(ch.items()))})
    return ch


def score_entries(d: Path) -> list[dict]:
    choices = read_choices(d)
    out = []
    for s in find_scores(d):
        takes = []
        for n, p in take_dirs(s.dir):
            doc = read_toml(p / "arranged.toml")
            takes.append({"n": n, "generator": doc.get("generator", ""), "metrics": doc.get("metrics", {}),
                          "fm1": (p / "fm1.wav").is_file(), "full": (p / "full.wav").is_file()})
        chips = []
        for n, p in chip_dirs(s.dir):
            doc = read_toml(p / "arranged.toml")
            mt = doc.get("metrics", {})
            chips.append({"name": f"chip-{n}", "source": doc.get("source", ""), "stil": doc.get("stil", ""),
                          "melody_match": mt.get("melody_match", 0.0), "title_match": mt.get("title_match", 0.0),
                          "fm1": (p / "fm1.wav").is_file(), "chip": (p / "chip.wav").is_file()})
        out.append({"id": s.id, "game": s.game, "name": s.name, "key": s.key, "seconds": round(s.seconds, 1), "shadow": s.shadow,
                    "original": (s.dir / "original.wav").is_file(), "takes": takes, "chips": chips, "choice": choices.get(s.id, 0)})
    return out


def choice_ok(entry: dict, v: Choice) -> bool:
    if isinstance(v, str):
        return v in {c["name"] for c in entry["chips"]}
    return v == 0 or v in {t["n"] for t in entry["takes"]}


def chip_line(c: dict) -> str:
    return f"{c['source']} \u2014 melody match {float(c['melody_match']):.2f}"


def apply_set(d: Path, sets: list[str]) -> None:
    entries = {e["id"]: e for e in score_entries(d)}
    update = {}
    for s in sets:
        sid, eq, n = s.rpartition("=")
        n_ = parse_choice(n) if eq else None
        if n_ is None:
            die(f"--set {s}: expected GAME/KEY=N or GAME/KEY=chip-N")
        if sid not in entries:
            die(f"--set {s}: no score {sid} under {d / 'arrange'}")
        if not choice_ok(entries[sid], n_):
            die(f"--set {s}: {sid} has no take {n_}")
        update[sid] = n_
    write_choices(d, update)
    for sid, n_ in update.items():
        print(f"{sid} = {n_}" + (" (the original)" if n_ == 0 else ""))


SHADOW_MARK = "(replaces the live version when chosen)"


def print_list(d: Path) -> None:
    entries = score_entries(d)
    if not entries:
        print(f"no scores under {d / 'arrange'}")
    for e in entries:
        ch = e["choice"]
        shadow = f" {SHADOW_MARK}" if e["shadow"] else ""
        original = " (the live version)" if e["shadow"] else " (original)"
        names = [str(t["n"]) for t in e["takes"]] + [c["name"] for c in e["chips"]]
        print(f"{e['id']}  ({e['name']}, {e['seconds']} s){shadow}  takes: {' '.join(names) or '-'}  "
              f"choice: {ch}{original if ch == 0 else ''}")
        for t in e["takes"]:
            print(f"  take {t['n']}: {t['generator']}")
            print(f"    {metrics_line(t['metrics'])}")
        for c in e["chips"]:
            print(f"  {c['name']}: {chip_line(c)}")


