# Generators


@dataclass
class GenNote:
    start: float  # seconds from the timeline's start
    end: float
    program: int  # GM program 0-127, 128 drums
    pitch: int  # MIDI pitch (GM drum key for drums)
    part: str  # "bass", "chords" or "drums"
    velocity: int = 90


@dataclass
class Take:
    notes: list[GenNote]
    generator: str  # arranged.toml's generator field: the model and its settings
    info: dict = field(default_factory=dict)  # free-form, printed and kept in takes.toml


@dataclass
class Settings:
    model: str = "amt"
    takes: int = 4
    seed: int = 1
    offline: bool = False
    soundfont: str | None = None
    amt_model: str = "stanford-crfm/music-medium-800k"
    prefix: str = ""

    def log(self, msg: str) -> None:
        print(f"{self.prefix}{msg}", flush=True)


GenerateTake = Callable[[Score, int, random.Random, Settings], Take]
GENERATORS: dict[str, GenerateTake] = {}


def generator(name: str) -> Callable[[GenerateTake], GenerateTake]:
    def reg(fn: GenerateTake) -> GenerateTake:
        GENERATORS[name] = fn
        return fn

    return reg


def take_rng(settings: Settings, score: Score, take_index: int) -> random.Random:
    return random.Random(f"{settings.model}/{settings.seed}/{score.id}/{take_index}")


def onsets_of(score: Score) -> list[float]:
    return sorted({round(score.sec(n.start_t), 3) for n in score.tonal()})


def estimate_beat(onsets: list[float]) -> float:
    iois = sorted(b - a for a, b in zip(onsets, onsets[1:]) if b - a > 0.05)
    if not iois:
        return 0.5
    beat = iois[len(iois) // 2]
    while beat < 0.3:
        beat *= 2
    while beat > 1.0:
        beat /= 2
    return beat


@generator("rules")
def rules_take(score: Score, take_index: int, rng: random.Random, settings: Settings) -> Take:
    """A bass on the strongest pitch class of each chord span, a triad above it, and a drum
    pattern on the beat; the take picks the span length, the bass rhythm and the pattern."""
    total = score.seconds
    tonal = [(score.sec(n.start_t), score.sec(n.end_t), score.midi(n)) for n in score.tonal()]
    onsets = onsets_of(score)
    if not tonal or total <= 0:
        return Take([], f"rules seed={settings.seed}")
    beat = estimate_beat(onsets)
    span_beats = rng.choice([2, 4])
    bass_beats = rng.choice([1, 2, span_beats])
    pattern = rng.choice(["rock", "half", "four"])
    t0 = onsets[0]
    notes: list[GenNote] = []
    span = beat * span_beats
    a = t0
    while a < total:
        b = min(a + span, total)
        w = [0.0] * 12
        for s, e, p in tonal:
            ov = min(e, b) - max(s, a)
            if ov > 0:
                w[int(round(p)) % 12] += ov
        if max(w) > 0:
            root = max(range(12), key=lambda k: w[k])
            third = 4 if w[(root + 4) % 12] >= w[(root + 3) % 12] else 3
            bass = 36 + root
            x = a
            while x < b - 1e-6:
                y = min(x + beat * bass_beats, b)
                notes.append(GenNote(x, y - 0.02, 33, bass, "bass"))
                x = y
            for iv in (0, third, 7):
                notes.append(GenNote(a, b, 4, 60 + (root + iv) % 12, "chords"))
        a = b
    k = 0
    x = t0
    while x < total:
        if pattern == "rock":
            key = 36 if k % 2 == 0 else 38
        elif pattern == "half":
            key = 36 if k % 4 == 0 else (38 if k % 4 == 2 else 42)
        else:
            key = 36
        notes.append(GenNote(x, min(x + 0.1, total), 128, key, "drums"))
        if x + beat / 2 < total:
            notes.append(GenNote(x + beat / 2, min(x + beat / 2 + 0.05, total), 128, 42, "drums"))
        x += beat
        k += 1
    label = f"rules seed={settings.seed} beat={beat:.3f}s span={span_beats} bass={bass_beats} drums={pattern}"
    return Take(notes, label)


# --- the Anticipatory Music Transformer ------------------------------------------------------

AMT_STAGES = (
    ("drums", frozenset({128})),
    ("bass", frozenset(range(32, 40))),
    ("chords", frozenset(set(range(0, 8)) | set(range(24, 32)) | set(range(48, 52)))),
)
AMT_TOP_P = (0.95, 0.98, 0.92, 0.96)  # by take, cycling
AMT_MELODY_PROGRAM = 80  # the original, every voice, as one square lead
AMT_WINDOW = 30.0  # seconds a generate call covers; a pass that stops early resumes at the next
AMT_LEAD_IN = 0.1  # seconds: the library drops controls in its first 50 ms, so time starts here
AMT_NOTES_PER_S = 15.0  # for the first estimate: generated notes a second of music, per pass
AMT_S_PER_NOTE = 0.12  # for the first estimate: seconds a generated note takes
AMT_NOTES_PER_S_MAX = 40  # notes a second of music a pass may write in a window; past it the
                          # window ends (the model can keep writing notes at one moment forever)
AMT_STALL = 16  # notes in a row at one moment that end the window (a chord has a few)


class _AmtState:
    model = None
    device = None
    banned = None  # note-token mask of the instruments the pass may not use
    gen = None  # the pass's torch.Generator (sampling runs on the CPU, so the seed decides)
    progress: Callable[[int], None] | None = None
    end_tick = 0  # the window's end, in the library's 10 ms time ticks
    budget = 0  # notes the window may still write; at 0 its next note is placed at end_tick
    last_tick = -1  # the time of the window's last note, and how many notes in a row had it
    same = 0


AMT = _AmtState()


def amt_load(settings: Settings) -> None:
    if AMT.model is not None:
        return
    if settings.offline:
        os.environ["HF_HUB_OFFLINE"] = "1"
        os.environ["TRANSFORMERS_OFFLINE"] = "1"
    import logging

    logging.getLogger("torch.distributed.elastic.multiprocessing.redirects").setLevel(logging.ERROR)
    import torch
    import transformers
    from transformers import AutoModelForCausalLM

    transformers.logging.set_verbosity_error()  # the checkpoint's empty token_out_embeddings: tied
    transformers.utils.logging.disable_progress_bar()
    import anticipation.sample as smp

    try:
        model = AutoModelForCausalLM.from_pretrained(settings.amt_model, local_files_only=True)
    except OSError:
        if settings.offline:
            die(f"the model {settings.amt_model} is not in the Hugging Face cache, and --offline "
                "fetches nothing: run once without --offline to download it (about 1.4 GB)")
        print(f"{PROG}: downloading the model {settings.amt_model} (about 1.4 GB, once) to the "
              "Hugging Face cache", flush=True)
        model = AutoModelForCausalLM.from_pretrained(settings.amt_model)
    if torch.backends.mps.is_available():
        dev = "mps"
    elif torch.cuda.is_available():
        dev = "cuda"
    else:
        dev = "cpu"
    AMT.model = model.to(dev).eval()
    AMT.device = dev
    smp.add_token = _amt_add_token


def amt_ensure_model(settings: Settings) -> None:
    """The model in the Hugging Face cache: downloaded once (with a notice) before any worker
    starts; under --offline, a stop with how to get it when it is missing."""
    from huggingface_hub import snapshot_download, try_to_load_from_cache

    if isinstance(try_to_load_from_cache(settings.amt_model, "config.json"), str):
        return
    if settings.offline:
        die(f"the model {settings.amt_model} is not in the Hugging Face cache, and --offline "
            "fetches nothing: run once without --offline to download it (about 1.4 GB)")
    print(f"{PROG}: downloading the model {settings.amt_model} (about 1.4 GB, once) to the "
          "Hugging Face cache", flush=True)
    snapshot_download(settings.amt_model)


def _amt_add_token(model, z, tokens, top_p, current_time, debug=False):
    """anticipation.sample.add_token with a key-value cache for the event's second and third
    tokens, and sampling on the CPU from the pass's generator."""
    import torch
    import torch.nn.functional as F
    from anticipation import ops
    import anticipation.sample as smp

    assert len(tokens) % 3 == 0
    history = tokens[max(len(tokens) - 1017, 0):]
    offset = ops.min_time(history, seconds=False)
    history = list(history)
    history[::3] = [tok - offset for tok in history[::3]]
    new: list[int] = []
    with torch.no_grad():
        out = model(input_ids=torch.tensor([z + history], device=model.device), use_cache=True)
        for i in range(3):
            if i:
                out = model(input_ids=torch.tensor([[new[-1]]], device=model.device),
                            cache=out.cache, use_cache=True)
            logits = out.logits[0, -1].float().cpu()
            logits = smp.safe_logits(logits, len(z) + len(history) + i - 1)
            if i == 0:
                logits = smp.future_logits(logits, current_time - offset)
            else:
                if i == 2:
                    logits = smp.instr_logits(logits, tokens)
                    logits[AMT.banned] = -float("inf")
            logits = smp.nucleus(logits, top_p)
            new.append(int(torch.multinomial(F.softmax(logits, dim=-1), 1, generator=AMT.gen)))
    from anticipation.vocab import TIME_OFFSET
    tick = new[0] - TIME_OFFSET + offset
    AMT.same = AMT.same + 1 if tick == AMT.last_tick else 1
    AMT.last_tick = tick
    if AMT.budget <= 0 or AMT.same >= AMT_STALL:   # spent, or stuck at one moment: a time at
        new[0] = TIME_OFFSET + AMT.end_tick - offset    # the window's end ends the window
        AMT.budget = min(AMT.budget, 0)
    AMT.budget -= 1
    new[0] += offset
    if AMT.progress:
        AMT.progress(new[0])
    return new


def _amt_tokens(notes: list[tuple[float, float, int, int]], control: bool) -> list[int]:
    from anticipation.vocab import CONTROL_OFFSET, DUR_OFFSET, NOTE_OFFSET, TIME_OFFSET

    base = CONTROL_OFFSET if control else 0
    out = []
    for start, dur, prog, pitch in notes:
        if not 0 <= pitch <= 127:
            continue
        t = int(round((start + AMT_LEAD_IN) * 100))
        d = max(1, min(999, int(round(dur * 100))))
        out += [base + TIME_OFFSET + t, base + DUR_OFFSET + d, base + NOTE_OFFSET + prog * 128 + pitch]
    return out


@generator("amt")
def amt_take(score: Score, take_index: int, rng: random.Random, settings: Settings) -> Take:
    """Three passes of the Anticipatory Music Transformer, drums, then bass, then chords, each
    allowed one instrument class and hearing the original and the passes before it as controls."""
    amt_load(settings)
    import torch
    from anticipation import ops
    from anticipation.sample import generate
    from anticipation.vocab import DUR_OFFSET, NOTE_OFFSET, TIME_OFFSET

    top_p = AMT_TOP_P[(take_index - 1) % len(AMT_TOP_P)]
    total = score.seconds
    end_bins = int(round((total + AMT_LEAD_IN) * 100))
    original = []
    for n in score.notes:
        s, e = score.sec(n.start_t), score.sec(n.end_t)
        if n.period_t > 0 and n.voice < 3:
            original.append((s, e - s, AMT_MELODY_PROGRAM, int(round(score.midi(n)))))
        else:
            original.append((s, e - s, 128, 38))
    melody = _amt_tokens(original, control=True)
    parts: list[GenNote] = []
    seeds = []
    t_start = time.time()
    stages_info = {}
    n_stages = len(AMT_STAGES)
    last = [time.time()]
    for si, (part, allowed) in enumerate(AMT_STAGES):
        seed = rng.getrandbits(63)
        seeds.append(seed)
        AMT.gen = torch.Generator().manual_seed(seed)
        banned = torch.ones(55028, dtype=torch.bool)
        banned[:NOTE_OFFSET] = False
        banned[NOTE_OFFSET + 129 * 128:] = False
        for ins in allowed:
            banned[NOTE_OFFSET + ins * 128:NOTE_OFFSET + (ins + 1) * 128] = False
        AMT.banned = banned
        count = [0]

        def progress(time_tok: int, si=si, part=part, count=count) -> None:
            count[0] += 1
            now = time.time()
            if now - last[0] < 15:
                return
            last[0] = now
            at = min(max((time_tok - TIME_OFFSET) / 100 - AMT_LEAD_IN, 0), total)
            frac = (si + at / max(total, 1e-6)) / n_stages
            el = now - t_start
            left = el * (1 - frac) / frac if frac > 0.01 else float("nan")
            settings.log(f"take {take_index} {part}: {at:.1f}/{total:.1f} s, {count[0]} notes, "
                         f"{el:.0f} s so far, about {fmt_dur(left)} left in this take")

        AMT.progress = progress
        ctl = list(melody) + _amt_tokens([(g.start, g.end - g.start, g.program, g.pitch) for g in parts], control=True)
        ctl = ops.sort(ctl)
        events: list[int] = []
        t0 = time.time()
        w = 0
        cut = 0
        while w < end_bins:
            w1 = min(w + int(AMT_WINDOW * 100), end_bins)
            AMT.end_tick = w1 + 1
            AMT.budget = max(1, int(AMT_NOTES_PER_S_MAX * (w1 - w) / 100))
            AMT.last_tick, AMT.same = -1, 0
            events = generate(AMT.model, (w + 0.5) / 100, (w1 + 0.5) / 100, inputs=events, controls=ctl, top_p=top_p)
            cut += AMT.budget < 0
            w = w1
        new = []
        for tm, du, no in zip(events[0::3], events[1::3], events[2::3]):
            nn = no - NOTE_OFFSET
            ins, pitch = nn // 128, nn % 128
            s = (tm - TIME_OFFSET) / 100 - AMT_LEAD_IN
            e = min(s + max(du - DUR_OFFSET, 1) / 100, total)
            if ins in allowed and 0 <= s < total and e > s:
                new.append(GenNote(s, e, ins, pitch, part))
        parts += new
        stages_info[part] = {"notes": len(new), "seconds": round(time.time() - t0, 1), "windows_cut": cut}
        settings.log(f"take {take_index} {part}: {len(new)} notes in {time.time() - t0:.0f} s "
                     f"({(time.time() - t0) / max(count[0], 1):.2f} s a note on {AMT.device})"
                     + (f"; {cut} window(s) cut (over {AMT_NOTES_PER_S_MAX} notes a second, or "
                        f"{AMT_STALL} notes at one moment)" if cut else ""))
    AMT.progress = None
    label = (f"amt {settings.amt_model} staged {','.join(p for p, _ in AMT_STAGES)} top_p={top_p} "
             f"seed={settings.seed}")
    return Take(parts, label, {"stages": stages_info, "device": AMT.device})


def estimate_seconds(score: Score, settings: Settings) -> float | None:
    if settings.model != "amt":
        return None
    return score.seconds * AMT_NOTES_PER_S * len(AMT_STAGES) * AMT_S_PER_NOTE


def fmt_dur(s: float) -> str:
    if s != s:
        return "?"
    if s < 90:
        return f"{s:.0f} s"
    if s < 5400:
        return f"{s / 60:.0f} min"
    return f"{s / 3600:.1f} h"


# ---------------------------------------------------------------------------------------------
# The FM-1's four voices


DRUM_CLASS = {35: "kick", 36: "kick", 38: "snare", 40: "snare", 37: "clap", 39: "clap",
              41: "tom", 43: "tom", 45: "tom", 47: "tom", 48: "tom", 50: "tom",
              42: "hat", 44: "hat", 46: "hat", 49: "cymbal", 51: "cymbal", 52: "cymbal",
              53: "cymbal", 55: "cymbal", 57: "cymbal", 59: "cymbal"}
DRUM_PRIORITY = {"kick": 0, "snare": 1, "clap": 2, "tom": 3, "hat": 4, "cymbal": 5}
DRUM_LEVEL = {"kick": 200, "snare": 170, "clap": 130, "tom": 130, "hat": 80, "cymbal": 96}
DRUM_OTHER_LEVEL = 110
# The FM-1's drum strikes only from off, and a frame (69888 T) plays at most 8 events of all
# voices together: a hit lasts at most DRUM_HIT_S, ends DRUM_GAP_T before the next one starts,
# and hits are at least DRUM_SPACING_S apart (the stronger kind wins a clash).
DRUM_HIT_S = 0.05
DRUM_GAP_T = 128
DRUM_SPACING_S = 0.04
TONAL_MIN_TICKS = 3  # bass and pad notes under 30 ms are dropped, to keep the frames' events few


def drum_key_of_level(level: int) -> int:
    """fm1.mid's drum key for a level of arranged.toml: kick, snare, clap or hat."""
    if level >= 185:
        return 36
    if level >= 150:
        return 38
    if level >= 100:
        return 39
    return 42


def mono_line(notes: list[tuple[float, float, int]], ticks: int, low: bool) -> list[tuple[int, int, int]]:
    """One note at a time from notes (start s, end s, pitch): at each tick the lowest (low) or
    highest sounding note; a later note wins a tie, so a repeated note is struck again. Returns
    (start tick, end tick, pitch); pieces under TONAL_MIN_TICKS are dropped."""
    import numpy as np

    pitch = np.full(ticks, np.nan)
    idx = np.full(ticks, -1, dtype=np.int64)
    for i, (s, e, p) in enumerate(notes):
        a, b = int(round(s * TICKS_PER_S)), min(int(round(e * TICKS_PER_S)), ticks)
        if b <= a:
            continue
        seg = pitch[a:b]
        m = ~(seg < p) if low else ~(seg > p)
        seg[m] = p
        idx[a:b][m] = i
    out = []
    k = 0
    while k < ticks:
        i = idx[k]
        j = k
        while j < ticks and idx[j] == i:
            j += 1
        if i >= 0 and j - k >= TONAL_MIN_TICKS:
            out.append((k, j, notes[i][2]))
        k = j
    return out


def arrange(score: Score, take: Take) -> dict[int, list[Note]]:
    """The take on the FM-1's voices: 0 the score's melody voice as it is, 1 the lowest bass
    note, 2 the highest chord note, 3 one drum hit at a time within the device's limits
    (DRUM_HIT_S, DRUM_GAP_T, DRUM_SPACING_S)."""
    total_t = score.total_t
    ticks = int(math.ceil(score.seconds * TICKS_PER_S))
    voices: dict[int, list[Note]] = {0: [], 1: [], 2: [], 3: []}
    mv = score.melody_voice()
    lead = sorted((n for n in score.tonal() if n.voice == mv), key=lambda n: (n.start_t, n.end_t))
    for i, n in enumerate(lead):
        s, e = max(n.start_t, 0), min(n.end_t, total_t)
        if i + 1 < len(lead):
            e = min(e, lead[i + 1].start_t)
        if e > s:
            voices[0].append(Note(0, s, e, n.period_t, max(1, min(255, n.level))))
    levels = sorted(n.level for n in voices[0]) or [128]
    lead_level = levels[len(levels) // 2]
    tick_t = lambda k: min(score.tstate(k / TICKS_PER_S), total_t)  # noqa: E731
    for v, part, low, level in ((1, "bass", True, lead_level), (2, "chords", False, int(lead_level * 0.7))):
        line = mono_line([(g.start, g.end, g.pitch) for g in take.notes if g.part == part], ticks, low)
        for a, b, p in line:
            s, e = tick_t(a), tick_t(b)
            if e > s:
                voices[v].append(Note(v, s, e, period_of_midi(score.clock_hz, p), max(1, min(255, level))))
    hits: list[tuple[float, str]] = []
    for g in take.notes:
        if g.part == "drums" and 0 <= g.start < score.seconds:
            hits.append((g.start, DRUM_CLASS.get(g.pitch, "other")))
    hits.sort()
    kept: list[tuple[float, str]] = []
    for at, kind in hits:
        if kept and at - kept[-1][0] < DRUM_SPACING_S:
            if DRUM_PRIORITY.get(kind, 9) < DRUM_PRIORITY.get(kept[-1][1], 9):
                kept[-1] = (kept[-1][0], kind)
            continue
        kept.append((at, kind))
    for i, (at, kind) in enumerate(kept):
        s = score.tstate(at)
        e = min(score.tstate(at + DRUM_HIT_S), total_t)
        if i + 1 < len(kept):
            e = min(e, score.tstate(kept[i + 1][0]) - DRUM_GAP_T)
        if e > s:
            voices[3].append(Note(3, s, e, 0, DRUM_LEVEL.get(kind, DRUM_OTHER_LEVEL)))
    return voices


# ---------------------------------------------------------------------------------------------
# Metrics

KS_MAJOR = (6.35, 2.23, 3.48, 2.33, 4.38, 4.09, 2.52, 5.19, 2.39, 3.66, 2.29, 2.88)
KS_MINOR = (6.33, 2.68, 3.52, 5.38, 2.60, 3.53, 2.54, 4.75, 3.98, 2.69, 3.34, 3.17)
PC_NAMES = "C C# D D# E F F# G G# A A# B".split()


def key_of(score: Score) -> tuple[str, list[int], float]:
    import numpy as np

    w = np.zeros(12)
    for n in score.tonal():
        w[int(round(score.midi(n))) % 12] += n.end_t - n.start_t
    if w.sum() <= 0 or w.std() == 0:
        return "", [], 0.0
    best = max(
        (float(np.corrcoef(np.roll(np.array(prof), k), w)[0, 1]), k, m)
        for m, prof in (("maj", KS_MAJOR), ("min", KS_MINOR))
        for k in range(12)
    )
    r, k, m = best
    steps = (0, 2, 4, 5, 7, 9, 11) if m == "maj" else (0, 2, 3, 5, 7, 8, 10)
    return f"{PC_NAMES[k]} {m}", [(k + s) % 12 for s in steps], r


def metrics(score: Score, voices: dict[int, list[Note]], generated: int) -> dict:
    import numpy as np

    ticks = max(int(math.ceil(score.seconds * TICKS_PER_S)), 1)

    def line(v: int) -> np.ndarray:
        arr = np.full(ticks, -1, dtype=np.int64)
        for n in voices[v]:
            a = int(score.sec(n.start_t) * TICKS_PER_S)
            b = min(int(score.sec(n.end_t) * TICKS_PER_S), ticks)
            if n.period_t > 0:
                arr[a:b] = int(round(score.midi(n)))
        return arr

    key, scale, r = key_of(score)
    lead = line(0)
    m: dict = {"key": key, "key_r": round(r, 3)}
    for v, nm in ((1, "bass"), (2, "pad")):
        x = line(v)
        on = x >= 0
        m[f"{nm}_in_key"] = round(float(np.isin(x[on] % 12, scale).mean()) if on.any() and scale else 0.0, 3)
        both = on & (lead >= 0)
        m[f"{nm}_consonance"] = round(float(np.isin((lead[both] - x[both]) % 12, CONSONANT).mean()) if both.any() else 0.0, 3)
    lead_on = np.array(sorted(score.sec(n.start_t) for n in voices[0]))
    others = [score.sec(n.start_t) for v in (1, 2, 3) for n in voices[v]]
    if len(lead_on) and others:
        o = np.array(others)
        pos = np.clip(np.searchsorted(lead_on, o), 1, len(lead_on) - 1) if len(lead_on) > 1 else np.zeros(len(o), dtype=int)
        near = np.minimum(np.abs(lead_on[pos] - o), np.abs(lead_on[np.maximum(pos - 1, 0)] - o))
        m["on_lead_onsets"] = round(float((near <= 0.03).mean()), 3)
    else:
        m["on_lead_onsets"] = 0.0
    secs = max(score.seconds, 1e-6)
    for v, nm in ((0, "lead"), (1, "bass"), (2, "pad"), (3, "drums")):
        m[f"{nm}_nps"] = round(len(voices[v]) / secs, 2)
    m["generated"] = generated
    return m


def metrics_line(m: dict) -> str:
    return (f"key {m.get('key') or '?'} (r {m.get('key_r', 0):.2f}); consonance bass {m.get('bass_consonance', 0):.2f} "
            f"pad {m.get('pad_consonance', 0):.2f}; in key bass {m.get('bass_in_key', 0):.2f} pad {m.get('pad_in_key', 0):.2f}; "
            f"on lead onsets {m.get('on_lead_onsets', 0):.2f}; notes/s lead {m.get('lead_nps', 0)} bass {m.get('bass_nps', 0)} "
            f"pad {m.get('pad_nps', 0)} drums {m.get('drums_nps', 0)}")


