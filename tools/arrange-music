    p = mel[i % len(mel)]
    notes = [(0, t, t + beat - 20000, period(p), 120), (3, t, t + 100000, 0, 150)]
    if i % 4 == 0:
        notes.append((1, t, t + 4 * beat - 20000, period(p - 24), 90))
    for v, s, e, per, lv in sorted(notes, key=lambda n: n[0]):
        lines += ["", "[[note]]", f"voice = {v}", f"start_t = {s}", f"end_t = {e}", f"period_t = {per}", f"level = {lv}"]
    t, i = t + beat, i + 1
Path(out).write_text("\n".join(lines) + "\n")
