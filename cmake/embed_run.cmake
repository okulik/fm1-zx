# Script mode helper for fmzx_embed: -DINPUT -DSYMBOL -DOUTPUT.
file(READ "${INPUT}" _hex HEX)
string(LENGTH "${_hex}" _hexlen)
math(EXPR _size "${_hexlen} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _body "${_hex}")
file(WRITE "${OUTPUT}"
  "/* Generated by cmake/embed.cmake from ${INPUT}. */\n"
  "#include <stdint.h>\n"
  "const uint8_t ${SYMBOL}[] = {\n${_body}\n};\n"
  "const uint32_t ${SYMBOL}_size = ${_size}u;\n")
